<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eventos | <%= bot.user.username %></title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Tilt+Warp&family=Bebas+Neue&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'titan-bg': '#0D0D0D',
                        'titan-accent': '#803E30',
                        'titan-cream': '#F8DCC0',
                        'titan-gold': '#D9A362',
                    }
                }
            }
        }
    </script>
    <style>
        .event-card {
            display: flex;
            flex-direction: column;
            gap: 8px;
            background: var(--bg-card);
            border: 1px solid rgba(248, 220, 192, 0.08);
            border-radius: 14px;
            padding: 16px 20px;
        }
        .event-card-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            font-size: 0.75rem;
            opacity: 0.55;
        }
        .event-card-meta span { display: inline-flex; align-items: center; gap: 5px; }
        .event-live-dot {
            width: 8px; height: 8px; border-radius: 50%;
            background: #4ADE80; display: inline-block;
            box-shadow: 0 0 6px #4ADE80;
        }
    </style>
</head>
<body class="flex min-h-screen"<%- (typeof isAdmin !== 'undefined' && !isAdmin) ? ' data-view-only="true"' : '' %>>

    <aside class="shrink-0 h-screen sticky top-0 py-[15px] pl-[15px] lg:py-[30px] lg:pl-[30px]">
        <%- include('partials/sidebar-v2', { active: 'eventos', guild, nickname, role, isOwner: typeof isOwner !== 'undefined' ? isOwner : false, showAvatarHint: typeof showAvatarHint !== 'undefined' ? showAvatarHint : false }) %>
    </aside>

    <%# Sem overflow-y-auto (pedido do dono, 2026-08-05) — ver comentário completo em moderacao.ejs. Página inteira rola via <body>, não mais o <main> por dentro (evita cortar a sombra dos cards perto da sidebar). %>
    <main class="flex-1 w-full flex flex-col p-[15px] gap-[20px] lg:p-[30px] lg:gap-[30px]">

        <%- include('partials/page-header', { guild, pageLabel: 'EVENTOS', pageLabelEn: 'EVENTS', pageRoute, otherGuilds }) %>

        <%- include('partials/save-result-overlay', { saved }) %>

        <%- include('partials/view-only-banner', { isAdmin, role }) %>

        <div id="ingamePulseRoot" data-guild-id="<%= guild.id %>" data-show-roster="true">
            <%- include('partials/ingame-pulse', { pulse }) %>
        </div>

        <!-- ACONTECENDO AGORA -->
        <section class="titan-card-premium flex-col gap-4">
            <h2 class="section-title text-lg flex items-center gap-2">
                <% if (happeningNow.length > 0) { %><span class="event-live-dot"></span><% } %>
                <span data-i18n-pt>Acontecendo Agora</span><span data-i18n-en>Happening Now</span>
            </h2>
            <% if (happeningNow.length === 0) { %>
                <p class="text-sm opacity-40"><span data-i18n-pt>Nenhum evento acontecendo agora.</span><span data-i18n-en>No event happening right now.</span></p>
            <% } else { %>
                <div class="flex flex-col gap-3">
                    <% happeningNow.forEach(ev => { %>
                        <div class="event-card">
                            <span class="font-semibold"><%= ev.name %></span>
                            <div class="event-card-meta">
                                <% if (ev.scheduledEndTimestamp) { %><span><i data-lucide="clock" class="w-3.5 h-3.5"></i> <span data-i18n-pt>Termina</span><span data-i18n-en>Ends</span> <%= new Date(ev.scheduledEndTimestamp).toLocaleString('pt-BR') %></span><% } %>
                                <% if (typeof ev.userCount === 'number') { %><span><i data-lucide="users" class="w-3.5 h-3.5"></i> <%= ev.userCount %> <span data-i18n-pt>inscrito(s)</span><span data-i18n-en>signed up</span></span><% } %>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </section>

        <!-- EVENTOS AGENDADOS -->
        <section class="titan-card-premium flex-col gap-4">
            <h2 class="section-title text-lg"><span data-i18n-pt>Eventos Agendados</span><span data-i18n-en>Scheduled Events</span></h2>
            <% if (scheduledEvents.length === 0) { %>
                <p class="text-sm opacity-40"><span data-i18n-pt>Nenhum evento agendado.</span><span data-i18n-en>No events scheduled.</span></p>
            <% } else { %>
                <div class="flex flex-col gap-3">
                    <% scheduledEvents.forEach(ev => { %>
                        <div class="event-card">
                            <span class="font-semibold"><%= ev.name %></span>
                            <div class="event-card-meta">
                                <% if (ev.scheduledStartTimestamp) { %><span><i data-lucide="calendar-clock" class="w-3.5 h-3.5"></i> <%= new Date(ev.scheduledStartTimestamp).toLocaleString('pt-BR') %></span><% } %>
                                <% if (typeof ev.userCount === 'number') { %><span><i data-lucide="users" class="w-3.5 h-3.5"></i> <%= ev.userCount %> <span data-i18n-pt>inscrito(s)</span><span data-i18n-en>signed up</span></span><% } %>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </section>

        <%#
            CONFIGURAÇÕES — Canal de Anúncios (Caçador-exclusivo) virou um
            CARD PRÓPRIO no fim da página, mesmo tratamento de
            moderacao.ejs (pedido do dono, ver doc-comment lá). Ainda o
            MESMO <form>/POST/botão Salvar — o <form> usa display:contents
            (classe "contents") pra não virar uma caixa própria no meio do
            layout, os dois <section> ficam como filhos diretos do
            gap-[30px] do <main>.
        %>
        <form action="/events/<%= guild.id %>/save" method="POST" class="contents">
            <section class="titan-card-premium flex-col gap-6">
                <h2 class="section-title text-lg"><%= guild.name %> | <span data-i18n-pt>Configurações</span><span data-i18n-en>Settings</span></h2>
                <div>
                    <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Cargos de Eventos</span><span data-i18n-en>Event Roles</span></h3>
                    <p class="text-xs opacity-50 mb-3"><span data-i18n-pt>Usados pelo comando /evento: quem pode criar eventos, e quem é avisado quando um novo evento é publicado.</span><span data-i18n-en>Used by the /evento command: who can create events, and who gets notified when a new event is published.</span></p>
                    <label class="text-xs opacity-60"><span data-i18n-pt>Equipe de Eventos</span><span data-i18n-en>Event Team</span></label>
                    <%- include('partials/role-picker', { id: 'event-role', name: 'event_role', roles, selectedIds: eventRoleIds, limit: eventRoleLimits.event, icon: 'shield' }) %>
                    <label class="text-xs opacity-60"><span data-i18n-pt>Notificação de Eventos</span><span data-i18n-en>Event Notification</span></label>
                    <%- include('partials/role-picker', { id: 'event-notify-role', name: 'event_notify_role', roles, selectedIds: eventNotifyRoleIds, limit: eventRoleLimits.eventNotify, icon: 'megaphone' }) %>
                </div>
            </section>

            <section class="titan-card-premium flex-col gap-6">
                <h2 class="section-title text-lg flex items-center gap-3 flex-wrap">
                    <span data-i18n-pt>Canal de Anúncios</span><span data-i18n-en>Announcement Channel</span>
                    <%- include('partials/tier-badge') %>
                </h2>
                <% if (!isCacador) { %>
                    <p class="text-xs opacity-50"><span data-i18n-pt>Exclusivo do plano Caçador — use</span><span data-i18n-en>Exclusive to the Caçador plan — use</span> <code>/premium</code> <span data-i18n-pt>pra saber mais.</span><span data-i18n-en>to learn more.</span></p>
                <% } else { %>
                    <p class="text-xs opacity-50 mb-3"><span data-i18n-pt>Canal onde o bot anuncia automaticamente a criação, o início e o encerramento de cada evento.</span><span data-i18n-en>Channel where the bot automatically announces each event's creation, start, and end.</span></p>
                    <div class="input-container-premium">
                        <div class="icon-box"><i data-lucide="megaphone"></i></div>
                        <select name="event_announce_channel" class="input-premium-field">
                            <option value="" data-i18n-opt-pt="— selecione um canal —" data-i18n-opt-en="— select a channel —">— selecione um canal —</option>
                            <% channels.forEach(c => { %>
                                <option value="<%= c.id %>" <%= settings.event_announce_channel === c.id ? 'selected' : '' %>>#<%= c.name %></option>
                            <% }); %>
                        </select>
                    </div>
                <% } %>

                <button type="submit" class="btn-salvar-final self-start mt-2"><span data-i18n-pt>Salvar Alterações</span><span data-i18n-en>Save Changes</span></button>
            </section>
        </form>

        <footer class="flex justify-end pb-2">
            <span class="bebas text-[12px] uppercase tracking-[6px] text-titan-cream opacity-10 hover:opacity-30 transition-opacity">
                BY: KNUST SEIER VI
            </span>
        </footer>
    </main>

    <script>if (window.lucide) window.lucide.createIcons();</script>
    <script src="/js/ingame-pulse-poll.js"></script>
    <script src="/js/role-picker.js"></script>
    <script src="/js/dashboard-view-only-lock.js"></script>
</body>
</html>
