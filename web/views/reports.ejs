<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reportes | <%= bot.user.username %></title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Tilt+Warp&family=Bebas+Neue&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'titan-bg': '#0D0D0D',
                        'titan-accent': '#803E30',
                        'titan-cream': '#F8DCC0',
                        'titan-gold': '#D9A362',
                    }
                }
            }
        }
    </script>
    <style>
        .report-card {
            display: flex;
            flex-direction: column;
            gap: 8px;
            background: var(--bg-card);
            border: 1px solid rgba(248, 220, 192, 0.08);
            border-radius: 14px;
            padding: 16px 20px;
        }
        .report-status {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            background: var(--surface);
            border-radius: 20px;
            padding: 3px 12px;
            opacity: 0.85;
        }
        .report-card-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            font-size: 0.75rem;
            opacity: 0.55;
        }
        .report-card-meta span { display: inline-flex; align-items: center; gap: 5px; }
    </style>
</head>
<body class="flex min-h-screen">

    <aside class="shrink-0 h-screen sticky top-0 py-[30px] pl-[30px] hidden lg:block">
        <%- include('partials/sidebar-v2', { active: 'denuncias', guild, nickname, role }) %>
    </aside>

    <main class="flex-1 w-full flex flex-col p-[30px] gap-[30px] overflow-y-auto">

        <%- include('partials/page-header', { guild, pageLabel: 'REPORTES', pageRoute, otherGuilds }) %>

        <%- include('partials/save-result-overlay', { saved }) %>

        <div id="ingamePulseRoot" data-guild-id="<%= guild.id %>" data-show-roster="false">
            <%- include('partials/ingame-pulse', { pulse, showRoster: false }) %>
        </div>

        <div id="reportsListRoot" data-poll-url="/fragments/reports-list/<%= guild.id %>">
            <%- include('partials/reports-list', { guild, openReports, closedReports }) %>
        </div>

        <%#
            Personalização do Report-Chat — bloco do /config personalizar do
            Discord (ver configSystem.js refreshPersonalizarPanel), movido
            pra cá (pedido do dono: personalização de report-chat pertence
            à aba de Denúncias, não à de Moderação). Mesmo padrão de card
            próprio + <form class="contents"> já usado em moderacao.ejs/
            events.ejs pro bloco Caçador-exclusivo no fim da página.
        %>
        <form action="/reports/<%= guild.id %>/save" method="POST" class="contents">
            <section class="titan-card-premium flex-col gap-6">
                <h2 class="section-title text-lg flex items-center gap-3 flex-wrap">
                    Personalização
                    <%- include('partials/tier-badge') %>
                </h2>
                <% if (!isCacador) { %>
                    <p class="text-xs opacity-50">Exclusivo do plano Caçador — use <code>/premium</code> pra saber mais.</p>
                <% } else { %>
                    <p class="text-xs opacity-50 -mt-3">Troque o banner, a mensagem de abertura do painel (o mesmo que /reportchat posta no canal) e a mensagem de boas-vindas da thread (a 1ª mensagem que a pessoa vê ao abrir um reporte ou revisão). O banner escolhido abaixo também aparece na thread.</p>

                    <label class="text-xs opacity-60">Banner do Report-Chat</label>
                    <div class="banner-picker">
                        <% reportChatBannerOptions.forEach(opt => { %>
                            <label class="banner-picker-option">
                                <input type="radio" name="report_chat_banner_key" value="<%= opt.value %>" <%= opt.value === reportChatBannerKey ? 'checked' : '' %>>
                                <span class="banner-picker-thumb" style="background-image:url('<%= opt.url %>')"></span>
                                <span class="banner-picker-label"><%= opt.label %></span>
                            </label>
                        <% }); %>
                    </div>

                    <label class="text-xs opacity-60 block mt-4">Mensagem do painel (vazio = padrão do bot)</label>
                    <div class="input-container-premium has-textarea">
                        <div class="icon-box"><i data-lucide="message-square"></i></div>
                        <textarea class="input-premium-field" name="report_chat_message" maxlength="1000" rows="3" placeholder="Explique como abrir um reporte ou revisar uma punição neste servidor..."><%= settings.report_chat_message || '' %></textarea>
                    </div>

                    <label class="text-xs opacity-60">Boas-vindas na thread (vazio = padrão do bot)</label>
                    <div class="input-container-premium has-textarea">
                        <div class="icon-box"><i data-lucide="message-square"></i></div>
                        <textarea class="input-premium-field" name="report_chat_welcome_message" maxlength="1000" rows="3" placeholder="Mensagem mostrada assim que a thread é aberta — vale pra reporte e pra revisão de punição..."><%= settings.report_chat_welcome_message || '' %></textarea>
                    </div>

                    <button type="submit" class="btn-salvar-final self-start mt-2">Salvar Alterações</button>
                <% } %>
            </section>
        </form>

        <footer class="flex justify-end pb-2">
            <span class="bebas text-[12px] uppercase tracking-[6px] text-titan-cream opacity-10 hover:opacity-30 transition-opacity">
                BY: KNUST SEIER VI
            </span>
        </footer>
    </main>

    <script>if (window.lucide) window.lucide.createIcons();</script>
    <script src="/js/ingame-pulse-poll.js"></script>
    <script src="/js/poll-fragment.js"></script>
</body>
</html>
