<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reportes | <%= bot.user.username %></title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Tilt+Warp&family=Bebas+Neue&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'titan-bg': '#0D0D0D',
                        'titan-accent': '#803E30',
                        'titan-cream': '#F8DCC0',
                        'titan-gold': '#D9A362',
                    }
                }
            }
        }
    </script>
    <style>
        .report-card {
            display: flex;
            flex-direction: column;
            gap: 8px;
            background: var(--bg-card);
            border: 1px solid rgba(248, 220, 192, 0.08);
            border-radius: 14px;
            padding: 16px 20px;
        }
        .report-status {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            background: var(--surface);
            border-radius: 20px;
            padding: 3px 12px;
            opacity: 0.85;
        }
        .report-card-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            font-size: 0.75rem;
            opacity: 0.55;
        }
        .report-card-meta span { display: inline-flex; align-items: center; gap: 5px; }

        /* Barra de busca (por ID de report ou usuário que abriu) + paginação
           das seções Abertos/Fechados (pedido do dono: "reports pode virar
           uma lista enorme no futuro") — estilo próprio, compacto, em vez de
           reaproveitar .input-container-premium/.icon-box (feito pra campos
           grandes de formulário, pesado demais ao lado de um título de
           seção). Ver web/views/partials/reports-list.ejs. */
        .report-search-form { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        .report-search-input {
            background: #131314;
            border: 1px solid rgba(217, 163, 98, 0.4);
            border-radius: 8px;
            padding: 6px 12px;
            color: #F8DCC0;
            font-family: 'Poppins', sans-serif;
            font-size: 0.8rem;
            width: 220px;
            outline: none;
        }
        .report-search-input:focus { border-color: #D9A362; }
        .report-search-btn {
            background: #D9A362;
            border: none;
            border-radius: 8px;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #131314;
            cursor: pointer;
            transition: background 0.15s ease;
        }
        .report-search-btn:hover { background: #F8DCC0; }
        .report-search-clear { font-size: 0.75rem; opacity: 0.6; text-decoration: underline; white-space: nowrap; }
        .report-search-clear:hover { opacity: 1; }
        .report-pagination { display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 4px; }
        .report-page-btn {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 0.75rem;
            color: #F8DCC0;
            opacity: 0.85;
            padding: 6px 12px;
            border-radius: 8px;
            border: 1px solid rgba(217, 163, 98, 0.3);
            transition: opacity 0.15s ease, background 0.15s ease;
        }
        .report-page-btn:hover { background: rgba(217, 163, 98, 0.12); opacity: 1; }
        .report-page-btn.disabled { opacity: 0.3; pointer-events: none; }
        .report-page-info { font-size: 0.7rem; opacity: 0.5; }
    </style>
</head>
<body class="flex min-h-screen">

    <aside class="shrink-0 h-screen sticky top-0 py-[30px] pl-[30px] hidden lg:block">
        <%- include('partials/sidebar-v2', { active: 'denuncias', guild, nickname, role, isOwner: typeof isOwner !== 'undefined' ? isOwner : false }) %>
    </aside>

    <main class="flex-1 w-full flex flex-col p-[30px] gap-[30px] overflow-y-auto">

        <%- include('partials/page-header', { guild, pageLabel: 'REPORTES', pageRoute, otherGuilds }) %>

        <%- include('partials/save-result-overlay', { saved }) %>

        <div id="ingamePulseRoot" data-guild-id="<%= guild.id %>" data-show-roster="false">
            <%- include('partials/ingame-pulse', { pulse, showRoster: false }) %>
        </div>

        <%#
            class="contents" (pedido do dono: mesma distribuição de espaço
            da página de Moderação) — sem isso, este <div> vira uma caixa
            própria no meio do layout e quebra a cadeia de gap-[30px] do
            <main>: "Reportes Abertos" e "Reportes Fechados" (os 2
            <section> de dentro de partials/reports-list.ejs) ficavam
            colados um no outro, sem nenhum respiro entre eles. Com
            display:contents o <div> some da árvore de layout e os 2
            <section> passam a ser filhos diretos do <main>, herdando o
            mesmo gap — igual o <form class="contents"> já faz com
            Configurações/Personalização em moderacao.ejs. Não afeta o
            poll-fragment.js: ele só faz root.innerHTML/dataset, nada
            depende do <div> ter caixa própria.
        %>
        <div id="reportsListRoot" data-poll-url="<%= reportsFragmentUrl %>" class="contents">
            <%- include('partials/reports-list', { guild, openReports, openPagination, closedReports, closedPagination }) %>
        </div>

        <%#
            Personalização do Report-Chat — bloco do /config personalizar do
            Discord (ver configSystem.js refreshPersonalizarPanel), movido
            pra cá (pedido do dono: personalização de report-chat pertence
            à aba de Denúncias, não à de Moderação). Mesmo padrão de card
            próprio + <form class="contents"> já usado em moderacao.ejs/
            events.ejs pro bloco Caçador-exclusivo no fim da página.
        %>
        <form action="/reports/<%= guild.id %>/save" method="POST" enctype="multipart/form-data" class="contents">
            <section class="titan-card-premium flex-col gap-6">
                <h2 class="section-title text-lg flex items-center gap-3 flex-wrap">
                    Personalização
                    <%- include('partials/tier-badge') %>
                </h2>
                <% if (!isCacador) { %>
                    <p class="text-xs opacity-50">Exclusivo do plano Caçador — use <code>/premium</code> pra saber mais.</p>
                <% } else { %>
                    <%#
                        Tudo dentro de UM <div> só (pedido do dono: mesma
                        distribuição de espaço de moderacao.ejs) — sem essa
                        embalagem, cada label/parágrafo/caixa vira filho
                        DIRETO do <section class="gap-6">, e o gap de 24px
                        do flex passa a valer entre TODA linha (label→caixa,
                        caixa→label seguinte...), em cima das margens finas
                        que cada um já tem (2-8px) — resultado: espaçamento
                        gigante e diferente do padrão de moderacao.ejs, onde
                        cada bloco (h3+campos) fica dentro do próprio <div>
                        e só a TRANSIÇÃO entre blocos pega o gap-6; dentro
                        de um bloco, o fluxo normal + as margens finas
                        mandam. Um <div> só (não vários) porque aqui só tem
                        um assunto (Report-Chat), diferente de moderacao.ejs
                        que tem 2 blocos com h3 próprio cada.
                    %>
                    <div>
                        <p class="text-xs opacity-50 mb-3">Troque o banner, a mensagem de abertura do painel (o mesmo que /reportchat posta no canal) e a mensagem de boas-vindas da thread (a 1ª mensagem que a pessoa vê ao abrir um reporte ou revisão). O banner escolhido abaixo também aparece na thread.</p>

                        <label class="text-xs opacity-60">Banner do Report-Chat</label>
                        <div class="banner-picker">
                            <% reportChatBannerOptions.forEach(opt => { %>
                                <label class="banner-picker-option">
                                    <input type="radio" name="report_chat_banner_key" value="<%= opt.value %>" <%= opt.value === reportChatBannerKey ? 'checked' : '' %>>
                                    <span class="banner-picker-thumb" style="background-image:url('<%= opt.url %>')"></span>
                                    <span class="banner-picker-label"><%= opt.label %></span>
                                </label>
                            <% }); %>
                        </div>
                        <label class="text-xs opacity-60 block mt-4">Ou envie sua própria imagem</label>
                        <% if (reportChatCustomBannerUrl) { %>
                            <div class="rounded-lg mb-2" style="aspect-ratio: 600/138; max-width:300px; background-image:url('<%= reportChatCustomBannerUrl %>'); background-size:cover; background-position:center;"></div>
                        <% } %>
                        <div class="input-container-premium">
                            <div class="icon-box"><i data-lucide="upload"></i></div>
                            <input type="file" name="report_chat_banner_file" accept="image/png,image/jpeg,image/webp" class="input-premium-field">
                        </div>
                        <p class="text-xs opacity-40">Enviar um arquivo aqui substitui a opção escolhida na galeria acima.<% if (reportChatCustomBannerUrl) { %> Imagem própria configurada atualmente (prévia acima).<% } %></p>

                        <label class="text-xs opacity-60 block mt-4">Mensagem do painel (vazio = padrão do bot)</label>
                        <div class="input-container-premium has-textarea">
                            <div class="icon-box"><i data-lucide="message-square"></i></div>
                            <textarea class="input-premium-field" name="report_chat_message" maxlength="1000" rows="4" placeholder="Explique como abrir um reporte ou revisar uma punição neste servidor..."><%= settings.report_chat_message || '' %></textarea>
                        </div>

                        <label class="text-xs opacity-60 block mt-4">Boas-vindas na thread (vazio = padrão do bot)</label>
                        <div class="input-container-premium has-textarea">
                            <div class="icon-box"><i data-lucide="message-square"></i></div>
                            <textarea class="input-premium-field" name="report_chat_welcome_message" maxlength="1000" rows="4" placeholder="Mensagem mostrada assim que a thread é aberta — vale pra reporte e pra revisão de punição..."><%= settings.report_chat_welcome_message || '' %></textarea>
                        </div>
                    </div>

                    <button type="submit" class="btn-salvar-final self-start mt-2">Salvar Alterações</button>
                <% } %>
            </section>
        </form>

        <footer class="flex justify-end pb-2">
            <span class="bebas text-[12px] uppercase tracking-[6px] text-titan-cream opacity-10 hover:opacity-30 transition-opacity">
                BY: KNUST SEIER VI
            </span>
        </footer>
    </main>

    <script>if (window.lucide) window.lucide.createIcons();</script>
    <script src="/js/ingame-pulse-poll.js"></script>
    <script src="/js/poll-fragment.js"></script>
</body>
</html>
