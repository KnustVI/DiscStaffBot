<%#
  web/views/documentacao.ejs
  ============================================================================
  Página pública de documentação (pedido do dono: "criar nossa página de
  documentação com toda a informação possível e a melhor organização
  possível mostrando a melhor forma de usar o bot atualmente") — catálogo
  completo dos ~25 comandos de barra que o bot principal registra
  (src/commands/*, exceto developer/, que é o bot privado separado).

  Sem login (mesmo padrão de hero.ejs/termos.ejs) — qualquer visitante
  pode consultar, é justamente o que convence um dono de servidor a
  convidar o bot.

  BILÍNGUE (pedido do dono, 2026-08-04) — mesmo padrão data-i18n-pt/en +
  toggle de hero.ejs/termos.ejs, reaproveitando a MESMA chave de
  localStorage ("titanspass_lang"): quem trocou pra EN na Hero já abre
  esta página em EN também. Os NOMES/OPÇÕES literais de comando (ex:
  "usuario", "motivo", "cargo") NÃO são traduzidos — são os parâmetros
  reais que aparecem no Discord, que só existe em português; traduzir
  esses criaria uma referência que não bate com o produto de verdade.
  Só a prosa explicativa (descrições, notas, rótulos de tipo) é bilíngue.

  Os 7 comandos /ingame-* (RCON) têm ~57 subcomandos somados — em vez de
  um cmd-card expandido por subcomando (viraria uma página absurda),
  cada um vira UMA tabela compacta (rconCmdCard). Os demais ~18 comandos
  "normais" usam cmd-card (nome + badges + descrição + tabela de opções +
  subcomandos, se houver).

  Fonte de verdade do conteúdo: catálogo extraído direto do código
  (src/commands/**, src/systems/pot/rconCommandCatalog.js,
  premiumSystem.js, configSystem.js) — não é aproximação, foi conferido
  arquivo por arquivo. Se um comando mudar de comportamento/opções depois
  desta página existir, ela PODE ficar desatualizada (nada aqui é gerado
  dinamicamente a partir do código real) — precisa editar manualmente.
%>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Documentação | <%= bot.user.username %></title>
    <meta name="description" content="Guia completo de todos os comandos do Titan's Pass: moderação, denúncias, eventos, integração com Path of Titans (RCON) e configuração do servidor.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&family=Tilt+Warp&family=Bebas+Neue&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'titan-dark': '#1F1D20',
                        'titan-cream': '#F8DCC0',
                        'titan-accent': '#803E30',
                    }
                }
            }
        }
    </script>

    <style>
        html, body { margin: 0; padding: 0; overflow-x: hidden; max-width: 100%; background: #111111; }
        html { scroll-behavior: smooth; }
        body { color: #F8DCC0; }
        [data-i18n-en] { display: none; }
        html[data-lang="en"] [data-i18n-pt] { display: none; }
        html[data-lang="en"] [data-i18n-en] { display: initial; }

        <%# .nav-btn/.lang-toggle etc. REMOVIDOS daqui (pedido do dono,
            2026-08-13) — vivem só em partials/top-nav.ejs agora. Notar
            que a versão desta página tinha uma deriva não-intencional
            (.nav-btn a 16px, as outras 3 páginas a 14px) — a partial
            consolidada padronizou pra 14px. %>

        .docs-header-padding { margin-top: calc(var(--nav-height, 60px) + 32px); padding: 0 16px; }

        .section-title {
            font-family: 'Tilt Warp', sans-serif;
            text-transform: uppercase;
            color: #F8DCC0;
        }

        .docs-shell { display: flex; align-items: flex-start; gap: 36px; max-width: 1280px; margin: 40px auto 0; padding: 0 16px 100px; }
        /* top/max-height contam com --nav-height (a nav é fixed, ~60-90px
           dependendo de quantas linhas ela quebra) — sem isso, o sticky
           gruda a régua embaixo da nav fixa e fica parcialmente escondido
           atrás dela ao rolar (pedido do dono: "deixe essa barra fixa pra
           descer junto com a tela"). overflow-y:auto só mostra barra de
           rolagem se o conteúdo realmente não couber (comportamento padrão
           do navegador) — não força uma quando cabe na tela. */
        .docs-toc {
            position: sticky;
            top: calc(var(--nav-height, 60px) + 16px);
            flex: none; width: 230px;
            display: flex; flex-direction: column; gap: 4px;
            max-height: calc(100vh - var(--nav-height, 60px) - 32px);
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: #803E30 transparent;
        }
        /* Pedido do dono, 2026-08-04: "barra de navegação da documentação
           sofre do mesmo problema" (a sidebar do dashboard também sumia
           em telas pequenas, ver sidebar-v2.ejs) — a causa aqui era
           parecida: .docs-toc vinha com "hidden lg:flex" e existia um
           SEGUNDO componente paralelo só pra mobile (.docs-mobile-toc,
           removido), com menos recursos (sem colapso por categoria,
           fonte menor) — duas implementações que já tinham começado a
           divergir uma da outra. Agora é UMA SÓ: abaixo de 1024px ela
           sai da coluna lateral (sticky não faz sentido em largura
           total) e vira um bloco normal, sempre visível, no topo do
           conteúdo — mesmo <details> por categoria de sempre, só que
           num cartão full-width em vez de coluna fixa de 230px. */
        @media (max-width: 1023px) {
            .docs-shell { flex-direction: column; gap: 20px; }
            .docs-toc {
                position: static; width: 100%; max-height: none; overflow: visible;
                background: #1A1A1A; border: 1px solid #3E3D38; border-radius: 14px; padding: 4px 14px;
            }
        }
        .docs-toc::-webkit-scrollbar { width: 6px; }
        .docs-toc::-webkit-scrollbar-track { background: transparent; }
        .docs-toc::-webkit-scrollbar-thumb { background: #803E30; border-radius: 10px; }
        .docs-toc::-webkit-scrollbar-thumb:hover { background: #DCA15E; }
        .docs-toc a {
            font-family: 'Poppins', sans-serif; font-size: 14px; color: #F8DCC0; opacity: 0.6;
            text-decoration: none; padding: 6px 10px; border-radius: 8px;
            transition: opacity 0.15s ease, background 0.15s ease;
        }
        .docs-toc a:hover { opacity: 1; background: rgba(255,255,255,0.04); }
        <%# Cada categoria da sidebar vira um <details> nativo, SEM "open"
            (pedido do dono: "deixe as abas sempre fechadas ao carregar a
            página") — sem JS, <details>/<summary> já dão o toggle
            sozinhos. %>
        .toc-group { border-bottom: 1px solid rgba(62,61,56,0.5); }
        .toc-group:last-child { border-bottom: none; }
        .toc-group summary {
            cursor: pointer; list-style: none;
            display: flex; align-items: center; justify-content: space-between; gap: 6px;
            font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 11.5px;
            text-transform: uppercase; letter-spacing: 0.6px; color: #F8DCC0; opacity: 0.55;
            padding: 10px 10px;
            transition: opacity 0.15s ease;
        }
        .toc-group summary:hover { opacity: 0.9; }
        .toc-group summary::-webkit-details-marker { display: none; }
        .toc-group summary::after {
            content: '▸'; font-size: 9px; opacity: 0.6; flex: none;
            transition: transform 0.15s ease;
        }
        .toc-group[open] > summary::after { transform: rotate(90deg); }
        .toc-group[open] > summary { opacity: 0.9; }
        .toc-links { display: flex; flex-direction: column; padding-bottom: 6px; }

        .docs-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 60px; }
        section[id] { scroll-margin-top: 24px; }

        .docs-cat-header { display: flex; flex-direction: column; gap: 8px; margin-bottom: 22px; }
        .docs-cat-title { font-size: clamp(22px, 3vw, 30px); }
        .docs-cat-desc { font-family: 'Poppins', sans-serif; font-size: 14.5px; opacity: 0.7; max-width: 720px; line-height: 1.55; }
        .docs-cat-body { display: flex; flex-direction: column; gap: 18px; }

        .docs-callout {
            background: linear-gradient(135deg, rgba(220,161,94,0.12), rgba(128,62,48,0.14));
            border: 1px solid rgba(220,161,94,0.35);
            border-radius: 14px; padding: 22px 24px; display: flex; flex-direction: column; gap: 12px;
        }
        .docs-callout ol, .docs-callout ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; font-family: 'Poppins', sans-serif; font-size: 14px; opacity: 0.92; line-height: 1.5; }
        .docs-callout code { background: rgba(255,255,255,0.08); padding: 1px 7px; border-radius: 5px; font-family: monospace; font-size: 0.92em; color: #DCA15E; }

        .legend { display: flex; flex-wrap: wrap; gap: 10px 20px; align-items: center; font-family: 'Poppins', sans-serif; font-size: 12.5px; opacity: 0.8; }
        .legend-item { display: flex; align-items: center; gap: 7px; }

        .cmd-card { background: #1A1A1A; border: 1px solid #3E3D38; border-radius: 14px; padding: 20px 22px; display: flex; flex-direction: column; gap: 10px; }
        .cmd-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        .cmd-name { font-family: 'Tilt Warp', sans-serif; font-size: 19px; color: #DCA15E; }
        .badge {
            font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 10px;
            text-transform: uppercase; letter-spacing: 0.4px;
            padding: 3px 10px; border-radius: 20px; white-space: nowrap;
        }
        .badge.tier-free { color: #F8DCC0; background: rgba(248,220,192,0.08); border: 1px solid rgba(248,220,192,0.3); }
        .badge.tier-rastreador { color: #DCA15E; background: rgba(220,161,94,0.12); border: 1px solid rgba(220,161,94,0.4); }
        .badge.tier-cacador { color: #FF4E3B; background: rgba(255,78,59,0.12); border: 1px solid rgba(255,78,59,0.4); }
        .badge.perm { color: #F8DCC0; background: rgba(255,255,255,0.05); border: 1px solid #3E3D38; }
        .badge.status-essential { color: #FF4E3B; background: rgba(255,78,59,0.12); border: 1px solid rgba(255,78,59,0.4); }
        .badge.status-optional { color: #F8DCC0; background: rgba(255,255,255,0.04); border: 1px solid #3E3D38; opacity: 0.75; }
        .cmd-desc { font-family: 'Poppins', sans-serif; font-size: 14px; opacity: 0.85; line-height: 1.55; }
        .cmd-desc code, .cmd-table code { background: rgba(255,255,255,0.07); padding: 1px 6px; border-radius: 5px; font-family: monospace; font-size: 0.9em; color: #DCA15E; }
        .cmd-note { font-family: 'Poppins', sans-serif; font-size: 12.5px; opacity: 0.6; font-style: italic; }
        .cmd-table-wrap { overflow-x: auto; }
        .cmd-table { width: 100%; border-collapse: collapse; font-family: 'Poppins', sans-serif; font-size: 12.5px; }
        .cmd-table th { text-align: left; opacity: 0.5; text-transform: uppercase; font-size: 10px; letter-spacing: 0.4px; padding: 6px 10px; border-bottom: 1px solid #3E3D38; white-space: nowrap; }
        .cmd-table td { padding: 8px 10px; border-bottom: 1px solid rgba(62,61,56,0.5); vertical-align: top; opacity: 0.9; }
        .cmd-table tr:last-child td { border-bottom: none; }
        .cmd-sub { border-top: 1px solid #3E3D38; padding-top: 12px; margin-top: 2px; display: flex; flex-direction: column; gap: 6px; }
        .cmd-sub-name { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 13px; color: #F8DCC0; }

        .docs-footer-links { display: flex; flex-wrap: wrap; gap: 12px; }
    </style>
</head>
<body class="text-titan-cream">

<%# Barra de navegação de topo — consolidada em partials/top-nav.ejs
    (pedido do dono, 2026-08-13, ver comentário completo em hero.ejs). %>
<%- include('partials/top-nav', { active: 'documentacao' }) %>

<%
// ===================== HELPERS DE RENDER =====================
// t(pt, en) monta o par de <span data-i18n-*> usado em TODO texto bilíngue
// da página — ver docblock no topo do arquivo. cmdCard cobre os ~18
// comandos "normais"; rconCmdCard cobre os 7 grupos de RCON (subcomandos
// demais pra virar um cmd-card expandido cada).
function t(pt, en) { return `<span data-i18n-pt>${pt}</span><span data-i18n-en>${en ?? pt}</span>`; }

// Vocabulário fixo de "Tipo" das tabelas de opção — em vez de pedir
// typePt/typeEn em CADA option (dezenas delas), só a chave PT precisa
// ser informada; a tradução vem deste dicionário. Cai pro próprio texto
// PT se não encontrar (nunca quebra, só fica sem traduzir esse caso raro).
const TYPE_EN = {
    'Usuário': 'User', 'Texto': 'Text', 'Texto (autocomplete)': 'Text (autocomplete)',
    'Número': 'Number', 'Número (0-100)': 'Number (0-100)',
    'Anexo': 'Attachment', 'Anexo (PNG/JPEG)': 'Attachment (PNG/JPEG)',
    'Escolha': 'Choice', 'Canal (fórum)': 'Channel (forum)', 'Canal (voz/palco)': 'Channel (voice/stage)',
    'Texto (máx. 100)': 'Text (max. 100)', 'Texto (máx. 1000)': 'Text (max. 1000)',
};
function typeLabel(pt) { return t(pt, TYPE_EN[pt] || pt); }

function permBadge(pt, en) { return `<span class="badge perm">${t(pt, en)}</span>`; }
function tierBadge(tier) {
    // Nomes traduzidos pro inglês (Rastreador -> Tracker, Caçador -> Hunter),
    // mesmo padrão já usado em hero.ejs — ver PREMIUM.txt seção 102: "Aplica
    // em QUALQUER lugar que renderiza o nome do tier em inglês". Esta página
    // (documentacao.ejs) tinha ficado de fora até agora (pedido do dono,
    // 2026-08-07: "tags de rastreador e caçador não são traduzidas... e
    // devem ser").
    const map = {
        free: ['FREE', 'FREE', 'tier-free'],
        rastreador: ['RASTREADOR+', 'TRACKER+', 'tier-rastreador'],
        cacador: ['CAÇADOR', 'HUNTER', 'tier-cacador'],
    };
    const [pt, en, cls] = map[tier] || map.free;
    return `<span class="badge ${cls}">${t(pt, en)}</span>`;
}
function optTable(opts) {
    if (!opts || !opts.length) return '';
    const rows = opts.map(o => `<tr><td><code>${o.name}</code></td><td>${typeLabel(o.type)}</td><td>${o.req ? t('Sim', 'Yes') : t('Não', 'No')}</td><td>${t(o.descPt, o.descEn)}</td></tr>`).join('');
    return `<div class="cmd-table-wrap"><table class="cmd-table"><thead><tr><th>${t('Opção', 'Option')}</th><th>${t('Tipo', 'Type')}</th><th>${t('Obrigatório', 'Required')}</th><th>${t('Descrição', 'Description')}</th></tr></thead><tbody>${rows}</tbody></table></div>`;
}
function cmdCard(cmd) {
    const badges = [permBadge(cmd.permPt, cmd.permEn)];
    if (cmd.tier) badges.push(tierBadge(cmd.tier));
    const subsHtml = (cmd.subs || []).map(s => `
        <div class="cmd-sub">
            <p class="cmd-sub-name">/${cmd.name} ${s.name}</p>
            <p class="cmd-desc">${t(s.descPt, s.descEn)}</p>
            ${s.tier ? `<div>${tierBadge(s.tier)}</div>` : ''}
            ${optTable(s.opts)}
        </div>
    `).join('');
    return `<div class="cmd-card" id="cmd-${cmd.id}">
        <div class="cmd-head"><span class="cmd-name">/${cmd.name}</span>${badges.join('')}</div>
        <p class="cmd-desc">${t(cmd.descPt, cmd.descEn)}</p>
        ${cmd.notePt ? `<p class="cmd-note">${t(cmd.notePt, cmd.noteEn)}</p>` : ''}
        ${optTable(cmd.opts)}
        ${subsHtml}
    </div>`;
}
function rconCmdCard(cmd) {
    const rows = cmd.subs.map(s => `<tr><td><code>${s.name}</code>${s.locked ? ' 🔒' : ''}</td><td>${t(s.descPt, s.descEn)}</td><td>${s.opts ? (s.optsIsProse ? t(s.opts, s.optsEn) : s.opts) : '—'}</td></tr>`).join('');
    return `<div class="cmd-card" id="cmd-${cmd.id}">
        <div class="cmd-head">
            <span class="cmd-name">/${cmd.name}</span>
            ${cmd.openToAll ? permBadge('Todos (só listplayers)', 'Everyone (listplayers only)') : permBadge('Staff', 'Staff')}
            ${tierBadge('cacador')}
        </div>
        <p class="cmd-desc">${t(cmd.descPt, cmd.descEn)}</p>
        <div class="cmd-table-wrap"><table class="cmd-table"><thead><tr><th>${t('Subcomando', 'Subcommand')}</th><th>${t('O que faz', 'What it does')}</th><th>${t('Opções', 'Options')}</th></tr></thead><tbody>${rows}</tbody></table></div>
    </div>`;
}

// Card de PÁGINA do dashboard web (não é um comando de barra — sem "/nome",
// sem tabela de opções). Reaproveita a mesma moldura .cmd-card pra ficar
// visualmente igual ao resto da página; a badge é sempre "Administrador"
// porque toda página do dashboard exige essa permissão no servidor.
function pageCard({ id, titlePt, titleEn, descPt, descEn, notePt, noteEn, bulletsPt, bulletsEn }) {
    const bulletsHtml = bulletsPt ? `<ul style="margin:0; padding-left:20px; display:flex; flex-direction:column; gap:4px; font-family:'Poppins',sans-serif; font-size:14px; opacity:0.85; line-height:1.5;">${bulletsPt.map((b, i) => `<li>${t(b, bulletsEn[i])}</li>`).join('')}</ul>` : '';
    return `<div class="cmd-card" id="${id}">
        <div class="cmd-head"><span class="cmd-name">${t(titlePt, titleEn)}</span>${permBadge('Administrador', 'Administrator')}</div>
        <p class="cmd-desc">${t(descPt, descEn)}</p>
        ${bulletsHtml}
        ${notePt ? `<p class="cmd-note">${t(notePt, noteEn)}</p>` : ''}
    </div>`;
}

// ===================== ÍNDICE (TOC) =====================
// labelPt/labelEn = rótulo descritivo (traduzido); label sozinho = nome
// literal de comando (ex: "/strike") — nunca traduzido, é o nome real
// digitado no Discord.
const toc = [
    { catPt: 'Comece Aqui', catEn: 'Get Started', items: [
        { id: 'comece-aqui', labelPt: 'Primeiros Passos', labelEn: 'Getting Started' },
        { id: 'legenda', labelPt: 'Como ler esta página', labelEn: 'How to read this page' },
    ] },
    { catPt: 'Dashboard Web', catEn: 'Web Dashboard', items: [
        { id: 'dash-intro', labelPt: 'Como acessar', labelEn: 'How to access' },
        { id: 'dash-navegacao', labelPt: 'Navegação do site', labelEn: 'Site navigation' },
        { id: 'dash-moderacao', labelPt: 'Página de Moderação', labelEn: 'Moderation page' },
        { id: 'dash-denuncias', labelPt: 'Página de Denúncias', labelEn: 'Reports page' },
        { id: 'dash-eventos', labelPt: 'Página de Eventos', labelEn: 'Events page' },
        { id: 'dash-gameserver', labelPt: 'Página de Game Server', labelEn: 'Game Server page' },
    ] },
    { catPt: 'Perfil & Premium', catEn: 'Profile & Premium', items: [
        { id: 'cmd-registrar', label: '/registrar' }, { id: 'cmd-perfil', label: '/perfil' },
        { id: 'cmd-perfil-edit', label: '/perfil-edit' }, { id: 'cmd-premium', label: '/premium' },
    ] },
    { catPt: 'Moderação', catEn: 'Moderation', items: [
        { id: 'cmd-strike', label: '/strike' }, { id: 'cmd-unstrike', label: '/unstrike' },
        { id: 'cmd-repset', label: '/repset' }, { id: 'cmd-historico', label: '/historico' },
        { id: 'cmd-staffonline', label: '/staffonline' },
    ] },
    { catPt: 'Denúncias & Eventos', catEn: 'Reports & Events', items: [
        { id: 'cmd-reportchat', label: '/reportchat' }, { id: 'cmd-evento', label: '/evento' }, { id: 'cmd-eventos-agendados', label: '/eventos-agendados' },
    ] },
    { catPt: 'Configuração (Admin)', catEn: 'Configuration (Admin)', items: [
        { id: 'cmd-config', label: '/config' }, { id: 'cmd-potserver', label: '/potserver' }, { id: 'cmd-ping', label: '/ping' },
    ] },
    { catPt: 'Integração PoT / RCON', catEn: 'PoT Integration / RCON', items: [
        { id: 'cmd-ingame-comandos', label: '/ingame-comandos' }, { id: 'cmd-ingame-admin', label: '/ingame-admin' },
        { id: 'cmd-ingame-buff', label: '/ingame-buff' }, { id: 'cmd-ingame-event', label: '/ingame-event' },
        { id: 'cmd-ingame-list', label: '/ingame-list' }, { id: 'cmd-ingame-map', label: '/ingame-map' },
        { id: 'cmd-ingame-marks', label: '/ingame-marks' }, { id: 'cmd-ingame-message', label: '/ingame-message' },
        { id: 'cmd-ingame-stats', label: '/ingame-stats' },
    ] },
    { catPt: 'Ajuda & Suporte', catEn: 'Help & Support', items: [
        { id: 'cmd-ajuda', label: '/ajuda' }, { id: 'cmd-botstatus', label: '/botstatus' }, { id: 'cmd-feedback', label: '/feedback' },
    ] },
];
%>

