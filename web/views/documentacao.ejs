<%#
  web/views/documentacao.ejs
  ============================================================================
  Página pública de documentação (pedido do dono: "criar nossa página de
  documentação com toda a informação possível e a melhor organização
  possível mostrando a melhor forma de usar o bot atualmente") — catálogo
  completo dos ~25 comandos de barra que o bot principal registra
  (src/commands/*, exceto developer/, que é o bot privado separado).

  Sem login (mesmo padrão de hero.ejs/termos.ejs) — qualquer visitante
  pode consultar, é justamente o que convence um dono de servidor a
  convidar o bot. Conteúdo só em português: os próprios comandos/
  descrições do bot no Discord já são só em português (o toggle EN/PT da
  Hero é só pro texto de marketing, não muda a língua real do bot), então
  documentar em inglês aqui criaria uma referência que não bate com o
  produto de verdade.

  Os 7 comandos /ingame-* (RCON) têm ~57 subcomandos somados — em vez de
  um cmd-card expandido por subcomando (viraria uma página absurda),
  cada um vira UMA tabela compacta (rconCmdCard). Os demais ~18 comandos
  "normais" usam cmd-card (nome + badges + descrição + tabela de opções +
  subcomandos, se houver).

  Fonte de verdade do conteúdo: catálogo extraído direto do código nesta
  sessão (src/commands/**, src/systems/pot/rconCommandCatalog.js,
  premiumSystem.js, configSystem.js) — não é aproximação, foi conferido
  arquivo por arquivo. Se um comando mudar de comportamento/opções depois
  desta página existir, ela PODE ficar desatualizada (nada aqui é gerado
  dinamicamente a partir do código real) — precisa editar manualmente.
%>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Documentação | <%= bot.user.username %></title>
    <meta name="description" content="Guia completo de todos os comandos do Titan's Pass: moderação, denúncias, eventos, integração com Path of Titans (RCON) e configuração do servidor.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&family=Tilt+Warp&family=Bebas+Neue&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'titan-dark': '#1F1D20',
                        'titan-cream': '#F8DCC0',
                        'titan-accent': '#803E30',
                    }
                }
            }
        }
    </script>

    <style>
        html, body { margin: 0; padding: 0; overflow-x: hidden; max-width: 100%; background: #111111; }
        html { scroll-behavior: smooth; }
        body { color: #F8DCC0; }

        .nav-btn {
            box-sizing: border-box;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 5px 20px;
            gap: 10px;
            height: 30px;
            background: #2A2A2A;
            border: 1px solid #803E30;
            border-radius: 15px;
            box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5), -5px -5px 10px rgba(0, 0, 0, 0.7);
            font-family: 'Poppins', sans-serif;
            font-weight: 300;
            font-size: 14px;
            color: #F8DCC0;
            text-decoration: none;
            white-space: nowrap;
            transition: background 0.15s ease, border-color 0.15s ease;
        }
        .nav-btn:hover { background: #803E30; border-color: #F8DCC0; }
        .nav-btn.is-active { background: #4B2427; border-color: #DCA15E; }
        @media (max-width: 640px) {
            .nav-btn { padding: 4px 12px; height: 26px; font-size: 12px; }
        }

        .docs-header-padding { margin-top: calc(var(--nav-height, 60px) + 32px); padding: 0 16px; }

        .section-title {
            font-family: 'Tilt Warp', sans-serif;
            text-transform: uppercase;
            color: #F8DCC0;
        }

        .docs-shell { display: flex; align-items: flex-start; gap: 36px; max-width: 1280px; margin: 40px auto 0; padding: 0 16px 100px; }
        /* top/max-height contam com --nav-height (a nav é fixed, ~60-90px
           dependendo de quantas linhas ela quebra) — sem isso, o sticky
           gruda a régua embaixo da nav fixa e fica parcialmente escondido
           atrás dela ao rolar (pedido do dono: "deixe essa barra fixa pra
           descer junto com a tela"). overflow-y:auto só mostra barra de
           rolagem se o conteúdo realmente não couber (comportamento padrão
           do navegador) — não força uma quando cabe na tela. */
        .docs-toc {
            position: sticky;
            top: calc(var(--nav-height, 60px) + 16px);
            flex: none; width: 230px;
            display: flex; flex-direction: column; gap: 4px;
            max-height: calc(100vh - var(--nav-height, 60px) - 32px);
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: #803E30 transparent;
        }
        .docs-toc::-webkit-scrollbar { width: 6px; }
        .docs-toc::-webkit-scrollbar-track { background: transparent; }
        .docs-toc::-webkit-scrollbar-thumb { background: #803E30; border-radius: 10px; }
        .docs-toc::-webkit-scrollbar-thumb:hover { background: #DCA15E; }
        .docs-toc a {
            font-family: 'Poppins', sans-serif; font-size: 13px; color: #F8DCC0; opacity: 0.6;
            text-decoration: none; padding: 6px 10px; border-radius: 8px;
            transition: opacity 0.15s ease, background 0.15s ease;
        }
        .docs-toc a:hover { opacity: 1; background: rgba(255,255,255,0.04); }
        <%# Cada categoria da sidebar vira um <details> nativo — pedido do
            dono: "cada categoria pode ser aberta mostrando a lista de
            comandos". Sem JS: <details>/<summary> já dão o toggle sozinhos. %>
        .toc-group { border-bottom: 1px solid rgba(62,61,56,0.5); }
        .toc-group:last-child { border-bottom: none; }
        .toc-group summary {
            cursor: pointer; list-style: none;
            display: flex; align-items: center; justify-content: space-between; gap: 6px;
            font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 10.5px;
            text-transform: uppercase; letter-spacing: 0.6px; color: #F8DCC0; opacity: 0.55;
            padding: 10px 10px;
            transition: opacity 0.15s ease;
        }
        .toc-group summary:hover { opacity: 0.9; }
        .toc-group summary::-webkit-details-marker { display: none; }
        .toc-group summary::after {
            content: '▸'; font-size: 9px; opacity: 0.6; flex: none;
            transition: transform 0.15s ease;
        }
        .toc-group[open] > summary::after { transform: rotate(90deg); }
        .toc-group[open] > summary { opacity: 0.9; }
        .toc-links { display: flex; flex-direction: column; padding-bottom: 6px; }

        .docs-mobile-toc {
            background: #1A1A1A; border: 1px solid #3E3D38; border-radius: 14px;
            padding: 4px 18px; margin-bottom: 8px;
        }
        .docs-mobile-toc summary {
            cursor: pointer; list-style: none;
            font-family: 'Tilt Warp', sans-serif; font-size: 15px; letter-spacing: 0.5px;
            padding: 14px 0; color: #DCA15E; text-transform: uppercase;
        }
        .docs-mobile-toc summary::-webkit-details-marker { display: none; }
        .docs-mobile-toc[open] summary { border-bottom: 1px solid #3E3D38; }
        .docs-mobile-toc-list { display: flex; flex-direction: column; padding: 10px 0 14px; }
        .docs-mobile-toc-list a { font-family:'Poppins',sans-serif; font-size:13px; color:#F8DCC0; opacity:0.75; text-decoration:none; padding:6px 4px; }
        .docs-mobile-toc-list .toc-cat { font-family:'Poppins',sans-serif; font-weight:700; font-size:10.5px; text-transform:uppercase; letter-spacing:0.6px; opacity:0.4; margin: 10px 4px 2px; }

        .docs-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 60px; }
        section[id] { scroll-margin-top: 24px; }

        .docs-cat-header { display: flex; flex-direction: column; gap: 8px; margin-bottom: 22px; }
        .docs-cat-title { font-size: clamp(22px, 3vw, 30px); }
        .docs-cat-desc { font-family: 'Poppins', sans-serif; font-size: 14.5px; opacity: 0.7; max-width: 720px; line-height: 1.55; }
        .docs-cat-body { display: flex; flex-direction: column; gap: 18px; }

        .docs-callout {
            background: linear-gradient(135deg, rgba(220,161,94,0.12), rgba(128,62,48,0.14));
            border: 1px solid rgba(220,161,94,0.35);
            border-radius: 14px; padding: 22px 24px; display: flex; flex-direction: column; gap: 12px;
        }
        .docs-callout ol, .docs-callout ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; font-family: 'Poppins', sans-serif; font-size: 14px; opacity: 0.92; line-height: 1.5; }
        .docs-callout code { background: rgba(255,255,255,0.08); padding: 1px 7px; border-radius: 5px; font-family: monospace; font-size: 0.92em; color: #DCA15E; }

        .legend { display: flex; flex-wrap: wrap; gap: 10px 20px; align-items: center; font-family: 'Poppins', sans-serif; font-size: 12.5px; opacity: 0.8; }
        .legend-item { display: flex; align-items: center; gap: 7px; }

        .cmd-card { background: #1A1A1A; border: 1px solid #3E3D38; border-radius: 14px; padding: 20px 22px; display: flex; flex-direction: column; gap: 10px; }
        .cmd-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        .cmd-name { font-family: 'Tilt Warp', sans-serif; font-size: 19px; color: #DCA15E; }
        .badge {
            font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 10px;
            text-transform: uppercase; letter-spacing: 0.4px;
            padding: 3px 10px; border-radius: 20px; white-space: nowrap;
        }
        .badge.tier-free { color: #F8DCC0; background: rgba(248,220,192,0.08); border: 1px solid rgba(248,220,192,0.3); }
        .badge.tier-rastreador { color: #DCA15E; background: rgba(220,161,94,0.12); border: 1px solid rgba(220,161,94,0.4); }
        .badge.tier-cacador { color: #FF4E3B; background: rgba(255,78,59,0.12); border: 1px solid rgba(255,78,59,0.4); }
        .badge.perm { color: #F8DCC0; background: rgba(255,255,255,0.05); border: 1px solid #3E3D38; }
        .badge.status-essential { color: #FF4E3B; background: rgba(255,78,59,0.12); border: 1px solid rgba(255,78,59,0.4); }
        .badge.status-optional { color: #F8DCC0; background: rgba(255,255,255,0.04); border: 1px solid #3E3D38; opacity: 0.75; }
        .cmd-desc { font-family: 'Poppins', sans-serif; font-size: 14px; opacity: 0.85; line-height: 1.55; }
        .cmd-desc code, .cmd-table code { background: rgba(255,255,255,0.07); padding: 1px 6px; border-radius: 5px; font-family: monospace; font-size: 0.9em; color: #DCA15E; }
        .cmd-note { font-family: 'Poppins', sans-serif; font-size: 12.5px; opacity: 0.6; font-style: italic; }
        .cmd-table-wrap { overflow-x: auto; }
        .cmd-table { width: 100%; border-collapse: collapse; font-family: 'Poppins', sans-serif; font-size: 12.5px; }
        .cmd-table th { text-align: left; opacity: 0.5; text-transform: uppercase; font-size: 10px; letter-spacing: 0.4px; padding: 6px 10px; border-bottom: 1px solid #3E3D38; white-space: nowrap; }
        .cmd-table td { padding: 8px 10px; border-bottom: 1px solid rgba(62,61,56,0.5); vertical-align: top; opacity: 0.9; }
        .cmd-table tr:last-child td { border-bottom: none; }
        .cmd-sub { border-top: 1px solid #3E3D38; padding-top: 12px; margin-top: 2px; display: flex; flex-direction: column; gap: 6px; }
        .cmd-sub-name { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 13px; color: #F8DCC0; }

        .docs-footer-links { display: flex; flex-wrap: wrap; gap: 12px; }
    </style>
</head>
<body class="text-titan-cream">

