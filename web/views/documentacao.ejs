<%
// ===================== HELPERS DE RENDER =====================
// Ver docblock no topo do arquivo — cmdCard cobre os ~18 comandos
// "normais"; rconCmdCard cobre os 7 grupos de RCON (subcomandos demais
// pra virar um cmd-card expandido cada).
function permBadge(text) { return `<span class="badge perm">${text}</span>`; }
function tierBadge(tier) {
    const map = {
        free: ['FREE', 'tier-free'],
        rastreador: ['RASTREADOR+', 'tier-rastreador'],
        cacador: ['CAÇADOR', 'tier-cacador'],
    };
    const [label, cls] = map[tier] || map.free;
    return `<span class="badge ${cls}">${label}</span>`;
}
function optTable(opts) {
    if (!opts || !opts.length) return '';
    const rows = opts.map(o => `<tr><td><code>${o.name}</code></td><td>${o.type}</td><td>${o.req ? 'Sim' : 'Não'}</td><td>${o.desc}</td></tr>`).join('');
    return `<div class="cmd-table-wrap"><table class="cmd-table"><thead><tr><th>Opção</th><th>Tipo</th><th>Obrigatório</th><th>Descrição</th></tr></thead><tbody>${rows}</tbody></table></div>`;
}
function cmdCard(cmd) {
    const badges = [permBadge(cmd.perm)];
    if (cmd.tier) badges.push(tierBadge(cmd.tier));
    const subsHtml = (cmd.subs || []).map(s => `
        <div class="cmd-sub">
            <p class="cmd-sub-name">/${cmd.name} ${s.name}</p>
            <p class="cmd-desc">${s.desc}</p>
            ${s.tier ? `<div>${tierBadge(s.tier)}</div>` : ''}
            ${optTable(s.opts)}
        </div>
    `).join('');
    return `<div class="cmd-card" id="cmd-${cmd.id}">
        <div class="cmd-head"><span class="cmd-name">/${cmd.name}</span>${badges.join('')}</div>
        <p class="cmd-desc">${cmd.desc}</p>
        ${cmd.note ? `<p class="cmd-note">${cmd.note}</p>` : ''}
        ${optTable(cmd.opts)}
        ${subsHtml}
    </div>`;
}
function rconCmdCard(cmd) {
    const rows = cmd.subs.map(s => `<tr><td><code>${s.name}</code>${s.locked ? ' 🔒' : ''}</td><td>${s.desc}</td><td>${s.opts || '—'}</td></tr>`).join('');
    return `<div class="cmd-card" id="cmd-${cmd.id}">
        <div class="cmd-head">
            <span class="cmd-name">/${cmd.name}</span>
            ${permBadge(cmd.openToAll ? 'Todos (só listplayers)' : 'Staff')}
            ${tierBadge('cacador')}
        </div>
        <p class="cmd-desc">${cmd.desc}</p>
        <div class="cmd-table-wrap"><table class="cmd-table"><thead><tr><th>Subcomando</th><th>O que faz</th><th>Opções</th></tr></thead><tbody>${rows}</tbody></table></div>
    </div>`;
}

// ===================== ÍNDICE (TOC) =====================
const toc = [
    { cat: 'Comece Aqui', items: [{ id: 'comece-aqui', label: 'Primeiros Passos' }, { id: 'legenda', label: 'Como ler esta página' }] },
    { cat: 'Perfil & Premium', items: [{ id: 'cmd-registrar', label: '/registrar' }, { id: 'cmd-perfil', label: '/perfil' }, { id: 'cmd-perfil-edit', label: '/perfil-edit' }, { id: 'cmd-premium', label: '/premium' }] },
    { cat: 'Moderação', items: [{ id: 'cmd-strike', label: '/strike' }, { id: 'cmd-unstrike', label: '/unstrike' }, { id: 'cmd-repset', label: '/repset' }, { id: 'cmd-historico', label: '/historico' }] },
    { cat: 'Denúncias & Eventos', items: [{ id: 'cmd-reportchat', label: '/reportchat' }, { id: 'cmd-evento', label: '/evento' }] },
    { cat: 'Configuração (Admin)', items: [{ id: 'cmd-config', label: '/config' }, { id: 'cmd-potserver', label: '/potserver' }, { id: 'cmd-ping', label: '/ping' }] },
    { cat: 'Integração PoT / RCON', items: [{ id: 'cmd-ingame-comandos', label: '/ingame-comandos' }, { id: 'cmd-ingame-admin', label: '/ingame-admin' }, { id: 'cmd-ingame-buff', label: '/ingame-buff' }, { id: 'cmd-ingame-event', label: '/ingame-event' }, { id: 'cmd-ingame-list', label: '/ingame-list' }, { id: 'cmd-ingame-map', label: '/ingame-map' }, { id: 'cmd-ingame-marks', label: '/ingame-marks' }, { id: 'cmd-ingame-message', label: '/ingame-message' }, { id: 'cmd-ingame-stats', label: '/ingame-stats' }] },
    { cat: 'Ajuda & Suporte', items: [{ id: 'cmd-ajuda', label: '/ajuda' }, { id: 'cmd-botstatus', label: '/botstatus' }, { id: 'cmd-reportarbug', label: '/reportarbug' }] },
];
%>

<div class="docs-header-padding">
    <div class="flex flex-col items-center text-center gap-3" style="max-width: 720px; margin: 0 auto;">
        <h1 class="section-title" style="font-size: clamp(28px, 4vw, 44px);">DOCUMENTAÇÃO</h1>
        <p style="font-family:'Poppins',sans-serif; font-size:16px; opacity:0.85; line-height:1.55;">
            Guia completo de todos os comandos do Titan's Pass — moderação, denúncias, eventos, integração com Path of Titans via RCON, e configuração do servidor. Use o índice ao lado (ou o menu abaixo, no celular) pra pular direto pro que precisa.
        </p>
    </div>
</div>

<div class="docs-shell">
    <!-- TOC desktop, sticky -->
    <aside class="docs-toc hidden lg:flex">
        <% toc.forEach(group => { %>
            <details class="toc-group" open>
                <summary><%= group.cat %></summary>
                <div class="toc-links">
                    <% group.items.forEach(item => { %><a href="#<%= item.id %>"><%= item.label %></a><% }); %>
                </div>
            </details>
        <% }); %>
    </aside>

    <main class="docs-main">
        <!-- TOC mobile, colapsável -->
        <details class="docs-mobile-toc lg:hidden">
            <summary>Índice</summary>
            <div class="docs-mobile-toc-list">
                <% toc.forEach(group => { %>
                    <span class="toc-cat"><%= group.cat %></span>
                    <% group.items.forEach(item => { %><a href="#<%= item.id %>"><%= item.label %></a><% }); %>
                <% }); %>
            </div>
        </details>

        <!-- ===================== COMECE AQUI ===================== -->
        <section id="comece-aqui">
            <div class="docs-cat-header">
                <h2 class="section-title docs-cat-title">Primeiros Passos</h2>
                <p class="docs-cat-desc">O caminho recomendado pra configurar o bot num servidor novo, do zero até denúncias/eventos/moderação funcionando.</p>
            </div>
            <div class="docs-callout">
                <div class="legend" style="margin-bottom: 2px;">
                    <span class="legend-item"><span class="badge status-essential">ESSENCIAL</span> pro funcionamento básico</span>
                    <span class="legend-item"><span class="badge status-optional">OPCIONAL</span> só se você precisar do recurso</span>
                </div>
                <ol>
                    <li><strong>Convide o bot</strong> com permissão de Administrador (necessário pra gerenciar cargos, canais e enviar mensagens nos formatos que o bot usa) — <a href="https://discord.com/oauth2/authorize?client_id=<%= bot.user.id %>&permissions=8&scope=bot%20applications.commands" target="_blank" rel="noopener" style="color:#DCA15E;">clique aqui pra convidar</a>.</li>
                    <li><span class="badge status-essential">ESSENCIAL</span> Configure os cargos da equipe em <code>/config roles</code> — pelo menos o cargo de <strong>Moderador</strong> é obrigatório pra qualquer comando de moderação funcionar.</li>
                    <li><span class="badge status-essential">ESSENCIAL</span> Configure os canais de log em <code>/config logs</code> (Geral/AutoMod, Punições, ReportChat, Staff) — sem isso, os registros não vão pra lugar nenhum.</li>
                    <li><span class="badge status-optional">OPCIONAL</span> Publique o painel de denúncias com <code>/reportchat</code> no canal onde os jogadores devem reportar.</li>
                    <li><span class="badge status-optional">OPCIONAL</span> Se você hospeda um servidor de <em>Path of Titans</em>, rode <code>/potserver setup</code> informando IP/senha/porta do RCON — conecta o servidor e já gera o token usado pelos webhooks também. Só faz sentido se você realmente hospeda um servidor; usar os comandos <code>/ingame-*</code> de controle remoto especificamente exige o plano <strong>Caçador</strong>.</li>
                    <li><span class="badge status-essential">ESSENCIAL</span> Depois do setup, configure os canais em <code>/potserver logs</code> — é o que registra no Discord tudo que acontece no servidor de jogo (login, mortes, combate...). Funciona em <strong>qualquer plano, incluindo o Free</strong> — diferente dos comandos de RCON, não exige Caçador.</li>
                    <li>Todo membro pode rodar <code>/registrar</code> pra vincular a conta do Discord ao Alderon ID (Path of Titans) — é o que liga o perfil, o histórico e os comandos in-game a cada pessoa.</li>
                </ol>
            </div>
        </section>

        <!-- ===================== LEGENDA ===================== -->
        <section id="legenda">
            <div class="docs-cat-header">
                <h2 class="section-title docs-cat-title">Como Ler Esta Página</h2>
                <p class="docs-cat-desc">Cada comando abaixo mostra quem pode usá-lo e se ele exige um plano específico do servidor. As cores das badges de plano são as mesmas da <a href="/#premium" style="color:#DCA15E;">tabela de preços</a>.</p>
            </div>
            <div class="legend">
                <span class="legend-item"><span class="badge perm">Permissão</span> — quem pode rodar o comando (Discord ou cargo configurado em <code>/config roles</code>)</span>
                <span class="legend-item"><span class="badge tier-free">FREE</span> — disponível em qualquer plano</span>
                <span class="legend-item"><span class="badge tier-rastreador">RASTREADOR+</span> — exige plano Rastreador ou Caçador</span>
                <span class="legend-item"><span class="badge tier-cacador">CAÇADOR</span> — exclusivo do plano Caçador</span>
                <span class="legend-item">🔒 — exige também o cargo de Supervisor, além de Staff</span>
            </div>
        </section>

        <!-- ===================== PERFIL & PREMIUM ===================== -->
        <section id="perfil-premium">
            <div class="docs-cat-header">
                <h2 class="section-title docs-cat-title">Perfil & Premium do Jogador</h2>
                <p class="docs-cat-desc">Comandos abertos a qualquer membro — vínculo com o jogo, perfil pessoal e o que cada plano de jogador (Free/Compy/Raptor) libera.</p>
            </div>
            <div class="docs-cat-body">
                <%- cmdCard({
                    id: 'registrar', name: 'registrar', perm: 'Todos',
                    desc: 'Abre o painel para vincular a conta do Discord ao Alderon ID (Path of Titans). É um vínculo GLOBAL — vale em qualquer servidor que use o bot, não precisa refazer em cada um.',
                }) %>
                <%- cmdCard({
                    id: 'perfil', name: 'perfil', perm: 'Todos',
                    desc: 'Mostra o cartão de perfil (Discord + vínculo com Path of Titans) — o seu, ou o de outra pessoa/Alderon ID.',
                    opts: [
                        { name: 'usuario', type: 'Usuário', req: false, desc: 'Padrão: você mesmo. Use este OU alderon_id, não os dois.' },
                        { name: 'alderon_id', type: 'Texto', req: false, desc: 'Consulta pelo ID do jogo em vez de uma conta Discord.' },
                    ],
                }) %>
                <%- cmdCard({
                    id: 'perfil-edit', name: 'perfil-edit', perm: 'Todos (registrado)',
                    desc: 'Sem anexos, abre um painel com tudo que o seu plano de jogador permite personalizar (foto de perfil, plano de fundo, título, emblema). Enviar um anexo em avatar/plano_de_fundo sobe a imagem direto, pulando o painel — um anexo vazio remove a imagem atual.',
                    note: 'Emblema: liberado em qualquer plano. Foto de perfil/plano de fundo/título: exige Player Premium Compy (escolha por galeria) ou Raptor (upload da sua própria imagem).',
                    opts: [
                        { name: 'avatar', type: 'Anexo', req: false, desc: 'Só processado no plano Raptor.' },
                        { name: 'plano_de_fundo', type: 'Anexo', req: false, desc: 'Só processado no plano Raptor.' },
                    ],
                }) %>
                <%- cmdCard({
                    id: 'premium', name: 'premium', perm: 'Todos',
                    desc: 'Vitrine dos planos Premium (jogador e servidor) com painel navegável por botão e o status atual de quem usou o comando.',
                    note: 'Preços e o que cada plano libera: veja a tabela completa em /#premium.',
                }) %>
            </div>
        </section>

        <!-- ===================== MODERAÇÃO ===================== -->
        <section id="moderacao">
            <div class="docs-cat-header">
                <h2 class="section-title docs-cat-title">Moderação</h2>
                <p class="docs-cat-desc">Punições, reputação e histórico — os comandos do dia a dia da staff.</p>
            </div>
            <div class="docs-cat-body">
                <%- cmdCard({
                    id: 'strike', name: 'strike', perm: 'Moderador + hierarquia',
                    desc: 'Aplica uma punição. No plano <strong>Free</strong>, vira um registro simples (sem nível, sem ação automática — só usuário, motivo e uma duração opcional). No <strong>Rastreador+</strong>, um nível fica sempre obrigatório (autocomplete dos níveis configurados em <code>/config punishments</code>) — duração, pontos perdidos e qualquer ação automática vêm sempre do nível escolhido, nunca do campo duração. Sempre mostra uma prévia de confirmação antes de aplicar de verdade (expira em 2 minutos).',
                    note: 'Aceita usuário e/ou Alderon ID — só AGID sem vínculo Discord registra um "alvo sintético" (punição só em jogo). Não é possível punir alguém com cargo igual ou superior ao seu.',
                    opts: [
                        { name: 'motivo', type: 'Texto', req: true, desc: 'Motivo da punição.' },
                        { name: 'usuario', type: 'Usuário', req: false, desc: 'Use este e/ou agid.' },
                        { name: 'agid', type: 'Texto', req: false, desc: 'Alderon ID do jogador.' },
                        { name: 'nivel', type: 'Texto (autocomplete)', req: false, desc: 'Obrigatório a partir do Rastreador. Vem de /config punishments.' },
                        { name: 'duracao', type: 'Texto', req: false, desc: 'Só tem efeito no plano Free.' },
                        { name: 'discord_act', type: 'Escolha', req: false, desc: 'Nenhuma / Mute / Expulsar / Banir.' },
                        { name: 'report', type: 'Texto', req: false, desc: 'ID de uma denúncia existente (ex: #R5) pra vincular a punição a ela.' },
                    ],
                }) %>
                <%- cmdCard({
                    id: 'unstrike', name: 'unstrike', perm: 'Moderador + hierarquia',
                    desc: 'Anula um strike ativo (pelo número mostrado como "Strike #N", não o ID interno do banco) e devolve os pontos de reputação perdidos, após confirmação por botão (expira em 2 minutos).',
                    opts: [
                        { name: 'id', type: 'Número', req: true, desc: 'O número do strike a anular (Strike #N).' },
                        { name: 'motivo', type: 'Texto', req: true, desc: 'Motivo da anulação.' },
                    ],
                }) %>
                <%- cmdCard({
                    id: 'repset', name: 'repset', perm: 'Moderador + hierarquia', tier: 'rastreador',
                    desc: 'Ajusta manualmente a reputação de um usuário para um valor absoluto (0-100). Envia uma DM ao jogador avisando e registra no canal de log de Punições.',
                    opts: [
                        { name: 'usuario', type: 'Usuário', req: true, desc: '' },
                        { name: 'pontos', type: 'Número (0-100)', req: true, desc: 'Novo valor absoluto de reputação.' },
                        { name: 'motivo', type: 'Texto', req: true, desc: '' },
                    ],
                }) %>
                <%- cmdCard({
                    id: 'historico', name: 'historico', perm: 'Varia por subcomando',
                    desc: 'Consulta o histórico de um jogador (punições/reputação) ou a atividade agregada da staff, em lista paginada.',
                    subs: [
                        { name: 'jogador', desc: 'Histórico de punições e reputação de um jogador — aberto a qualquer membro.', tier: 'rastreador', opts: [
                            { name: 'usuario', type: 'Usuário', req: false, desc: 'Use este OU alderon_id.' },
                            { name: 'alderon_id', type: 'Texto', req: false, desc: '' },
                        ] },
                        { name: 'staff', desc: 'Atividade de um membro da staff, ou o ranking de todos se ninguém for indicado. Exige cargo de Staff pra usar.', tier: 'cacador', opts: [
                            { name: 'staff', type: 'Usuário', req: false, desc: 'Vazio = ranking geral.' },
                        ] },
                    ],
                }) %>
            </div>
        </section>

        <!-- ===================== DENÚNCIAS & EVENTOS ===================== -->
        <section id="denuncias-eventos">
            <div class="docs-cat-header">
                <h2 class="section-title docs-cat-title">Denúncias & Eventos</h2>
                <p class="docs-cat-desc">O painel de denúncias que os jogadores usam, e a criação de eventos da comunidade.</p>
            </div>
            <div class="docs-cat-body">
                <%- cmdCard({
                    id: 'reportchat', name: 'reportchat', perm: 'Administrador',
                    desc: 'Publica no canal atual o painel de ReportChat: um botão "Reportar Jogador" que qualquer membro pode clicar pra abrir uma thread privada com a staff. Normalmente só precisa ser rodado uma vez, no canal de denúncias do servidor.',
                }) %>
                <%- cmdCard({
                    id: 'evento', name: 'evento', perm: 'Gerenciar Eventos + cargo Equipe de Eventos',
                    desc: 'Cria e publica um evento da comunidade: baixa a imagem enviada e publica um post no fórum escolhido, com título, descrição, imagem e data. A partir do plano Rastreador, também cria um Evento Agendado nativo do Discord e marca o cargo de notificação; no plano Caçador, ganha também botão de teleporte automático e anúncio num canal dedicado.',
                    note: 'No plano Free, publica só o post no fórum — sem evento agendado nem marcação de cargo. É preciso ter o cargo "Equipe de Eventos" configurado em /config roles.',
                    opts: [
                        { name: 'forum', type: 'Canal (fórum)', req: true, desc: 'Onde a thread do evento é criada.' },
                        { name: 'titulo', type: 'Texto (máx. 100)', req: true, desc: '' },
                        { name: 'descricao', type: 'Texto (máx. 1000)', req: true, desc: '' },
                        { name: 'imagem', type: 'Anexo (PNG/JPEG)', req: true, desc: 'Máximo 1920×1279.' },
                        { name: 'data', type: 'Texto', req: true, desc: 'Formato DD/MM/AAAA HH:MM, precisa ser uma data futura.' },
                        { name: 'local_canal', type: 'Canal (voz/palco)', req: false, desc: 'Use este OU local_descricao — um dos dois é obrigatório fora do plano Free.' },
                        { name: 'local_descricao', type: 'Texto (máx. 100)', req: false, desc: 'Local em texto livre.' },
                    ],
                }) %>
            </div>
        </section>

        <!-- ===================== CONFIGURAÇÃO (ADMIN) ===================== -->
        <section id="configuracao">
            <div class="docs-cat-header">
                <h2 class="section-title docs-cat-title">Configuração (Admin)</h2>
                <p class="docs-cat-desc">Comandos de administração do servidor — todos exigem permissão de Administrador no Discord.</p>
            </div>
            <div class="docs-cat-body">
                <%- cmdCard({
                    id: 'config', name: 'config', perm: 'Administrador',
                    desc: 'Comando único que abre os painéis de configuração do servidor — cada subcomando é um painel próprio, sem precisar decorar mais nada.',
                    subs: [
                        { name: 'roles', desc: 'Painel de cargos automáticos: Moderação (Moderador/Supervisor), Cargos Automáticos (reputação: Exemplar/Problemático/Strike temporário) e Eventos (Equipe de Eventos/Notificação).' },
                        { name: 'logs', desc: 'Painel único dos 4 canais de log: Geral/AutoMod, Punições, ReportChat e Staff.' },
                        { name: 'punishments', desc: 'Painel de pontos por nível de strike e limites de reputação.', tier: 'rastreador' },
                        { name: 'personalizar', desc: 'Painel de banners usados em /strike, /unstrike e no ReportChat — escolha entre o padrão do bot, a galeria de imagens do pool, ou envie a sua própria pelas opções abaixo.', tier: 'cacador', opts: [
                            { name: 'banner_strike', type: 'Anexo', req: false, desc: 'Se enviado, sobe direto (pula o painel de escolha).' },
                            { name: 'banner_unstrike', type: 'Anexo', req: false, desc: '' },
                            { name: 'banner_reportchat', type: 'Anexo', req: false, desc: '' },
                        ] },
                        { name: 'buffs', desc: 'Painel de criação/edição de buffs — presets de atributos (RCON) aplicados em lote num jogador com /ingame-buff aplicar. Exige também o cargo de Supervisor, além do plano.', tier: 'cacador' },
                        { name: 'filtro', desc: 'Painel do filtro de palavras do chat em jogo, com ação automática configurável. Exige também o cargo de Supervisor, além do plano.', tier: 'cacador' },
                    ],
                }) %>
                <%- cmdCard({
                    id: 'potserver', name: 'potserver', perm: 'Administrador',
                    desc: 'Gerencia a integração com o servidor de jogo Path of Titans (conexão RCON + webhooks de eventos do jogo). Veja a seção Integração PoT / RCON abaixo pra entender o que isso desbloqueia.',
                    subs: [
                        { name: 'setup', desc: 'Salva IP, senha e porta do RCON, gera (ou reaproveita) o token de autenticação do webhook, e testa a conexão na hora.', opts: [
                            { name: 'ip', type: 'Texto', req: true, desc: '' },
                            { name: 'rcon_password', type: 'Texto', req: true, desc: '' },
                            { name: 'rcon_port', type: 'Número', req: true, desc: '' },
                            { name: 'nome', type: 'Texto', req: false, desc: 'Nome de exibição do servidor.' },
                        ] },
                        { name: 'logs', desc: 'Abre o painel de configuração dos canais/webhooks de eventos do jogo (login, mortes, combate...). Exige ter rodado setup antes. Funciona em qualquer plano, incluindo o Free — só o relatório de combate detalhado exige Rastreador+.' },
                        { name: 'status', desc: 'Mostra IP/porta, quantos webhooks estão configurados, o token (mascarado), estatísticas de uso, e testa o RCON ao vivo.' },
                        { name: 'reset', desc: 'Apaga configurações, com confirmação por botão.', opts: [
                            { name: 'scope', type: 'Escolha', req: true, desc: 'server = só a config do servidor (mantém o token) · logs = só os webhooks · all = tudo, incluindo revogar o token.' },
                        ] },
                    ],
                }) %>
                <%- cmdCard({
                    id: 'ping', name: 'ping', perm: 'Todos',
                    desc: 'Latência do bot (ping do WebSocket), com um indicador visual de status. Aberto a qualquer membro, apesar de morar na mesma categoria dos comandos de configuração.',
                }) %>
            </div>
        </section>

        <!-- ===================== INTEGRAÇÃO POT / RCON ===================== -->
        <section id="integracao-pot">
            <div class="docs-cat-header">
                <h2 class="section-title docs-cat-title">Integração Path of Titans / RCON</h2>
                <p class="docs-cat-desc">
                    Depois de conectar seu servidor com <code>/potserver setup</code> (exige RCON habilitado no seu servidor de PoT), o plano <strong>Caçador</strong> libera ~57 comandos de RCON direto do Discord, agrupados em 7 comandos por categoria — sem precisar abrir o console do jogo. Todos exigem ter um cargo de Staff configurado em <code>/config roles</code>; os marcados com 🔒 exigem também o cargo de Supervisor. Toda ação fica registrada no canal de log configurado.
                </p>
            </div>
            <div class="docs-cat-body">
                <%- cmdCard({
                    id: 'ingame-comandos', name: 'ingame-comandos', perm: 'Staff',
                    desc: 'Lista paginada (uma categoria por página) com todos os comandos /ingame-* e suas opções — a referência completa direto no Discord, sempre atualizada com o que está realmente configurado no seu bot.',
                }) %>
                <%- rconCmdCard({
                    id: 'ingame-admin', name: 'ingame-admin',
                    desc: 'Comandos administrativos do servidor (categoria "Admin" do RCON oficial do jogo).',
                    subs: [
                        { name: 'save / load', desc: 'Salva/carrega os dados do servidor.' },
                        { name: 'promote', locked: true, desc: 'Promove o jogador a um cargo de admin.', opts: 'usuario/agid, cargo' },
                        { name: 'demote', locked: true, desc: 'Remove o cargo de admin do jogador.', opts: 'usuario/agid' },
                        { name: 'cancelrestart', locked: true, desc: 'Cancela um reinício agendado.' },
                        { name: 'restart', locked: true, desc: 'Agenda um reinício.', opts: 'segundos' },
                        { name: 'reloadrules', desc: 'Recarrega as regras do servidor.' },
                        { name: 'whitelist / delwhitelist', desc: 'Adiciona/remove o jogador da whitelist.', opts: 'usuario/agid' },
                        { name: 'reloadwhitelist / reloadmotd', desc: 'Recarrega a whitelist/mensagem do dia.' },
                        { name: 'alloweditabilities', desc: 'Permite o jogador editar habilidades.', opts: 'usuario/agid' },
                        { name: 'serverinfo', locked: true, desc: 'Mostra informações do servidor.' },
                    ],
                }) %>
                <%- rconCmdCard({
                    id: 'ingame-buff', name: 'ingame-buff',
                    desc: 'Aplica um buff (preset de atributos configurado em /config buffs) num jogador — verifica se ele está online antes de aplicar.',
                    subs: [
                        { name: 'aplicar', desc: 'Abre um menu pra escolher qual buff configurado aplicar no jogador.', opts: 'usuario/agid' },
                        { name: 'listar', desc: 'Lista os buffs configurados no servidor e seus atributos.', opts: '—' },
                    ],
                }) %>
                <%- rconCmdCard({
                    id: 'ingame-event', name: 'ingame-event',
                    desc: 'Comandos de eventos/criaturas do RCON (categoria "Event"). Não confundir com /evento, que é o agendamento de eventos da comunidade.',
                    subs: [
                        { name: 'setwound / setpermawound', desc: 'Aplica ferimento temporário/permanente ao jogador.', opts: 'usuario/agid, categoria, valor' },
                        { name: 'skipshed', desc: 'Pula a muda (troca de pele) do jogador.', opts: 'usuario/agid' },
                        { name: 'spawncritter', desc: 'Spawna criaturas pequenas.', opts: 'nome, quantidade' },
                        { name: 'countcritters / clearcritters', desc: 'Conta/remove as criaturas ativas no mapa.' },
                        { name: 'freezecritters', desc: 'Congela ou descongela as criaturas.', opts: 'congelar (sim/não)' },
                    ],
                }) %>
                <%- rconCmdCard({
                    id: 'ingame-list', name: 'ingame-list', openToAll: true,
                    desc: 'Comandos de listagem/consulta. listplayers é o único subcomando aberto a QUALQUER membro do servidor — os outros seguem restritos à staff.',
                    subs: [
                        { name: 'listplayers', desc: 'Lista os jogadores conectados agora + total online.', opts: '— (aberto a todos)' },
                        { name: 'listpoi', desc: 'Lista os pontos de interesse do mapa.' },
                        { name: 'listquests', desc: 'Lista as missões disponíveis.' },
                        { name: 'listroles', desc: 'Lista os cargos de admin do servidor de jogo.' },
                        { name: 'listwaters', desc: 'Lista as fontes de água do mapa.' },
                        { name: 'listwaystones', desc: 'Lista os waystones (pedras de teleporte).' },
                        { name: 'listcreatormode', desc: 'Lista os saves salvos do modo criador.' },
                    ],
                }) %>
                <%- rconCmdCard({
                    id: 'ingame-map', name: 'ingame-map',
                    desc: 'Comandos de mapa/mundo — clima, hora, água, modo criador.',
                    subs: [
                        { name: 'weather', desc: 'Muda o clima do servidor.', opts: 'tipo' },
                        { name: 'timeofday', desc: 'Muda a hora do dia.', opts: 'hora' },
                        { name: 'waterquality', desc: 'Ajusta a qualidade da água de uma área.', opts: 'tag, porcentagem' },
                        { name: 'waystonecooldown', desc: 'Ajusta o cooldown de um waystone.', opts: 'tag, porcentagem' },
                        { name: 'clearcreatorobjects / resetcreatormode / replenishcreatormode', desc: 'Limpa/reseta/reabastece o modo criador.' },
                        { name: 'loadcreatormode / savecreatormode / removecreatormode', desc: 'Carrega/salva/remove um save do modo criador.', opts: 'nome' },
                    ],
                }) %>
                <%- rconCmdCard({
                    id: 'ingame-marks', name: 'ingame-marks',
                    desc: 'Comandos de marcas (pontos de dano/prestígio no jogo).',
                    subs: [
                        { name: 'setmarks', desc: 'Define um valor absoluto de marcas.', opts: 'usuario/agid, numero' },
                        { name: 'addmarks / removemarks', desc: 'Adiciona/remove marcas do jogador.', opts: 'usuario/agid, numero' },
                        { name: 'addmarksall', locked: true, desc: 'Adiciona marcas para todo mundo online.', opts: 'numero' },
                    ],
                }) %>
                <%- rconCmdCard({
                    id: 'ingame-message', name: 'ingame-message',
                    desc: 'Comandos de mensagens/anúncios in-game.',
                    subs: [
                        { name: 'systemmessage', desc: 'Envia uma mensagem de sistema pra um jogador.', opts: 'usuario/agid, mensagem' },
                        { name: 'whisper', desc: 'Sussurra uma mensagem privada pra um jogador.', opts: 'usuario/agid, mensagem' },
                        { name: 'systemmessageall', desc: 'Mensagem de sistema pra todos.', opts: 'mensagem' },
                        { name: 'announce', desc: 'Anúncio pra todos.', opts: 'mensagem' },
                    ],
                }) %>
                <%- rconCmdCard({
                    id: 'ingame-stats', name: 'ingame-stats',
                    desc: 'Comandos de atributos/status do dinossauro ("Change Stats").',
                    subs: [
                        { name: 'heal', desc: 'Cura o jogador (vazio = você mesmo).', opts: 'usuario/agid' },
                        { name: 'healall', locked: true, desc: 'Cura todo mundo online.' },
                        { name: 'godmode', locked: true, desc: 'Ativa/desativa o modo deus.', opts: 'usuario/agid' },
                        { name: 'setattr', desc: 'Define um atributo específico.', opts: 'usuario/agid, atributo, valor' },
                        { name: 'setattrall', locked: true, desc: 'Define um atributo pra todo mundo online.', opts: 'atributo, valor' },
                        { name: 'getattr', locked: true, desc: 'Consulta um atributo específico.', opts: 'usuario/agid, atributo' },
                        { name: 'getallattr', locked: true, desc: 'Consulta todos os atributos do jogador.', opts: 'usuario/agid' },
                        { name: 'rewardgrowth / rewardwellrested', desc: 'Recompensa crescimento/descanso.', opts: 'usuario/agid, valor' },
                        { name: 'clearcooldowns', desc: 'Limpa os cooldowns do jogador.' },
                    ],
                }) %>
            </div>
        </section>

        <!-- ===================== AJUDA & SUPORTE ===================== -->
        <section id="ajuda-suporte">
            <div class="docs-cat-header">
                <h2 class="section-title docs-cat-title">Ajuda & Suporte</h2>
                <p class="docs-cat-desc">Guia interativo dentro do próprio Discord, status do bot, e como falar com a gente.</p>
            </div>
            <div class="docs-cat-body">
                <%- cmdCard({
                    id: 'ajuda', name: 'ajuda', perm: 'Todos',
                    desc: 'Guia interativo do bot, navegado por menu — mostra um conteúdo mais completo (configuração/moderação/sistemas do servidor) pra quem é Administrador, e uma versão enxuta pra membros comuns.',
                }) %>
                <%- cmdCard({
                    id: 'botstatus', name: 'botstatus', perm: 'Administrador',
                    desc: 'Painel de saúde do bot: uptime e ping sempre visíveis; a partir do plano Caçador, também mostra estatísticas do servidor (punições, reputação média, status do AutoMod).',
                }) %>
                <%- cmdCard({
                    id: 'reportarbug', name: 'reportarbug', perm: 'Todos',
                    desc: 'Envia uma sugestão ou relato de bug direto pro desenvolvedor do bot.',
                    opts: [
                        { name: 'tipo', type: 'Escolha', req: true, desc: 'Sugerir Melhoria ou Reportar Bug/Erro.' },
                        { name: 'mensagem', type: 'Texto', req: true, desc: '' },
                    ],
                }) %>
                <div class="docs-callout">
                    <p style="font-family:'Poppins',sans-serif; font-size:14px; margin:0; opacity:0.9;">Precisa de ajuda que não está aqui? Entre no nosso servidor de suporte.</p>
                    <div class="docs-footer-links">
                        <a href="https://discord.gg/fkD5FQktn6" target="_blank" rel="noopener" class="nav-btn" style="height:36px; padding:6px 22px;">ENTRAR NO SUPORTE</a>
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>

