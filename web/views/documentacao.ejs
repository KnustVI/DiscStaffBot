                        { name: 'getattr', locked: true, descPt: 'Consulta um atributo específico.', descEn: 'Looks up a specific attribute.', opts: 'usuario/agid, atributo' },
                        { name: 'getallattr', locked: true, descPt: 'Consulta todos os atributos do jogador.', descEn: "Looks up all of the player's attributes.", opts: 'usuario/agid' },
                        { name: 'rewardgrowth / rewardwellrested', descPt: 'Recompensa crescimento/descanso.', descEn: 'Rewards growth/rest.', opts: 'usuario/agid, valor' },
                        { name: 'clearcooldowns', descPt: 'Limpa os cooldowns do jogador.', descEn: "Clears the player's cooldowns." },
                    ],
                }) %>
            </div>
        </section>

        <!-- ===================== AJUDA & SUPORTE ===================== -->
        <section id="ajuda-suporte">
            <div class="docs-cat-header">
                <h2 class="section-title docs-cat-title"><span data-i18n-pt>Ajuda & Suporte</span><span data-i18n-en>Help & Support</span></h2>
                <p class="docs-cat-desc"><%- t('Guia interativo dentro do próprio Discord, status do bot, e como falar com a gente.', 'An interactive guide right inside Discord, bot status, and how to reach us.') %></p>
            </div>
            <div class="docs-cat-body">
                <%- cmdCard({
                    id: 'ajuda', name: 'ajuda', permPt: 'Todos', permEn: 'Everyone',
                    descPt: 'Guia interativo do bot, navegado por menu — mostra um conteúdo mais completo (configuração/moderação/sistemas do servidor) pra quem é Administrador, e uma versão enxuta pra membros comuns.',
                    descEn: "An interactive, menu-driven bot guide — shows fuller content (configuration/moderation/server systems) for Administrators, and a lighter version for regular members.",
                }) %>
                <%- cmdCard({
                    id: 'botstatus', name: 'botstatus', permPt: 'Administrador', permEn: 'Administrator',
                    descPt: 'Painel de saúde do bot: uptime e ping sempre visíveis; a partir do plano Caçador, também mostra estatísticas do servidor (punições, reputação média, status do AutoMod).',
                    descEn: "The bot's health panel: uptime and ping always visible; from the Hunter plan onward, it also shows server stats (punishments, average reputation, AutoMod status).",
                }) %>
                <%- cmdCard({
                    id: 'feedback', name: 'feedback', permPt: 'Todos', permEn: 'Everyone',
                    descPt: 'Envia uma sugestão ou relato de bug direto pro desenvolvedor do bot.',
                    descEn: "Sends a suggestion or bug report straight to the bot's developer.",
                    opts: [
                        { name: 'tipo', type: 'Escolha', req: true, descPt: 'Sugerir Melhoria ou Reportar Bug/Erro.', descEn: 'Suggest an Improvement or Report a Bug/Error.' },
                        { name: 'mensagem', type: 'Texto', req: true, descPt: '', descEn: '' },
                    ],
                }) %>
                <div class="docs-callout">
                    <p style="font-family:'Poppins',sans-serif; font-size:14px; margin:0; opacity:0.9;"><%- t('Precisa de ajuda que não está aqui? Entre no nosso servidor de suporte.', "Need help with something not covered here? Join our support server.") %></p>
                    <div class="docs-footer-links">
                        <a href="https://discord.gg/fkD5FQktn6" target="_blank" rel="noopener" class="nav-btn" style="height:36px; padding:6px 22px;"><span data-i18n-pt>ENTRAR NO SUPORTE</span><span data-i18n-en>JOIN SUPPORT</span></a>
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>

