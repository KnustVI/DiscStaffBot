                        { name: 'weather', descPt: 'Muda o clima do servidor.', descEn: "Changes the server's weather.", opts: 'tipo' },
                        { name: 'timeofday', descPt: 'Muda a hora do dia.', descEn: 'Changes the time of day.', opts: 'hora' },
                        { name: 'waterquality', descPt: 'Ajusta a qualidade da água de uma área.', descEn: "Adjusts an area's water quality.", opts: 'tag, porcentagem' },
                        { name: 'waystonecooldown', descPt: 'Ajusta o cooldown de um waystone.', descEn: "Adjusts a waystone's cooldown.", opts: 'tag, porcentagem' },
                        { name: 'clearcreatorobjects / resetcreatormode / replenishcreatormode', descPt: 'Limpa/reseta/reabastece o modo criador.', descEn: 'Clears/resets/replenishes creator mode.' },
                        { name: 'loadcreatormode / savecreatormode / removecreatormode', descPt: 'Carrega/salva/remove um save do modo criador.', descEn: 'Loads/saves/removes a creator mode save.', opts: 'nome' },
                    ],
                }) %>
                <%- rconCmdCard({
                    id: 'ingame-marks', name: 'ingame-marks',
                    descPt: 'Comandos de marcas (pontos de dano/prestígio no jogo).',
                    descEn: "Marks commands (in-game damage/prestige points).",
                    subs: [
                        { name: 'setmarks', descPt: 'Define um valor absoluto de marcas.', descEn: 'Sets an absolute marks value.', opts: 'usuario/agid, numero' },
                        { name: 'addmarks / removemarks', descPt: 'Adiciona/remove marcas do jogador.', descEn: "Adds/removes marks from the player.", opts: 'usuario/agid, numero' },
                        { name: 'addmarksall', locked: true, descPt: 'Adiciona marcas para todo mundo online.', descEn: 'Adds marks for everyone online.', opts: 'numero' },
                    ],
                }) %>
                <%- rconCmdCard({
                    id: 'ingame-message', name: 'ingame-message',
                    descPt: 'Comandos de mensagens/anúncios in-game.',
                    descEn: 'In-game message/announcement commands.',
                    subs: [
                        { name: 'systemmessage', descPt: 'Envia uma mensagem de sistema pra um jogador.', descEn: 'Sends a system message to a player.', opts: 'usuario/agid, mensagem' },
                        { name: 'whisper', descPt: 'Sussurra uma mensagem privada pra um jogador.', descEn: 'Whispers a private message to a player.', opts: 'usuario/agid, mensagem' },
                        { name: 'systemmessageall', descPt: 'Mensagem de sistema pra todos.', descEn: 'System message to everyone.', opts: 'mensagem' },
                        { name: 'announce', descPt: 'Anúncio pra todos.', descEn: 'Announcement to everyone.', opts: 'mensagem' },
                    ],
                }) %>
                <%- rconCmdCard({
                    id: 'ingame-stats', name: 'ingame-stats',
                    descPt: 'Comandos de atributos/status do dinossauro ("Change Stats").',
                    descEn: 'Dinosaur attribute/status commands ("Change Stats").',
                    subs: [
                        { name: 'heal', descPt: 'Cura o jogador (vazio = você mesmo).', descEn: 'Heals the player (empty = yourself).', opts: 'usuario/agid' },
                        { name: 'healall', locked: true, descPt: 'Cura todo mundo online.', descEn: 'Heals everyone online.' },
                        { name: 'godmode', locked: true, descPt: 'Ativa/desativa o modo deus.', descEn: 'Toggles god mode.', opts: 'usuario/agid' },
                        { name: 'setattr', descPt: 'Define um atributo específico.', descEn: 'Sets a specific attribute.', opts: 'usuario/agid, atributo, valor' },
