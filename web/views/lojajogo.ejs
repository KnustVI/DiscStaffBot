<%#
  web/views/lojajogo.ejs
  Loja de Jogo — reforma 2026-08-16 (pedido do dono: "a configuração
  atual de preço não esta muito boa... gostaria que a configuração de
  preços trabalhasse de forma parecida com a configuração de
  emblemas/titulos que eu, desenvolvedor, tenho"). Substitui o catálogo
  fixo de 6 itens (era só liga/preço/espécie por item hardcoded) por
  criação LIVRE de item pelo admin de CADA servidor, espelhando a UX de
  /dev/Loja (dialog de criação + grade de cards com Público/Em breve/
  Excluir) — ver gameShopSystem.js#createShopItem/listShopItems e
  dashboard.js GET/POST /lojajogo/:guildID.

  Migração automática (mesmo pedido, confirmado explicitamente): itens
  do catálogo fixo antigo que já estavam ligados com preço configurado
  viram itens novos equivalentes sozinhos, na 1ª vez que esta página é
  aberta pra cada servidor — ver gameShopSystem.js#migrateLegacyItemsForGuild,
  chamada em GET /lojajogo/:guildID antes de montar `shopItems`.

  Exclusão é LÓGICA (pedido explícito do dono: item excluído continua
  funcionando pra quem já comprou e não usou) — o botão "Excluir" some
  o item desta lista, mas nunca apaga a linha de verdade.

  GET exige isStaff (view-only pra quem não é admin, mesmo padrão de
  gameserver.ejs — travado de verdade por web/public/js/dashboard-view-only-lock.js,
  que desabilita todo form[method=POST] quando data-view-only="true").
  POST exige isAdmin. O dono acessa QUALQUER servidor via bypass em
  dashboard.js (isOwnerSession), mesmo sem ser membro lá.

  Uso: res.render('lojajogo', { guild, nickname, role, isAdmin, isOwner,
    pageRoute, otherGuilds, showAvatarHint, shopItems, knownSpecies,
    actionTypes, rconEnabled, saved }) — ver dashboard.js GET
    /lojajogo/:guildID pra lista completa de locals.
%>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loja de Jogo | <%= bot.user.username %></title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Tilt+Warp&family=Bebas+Neue&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'titan-bg': '#0D0D0D',
                        'titan-accent': '#803E30',
                        'titan-cream': '#F8DCC0',
                        'titan-gold': '#D9A362',
                    }
                }
            }
        }
    </script>
    <style>
        .lj-species-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            max-height: 220px;
            overflow-y: auto;
            padding: 12px;
            background: rgba(0, 0, 0, 0.25);
            border: 1px solid rgba(128, 62, 48, 0.4);
            border-radius: 12px;
        }
        .lj-species-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: #2A2A2A;
            border: 1px solid #803E30;
            border-radius: 20px;
            font-size: 13px;
            cursor: pointer;
            user-select: none;
        }
        .lj-species-chip input { accent-color: #DCA15E; }
        .lj-species-chip:has(input:checked) { background: #4B2427; border-color: #DCA15E; }

        <%# Grade de itens criados — mesmas classes .pool-* de dev-lojas.ejs
            (CSS de página não é compartilhado neste projeto, duplicado
            aqui igual lá faz com a própria). %>
        .pool-grid { display: flex; flex-wrap: wrap; gap: 16px; }
        .pool-item {
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            gap: 8px;
            width: 220px;
            padding: 12px;
            background: #131314;
            border: 1px solid rgba(217, 163, 98, 0.25);
            border-radius: 10px;
        }
        .pool-item-thumb {
            width: 100%;
            aspect-ratio: 4 / 3;
            border-radius: 8px;
            background-color: #1F1D20;
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #DCA15E;
        }
        .pool-item-thumb svg { width: 32px; height: 32px; opacity: 0.6; }
        .pool-item-label {
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 0.85rem;
            color: #F8DCC0;
        }
        .pool-item-desc {
            font-size: 0.72rem;
            opacity: 0.6;
            line-height: 1.4;
        }
        .pool-item-meta { font-size: 0.7rem; opacity: 0.5; }
        .pool-item-badge {
            display: inline-flex;
            align-self: flex-start;
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 2px 8px;
            border-radius: 20px;
        }
        .pool-item-badge.is-public { background: rgba(165, 255, 161, 0.15); color: #A5FFA1; }
        .pool-item-badge.is-private { background: rgba(255, 78, 59, 0.15); color: #FF4E3B; }
        .pool-item-badge.is-coming-soon { background: rgba(217, 163, 98, 0.18); color: #DCA15E; }
        .pool-item-badges { display: flex; gap: 6px; flex-wrap: wrap; }
        .pool-item-actions { display: flex; flex-direction: column; gap: 6px; margin-top: auto; }
        .pool-toggle-btn, .pool-delete-btn {
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 0.75rem;
            width: 100%;
            padding: 6px 10px;
            border-radius: 8px;
            border: 1px solid rgba(248, 220, 192, 0.25);
            background: transparent;
            color: #F8DCC0;
            cursor: pointer;
            transition: background 0.15s ease, border-color 0.15s ease;
        }
        .pool-toggle-btn:hover { background: rgba(248, 220, 192, 0.1); }
        .pool-delete-btn { border-color: rgba(255, 78, 59, 0.3); color: #FF4E3B; }
        .pool-delete-btn:hover { background: rgba(255, 78, 59, 0.12); }

        <%# Botão "Criar item" + dialog nativo — mesmo padrão de overlay
            de partials/requirement-form.ejs (top layer do navegador,
            centraliza/empilha sozinho, fecha com Esc/clique fora de
            graça). %>
        .lj-create-btn {
            align-self: flex-start;
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 0.85rem;
            padding: 10px 18px;
            border-radius: 10px;
            border: none;
            background: #DCA15E;
            color: #131314;
            cursor: pointer;
            transition: background 0.15s ease;
        }
        .lj-create-btn:hover { background: #F8DCC0; }
        dialog.lj-item-dialog {
            background: #1A1A1A;
            color: #F8DCC0;
            border: 1px solid rgba(217, 163, 98, 0.35);
            border-radius: 14px;
            padding: 20px;
            width: calc(100% - 32px);
            max-width: 460px;
            max-height: calc(100vh - 64px);
            overflow-y: auto;
        }
        dialog.lj-item-dialog::backdrop { background: rgba(0, 0, 0, 0.65); }
        .lj-dialog-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px; }
        .lj-dialog-head h3 { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 1rem; margin: 0; color: #F8DCC0; }
        .lj-dialog-close {
            flex: none;
            width: 26px;
            height: 26px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            border: 1px solid rgba(217, 163, 98, 0.3);
            border-radius: 6px;
            color: #F8DCC0;
            opacity: 0.7;
            cursor: pointer;
            font-size: 1rem;
            line-height: 1;
        }
        .lj-dialog-close:hover { opacity: 1; background: rgba(217, 163, 98, 0.12); }
        .lj-dialog-actions { display: flex; gap: 8px; margin-top: 8px; }
        .lj-dialog-actions .pool-toggle-btn { width: auto; flex: none; padding-left: 14px; padding-right: 14px; }
        .lj-dialog-actions .lj-create-btn { flex: 1; }
        .lj-field-group { display: flex; flex-direction: column; gap: 14px; }
        .lj-select-premium {
            width: 100%;
            background: #1F1D20;
            border: 1px solid rgba(217, 163, 98, 0.3);
            border-radius: 8px;
            padding: 8px 10px;
            color: #F8DCC0;
            font-family: 'Poppins', sans-serif;
            font-size: 0.85rem;
        }
        .lj-item-dialog input[type="file"] {
            color: #F8DCC0;
            font-family: 'Poppins', sans-serif;
            font-size: 0.8rem;
        }
        .lj-item-dialog input[type="file"]::file-selector-button {
            margin-right: 10px;
            padding: 6px 12px;
            border: none;
            border-radius: 6px;
            background: #DCA15E;
            color: #131314;
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 0.75rem;
            cursor: pointer;
        }
    </style>
</head>
<body class="flex min-h-screen"<%- (typeof isAdmin !== 'undefined' && !isAdmin) ? ' data-view-only="true"' : '' %>>
    <%# Barra de navegação de topo — acompanha a sidebar em toda página
        (pedido do dono, 2026-08-13, ver partials/top-nav.ejs). %>
    <%- include('partials/top-nav', { hideOnScroll: true, reserveSpace: true }) %>

    <aside class="shrink-0 h-screen sticky top-0 py-[15px] pl-[15px] lg:py-[30px] lg:pl-[30px]">
        <%- include('partials/sidebar-v2', { active: 'lojajogo', guild, nickname, role, isOwner, showAvatarHint }) %>
    </aside>

    <main class="flex-1 w-full flex flex-col p-[15px] gap-[20px] lg:p-[30px] lg:gap-[30px]">

        <%- include('partials/page-header', { guild, pageLabel: 'LOJA DE JOGO', pageLabelEn: 'GAME SHOP', pageRoute, otherGuilds }) %>

        <%- include('partials/save-result-overlay', { saved }) %>

        <%- include('partials/view-only-banner', { isAdmin, role }) %>

        <div class="titan-card-premium flex-col gap-4">
            <h2 class="section-title text-lg"><span data-i18n-pt>LOJA DE JOGO</span><span data-i18n-en>GAME SHOP</span></h2>
            <p class="text-[13px] opacity-50">
                <span data-i18n-pt>Crie os itens que os jogadores deste servidor podem comprar com Ossos — nome, descrição, imagem, ação em jogo, preço, estoque e quais dinossauros podem usar são todos escolhidos por você.</span>
                <span data-i18n-en>Create the items players on this server can buy with Bones — name, description, image, in-game action, price, stock and which dinosaurs can use it are all up to you.</span>
            </p>
            <p class="text-[13px] opacity-50">
                <span data-i18n-pt>São itens consumíveis: cada compra vale por 1 uso e some do inventário do jogador assim que ele usar. Excluir um item aqui não afeta quem já comprou e ainda não usou — o item continua funcionando pra essas pessoas.</span>
                <span data-i18n-en>These are consumable items: each purchase is good for 1 use and disappears from the player's inventory once used. Deleting an item here doesn't affect players who already bought it and haven't used it yet — it keeps working for them.</span>
            </p>
            <% if (!rconEnabled) { %>
                <div class="outline-chip">
                    <i data-lucide="triangle-alert" class="outline-chip-icon" style="color:#F8DCC0;"></i>
                    <div class="outline-chip-text">
                        <span class="outline-chip-headline"><span data-i18n-pt>Este servidor não está no plano Caçador</span><span data-i18n-en>This server isn't on the Caçador plan</span></span>
                        <span class="outline-chip-subtitle"><span data-i18n-pt>Itens criados aqui não podem ser comprados nem usados até o servidor ter o tier Caçador — a Loja de Jogo depende do mesmo RCON liberado só nesse plano.</span><span data-i18n-en>Items created here can't be bought or used until this server has the Caçador tier — the Game Shop depends on the same RCON only unlocked at that plan.</span></span>
                    </div>
                </div>
            <% } %>
            <button type="button" class="lj-create-btn" onclick="document.getElementById('ljCreateDialog').showModal()"><span data-i18n-pt>+ Criar item</span><span data-i18n-en>+ Create item</span></button>
        </div>

        <dialog id="ljCreateDialog" class="lj-item-dialog">
            <form action="/lojajogo/<%= guild.id %>/criar" method="POST" enctype="multipart/form-data" class="lj-field-group" onsubmit="setTimeout(() => document.getElementById('ljCreateDialog').close(), 0)">
                <div class="lj-dialog-head">
                    <h3><span data-i18n-pt>Criar item</span><span data-i18n-en>Create item</span></h3>
                    <button type="button" class="lj-dialog-close" onclick="this.closest('dialog').close()" aria-label="Fechar">&times;</button>
                </div>

                <div>
                    <label class="text-[13px] opacity-60"><span data-i18n-pt>Nome</span><span data-i18n-en>Name</span></label>
                    <div class="input-container-premium">
                        <div class="icon-box"><i data-lucide="tag"></i></div>
                        <input type="text" class="input-premium-field" name="name" maxlength="100" required placeholder="Ex: Poção de Crescimento">
                    </div>
                </div>

                <div>
                    <label class="text-[13px] opacity-60"><span data-i18n-pt>Descrição</span><span data-i18n-en>Description</span></label>
                    <%#
                        BUG REAL corrigido (pedido do dono, 2026-08-19: "Campo
                        de descrição no overlay de criação esta da mesma cor
                        do cardo... deixe ele como os outros campos") — o
                        fundo/borda de .input-premium-field vêm do
                        .input-container-premium que o envolve
                        (background:#131314, borda dourada — ver style.css);
                        sozinho, .input-premium-field é
                        background:transparent/border:none, então este
                        textarea (único campo do dialog sem o wrapper) ficava
                        visualmente idêntico ao fundo do card por trás. Mesmo
                        padrão já usado pra textarea em reports.ejs
                        (.input-container-premium.has-textarea + .icon-box).
                    %>
                    <div class="input-container-premium has-textarea">
                        <div class="icon-box"><i data-lucide="align-left"></i></div>
                        <textarea class="input-premium-field" name="description" maxlength="500" required placeholder="Ex: Aumenta o crescimento do seu dinossauro atual."></textarea>
                    </div>
                </div>

                <div>
                    <label class="text-[13px] opacity-60"><span data-i18n-pt>Imagem (opcional, máx. 250×250)</span><span data-i18n-en>Image (optional, max. 250×250)</span></label>
                    <input type="file" name="imagem" accept="image/png,image/jpeg,image/webp">
                    <p class="text-[11px] opacity-40 mt-1"><span data-i18n-pt>Em branco, usa um ícone padrão de acordo com o tipo de ação.</span><span data-i18n-en>Left blank, uses a default icon based on the action type.</span></p>
                </div>

                <div>
                    <label class="text-[13px] opacity-60"><span data-i18n-pt>Ação em jogo</span><span data-i18n-en>In-game action</span></label>
                    <select class="lj-select-premium" name="action_type" id="ljActionType" onchange="ljItemFormSync()">
                        <option value="growth" data-needs-growth="1">Growth (crescer o dinossauro)</option>
                        <option value="skipshed">Skipshed</option>
                        <option value="teleport" data-needs-teleport="1">Teleporte (mapa + coordenadas)</option>
                    </select>
                </div>

                <div id="ljGrowthField">
                    <label class="text-[13px] opacity-60"><span data-i18n-pt>Etapa de crescimento</span><span data-i18n-en>Growth stage</span></label>
                    <select class="lj-select-premium" name="growth_stage">
                        <option value="juvenil" data-i18n-opt-pt="Juvenil (25%)" data-i18n-opt-en="Juvenile (25%)">Juvenil (25%)</option>
                        <option value="adolescente" data-i18n-opt-pt="Adolescente (50%)" data-i18n-opt-en="Adolescent (50%)">Adolescente (50%)</option>
                        <option value="subadulto" data-i18n-opt-pt="Subadulto (75%)" data-i18n-opt-en="Subadult (75%)">Subadulto (75%)</option>
                        <option value="adulto" data-i18n-opt-pt="Adulto (100%)" data-i18n-opt-en="Adult (100%)">Adulto (100%)</option>
                    </select>
                </div>

                <div id="ljTeleportFields" style="display:none;">
                    <label class="text-[13px] opacity-60"><span data-i18n-pt>Mapa</span><span data-i18n-en>Map</span></label>
                    <div class="input-container-premium">
                        <div class="icon-box"><i data-lucide="map"></i></div>
                        <input type="text" class="input-premium-field" name="map" maxlength="100" placeholder="Ex: Gondwa">
                    </div>
                    <label class="text-[13px] opacity-60 mt-2 block"><span data-i18n-pt>Coordenadas</span><span data-i18n-en>Coordinates</span></label>
                    <div class="input-container-premium">
                        <div class="icon-box"><i data-lucide="map-pin"></i></div>
                        <input type="text" class="input-premium-field" name="coords" maxlength="200" placeholder="Ex: X=1234 Y=5678 Z=90">
                    </div>
                    <%#
                        Instrução mais explícita (pedido do dono, 2026-08-19:
                        "acabado do campo de coordenadas instrua o
                        administrador a pegar a coordenada no mapa usando
                        /mapbug em jogo no local que deve ser feito o
                        teleporte") — antes só dizia "cole a posição copiada
                        com /mapbug", sem deixar claro que é preciso IR ATÉ O
                        LOCAL de destino em jogo primeiro, e rodar o comando
                        lá (não em qualquer lugar).
                    %>
                    <p class="text-[11px] opacity-40 mt-1"><span data-i18n-pt>Vá até o local exato em jogo pra onde os jogadores devem ser teleportados, use <code>/mapbug</code> lá pra pegar a coordenada, e cole o resultado aqui. Só funciona pra quem estiver jogando no mapa informado acima.</span><span data-i18n-en>Go to the exact spot in-game where players should be teleported to, use <code>/mapbug</code> there to get the coordinate, and paste the result here. Only works for players on the map named above.</span></p>
                </div>

                <div>
                    <label class="text-[13px] opacity-60"><span data-i18n-pt>Preço (Ossos)</span><span data-i18n-en>Price (Bones)</span></label>
                    <div class="input-container-premium">
                        <div class="icon-box"><i data-lucide="bone"></i></div>
                        <input type="number" class="input-premium-field" name="price" min="1" step="1" required placeholder="Ex: 100">
                    </div>
                </div>

                <%#
                    BUG REAL corrigido (pedido do dono, 2026-08-19: "Existe
                    um pequeno conflito na seleção de stoque dos itens de
                    loja de jogo, onde não esta sendo possivel definir como
                    estoque infinito") — o campo de quantidade já aceitava
                    "em branco = ilimitado" por baixo (ver gameShopSystem.js
                    createShopItem), mas não existia NENHUMA affordance
                    explícita pra isso: nada impedia o campo de ficar com um
                    valor residual (autofill, engano) sem o admin perceber
                    que aquilo virava estoque LIMITADO, e não havia como
                    "confirmar" a intenção de infinito além de simplesmente
                    não tocar no campo. Agora um <select> decide o modo
                    primeiro (ljStockModeSync, ver <script> abaixo) — o
                    campo de quantidade só aparece E só é `required` no modo
                    "Limitado"; no modo "Infinito" ele fica escondido e é
                    limpo/sem required, garantindo que sempre submete em
                    branco (null no banco = ilimitado, sem ambiguidade).
                %>
                <div>
                    <label class="text-[13px] opacity-60"><span data-i18n-pt>Estoque</span><span data-i18n-en>Stock</span></label>
                    <select class="lj-select-premium" id="ljStockMode" onchange="ljStockModeSync('ljStockMode', 'ljStockLimitField', 'ljStockLimitInput')">
                        <option value="unlimited" data-i18n-opt-pt="Infinito" data-i18n-opt-en="Unlimited">Infinito</option>
                        <option value="limited" data-i18n-opt-pt="Limitado" data-i18n-opt-en="Limited">Limitado</option>
                    </select>
                </div>
                <div id="ljStockLimitField" style="display:none;">
                    <label class="text-[13px] opacity-60"><span data-i18n-pt>Quantidade disponível</span><span data-i18n-en>Available quantity</span></label>
                    <div class="input-container-premium">
                        <div class="icon-box"><i data-lucide="package"></i></div>
                        <input type="number" class="input-premium-field" name="stock_limit" id="ljStockLimitInput" min="1" step="1" placeholder="Ex: 20">
                    </div>
                </div>

                <div>
                    <label class="text-[13px] opacity-60 mb-2 block"><span data-i18n-pt>Dinossauros que podem usar (nenhum marcado = todos liberados)</span><span data-i18n-en>Dinosaurs that can use it (none checked = all allowed)</span></label>
                    <% if (knownSpecies.length === 0) { %>
                        <p class="text-[13px] opacity-40"><span data-i18n-pt>Nenhuma espécie registrada ainda neste servidor — assim que um jogador entrar no jogo com um dinossauro, ele aparece aqui.</span><span data-i18n-en>No species registered on this server yet — as soon as a player spawns as one, it shows up here.</span></p>
                    <% } else { %>
                        <div class="lj-species-grid">
                            <% knownSpecies.forEach(species => { %>
                                <label class="lj-species-chip">
                                    <input type="checkbox" name="species" value="<%= species %>">
                                    <%= species %>
                                </label>
                            <% }); %>
                        </div>
                    <% } %>
                </div>

                <div class="lj-dialog-actions">
                    <button type="button" class="pool-toggle-btn" onclick="this.closest('dialog').close()"><span data-i18n-pt>Cancelar</span><span data-i18n-en>Cancel</span></button>
                    <button type="submit" class="lj-create-btn"><span data-i18n-pt>Criar item</span><span data-i18n-en>Create item</span></button>
                </div>
            </form>
        </dialog>

        <%#
            Dialog de edição (pedido do dono, 2026-08-18: "adicione o botão
            editar item também para os itens criados") — UM único dialog
            compartilhado por todos os cards (em vez de um dialog por item,
            que multiplicaria o HTML por N itens à toa), populado via JS
            (ljOpenEditDialog, fim da página) a partir do <script
            type="application/json" class="lj-item-data"> de cada card. Mesmo
            campo por campo do dialog de criação acima, EXCETO o seletor de
            "Ação em jogo": aqui vira um rótulo fixo (não dá pra trocar o tipo
            de um item já criado, ver updateShopItem em gameShopSystem.js) e
            só a sub-seção (Growth ou Teleporte) do tipo já existente do item
            é mostrada.
        %>
        <dialog id="ljEditDialog" class="lj-item-dialog">
            <form id="ljEditForm" method="POST" enctype="multipart/form-data" class="lj-field-group" onsubmit="setTimeout(() => document.getElementById('ljEditDialog').close(), 0)">
                <div class="lj-dialog-head">
                    <h3><span data-i18n-pt>Editar item</span><span data-i18n-en>Edit item</span></h3>
                    <button type="button" class="lj-dialog-close" onclick="this.closest('dialog').close()" aria-label="Fechar">&times;</button>
                </div>

                <div>
                    <label class="text-[13px] opacity-60"><span data-i18n-pt>Nome</span><span data-i18n-en>Name</span></label>
                    <div class="input-container-premium">
                        <div class="icon-box"><i data-lucide="tag"></i></div>
                        <input type="text" class="input-premium-field" name="name" id="ljEditName" maxlength="100" required>
                    </div>
                </div>

                <div>
                    <label class="text-[13px] opacity-60"><span data-i18n-pt>Descrição</span><span data-i18n-en>Description</span></label>
                    <div class="input-container-premium has-textarea">
                        <div class="icon-box"><i data-lucide="align-left"></i></div>
                        <textarea class="input-premium-field" name="description" id="ljEditDescription" maxlength="500" required></textarea>
                    </div>
                </div>

                <div>
                    <label class="text-[13px] opacity-60"><span data-i18n-pt>Imagem (opcional, máx. 250×250)</span><span data-i18n-en>Image (optional, max. 250×250)</span></label>
                    <input type="file" name="imagem" accept="image/png,image/jpeg,image/webp">
                    <p class="text-[11px] opacity-40 mt-1"><span data-i18n-pt>Deixe em branco pra manter a imagem atual.</span><span data-i18n-en>Leave blank to keep the current image.</span></p>
                </div>

                <div>
                    <label class="text-[13px] opacity-60"><span data-i18n-pt>Ação em jogo</span><span data-i18n-en>In-game action</span></label>
                    <p class="text-[13px] opacity-80" id="ljEditActionTypeLabel"></p>
                    <p class="text-[11px] opacity-40 mt-1"><span data-i18n-pt>O tipo de ação não pode ser alterado depois de criado — crie um item novo se precisar de outro tipo.</span><span data-i18n-en>The action type can't be changed after creation — create a new item if you need a different type.</span></p>
                </div>

                <div id="ljEditGrowthField">
                    <label class="text-[13px] opacity-60"><span data-i18n-pt>Etapa de crescimento</span><span data-i18n-en>Growth stage</span></label>
                    <select class="lj-select-premium" name="growth_stage" id="ljEditGrowthStage">
                        <option value="juvenil" data-i18n-opt-pt="Juvenil (25%)" data-i18n-opt-en="Juvenile (25%)">Juvenil (25%)</option>
                        <option value="adolescente" data-i18n-opt-pt="Adolescente (50%)" data-i18n-opt-en="Adolescent (50%)">Adolescente (50%)</option>
                        <option value="subadulto" data-i18n-opt-pt="Subadulto (75%)" data-i18n-opt-en="Subadult (75%)">Subadulto (75%)</option>
                        <option value="adulto" data-i18n-opt-pt="Adulto (100%)" data-i18n-opt-en="Adult (100%)">Adulto (100%)</option>
                    </select>
                </div>

                <div id="ljEditTeleportFields">
                    <label class="text-[13px] opacity-60"><span data-i18n-pt>Mapa</span><span data-i18n-en>Map</span></label>
                    <div class="input-container-premium">
                        <div class="icon-box"><i data-lucide="map"></i></div>
                        <input type="text" class="input-premium-field" name="map" id="ljEditMap" maxlength="100">
                    </div>
                    <label class="text-[13px] opacity-60 mt-2 block"><span data-i18n-pt>Coordenadas</span><span data-i18n-en>Coordinates</span></label>
                    <div class="input-container-premium">
                        <div class="icon-box"><i data-lucide="map-pin"></i></div>
                        <input type="text" class="input-premium-field" name="coords" id="ljEditCoords" maxlength="200">
                    </div>
                    <p class="text-[11px] opacity-40 mt-1"><span data-i18n-pt>Vá até o local exato em jogo pra onde os jogadores devem ser teleportados, use <code>/mapbug</code> lá pra pegar a coordenada, e cole o resultado aqui. Só funciona pra quem estiver jogando no mapa informado acima.</span><span data-i18n-en>Go to the exact spot in-game where players should be teleported to, use <code>/mapbug</code> there to get the coordinate, and paste the result here. Only works for players on the map named above.</span></p>
                </div>

                <div>
                    <label class="text-[13px] opacity-60"><span data-i18n-pt>Preço (Ossos)</span><span data-i18n-en>Price (Bones)</span></label>
                    <div class="input-container-premium">
                        <div class="icon-box"><i data-lucide="bone"></i></div>
                        <input type="number" class="input-premium-field" name="price" id="ljEditPrice" min="1" step="1" required>
                    </div>
                </div>

                <div>
                    <%#
                        BUG REAL corrigido (pedido do dono, 2026-08-19: "Quando
                        item chega a stoque 0, não é possivel recolocar o
                        estoque no botão editar"). Antes este campo mostrava/
                        editava stock_limit (o total histórico configurado na
                        criação — nunca muda sozinho), mas o card do item
                        mostra "Estoque: X" com o RESTANTE (stock_limit -
                        stock_sold). Um admin vendo "Estoque: 0" no card e
                        tentando reabastecer não tinha como saber que precisava
                        somar o stock_sold (nunca exibido em lugar nenhum) ao
                        número que queria digitar — só reeditar com o MESMO
                        valor de antes (ou qualquer valor menor que o já
                        vendido) continuava dando 0, parecendo "impossível
                        reabastecer". Agora este campo edita o RESTANTE
                        diretamente (mesmo número do card) — updateShopItem
                        recalcula stock_limit por baixo (stock_sold +
                        valor digitado aqui), sem tocar em stock_sold (histórico
                        de vendas reais, nunca deve ser apagado).
                    %>
                    <label class="text-[13px] opacity-60"><span data-i18n-pt>Estoque</span><span data-i18n-en>Stock</span></label>
                    <select class="lj-select-premium" id="ljEditStockMode" onchange="ljStockModeSync('ljEditStockMode', 'ljEditStockLimitField', 'ljEditStockLimit')">
                        <option value="unlimited" data-i18n-opt-pt="Infinito" data-i18n-opt-en="Unlimited">Infinito</option>
                        <option value="limited" data-i18n-opt-pt="Limitado" data-i18n-opt-en="Limited">Limitado</option>
                    </select>
                </div>
                <div id="ljEditStockLimitField">
                    <label class="text-[13px] opacity-60"><span data-i18n-pt>Quantidade disponível agora</span><span data-i18n-en>Available quantity right now</span></label>
                    <div class="input-container-premium">
                        <div class="icon-box"><i data-lucide="package"></i></div>
                        <input type="number" class="input-premium-field" name="stock_limit" id="ljEditStockLimit" min="1" step="1">
                    </div>
                    <p class="text-[11px] opacity-40 mt-1"><span data-i18n-pt>Mesmo número mostrado como "Estoque" no card — aumente pra reabastecer.</span><span data-i18n-en>Same number shown as "Stock" on the card — increase it to restock.</span></p>
                </div>

                <div>
                    <label class="text-[13px] opacity-60 mb-2 block"><span data-i18n-pt>Dinossauros que podem usar (nenhum marcado = todos liberados)</span><span data-i18n-en>Dinosaurs that can use it (none checked = all allowed)</span></label>
                    <% if (knownSpecies.length === 0) { %>
                        <p class="text-[13px] opacity-40"><span data-i18n-pt>Nenhuma espécie registrada ainda neste servidor.</span><span data-i18n-en>No species registered on this server yet.</span></p>
                    <% } else { %>
                        <div class="lj-species-grid">
                            <% knownSpecies.forEach(species => { %>
                                <label class="lj-species-chip">
                                    <input type="checkbox" class="lj-edit-species-checkbox" name="species" value="<%= species %>">
                                    <%= species %>
                                </label>
                            <% }); %>
                        </div>
                    <% } %>
                </div>

                <div class="lj-dialog-actions">
                    <button type="button" class="pool-toggle-btn" onclick="this.closest('dialog').close()"><span data-i18n-pt>Cancelar</span><span data-i18n-en>Cancel</span></button>
                    <button type="submit" class="lj-create-btn"><span data-i18n-pt>Salvar alterações</span><span data-i18n-en>Save changes</span></button>
                </div>
            </form>
        </dialog>

        <% if (shopItems.length === 0) { %>
            <p class="text-sm opacity-40"><span data-i18n-pt>Nenhum item criado ainda.</span><span data-i18n-en>No items created yet.</span></p>
        <% } else { %>
            <div class="pool-grid">
                <% const ljIcons = { growth: 'sprout', skipshed: 'refresh-cw', teleport: 'map-pin' }; %>
                <% shopItems.forEach(item => { %>
                    <div class="pool-item">
                        <div class="pool-item-thumb" style="<%= item.url ? `background-image:url('${item.url}')` : '' %>">
                            <% if (!item.url) { %><i data-lucide="<%= ljIcons[item.action_type] || 'store' %>"></i><% } %>
                        </div>
                        <span class="pool-item-label"><%= item.name %></span>
                        <span class="pool-item-desc"><%= item.description %></span>
                        <span class="pool-item-meta">
                            <span data-i18n-pt>Preço:</span><span data-i18n-en>Price:</span> <%= item.price %> <span data-i18n-pt>Ossos</span><span data-i18n-en>Bones</span>
                            · <span data-i18n-pt>Estoque:</span><span data-i18n-en>Stock:</span> <%= item.remainingStock === null ? '∞' : item.remainingStock %>
                        </span>
                        <% if (item.species && item.species.length > 0) { %>
                            <span class="pool-item-desc"><span data-i18n-pt>Restrito a:</span><span data-i18n-en>Restricted to:</span> <%= item.species.join(', ') %></span>
                        <% } %>
                        <div class="pool-item-badges">
                            <span class="pool-item-badge <%= item.is_public ? 'is-public' : 'is-private' %>"><%= item.is_public ? 'Público' : 'Privado' %></span>
                            <% if (item.coming_soon) { %><span class="pool-item-badge is-coming-soon">Em breve</span><% } %>
                        </div>
                        <div class="pool-item-actions">
                            <button type="button" class="pool-toggle-btn" onclick="ljOpenEditDialog(<%= item.id %>)"><span data-i18n-pt>Editar</span><span data-i18n-en>Edit</span></button>
                            <form action="/lojajogo/<%= guild.id %>/<%= item.id %>/toggle" method="POST">
                                <button type="submit" class="pool-toggle-btn"><%= item.is_public ? 'Tornar privado' : 'Tornar público' %></button>
                            </form>
                            <form action="/lojajogo/<%= guild.id %>/<%= item.id %>/toggle-coming-soon" method="POST">
                                <button type="submit" class="pool-toggle-btn"><%= item.coming_soon ? 'Tirar do "Em breve"' : 'Marcar "Em breve"' %></button>
                            </form>
                            <form action="/lojajogo/<%= guild.id %>/<%= item.id %>/excluir" method="POST" onsubmit="return confirm('Excluir \'<%= item.name.replace(/'/g, "") %>\' da loja? Quem já comprou e não usou continua podendo usar.');">
                                <button type="submit" class="pool-delete-btn"><span data-i18n-pt>Excluir</span><span data-i18n-en>Delete</span></button>
                            </form>
                        </div>
                        <%#
                            Dados do item pro dialog de edição (ver ljOpenEditDialog
                            no fim da página) — mesmo padrão de embutir JSON num
                            <script type="application/json"> já usado em
                            partials/role-picker.ejs, em vez de tentar encaixar
                            JSON.stringify dentro de um atributo onclick (aspas de
                            nome/descrição do item quebrariam o HTML). Escapa "<"
                            (mesmo replace de role-picker.ejs) pra um eventual
                            "</script" dentro de nome/descrição não fechar a tag
                            mais cedo.
                        %>
                        <script type="application/json" class="lj-item-data" data-item-id="<%= item.id %>"><%- JSON.stringify({
                            name: item.name,
                            description: item.description,
                            actionType: item.action_type,
                            actionConfig: item.actionConfig,
                            price: item.price,
                            remainingStock: item.remainingStock,
                            species: item.species,
                        }).replace(/</g, '\\u003c') %></script>
                    </div>
                <% }); %>
            </div>
        <% } %>

        <footer class="flex justify-end pb-2">
            <span class="bebas text-[12px] uppercase tracking-[6px] text-titan-cream opacity-10 hover:opacity-30 transition-opacity">
                BY: KNUST SEIER VI
            </span>
        </footer>
    </main>

    <script>
        function ljItemFormSync() {
            const select = document.getElementById('ljActionType');
            const option = select.options[select.selectedIndex];
            document.getElementById('ljGrowthField').style.display = option.dataset.needsGrowth === '1' ? '' : 'none';
            document.getElementById('ljTeleportFields').style.display = option.dataset.needsTeleport === '1' ? '' : 'none';
        }

        // Modo de estoque (Infinito/Limitado, pedido do dono 2026-08-19: ver
        // comentário completo no HTML acima) — mostra o campo de quantidade
        // e só o torna `required` no modo "Limitado"; no modo "Infinito" ele
        // fica escondido E é limpo (nunca deixa um valor residual ser
        // enviado por engano junto de "Infinito" selecionado). Reaproveitada
        // pelos 2 dialogs (criação/edição), só muda os 3 ids passados.
        function ljStockModeSync(selectId, wrapId, inputId) {
            const isLimited = document.getElementById(selectId).value === 'limited';
            document.getElementById(wrapId).style.display = isLimited ? '' : 'none';
            const input = document.getElementById(inputId);
            input.required = isLimited;
            if (!isLimited) input.value = '';
        }

        // Clique fora do conteúdo fecha o <dialog> (::backdrop não recebe
        // clique — compara a posição do clique com o retângulo real do
        // conteúdo, mesmo padrão de dev-lojas.ejs), e reseta o form ao
        // fechar (por qualquer motivo — Cancelar/X/fora/Esc) pra não
        // deixar campos preenchidos "fantasma" da última tentativa.
        (function () {
            const dialog = document.getElementById('ljCreateDialog');
            // form.reset() só volta os VALORES aos padrões do HTML (select
            // volta pra "Infinito") — não desfaz o display:none/required
            // que ljStockModeSync setou via JS enquanto o modo "Limitado"
            // esteve selecionado, então precisa resincronizar explicitamente
            // depois do reset, senão o campo de quantidade ficaria visível/
            // required "fantasma" na próxima abertura mesmo com "Infinito"
            // já selecionado de novo.
            dialog.addEventListener('close', () => {
                dialog.querySelector('form').reset();
                ljStockModeSync('ljStockMode', 'ljStockLimitField', 'ljStockLimitInput');
            });
            dialog.addEventListener('click', (e) => {
                const rect = dialog.getBoundingClientRect();
                const insideContent = e.clientY >= rect.top && e.clientY <= rect.bottom && e.clientX >= rect.left && e.clientX <= rect.right;
                if (!insideContent) dialog.close();
            });
        })();

        <%#
            Dialog de edição (ver comentário no HTML acima) — mesmo padrão de
            clique-fora-fecha do dialog de criação, SEM reset automático no
            close (diferente do de criação): o form é sempre repopulado do
            zero por ljOpenEditDialog a cada abertura, então resetar no close
            seria trabalho redundante, e resetar ANTES do close (ex: clique
            fora enquanto o admin ainda está editando) apagaria o que ele
            digitou sem necessidade nenhuma.
        %>
        (function () {
            const dialog = document.getElementById('ljEditDialog');
            dialog.addEventListener('click', (e) => {
                const rect = dialog.getBoundingClientRect();
                const insideContent = e.clientY >= rect.top && e.clientY <= rect.bottom && e.clientX >= rect.left && e.clientX <= rect.right;
                if (!insideContent) dialog.close();
            });
        })();

        const LJ_GUILD_ID = '<%= guild.id %>';
        const LJ_GROWTH_STAGE_VALUES = <%- JSON.stringify(growthStageValues) %>;
        const LJ_ACTION_LABELS = {
            growth: 'Growth (crescer o dinossauro)',
            skipshed: 'Skipshed',
            teleport: 'Teleporte (mapa + coordenadas)',
        };

        // Popula o dialog de edição com os dados do item clicado (lidos do
        // <script type="application/json" class="lj-item-data"> do próprio
        // card, ver comentário lá) e abre. itemId vem do onclick de cada
        // botão "Editar".
        function ljOpenEditDialog(itemId) {
            const dataEl = document.querySelector('.lj-item-data[data-item-id="' + itemId + '"]');
            if (!dataEl) return;
            const item = JSON.parse(dataEl.textContent);

            const form = document.getElementById('ljEditForm');
            form.action = '/lojajogo/' + LJ_GUILD_ID + '/' + itemId + '/editar';
            document.getElementById('ljEditName').value = item.name || '';
            document.getElementById('ljEditDescription').value = item.description || '';
            document.getElementById('ljEditPrice').value = item.price;
            document.getElementById('ljEditStockLimit').value = item.remainingStock === null || item.remainingStock === undefined ? '' : item.remainingStock;
            document.getElementById('ljEditStockMode').value = (item.remainingStock === null || item.remainingStock === undefined) ? 'unlimited' : 'limited';
            ljStockModeSync('ljEditStockMode', 'ljEditStockLimitField', 'ljEditStockLimit');

            document.getElementById('ljEditActionTypeLabel').textContent = LJ_ACTION_LABELS[item.actionType] || item.actionType;
            document.getElementById('ljEditGrowthField').style.display = item.actionType === 'growth' ? '' : 'none';
            document.getElementById('ljEditTeleportFields').style.display = item.actionType === 'teleport' ? '' : 'none';

            if (item.actionType === 'growth' && item.actionConfig) {
                const stageKey = Object.keys(LJ_GROWTH_STAGE_VALUES).find((k) => LJ_GROWTH_STAGE_VALUES[k] === item.actionConfig.growthValue);
                if (stageKey) document.getElementById('ljEditGrowthStage').value = stageKey;
            } else if (item.actionType === 'teleport' && item.actionConfig) {
                document.getElementById('ljEditMap').value = item.actionConfig.map || '';
                document.getElementById('ljEditCoords').value = item.actionConfig.coords || '';
            }

            document.querySelectorAll('.lj-edit-species-checkbox').forEach((cb) => {
                cb.checked = Array.isArray(item.species) && item.species.includes(cb.value);
            });

            document.getElementById('ljEditDialog').showModal();
        }

        if (window.lucide) window.lucide.createIcons();
    </script>
    <script src="/js/dashboard-view-only-lock.js"></script>
</body>
</html>
