<!-- ===================== FOOTER ===================== -->
<footer class="w-full flex flex-col items-center" style="background:#111111; padding: 30px 16px; gap: 10px;">
    <a href="/termos" class="opacity-70 hover:opacity-100 text-sm underline" style="font-family:'Poppins',sans-serif; font-weight:300; color:#F8DCC0;">
        <span data-i18n-pt>Termos de Serviço</span><span data-i18n-en>Terms of Service</span>
    </a>
    <% if (typeof isOwner !== 'undefined' && isOwner) { %>
        <!-- Só visível pra você (logado com o Discord do dono) — deixa
             forçar a versão internacional (Ko-fi) da página pra conferir
             visual/fluxo sem precisar estar de fato fora do Brasil. Não
             aparece pra nenhum outro visitante, logado ou não. -->
        <% if (regionOverride === 'intl') { %>
            <a href="/" class="opacity-70 hover:opacity-100 text-sm underline" style="font-family:'Poppins',sans-serif; font-weight:300; color:#DCA15E;">
                🔒 <span data-i18n-pt>Voltar pra versão Brasil (automática)</span><span data-i18n-en>Back to Brazil version (automatic)</span>
            </a>
        <% } else { %>
            <a href="/?preview_region=intl" class="opacity-70 hover:opacity-100 text-sm underline" style="font-family:'Poppins',sans-serif; font-weight:300; color:#DCA15E;">
                🔒 <span data-i18n-pt>Preview: versão internacional (Ko-fi)</span><span data-i18n-en>Preview: international version (Ko-fi)</span>
            </a>
        <% } %>
    <% } %>
    <span class="opacity-80 text-sm" style="font-family:'Poppins',sans-serif; font-weight:300;">BY: KNUST SEIER VI</span>
</footer>

<%#
  Overlay de Premium travado (pedido do dono, 2026-08-09) — clique em todo
  link "[data-premium-locked]" (Ko-fi + botões "Adquirir ... Premium", ver
  pricingCta()/acquireSectionButton()) é interceptado (JS abaixo) e mostra
  isto por cima da página em vez de navegar. Compra de Premium continua
  travada de propósito (fase de testes) — diferente do Dashboard, que foi
  destravado pra todo mundo em 2026-08-10 (ver comentário na nav, topo do
  arquivo).
%>
<div class="dev-overlay" id="premiumLockedOverlay" hidden>
    <%- include('partials/premium-locked-overlay') %>
</div>

<%#
  Overlay maior ao clicar num anúncio de parceiro (pedido do dono,
  2026-08-10) — mesmo backdrop .dev-overlay dos 2 acima, conteúdo
  preenchido via JS (openPartnerNewsOverlay, script abaixo) a partir de
  partnerNewsData. Todo campo dinâmico é preenchido via textContent (nunca
  innerHTML) — guildName/title/text vêm de dados que o dono do servidor
  PARCEIRO controla (nome do Discord dele, texto do /divulgar), então
  precisam do mesmo escape automático que a interpolação padrão do EJS já
  dá pro card normal renderizado no servidor.
%>
<div class="dev-overlay" id="partnerNewsOverlay" hidden>
    <div class="partner-news-overlay-card">
        <div class="partner-news-overlay-image" id="partnerNewsOverlayImage" hidden></div>
        <div class="partner-news-header">
            <img id="partnerNewsOverlayIcon" src="" alt="" hidden>
            <div class="partner-news-icon-fallback" id="partnerNewsOverlayIconFallback"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#DCA15E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg></div>
            <span id="partnerNewsOverlayGuildName"></span>
        </div>
        <p class="partner-news-overlay-title" id="partnerNewsOverlayTitle"></p>
        <p class="partner-news-overlay-text" id="partnerNewsOverlayText" hidden></p>
        <a href="#" target="_blank" rel="noopener" class="partner-news-event" id="partnerNewsOverlayEvent" hidden>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#DCA15E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21 12 17.77 5.82 21 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <span id="partnerNewsOverlayEventName"></span>
        </a>
        <button type="button" class="btn-primary partner-news-overlay-close" id="partnerNewsOverlayClose"><span data-i18n-pt>FECHAR</span><span data-i18n-en>CLOSE</span></button>
    </div>
</div>

<script>
    (function () {
        var overlay = document.getElementById('premiumLockedOverlay');
        if (!overlay) return;

        function openOverlay() { overlay.hidden = false; }
        function closeOverlay() { overlay.hidden = true; }

        document.querySelectorAll('[data-premium-locked]').forEach(function (link) {
            link.addEventListener('click', function (e) {
                e.preventDefault();
                openOverlay();
            });
        });
        overlay.addEventListener('click', function (e) {
            if (e.target === overlay) closeOverlay();
        });
        var closeBtn = document.getElementById('premiumLockedClose');
        if (closeBtn) closeBtn.addEventListener('click', closeOverlay);
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeOverlay();
        });
    })();

    // Overlay maior do anúncio de parceiro (ver partnerNewsData, script
    // logo acima deste bloco) — mesmo padrão dos 2 overlays anteriores.
    (function () {
        var overlay = document.getElementById('partnerNewsOverlay');
        if (!overlay || typeof partnerNewsData === 'undefined') return;

        var imageEl = document.getElementById('partnerNewsOverlayImage');
        var iconEl = document.getElementById('partnerNewsOverlayIcon');
        var iconFallbackEl = document.getElementById('partnerNewsOverlayIconFallback');
        var guildNameEl = document.getElementById('partnerNewsOverlayGuildName');
        var titleEl = document.getElementById('partnerNewsOverlayTitle');
        var textEl = document.getElementById('partnerNewsOverlayText');
        var eventEl = document.getElementById('partnerNewsOverlayEvent');
        var eventNameEl = document.getElementById('partnerNewsOverlayEventName');

        // Sempre textContent pros campos vindos de partnerNewsData (nunca
        // innerHTML) — esses valores vêm de fora do nosso controle (nome
        // do servidor parceiro, texto do /divulgar dele).
        window.openPartnerNewsOverlay = function (idx) {
            var pn = partnerNewsData[idx];
            if (!pn) return;

            if (pn.imageUrl) {
                imageEl.style.backgroundImage = "url('" + pn.imageUrl + "')";
                imageEl.hidden = false;
            } else {
                imageEl.hidden = true;
            }

            if (pn.iconUrl) {
                iconEl.src = pn.iconUrl;
                iconEl.hidden = false;
                iconFallbackEl.hidden = true;
            } else {
                iconEl.hidden = true;
                iconFallbackEl.hidden = false;
            }
            guildNameEl.textContent = pn.guildName;
            titleEl.textContent = pn.title;

            if (pn.text) {
                textEl.textContent = pn.text;
                textEl.hidden = false;
            } else {
                textEl.hidden = true;
            }

            if (pn.eventUrl) {
                eventEl.href = pn.eventUrl;
                eventNameEl.textContent = pn.eventName;
                eventEl.hidden = false;
            } else {
                eventEl.hidden = true;
            }

            overlay.hidden = false;
        };

        function closeOverlay() { overlay.hidden = true; }
        overlay.addEventListener('click', function (e) {
            if (e.target === overlay) closeOverlay();
        });
        var closeBtn = document.getElementById('partnerNewsOverlayClose');
        if (closeBtn) closeBtn.addEventListener('click', closeOverlay);
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeOverlay();
        });
    })();

    // Setas do carrossel horizontal (só existem no DOM quando há mais de 5
    // anúncios — ver isPartnerNewsCarousel acima).
    (function () {
        var track = document.getElementById('partnerNewsCarousel');
        if (!track) return;
        var prevBtn = document.getElementById('partnerNewsPrev');
        var nextBtn = document.getElementById('partnerNewsNext');
        function scrollAmount() { return Math.min(track.clientWidth * 0.9, 600); }
        if (prevBtn) prevBtn.addEventListener('click', function () { track.scrollBy({ left: -scrollAmount(), behavior: 'smooth' }); });
        if (nextBtn) nextBtn.addEventListener('click', function () { track.scrollBy({ left: scrollAmount(), behavior: 'smooth' }); });
    })();

    // JS de idioma (toggleLang/updateLangToggleLabel/inicialização)
    // REMOVIDO daqui (pedido do dono, 2026-08-13) — vive só em
    // partials/top-nav.ejs agora.
</script>

</body>
</html>
