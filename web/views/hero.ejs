                    <span data-i18n-pt>CONVIDE O BOT</span><span data-i18n-en>INVITE THE BOT</span>
                </a>
                <% if (user) { %>
                    <a href="/dashboard" class="dashboard-link btn-primary">
                        <span data-i18n-pt>PORTAL</span><span data-i18n-en>PORTAL</span>
                    </a>
                <% } else { %>
                    <a href="/login" class="btn-primary">
                        <span data-i18n-pt>ENTRAR</span><span data-i18n-en>LOGIN</span>
