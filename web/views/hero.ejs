<%#
  Overlay do botão Dashboard travado (pedido do dono, 2026-08-02): enquanto
  DASHBOARD_LOCKED_TO_OWNER estiver true (dashboard.js), todo link
  ".dashboard-link" acima (canto, PORTAL da nav, PORTAL dos 2 CTAs) ganha
  data-locked pra quem não é o dono — o
  clique é interceptado (JS abaixo) e mostra isto por cima da página em
  vez de navegar pra /dashboard (que aplicaria o MESMO bloqueio de novo,
  só que depois de um reload inteiro). O dono continua navegando normal
  (sem data-locked, sem listener, link funciona como sempre).
%>
<div class="dev-overlay" id="devOverlay" hidden>
    <%- include('partials/dev-overlay-card') %>
</div>

<script>
    (function () {
        var overlay = document.getElementById('devOverlay');
        if (!overlay) return;

        function openOverlay() { overlay.hidden = false; }
        function closeOverlay() { overlay.hidden = true; }

        document.querySelectorAll('.dashboard-link[data-locked]').forEach(function (link) {
            link.addEventListener('click', function (e) {
                e.preventDefault();
                openOverlay();
            });
        });
        overlay.addEventListener('click', function (e) {
            if (e.target === overlay) closeOverlay();
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeOverlay();
        });
    })();

    (function () {
        const stored = localStorage.getItem('titanspass_lang') || 'pt';
        document.documentElement.setAttribute('data-lang', stored);
        document.getElementById('langBtnLabel').textContent = stored === 'pt' ? 'EN' : 'PT';
    })();

    function toggleLang() {
        const current = document.documentElement.getAttribute('data-lang') || 'pt';
        const next = current === 'pt' ? 'en' : 'pt';
        document.documentElement.setAttribute('data-lang', next);
        localStorage.setItem('titanspass_lang', next);
        document.getElementById('langBtnLabel').textContent = next === 'pt' ? 'EN' : 'PT';
    }
</script>

</body>
</html>
