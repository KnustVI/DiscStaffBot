            </span>
            <span class="mockup-pill ${pillClass}"><span data-i18n-pt>${pillPt}</span><span data-i18n-en>${pillEn}</span></span>
        </div>`;
    }
    // Painel completo (moldura .feature-card + .mockup-panel por dentro) —
    // showRail liga a "barra lateral" de 4 ícones (só usada no mockup do
    // Dashboard Web, pra lembrar o sidebar real); rings é opcional (só o
    // Dashboard usa, pros 3 gráficos de progresso). stacked:true tira o
    // "lg:w-1/2" (usado quando o mockup entra num par empilhado dentro de
    // uma coluna que JÁ é metade da largura — ver bloco de Análise/Staff
    // mais abaixo, mesmo motivo dos 2 <img> empilhados que ele substitui).
    function mockupPanel({ topbarPt, topbarEn, showRail, rings, rows, stacked }) {
        const railHtml = showRail ? `<div class="mockup-rail">
            <div class="mockup-rail-icon is-active">${mockupIcons.chart}</div>
            <div class="mockup-rail-icon">${mockupIcons.shield}</div>
            <div class="mockup-rail-icon">${mockupIcons.chat}</div>
            <div class="mockup-rail-icon">${mockupIcons.gear}</div>
        </div>` : '';
        const ringsHtml = (rings && rings.length)
            ? `<div class="mockup-rings">${rings.map(r => mockupRing(r.percent, r.hex, r.value)).join('')}</div>`
            : '';
        const rowsHtml = rows.map(mockupRow).join('');
        const widthClass = stacked ? 'w-full' : 'w-full lg:w-1/2';
        return `<div class="feature-card mockup-panel ${widthClass}" style="max-width: 420px;">
            <div class="mockup-topbar">
                <span class="mockup-dot"></span><span class="mockup-dot"></span><span class="mockup-dot is-accent"></span>
                <span class="mockup-topbar-label"><span data-i18n-pt>${topbarPt}</span><span data-i18n-en>${topbarEn}</span></span>
            </div>
            <div class="mockup-body">${railHtml}<div class="mockup-main">${ringsHtml}${rowsHtml}</div></div>
        </div>`;
    }

