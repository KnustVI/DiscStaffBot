<!-- ===================== PLAYER PREMIUM ===================== -->
<div class="relative w-full flex justify-center" style="padding: 0 16px;">
    <div style="width:100%; max-width:1100px; border-top:1px solid #3E3D38;"></div>
</div>
<section id="premium" class="relative w-full flex flex-col items-center" style="padding: 60px 16px;">
    <h2 class="section-title text-shadow-figma mb-2 text-center"><span data-i18n-pt>PLAYER PREMIUM</span><span data-i18n-en>PLAYER PREMIUM</span></h2>
    <p class="mb-4 text-center opacity-90 text-shadow-figma" style="font-family:'Poppins',sans-serif; font-weight:600;">
        <span data-i18n-pt>Personalize seu perfil e participe das missões mensais do bot!</span>
        <span data-i18n-en>Customize your profile and take part in the bot's monthly missions!</span>
    </p>
    <%
    // Preço/pagamento variam por região (isBrazil, ver dashboard.js): Brasil
    // continua 100% manual via Pix (como hoje), fora do Brasil vai por
    // Ko-fi em US$ — pedido do dono, PayPal direto exigiria conta Empresa
    // com CNPJ que ele não tem. O idioma exibido continua controlado pelo
    // toggle EN/PT normal (data-i18n-*), independente da região.
    //
    // BR não tem mais botão por card: todo tier pago de uma mesma seção
    // leva pro MESMO link (servidor de suporte), então em vez de repetir
    // "Assinar" em cada card, um botão só (acquireSectionButton, abaixo)
    // cobre a seção inteira. Ko-fi (fora do Brasil) continua por card —
    // implementação separada, ainda não revisada.
    // Botões de AQUISIÇÃO de Premium travados (pedido do dono, 2026-08-09:
    // "Trava os botões de premium por hora, informe por overlay que o
    // premium ainda não esta em uso durante a fase de testes") — Ko-fi e
    // "Adquirir" ganham data-premium-locked em vez do link de verdade
    // funcionar; o clique é interceptado (mesmo padrão do overlay de
    // dashboard travado, ver script perto do fim do arquivo) e mostra o
    // aviso de fase de testes em vez de sair do site/abrir o Ko-fi. Link
    // continua no href (só decorativo enquanto JS não roda) pro botão
    // continuar parecendo um link de verdade visualmente/semanticamente.
    function pricingCta(priceBR, priceIntl, color) {
        const moneyLine = `<p class="text-2xl font-bold my-2" style="font-family:'Tilt Warp',sans-serif; color:${color};">${isBrazil ? priceBR : priceIntl}<span class="text-sm opacity-70">/<span data-i18n-pt>mês</span><span data-i18n-en>mo</span></span></p>`;
        const ctaLine = isBrazil
            ? `<p class="text-xs opacity-70 mb-3" style="font-family:'Poppins',sans-serif;"><span data-i18n-pt>Pagamento temporariamente pausado. Bot em fase de testes.</span><span data-i18n-en>Payments temporarily paused. Bot in testing phase.</span></p>`
            : `<a href="https://ko-fi.com/knustvi" target="_blank" rel="noopener" data-premium-locked="true" class="btn-primary small" style="min-width:0; height:32px; font-size:13px; padding:5px 16px; margin-bottom:12px;"><span data-i18n-pt>Assinar via Ko-fi</span><span data-i18n-en>Subscribe via Ko-fi</span></a>`;
        return moneyLine + ctaLine;
    }

    // Botão único por seção (só BR — Ko-fi já resolve isso por card, um
    // link por tier). Também travado — ver comentário de pricingCta acima.
    function acquireSectionButton(labelPt, labelEn) {
        if (!isBrazil) return '';
        return `<a href="https://discord.gg/fkD5FQktn6" target="_blank" rel="noopener" data-premium-locked="true" class="btn-primary small mb-6" style="min-width:0; height:32px; font-size:13px; padding:5px 18px;">💎 <span data-i18n-pt>${labelPt}</span><span data-i18n-en>${labelEn}</span></a>`;
    }
    %>
    <%- acquireSectionButton('Adquirir Player Premium', 'Get Player Premium') %>
    <div class="w-full grid grid-cols-1 md:grid-cols-3 gap-6" style="max-width: 1000px;">
        <div class="pricing-card">
            <h3 style="font-family:'Tilt Warp',sans-serif; font-size:24px; text-transform:uppercase;">FREE</h3>
            <ul style="font-family:'Poppins',sans-serif; font-size:14px; display:flex; flex-direction:column; gap:8px; list-style:none; padding:0; opacity:0.9; margin-top:12px;">
                <li><span data-i18n-pt>Personalize seu perfil pela loja</span><span data-i18n-en>Customize your profile via the shop</span></li>
                <li><span data-i18n-pt>Badges de missões</span><span data-i18n-en>Mission badges</span></li>
                <li><span data-i18n-pt>Títulos de missões</span><span data-i18n-en>Mission titles</span></li>
                <li><span data-i18n-pt>Ganhe Caçadas por hora de jogo</span><span data-i18n-en>Earn Hunt per hour played</span></li>
            </ul>
        </div>
        <div class="pricing-card featured">
            <h3 style="font-family:'Tilt Warp',sans-serif; font-size:24px; text-transform:uppercase; color:#DCA15E;">COMPY</h3>
            <%- pricingCta('R$10', '$6', '#DCA15E') %>
            <p class="text-xs opacity-60 mb-2" style="font-family:'Poppins',sans-serif;"><span data-i18n-pt>Tudo do Free +</span><span data-i18n-en>Everything in Free +</span></p>
            <ul style="font-family:'Poppins',sans-serif; font-size:14px; display:flex; flex-direction:column; gap:8px; list-style:none; padding:0; opacity:0.9;">
                <li><span data-i18n-pt>Badge exclusivo</span><span data-i18n-en>Exclusive badge</span></li>
                <li><span data-i18n-pt>Títulos exclusivos</span><span data-i18n-en>Exclusive titles</span></li>
                <li><span data-i18n-pt>Ganho extra de Caçadas por missão concluída</span><span data-i18n-en>Extra Hunt earnings per completed mission</span></li>
            </ul>
        </div>
        <div class="pricing-card">
            <h3 style="font-family:'Tilt Warp',sans-serif; font-size:24px; text-transform:uppercase; color:#FF4E3B;">RAPTOR</h3>
            <%- pricingCta('R$25', '$12', '#FF4E3B') %>
            <p class="text-xs opacity-60 mb-2" style="font-family:'Poppins',sans-serif;"><span data-i18n-pt>Tudo do Compy +</span><span data-i18n-en>Everything in Compy +</span></p>
            <ul style="font-family:'Poppins',sans-serif; font-size:14px; display:flex; flex-direction:column; gap:8px; list-style:none; padding:0; opacity:0.9;">
                <li><span data-i18n-pt>Perfil 100% personalizável com suas próprias imagens</span><span data-i18n-en>100% custom profile with your own images</span></li>
                <li><span data-i18n-pt>Ganho extra de Caçadas por Missão Titan concluída</span><span data-i18n-en>Extra Hunt earnings per completed Titan Mission</span></li>
            </ul>
        </div>
    </div>
</section>

<!-- ===================== SERVER PREMIUM ===================== -->
<div class="relative w-full flex justify-center" style="padding: 0 16px;">
    <div style="width:100%; max-width:1100px; border-top:1px solid #3E3D38;"></div>
</div>
<section class="relative w-full flex flex-col items-center" style="padding: 20px 16px 70px;">
    <h2 class="section-title text-shadow-figma mb-2 text-center"><span data-i18n-pt>SERVER PREMIUM</span><span data-i18n-en>SERVER PREMIUM</span></h2>
    <p class="mb-4 text-center opacity-90 text-shadow-figma" style="font-family:'Poppins',sans-serif; font-weight:600;">
        <span data-i18n-pt>Melhore tudo que puder no seu servidor!</span>
        <span data-i18n-en>Level up everything you can on your server!</span>
    </p>
    <%- acquireSectionButton('Adquirir Server Premium', 'Get Server Premium') %>
    <p class="mb-10 text-center opacity-60 text-sm" style="font-family:'Poppins',sans-serif;">
        <span data-i18n-pt>Necessário ser um Host de Path of Titans.</span>
        <span data-i18n-en>Requires being a Path of Titans server host.</span>
    </p>

    <%
    // Mesmas categorias de antes (Missões/Reportes/Moderação/Eventos/
    // Integração/Bônus), mas agora como 3 cards com lista de bullets em vez
    // de tabela — pedido do dono: em parágrafo corrido fica difícil ver o
    // que entra em cada tier, igual o Player Premium já resolve com <ul>.
    const serverRows = [
        { labelPt: 'MISSÕES', labelEn: 'MISSIONS',
          free: { pt: "Missões mensais do Titan's Pass (em breve).", en: "Titan's Pass monthly missions (coming soon)." },
          rast: { pt: '1 missão mensal exclusiva para o servidor (em breve). Badge exclusiva para players (em breve).', en: '1 monthly mission exclusive to the server (coming soon). Exclusive badge for players (coming soon).' },
          cac: { pt: '2 missões mensais exclusivas para o servidor (em breve).', en: '2 monthly missions exclusive to the server (coming soon).' } },
        { labelPt: 'REPORTES', labelEn: 'REPORTS',
          free: { pt: 'Até 1 chat de reporte ativo. Até 1 revisão de punição ativa. Cooldown de 6h.', en: 'Up to 1 active report chat. Up to 1 active punishment review. 6h cooldown.' },
          rast: { pt: 'Até 3 chats de reporte ativos. Até 3 revisões de punição ativas. Sem tempo de espera.', en: 'Up to 3 active report chats. Up to 3 active punishment reviews. No cooldown.' },
          cac: { pt: 'Chats de reporte ilimitados, sem tempo de espera. Resumo automático dos logs dos possíveis envolvidos direto no chat (em breve). Personalização de banners e mensagem do painel.', en: 'Unlimited report chats, no cooldown. Automatic summary of involved players\' logs right in the chat (coming soon). Banner and panel message customization.' } },
        { labelPt: 'MODERAÇÃO', labelEn: 'MODERATION',
          free: { pt: 'Registro de punições.', en: 'Punishment logging.' },
          rast: { pt: 'Sistema de pontos de reputação. Cargo temporário de punição. Até 4 níveis de punição configuráveis. Histórico de punições.', en: 'Reputation point system. Temporary punishment role. Up to 4 configurable punishment levels. Punishment history.' },
          cac: { pt: 'Cargo temporário de punição. Até 10 níveis de punição configuráveis. Personalização de qual comando requer supervisão. Cargos de reputação automáticos. Análise de atividade de staff.', en: 'Temporary punishment role. Up to 10 configurable punishment levels. Customize which command requires supervisor approval. Automatic reputation roles. Staff activity analysis.' } },
        { labelPt: 'EVENTOS', labelEn: 'EVENTS',
          free: { pt: 'Cria eventos em fóruns. Suporte para imagem de capa do evento.', en: 'Creates events in forums. Supports an event cover image.' },
          rast: { pt: 'Cria eventos diretamente no Discord. Marca automaticamente jogadores com o cargo selecionado.', en: 'Creates events directly on Discord. Automatically pings players with the selected role.' },
          cac: { pt: 'Anuncia automaticamente a criação, o início e o encerramento dos eventos. Faz postagem em redes sociais (em breve). Análise de atividade de staff.', en: 'Automatically announces event creation, start, and end. Posts to social media (coming soon). Staff activity analysis.' } },
        { labelPt: 'INTEGRAÇÃO PATH OF TITANS', labelEn: 'PATH OF TITANS INTEGRATION',
          free: { pt: 'Logs de jogo por webhook.', en: 'In-game logs via webhook.' },
          rast: { pt: 'Ação automática em jogo (RCON) nas punições. Aviso automático em jogo antes de eventos. Botões de teleporte configuráveis.', en: 'Automatic in-game action (RCON) on punishments. Automatic in-game event reminders. Configurable teleport buttons.' },
          cac: { pt: 'Todos os comandos disponíveis para aplicar in-game via RCON. Comando de TP integrado à criação de eventos. Criar comando de buff personalizado. Postagem automática de ninhos (em breve). Mute automático in-game com filtro personalizado de palavras.', en: 'Every command available to apply in-game via RCON. TP command integrated into event creation. Create a custom buff command. Automatic nest posting (coming soon). Automatic in-game mute with a custom word filter.' } },
        { labelPt: 'BÔNUS', labelEn: 'BONUS',
          free: null,
          rast: { pt: 'O proprietário do servidor recebe Player Premium Compy gratuitamente.', en: 'The server owner gets Player Premium Compy for free.' },
          cac: { pt: 'O proprietário do servidor recebe Player Premium Raptor gratuitamente. Personalização de banners, cores e rodapé dos painéis.', en: 'The server owner gets Player Premium Raptor for free. Banner, color, and panel footer customization.' } },
    ];
    // Quebra "Frase um. Frase dois." em bullets separados — mesmo espírito
    // das listas do Player Premium.
    const splitBullets = (text) => (text || '')
        .split(/\.\s+/)
        .map(s => s.replace(/\.$/, '').trim())
        .filter(Boolean);

    // Nomes dos tiers de SERVER PREMIUM traduzidos pro inglês (Rastreador ->
    // Tracker, Caçador -> Hunter) — Player Premium (Compy/Raptor) não muda,
    // já são nomes em inglês. Ver PREMIUM.txt seção 102.
    const serverTiers = [
        { key: 'free', namePt: 'FREE', nameEn: 'FREE', color: '#F8DCC0', priceBR: 'R$0', priceIntl: '$0', tagPt: null, tagEn: null, featured: false },
        { key: 'rast', namePt: 'RASTREADOR', nameEn: 'TRACKER', color: '#DCA15E', priceBR: 'R$25', priceIntl: '$14', tagPt: 'Tudo do Free +', tagEn: 'Everything in Free +', featured: true },
        { key: 'cac', namePt: 'CAÇADOR', nameEn: 'HUNTER', color: '#FF4E3B', priceBR: 'R$40', priceIntl: '$28', tagPt: 'Tudo do Rastreador +', tagEn: 'Everything in Tracker +', featured: false },
    ];
    %>
    <div class="w-full grid grid-cols-1 md:grid-cols-3 gap-6" style="max-width: 1100px;">
        <% serverTiers.forEach(tier => { %>
            <div class="pricing-card <%= tier.featured ? 'featured' : '' %>">
                <h3 style="font-family:'Tilt Warp',sans-serif; font-size:24px; text-transform:uppercase; color:<%= tier.color %>;"><span data-i18n-pt><%= tier.namePt %></span><span data-i18n-en><%= tier.nameEn %></span></h3>
                <% if (tier.key === 'free') { %>
                    <p class="text-2xl font-bold my-2" style="font-family:'Tilt Warp',sans-serif; color:<%= tier.color %>;"><%= tier.priceBR %></p>
                <% } else { %>
                    <%- pricingCta(tier.priceBR, tier.priceIntl, tier.color) %>
                <% } %>
                <% if (tier.tagPt) { %>
                    <p class="text-xs opacity-60 mb-2" style="font-family:'Poppins',sans-serif;"><span data-i18n-pt><%= tier.tagPt %></span><span data-i18n-en><%= tier.tagEn %></span></p>
                <% } %>
                <% serverRows.forEach(row => { %>
                    <% const cell = row[tier.key]; if (cell) { %>
                        <p class="cat-label"><span data-i18n-pt><%= row.labelPt %></span><span data-i18n-en><%= row.labelEn %></span></p>
                        <ul>
                            <% splitBullets(cell.pt).forEach((b, bi) => { %>
                                <li><span data-i18n-pt><%= b %></span><span data-i18n-en><%= splitBullets(cell.en)[bi] || '' %></span></li>
                            <% }); %>
                        </ul>
                    <% } %>
                <% }); %>
            </div>
        <% }); %>
    </div>
</section>

