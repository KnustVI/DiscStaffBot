    </section>

<!-- ===================== FEATURE SECTIONS ===================== -->
<div class="relative w-full flex justify-center" style="padding: 40px 16px 0;">
    <div style="width:100%; max-width:1100px; border-top:1px solid #3E3D38;"></div>
</div>
<main class="relative w-full flex flex-col items-center" style="gap: 80px; padding: 20px 16px 90px;">

    <%
    // Ícones minúsculos (24x24, stroke) usados dentro dos mockupRow abaixo —
    // mesmo espírito visual dos ícones da seção "Porque Usar" (stroke
    // #F8DCC0/currentColor), só que num tamanho de lista, não de destaque.
    const mockupIcons = {
        shield: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.5 8.5 8 10 4.5-1.5 8-5 8-10V5l-8-3Z"/></svg>',
        chat: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10Z"/></svg>',
        gear: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg>',
        link: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 17H7A5 5 0 0 1 7 7h2M15 7h2a5 5 0 1 1 0 10h-2M8 12h8"/></svg>',
        bolt: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h8l-1 8 10-12h-8l1-8Z"/></svg>',
        check: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m20 6-11 11-5-5"/></svg>',
        chart: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18M7 15v3M12 10v8M17 6v12"/></svg>',
        lock: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>',
    };

    // Anel de progresso minúsculo (stroke-dasharray simples — versão
    // enxuta do motivo real dos gráficos do dashboard, ver stat-donut.ejs;
    // não reaproveita o path exato do Figma de lá porque hero.ejs é uma
    // página autocontida, sem partials compartilhados com o dashboard).
    function mockupRing(percent, hex, valueLabel) {
        const r = 24, c = 2 * Math.PI * r;
        const filled = (Math.max(0, Math.min(100, percent)) / 100) * c;
        return `<div class="mockup-ring-wrap">
            <svg width="56" height="56" viewBox="0 0 56 56">
                <circle cx="28" cy="28" r="${r}" fill="none" stroke="#3E3D38" stroke-width="5" opacity="0.4"/>
                <circle cx="28" cy="28" r="${r}" fill="none" stroke="${hex}" stroke-width="5" stroke-linecap="round"
                    stroke-dasharray="${filled.toFixed(1)} ${c.toFixed(1)}" transform="rotate(-90 28 28)"/>
            </svg>
            <span class="mockup-ring-value" style="color:${hex};">${valueLabel}</span>
        </div>`;
    }
    // Uma "linha de lista" do mockup — ícone + label/sub bilíngues + pill de
    // status colorida (mesmo padrão data-i18n-pt/en do resto da página,
    // mesmo sendo conteúdo decorativo). icon aceita "img:<nome>" (pedido do
    // dono, 2026-08-12: "adicione os icones da moeda" no card da Loja) pra
    // usar um ícone de verdade (assets/icons/<nome>.webp, já usado em
    // perfil.ejs/loja.ejs) em vez de um dos 8 SVGs genéricos de mockupIcons.
    function mockupRow({ icon, labelPt, labelEn, subPt, subEn, pillPt, pillEn, pillClass }) {
        const iconHtml = icon?.startsWith('img:')
            ? `<img src="/images/icons/${icon.slice(4)}.webp" alt="" style="width:16px; height:16px; border-radius:4px; object-fit:cover;">`
            : (mockupIcons[icon] || mockupIcons.check);
        return `<div class="mockup-row">
            <span class="mockup-row-icon">${iconHtml}</span>
            <span class="mockup-row-text">
                <span class="mockup-row-label"><span data-i18n-pt>${labelPt}</span><span data-i18n-en>${labelEn}</span></span>
