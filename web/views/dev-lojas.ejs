<%#
  web/views/dev-lojas.ejs
  Página GLOBAL (sem :guildID), restrita ao dono do bot (isOwnerSession,
  ver dashboard.js GET /dev/Loja) — CONTEÚDO substituído por completo na
  reforma das lojas (pedido do dono 2026-08-12: "Controle da loja...
  deve ser um painel de configuração completa de todas as lojas"). URL
  já passou por 2 rodadas de renomeação no mesmo dia: nasceu em
  `/dev/lojas` (seção 183 do PREMIUM.txt), voltou pra `/dev/image-pool`
  por pedido do dono (a URL antiga já estava salva/em uso — ver seção
  185), e finalmente virou `/dev/Loja` por pedido explícito seguinte.
  Nome do arquivo (dev-lojas.ejs) continua diferente do nome da rota —
  Express/EJS não exigem que bata, o `res.render('dev-lojas', ...)` é só
  uma referência interna, não precisa mudar toda vez que a URL muda.

  5 seções: (1) Loja de Jogo de CADA servidor onde o bot está (link pra
  /lojajogo/:guildId, mesma página do admin — o dono tem bypass lá pra
  configurar/dar suporte em qualquer servidor mesmo sem ser membro); (2)
  config global da Loja de Personalização (taxa de envio do marketplace);
  (3) fila de aprovação de imagens enviadas por jogador; (4) pool de
  Personalização/Banner (upload/visibilidade/preço) + Título (editor de
  requisito, ver abaixo); (5) Emblemas, com o MESMO editor de requisito
  de resgate de Título (partials/requirement-form.ejs, ver
  src/systems/pot/achievementSystem.js) — Título estava faltando esse
  editor até 2026-08-12 (pedido do dono: "titulo esta sem essa
  confguração tambem"), corrigido no mesmo dia que a UX do requisito
  ganhou rótulo/dica dinâmicos por tipo escolhido.

  Uso: res.render('dev-lojas', { groups, badges, pendingSubmissions,
    allGuilds, requirementTypes, personalizationConfig, saved }) — ver
    dashboard.js GET /dev/Loja pro shape completo de cada local.
%>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Controle de Lojas (Dev) | <%= bot.user.username %></title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Tilt+Warp&family=Bebas+Neue&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'titan-bg': '#0D0D0D',
                        'titan-accent': '#803E30',
                        'titan-cream': '#F8DCC0',
                        'titan-gold': '#D9A362',
                    }
                }
            }
        }
    </script>
    <style>
        .pool-grid { display: flex; flex-wrap: wrap; gap: 16px; }
        .pool-item {
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            gap: 8px;
            width: 180px;
            padding: 10px;
            background: #131314;
            border: 1px solid rgba(217, 163, 98, 0.25);
            border-radius: 10px;
        }
        .pool-item-thumb {
            width: 100%;
            aspect-ratio: 4 / 3;
            border-radius: 8px;
            background-color: #1F1D20;
            background-size: cover;
            background-position: center;
        }
        .pool-item-label {
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 0.8rem;
            color: #F8DCC0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .pool-item-meta { font-size: 0.7rem; opacity: 0.5; }
        .pool-item-badge {
            display: inline-flex;
            align-self: flex-start;
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 2px 8px;
            border-radius: 20px;
        }
        .pool-item-badge.is-public { background: rgba(165, 255, 161, 0.15); color: #A5FFA1; }
        .pool-item-badge.is-private { background: rgba(255, 78, 59, 0.15); color: #FF4E3B; }
        .pool-item-actions { display: flex; flex-direction: column; gap: 6px; margin-top: auto; }
        .pool-toggle-btn, .pool-delete-btn, .pool-approve-btn, .pool-reject-btn {
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 0.75rem;
            width: 100%;
            padding: 6px 10px;
            border-radius: 8px;
            border: 1px solid rgba(248, 220, 192, 0.25);
            background: transparent;
            color: #F8DCC0;
            cursor: pointer;
            transition: background 0.15s ease, border-color 0.15s ease;
        }
        .pool-toggle-btn:hover { background: rgba(248, 220, 192, 0.1); }
        .pool-delete-btn, .pool-reject-btn { border-color: rgba(255, 78, 59, 0.3); color: #FF4E3B; }
        .pool-delete-btn:hover, .pool-reject-btn:hover { background: rgba(255, 78, 59, 0.12); }
        .pool-approve-btn { border-color: rgba(165, 255, 161, 0.35); color: #A5FFA1; }
        .pool-approve-btn:hover { background: rgba(165, 255, 161, 0.12); }

        .pool-upload-form {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
            padding: 12px;
            background: #131314;
            border: 1px dashed rgba(217, 163, 98, 0.3);
            border-radius: 10px;
        }
        .pool-upload-form input[type="text"] {
            background: transparent;
            border: 1px solid rgba(217, 163, 98, 0.3);
            border-radius: 8px;
            padding: 8px 12px;
            color: #F8DCC0;
            font-family: 'Poppins', sans-serif;
            font-size: 0.85rem;
            width: 200px;
        }
        .pool-upload-form input[type="file"] {
            color: #F8DCC0;
            font-family: 'Poppins', sans-serif;
            font-size: 0.8rem;
        }
        .pool-upload-form input[type="file"]::file-selector-button {
            margin-right: 10px;
            padding: 6px 12px;
            border: none;
            border-radius: 6px;
            background: #DCA15E;
            color: #131314;
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 0.75rem;
            cursor: pointer;
        }
        .pool-upload-submit {
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 0.8rem;
            padding: 8px 16px;
            border-radius: 8px;
            border: none;
            background: #DCA15E;
            color: #131314;
            cursor: pointer;
            transition: background 0.15s ease;
        }
        .pool-upload-submit:hover { background: #F8DCC0; }

        .pool-price-form, .pool-requirement-form {
            display: flex;
            flex-direction: column;
            gap: 6px;
            padding: 8px;
            margin-top: 4px;
            background: rgba(217, 163, 98, 0.06);
            border: 1px dashed rgba(217, 163, 98, 0.25);
            border-radius: 8px;
        }
        .pool-price-current { font-size: 0.65rem; opacity: 0.6; }
        <%# Rótulo/valor/espécie do requisito (pedido do dono, 2026-08-12:
            "não esta claro como devem ser os requisitos") — linha própria
            em vez de espremer no mesmo .pool-price-row genérico do preço,
            já que aqui o rótulo do campo MUDA de acordo com o tipo
            escolhido (ver partials/requirement-form.ejs). %>
        .pool-req-value-row { display: flex; align-items: center; gap: 6px; }
        .pool-req-value-row label { font-size: 0.65rem; opacity: 0.7; flex: none; white-space: nowrap; }
        .pool-req-value-row input { flex: 1; min-width: 0; background: #1F1D20; border: 1px solid rgba(217, 163, 98, 0.3); border-radius: 6px; padding: 4px 6px; color: #F8DCC0; font-family: 'Poppins', sans-serif; font-size: 0.7rem; }
        .pool-req-hint { font-size: 0.62rem; opacity: 0.5; line-height: 1.4; font-style: italic; }
        .pool-price-row { display: flex; gap: 6px; }
        .pool-price-row input[type="number"],
        .pool-price-row input[type="text"],
        .pool-price-row select {
            flex: 1;
            min-width: 0;
            background: #1F1D20;
            border: 1px solid rgba(217, 163, 98, 0.3);
            border-radius: 6px;
            padding: 4px 6px;
            color: #F8DCC0;
            font-family: 'Poppins', sans-serif;
            font-size: 0.7rem;
        }
        .pool-price-submit {
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 0.7rem;
            width: 100%;
            padding: 5px 10px;
            border-radius: 6px;
            border: none;
            background: #803E30;
            color: #F8DCC0;
            cursor: pointer;
            transition: background 0.15s ease;
        }
        .pool-price-submit:hover { background: #9A4C3B; }

        .lojas-guild-grid { display: flex; flex-wrap: wrap; gap: 12px; }
        .lojas-guild-card {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            background: #131314;
            border: 1px solid rgba(217, 163, 98, 0.25);
            border-radius: 10px;
            text-decoration: none;
            color: #F8DCC0;
            transition: border-color 0.15s ease, background 0.15s ease;
        }
        .lojas-guild-card:hover { border-color: #DCA15E; background: rgba(220, 161, 94, 0.08); }
        .lojas-guild-card img { width: 32px; height: 32px; border-radius: 50%; }
        .lojas-guild-card span { font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 0.85rem; }

        .lojas-pending-card {
            display: flex;
            gap: 14px;
            padding: 12px;
            background: #131314;
            border: 1px solid rgba(217, 163, 98, 0.25);
            border-radius: 10px;
        }
        .lojas-pending-thumb {
            width: 120px;
            aspect-ratio: 800 / 427;
            border-radius: 8px;
            background-color: #1F1D20;
            background-size: cover;
            background-position: center;
            flex: none;
        }
        .lojas-pending-info { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 0; }
        .lojas-pending-actions { display: flex; gap: 8px; margin-top: 6px; }
        .lojas-pending-actions form { flex: 1; }
    </style>
</head>
<body class="flex min-h-screen">

    <main class="flex-1 w-full flex flex-col p-[30px] gap-[30px]">

        <%- include('partials/save-result-overlay', { saved }) %>

        <div class="flex items-center justify-between flex-wrap gap-3">
            <div>
                <h1 class="section-title text-xl">Controle de Lojas</h1>
                <p class="text-xs opacity-50 mt-1">Loja de Jogo de todos os servidores, pool de Personalização/Banner/Título/Emblema, fila de aprovação do marketplace de imagem de jogador e configuração da taxa de envio.</p>
            </div>
            <a href="/dashboard" class="btn-primary !min-w-0 !h-auto !py-2 !px-4 !text-sm">
                <i data-lucide="arrow-left" class="w-4 h-4"></i> Voltar
            </a>
        </div>

        <%# ==================== LOJA DE JOGO — TODOS OS SERVIDORES ==================== %>
        <section class="titan-card-premium flex-col gap-4">
            <h2 class="section-title text-lg">Loja de Jogo — Todos os Servidores (<%= allGuilds.length %>)</h2>
            <p class="text-xs opacity-50">Cada link abre o mesmo painel do admin daquele servidor — como dono, você configura qualquer um, mesmo sem ser membro.</p>
            <% if (allGuilds.length === 0) { %>
                <p class="text-sm opacity-40">O bot não está em nenhum servidor ainda.</p>
            <% } else { %>
                <div class="lojas-guild-grid">
                    <% allGuilds.forEach(g => { %>
                        <a href="/lojajogo/<%= g.id %>" class="lojas-guild-card">
                            <% if (g.iconURL) { %><img src="<%= g.iconURL %>" alt=""><% } else { %><i data-lucide="server" class="w-6 h-6"></i><% } %>
                            <span><%= g.name %></span>
                        </a>
                    <% }); %>
                </div>
            <% } %>
        </section>

        <%# ==================== CONFIG GLOBAL DO MARKETPLACE ==================== %>
        <section class="titan-card-premium flex-col gap-4">
            <h2 class="section-title text-lg">Marketplace de Imagens — Configuração</h2>
            <p class="text-xs opacity-50">Taxa (em Caçadas) que um jogador paga pra enviar uma imagem própria pra venda na Loja de Personalização — precisa da sua aprovação antes de aparecer pra qualquer um comprar.</p>
            <form action="/dev/Loja/config" method="POST" class="pool-price-row" style="max-width: 420px;">
                <input type="number" name="submission_fee" min="1" step="1" value="<%= personalizationConfig.submission_fee %>" placeholder="Taxa de envio">
                <select name="accepting_submissions">
                    <option value="1" <%= personalizationConfig.accepting_submissions ? 'selected' : '' %>>Aceitando envios</option>
                    <option value="0" <%= !personalizationConfig.accepting_submissions ? 'selected' : '' %>>Envios fechados</option>
                </select>
                <button type="submit" class="pool-price-submit" style="width: auto; padding-left: 16px; padding-right: 16px;">Salvar</button>
            </form>
        </section>

        <%# ==================== FILA DE APROVAÇÃO ==================== %>
        <section class="titan-card-premium flex-col gap-4">
            <h2 class="section-title text-lg">Fila de Aprovação (<%= pendingSubmissions.length %>)</h2>
            <% if (pendingSubmissions.length === 0) { %>
                <p class="text-sm opacity-40">Nenhum envio pendente.</p>
            <% } else { %>
                <div class="flex flex-col gap-3">
                    <% pendingSubmissions.forEach(sub => { %>
                        <div class="lojas-pending-card">
                            <div class="lojas-pending-thumb" style="<%= sub.url ? `background-image:url('${sub.url}')` : '' %>"></div>
                            <div class="lojas-pending-info">
                                <span class="pool-item-label"><%= sub.label %></span>
                                <span class="pool-item-meta">Enviado por <%= sub.submitterName %> — taxa paga: <%= sub.submission_fee %> Caçadas</span>
                                <div class="lojas-pending-actions">
                                    <form action="/dev/Loja/pendente/<%= sub.id %>/aprovar" method="POST">
                                        <button type="submit" class="pool-approve-btn">Aprovar</button>
                                    </form>
                                    <form action="/dev/Loja/pendente/<%= sub.id %>/reprovar" method="POST" onsubmit="return confirm('Reprovar? A taxa de envio é devolvida e o item é apagado por completo.');">
                                        <button type="submit" class="pool-reject-btn">Reprovar</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </section>

        <%# ==================== POOL: PERSONALIZAÇÃO / BANNER / TÍTULO ==================== %>
        <% const SHOP_TIERS = ['free', 'compy', 'raptor']; const TIER_LABELS = { free: 'Free', compy: 'Compy', raptor: 'Raptor' }; %>
        <% groups.forEach(group => { %>
            <section class="titan-card-premium flex-col gap-4">
                <h2 class="section-title text-lg"><%= group.label %> (<%= group.images.length %>)</h2>

                <% if (group.type === 'titulo') { %>
                    <form class="pool-upload-form" action="/dev/Loja/titulo/add" method="POST">
                        <input type="text" name="titulo" placeholder="Texto do título" maxlength="80" required>
                        <button type="submit" class="pool-upload-submit">Adicionar</button>
                    </form>
                <% } else { %>
                    <form class="pool-upload-form" action="/dev/Loja/<%= group.type %>/upload" method="POST" enctype="multipart/form-data">
                        <input type="text" name="label" placeholder="Nome de exibição" maxlength="80" required>
                        <input type="file" name="imagem" accept="image/png,image/jpeg,image/webp" required>
                        <button type="submit" class="pool-upload-submit">Adicionar</button>
                    </form>
                <% } %>

                <% if (group.images.length === 0) { %>
                    <p class="text-sm opacity-40">Nenhuma imagem cadastrada ainda.</p>
                <% } else { %>
                    <div class="pool-grid">
                        <% group.images.forEach(img => { %>
                            <div class="pool-item">
                                <% if (group.type === 'titulo') { %>
                                    <div class="pool-item-thumb flex items-center justify-center text-center p-2">
                                        <span class="pool-item-label !whitespace-normal"><%= img.label %></span>
                                    </div>
                                <% } else { %>
                                    <div class="pool-item-thumb" style="<%= img.url ? `background-image:url('${img.url}')` : '' %>"></div>
                                    <span class="pool-item-label"><%= img.label %></span>
                                <% } %>
                                <span class="pool-item-meta">#<%= img.id %> — <%= new Date(img.created_at).toLocaleDateString('pt-BR') %></span>
                                <span class="pool-item-badge <%= img.is_public ? 'is-public' : 'is-private' %>"><%= img.is_public ? 'Público' : 'Privado' %></span>
                                <% if (group.type === 'personalizacao') { %>
                                    <div class="pool-price-form">
                                        <span class="pool-price-current">
                                            <% if (img.shop_price) { %>
                                                Preço atual: <%= img.shop_price %> Caçadas (mín. <%= TIER_LABELS[img.shop_min_tier] || img.shop_min_tier %>)<% if (img.submitted_by) { %> — item de jogador<% } %>
                                            <% } else { %>
                                                Não está à venda
                                            <% } %>
                                        </span>
                                        <form action="/dev/Loja/<%= group.type %>/<%= img.id %>/preco" method="POST">
                                            <div class="pool-price-row">
                                                <input type="number" name="preco" min="0" step="1" placeholder="Preço" value="<%= img.shop_price || '' %>">
                                                <select name="tier_minimo">
                                                    <% SHOP_TIERS.forEach(tier => { %>
                                                        <option value="<%= tier %>" <%= (img.shop_min_tier || 'free') === tier ? 'selected' : '' %>><%= TIER_LABELS[tier] %></option>
                                                    <% }); %>
                                                </select>
                                            </div>
                                            <button type="submit" class="pool-price-submit">Salvar preço</button>
                                        </form>
                                    </div>
                                <% } else if (group.type === 'titulo') { %>
                                    <%- include('partials/requirement-form', { img, type: 'titulo', requirementTypes }) %>
                                <% } %>
                                <div class="pool-item-actions">
                                    <form action="/dev/Loja/<%= group.type %>/<%= img.id %>/toggle" method="POST">
                                        <button type="submit" class="pool-toggle-btn"><%= img.is_public ? 'Tornar privado' : 'Tornar público' %></button>
                                    </form>
                                    <form action="/dev/Loja/<%= group.type %>/<%= img.id %>/delete" method="POST" onsubmit="return confirm('Excluir \'<%= img.label.replace(/'/g, "") %>\' do pool? Isso não pode ser desfeito.');">
                                        <button type="submit" class="pool-delete-btn">Excluir</button>
                                    </form>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </section>
        <% }); %>

        <%# ==================== EMBLEMAS (requisito de resgate, não preço) ==================== %>
        <section class="titan-card-premium flex-col gap-4">
            <h2 class="section-title text-lg">Emblemas (<%= badges.length %>)</h2>
            <p class="text-xs opacity-50">Emblemas não são mais compráveis direto — defina um requisito e o jogador vê o botão "Resgatar" assim que cumprir, sem gastar moeda nenhuma.</p>
            <form class="pool-upload-form" action="/dev/Loja/badge/upload" method="POST" enctype="multipart/form-data">
                <input type="text" name="label" placeholder="Nome de exibição" maxlength="80" required>
                <input type="file" name="imagem" accept="image/png,image/jpeg,image/webp" required>
                <button type="submit" class="pool-upload-submit">Adicionar</button>
            </form>

            <% if (badges.length === 0) { %>
                <p class="text-sm opacity-40">Nenhum emblema cadastrado ainda.</p>
            <% } else { %>
                <div class="pool-grid">
                    <% badges.forEach(img => { %>
                        <div class="pool-item">
                            <div class="pool-item-thumb" style="<%= img.url ? `background-image:url('${img.url}')` : '' %>"></div>
                            <span class="pool-item-label"><%= img.label %></span>
                            <span class="pool-item-meta">#<%= img.id %> — <%= new Date(img.created_at).toLocaleDateString('pt-BR') %></span>
                            <span class="pool-item-badge <%= img.is_public ? 'is-public' : 'is-private' %>"><%= img.is_public ? 'Público' : 'Privado' %></span>
                            <%- include('partials/requirement-form', { img, type: 'badge', requirementTypes }) %>
                            <div class="pool-item-actions">
                                <form action="/dev/Loja/badge/<%= img.id %>/toggle" method="POST">
                                    <button type="submit" class="pool-toggle-btn"><%= img.is_public ? 'Tornar privado' : 'Tornar público' %></button>
                                </form>
                                <form action="/dev/Loja/badge/<%= img.id %>/delete" method="POST" onsubmit="return confirm('Excluir \'<%= img.label.replace(/'/g, "") %>\' do pool? Isso não pode ser desfeito.');">
                                    <button type="submit" class="pool-delete-btn">Excluir</button>
                                </form>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </section>

        <footer class="flex justify-end pb-2">
            <span class="bebas text-[12px] uppercase tracking-[6px] text-titan-cream opacity-10 hover:opacity-30 transition-opacity">
                BY: KNUST SEIER VI
            </span>
        </footer>
    </main>

    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <script>if (window.lucide) window.lucide.createIcons();</script>
    <script>
        // Sincroniza o formulário de requisito (partials/requirement-form.ejs)
        // com o tipo escolhido no <select> — rótulo do campo "Valor", frase
        // de ajuda, e mostra/esconde o campo de Espécie só quando o tipo
        // selecionado realmente usa espécie (needsSpecies). Um formulário
        // por item do pool (badge/titulo), cada um com seu próprio id
        // (rfId, ver o parcial) — por isso a função recebe o prefixo e
        // busca os elementos por ele, em vez de IDs fixos repetidos na página.
        function requirementFormSync(rfId) {
            const select = document.getElementById(rfId + '-type');
            const option = select.options[select.selectedIndex];
            const valueLabel = document.getElementById(rfId + '-value-label');
            const speciesRow = document.getElementById(rfId + '-species-row');
            const hint = document.getElementById(rfId + '-hint');
            valueLabel.textContent = (option.dataset.valueLabel || 'Valor') + ':';
            speciesRow.style.display = option.dataset.needsSpecies === '1' ? '' : 'none';
            hint.textContent = option.dataset.hint || 'Escolha um tipo de requisito acima para ver a explicação.';
        }
    </script>
</body>
</html>
