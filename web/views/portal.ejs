<%#
  web/views/portal.ejs
  "Portal" (pedido do dono, 2026-08-06) — nova entrada única pra quem está
  logado, no lugar dos antigos botões separados DASHBOARD/PERFIL na nav.
  Renomeado de index.ejs (era a página em /dashboard, "Seleção de
  Servidores") — mesma rota GET /dashboard em dashboard.js, só o
  res.render/conteúdo mudou. 2 colunas: card de perfil (atalho pra
  /perfil completo, "Toca") e escolha de servidor (só pra quem administra
  algum, mesmo getAdminGuildsWithBot de sempre). /perfil continua
  existindo do jeito que está, com a mesma sidebar restrita — só deixou
  de ter link direto na nav do site.

  Card de perfil redesenhado (Figma "Group 14", pedido do dono
  2026-08-06) — trocou de imagem PNG gerada por canvas (renderProfileCard)
  pra HTML/CSS ao vivo (textura de fundo fixa + nome/Alderon ID/Discord
  username como texto de verdade), ver dashboard.js GET /dashboard pra
  como `profile` é montado.

  Grade de servidores sempre com no mínimo 6 ícones (pedido do dono,
  2026-08-06) — preenchida com ícones de dinossauro decorativos quando o
  usuário administra menos de 6 servidores reais (ver partials/
  dino-icon.ejs).

  Uso: res.render('portal', { guilds, locked, profile }) — profile é
  { nickname, alderonId, discordUsername, honorStars } ou null (sem
  vínculo/não logado) — ver dashboard.js GET /dashboard.
%>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal | <%= bot.user.username %></title>

    <!-- Fontes -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Tilt+Warp&family=Bebas+Neue&display=swap" rel="stylesheet">

    <!-- Tailwind CDN (mesmo padrão do resto do dashboard) -->
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'titan-dark': '#1F1D20',
                        'titan-cream': '#F8DCC0',
                        'titan-accent': '#803E30',
                    }
                }
            }
        }
    </script>

    <style>
        html, body { margin: 0; padding: 0; overflow-x: hidden; max-width: 100%; background: #111111; }
        [data-i18n-en] { display: none; }
        html[data-lang="en"] [data-i18n-pt] { display: none; }
        html[data-lang="en"] [data-i18n-en] { display: initial; }

        .guild-icon-img { width: 100%; height: 100%; object-fit: cover; border-radius: inherit; }

        /* Tile da grade "DASHBOARD DO SEU SERVIDOR" (Figma Frame 11934,
           pedido do dono 2026-08-06) — servidor real usa a moldura CSS
           (border/box-shadow/border-radius, mesma família "USER/SERVER
           Icon" já usada no resto do site); tile de preenchimento
           (.is-filler, ver partials/dino-icon.ejs) NÃO leva moldura CSS
           própria — o SVG do dinossauro já desenha a dele (borda colorida
           + sombra + recorte), duplicar aqui deixaria dobrado. */
        .portal-server-tile {
            display: flex;
            align-items: center;
            justify-content: center;
            aspect-ratio: 1 / 1;
            cursor: pointer;
            transition: transform 0.2s ease, border-color 0.2s ease;
        }
        .portal-server-tile:not(.is-filler) {
            border-radius: 15px;
            border: 2px solid #3E3D38;
            background: #2A2A2A;
            box-shadow: 0px 12px 18px 11px rgba(1, 2, 10, 0.45);
            overflow: hidden;
        }
        .portal-server-tile:not(.is-filler):hover { border-color: #803E30; transform: scale(1.05); }
        .portal-server-tile.is-filler { pointer-events: none; }

        /* Componente .btn-primary (Figma node 250-59) - mesma definicao de web/public/css/style.css,
           duplicada aqui pq esta pagina usa um <style> proprio em vez do stylesheet compartilhado. */
        .btn-primary {
            box-sizing: border-box;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 5px 20px;
            gap: 10px;
            min-width: 232px;
            height: 39px;
            background: #2A2A2A;
            border: 1px solid #803E30;
            border-radius: 15px;
            box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5), -5px -5px 10px rgba(0, 0, 0, 0.7);
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 20px;
            line-height: 30px;
            color: #F8DCC0;
            text-decoration: none;
            cursor: pointer;
            transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
        }
        .btn-primary-icon {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: currentColor;
            flex: none;
        }
        .btn-primary:hover {
            background: #803E30;
            border-color: #F8DCC0;
            box-shadow: -5px -5px 10px rgba(0, 0, 0, 0.5), 5px 5px 10px rgba(0, 0, 0, 0.5),
                        10px 10px 20px rgba(0, 0, 0, 0.5), -10px -10px 20px rgba(0, 0, 0, 0.5);
        }
        .btn-primary:active {
            background: #4B2427;
            border-color: #803E30;
            box-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5), -1px -1px 2px rgba(0, 0, 0, 0.5),
                        inset 0px 8px 7.8px rgba(0, 0, 0, 0.59);
        }

        /* Barra de navegação padrão do site (mesma de hero.ejs — pedido do
           dono, 2026-08-06: "devemos ter ainda a mesma barra de navegação
           no top de home"). Fixa, então o conteúdo abaixo compensa com
           --nav-height (ver .portal-hero-padding e o script no fim). */
        .nav-btn {
            box-sizing: border-box;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 5px 20px;
            gap: 10px;
            height: 30px;
            background: #2A2A2A;
            border: 1px solid #803E30;
            border-radius: 15px;
            box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5), -5px -5px 10px rgba(0, 0, 0, 0.7);
            font-family: 'Poppins', sans-serif;
            font-weight: 300;
            font-size: 14px;
            color: #F8DCC0;
            text-decoration: none;
            white-space: nowrap;
            transition: background 0.15s ease, border-color 0.15s ease;
        }
        .nav-btn:hover { background: #803E30; border-color: #F8DCC0; }
        .nav-btn.is-active { background: #4B2427; border-color: #DCA15E; }
        .nav-btn:active {
            background: #4B2427;
            border-color: #803E30;
            box-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5), -1px -1px 2px rgba(0, 0, 0, 0.5), inset 0px 8px 7.8px rgba(0, 0, 0, 0.59);
        }
        /* Botão de idioma redesenhado (pedido do dono, 2026-08-06) — ver
           comentário completo em hero.ejs. */
        .lang-toggle {
            position: relative;
            display: inline-flex;
            align-items: center;
            width: 52px;
            height: 36px;
            background: none;
            border: none;
            padding: 0;
            cursor: pointer;
            flex: none;
        }
        .lang-toggle-flag {
            position: absolute;
            top: 2px;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            overflow: hidden;
            background: #2A2A2A;
            border: 1px solid #803E30;
            box-shadow: 3px 4px 8px rgba(0, 0, 0, 0.5);
            transition: left 0.2s ease, border-color 0.15s ease;
        }
        .lang-toggle-flag img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .lang-toggle:hover .lang-toggle-flag { border-color: #F8DCC0; }
        .lang-toggle-flag-pt { left: 0; z-index: 2; }
        .lang-toggle-flag-en { left: 18px; z-index: 1; }
        html[data-lang="en"] .lang-toggle-flag-pt { left: 18px; z-index: 1; }
        html[data-lang="en"] .lang-toggle-flag-en { left: 0; z-index: 2; }
        .portal-hero-padding { margin-top: calc(var(--nav-height, 84px) + 16px); }

        .section-title {
            font-family: 'Tilt Warp', sans-serif;
            font-size: clamp(22px, 3vw, 32px);
            text-transform: uppercase;
            color: #F8DCC0;
        }
        .portal-col-head {
            font-family: 'Tilt Warp', cursive;
            font-size: clamp(20px, 2.4vw, 26px);
            text-transform: uppercase;
            color: #F8DCC0;
        }
        /* Card de perfil (Figma "Group 14", pedido do dono 2026-08-06) — o
           card inteiro é o link pra "Toca" (/perfil), mesmo tipo de
           affordance de hover já usado nos ícones de servidor da coluna
           ao lado (leve scale + borda acesa). */
        .portal-profile-link { display: inline-block; width: 100%; max-width: 452px; transition: transform 0.15s ease; }
        .portal-profile-link:hover { transform: scale(1.015); }
        .portal-profile-card { display: flex; flex-direction: column; width: 100%; }

        /* Bloco de textura (Figma: "Profile avatar", 445x284, background:
           url(fundo_site_variante_3.png)) — o dono ainda vai mandar o
           arquivo real dessa textura (mesmo fluxo de quando mandou as
           bandeiras); enquanto isso, um gradiente na mesma paleta do site
           ocupa o lugar. Pra trocar depois: troca só a propriedade
           `background` de .portal-profile-bg por
           `background: url('/images/portal-profile-bg.webp') center/cover;`.

           Canto inferior-esquerdo cortado em diagonal (pedido do dono,
           2026-08-06, comparando com a imagem de referência do Figma — o
           corte não veio nos valores exatos do CSS exportado, só dava pra
           ver no mock, então a proporção do corte foi estimada visualmente
           a partir da referência, não é pixel-perfect). clip-path só
           recorta os OUTROS 3 cantos exatamente no canto da caixa (0 0 /
           100% 0 / 100% 100%), então quem arredonda eles continua sendo o
           border-radius normal — só o 4º ponto (esquerda) e o que vem
           antes dele (base) é que cortam a diagonal de verdade. .-frame é
           só a "moldura" dourada (mesma técnica de padding+background pra
           simular border em cima de um clip-path não-retangular — um
           border CSS comum não acompanha a borda diagonal, fica reto por
           baixo do recorte). */
        .portal-profile-bg-frame {
            position: relative;
            width: 100%;
            aspect-ratio: 445 / 284;
            padding: 1.5px;
            border-radius: 14px;
            background: #DCA15E;
            box-shadow: 12px 15px 11.5px rgba(0, 0, 0, 0.36);
            clip-path: polygon(0 0, 100% 0, 100% 100%, 58% 100%, 0 58%);
        }
        .portal-profile-bg {
            position: relative;
            width: 100%;
            height: 100%;
            border-radius: 13px;
            background: linear-gradient(135deg, #1F1D20 0%, #2A2A2A 35%, #4B2427 65%, #803E30 100%);
            box-shadow: inset 0px 4px 4px rgba(0, 0, 0, 0.25);
            clip-path: polygon(0 0, 100% 0, 100% 100%, 58% 100%, 0 58%);
        }
        .portal-profile-stars {
            position: absolute;
            left: 7%;
            bottom: 5%;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        /* Estrela usa o mesmo glifo "★" já usado em perfil.ejs (Honra) —
           o CSS do Figma só descreve o PREENCHIMENTO (gradiente dourado/
           creme) de um badge, não o formato de estrela em si (isso vem de
           uma máscara vetorial que "copiar CSS" não exporta, só SVG/path
           — se o dono tiver o SVG da estrela, dá pra trocar por um ícone
           exato igual foi feito com os dinossauros). */
        .portal-profile-star {
            font-size: clamp(18px, 2.6vw, 30px);
            line-height: 1;
            color: rgba(248, 220, 192, 0.25);
        }
        .portal-profile-star.is-filled {
            color: #DCA15E;
            text-shadow: 0 0 8px rgba(255, 226, 129, 0.5);
        }

        .portal-profile-text {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            text-align: left;
            gap: 6px;
            padding: 14px 4px 0;
        }
        .portal-profile-name {
            font-family: 'Tilt Warp', cursive;
            font-size: clamp(26px, 5vw, 48px);
            line-height: 1.25;
            color: #F8DCC0;
            text-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5), -5px -5px 10px rgba(0, 0, 0, 0.7);
        }
        .portal-profile-row {
            display: flex;
            align-items: center;
            gap: 10px;
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: clamp(14px, 2vw, 20px);
            color: #F8DCC0;
            filter: drop-shadow(5px 5px 10px rgba(0, 0, 0, 0.5)) drop-shadow(-5px -5px 10px rgba(0, 0, 0, 0.7));
        }
        .portal-profile-icon { width: clamp(20px, 3vw, 32px); height: clamp(20px, 3vw, 32px); flex: none; object-fit: contain; }
        /* Selo azul do Discord (pedido do dono, comparando com a imagem de
           referência) — o ícone genérico provisório (sem o DiscordLOGO.png
           real do dono ainda) fica dentro de um círculo #5865F2 (cor
           oficial "blurple"), igual ao selo vermelho do pot-logo.webp ao
           lado dele já tem de fábrica. */
        .portal-profile-icon-badge {
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #5865F2;
            padding: 18%;
            box-sizing: border-box;
        }
        .portal-profile-icon-badge svg { width: 100%; height: 100%; }

        .dev-overlay { display: flex; align-items: center; justify-content: center; width: 100%; }

        /* Backdrop do aviso "dashboard em desenvolvimento" ao clicar num
           .dashboard-link[data-locked] (mesmo padrão de hero.ejs) — aqui é
           só o clique dentro da própria nav; server-side (locked=true) já
           mostra o cartão direto no lugar do corpo normal, ver mais abaixo. */
        .dev-overlay-backdrop {
            position: fixed;
            inset: 0;
            z-index: 200;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(10, 9, 10, 0.85);
            backdrop-filter: blur(4px);
        }
        .dev-overlay-backdrop[hidden] { display: none; }
    </style>
</head>
<body>

<!-- ===================== NAV (fixa, padrão do site) ===================== -->
<nav class="w-full flex flex-wrap items-center justify-center fixed top-0 left-0 right-0 z-50" style="gap: clamp(10px, 2vw, 20px); padding: 14px 16px; background: rgba(17, 17, 17, 0.92); backdrop-filter: blur(6px); border-bottom: 1px solid #3E3D38;">
    <%# Mesmo slot dinâmico Entrar/Portal de hero.ejs, ver comentário completo lá. %>
    <% if (user) { %>
        <a href="/dashboard" class="dashboard-link absolute left-4 top-1/2 -translate-y-1/2 hidden md:flex items-center gap-2 text-sm opacity-80 hover:opacity-100" <%- (typeof isOwner !== 'undefined' && isOwner) ? '' : 'data-locked="true"' %> style="font-family:'Poppins',sans-serif; color:#F8DCC0; text-decoration:none;">
            <img src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png` : `https://cdn.discordapp.com/embed/avatars/${(user.id % 5)}.png` %>" alt="" style="width:24px; height:24px; border-radius:50%; object-fit:cover; flex:none;">
            <%= (user.nickname || user.global_name || user.username) %>
        </a>
    <% } %>
    <a href="/" class="nav-btn"><span data-i18n-pt>HOME</span><span data-i18n-en>HOME</span></a>
    <% if (user) { %>
        <a href="/dashboard" class="dashboard-link nav-btn is-active" <%- (typeof isOwner !== 'undefined' && isOwner) ? '' : 'data-locked="true"' %>><span data-i18n-pt>PORTAL</span><span data-i18n-en>PORTAL</span></a>
    <% } else { %>
        <a href="/login" class="nav-btn"><span data-i18n-pt>ENTRAR</span><span data-i18n-en>LOGIN</span></a>
    <% } %>
    <a href="/#premium" class="nav-btn"><span data-i18n-pt>PREMIUM</span><span data-i18n-en>PREMIUM</span></a>
    <a href="/documentacao" class="nav-btn"><span data-i18n-pt>DOCUMENTAÇÃO</span><span data-i18n-en>DOCUMENTATION</span></a>
    <a href="https://discord.gg/fkD5FQktn6" target="_blank" rel="noopener" class="nav-btn"><span data-i18n-pt>SUPORTE</span><span data-i18n-en>SUPPORT</span></a>
    <button type="button" class="lang-toggle" id="langToggleBtn" onclick="toggleLang()" aria-label="Switch language to English">
        <span class="lang-toggle-flag lang-toggle-flag-pt" aria-hidden="true"><img src="/images/flag-br.webp" alt=""></span>
        <span class="lang-toggle-flag lang-toggle-flag-en" aria-hidden="true"><img src="/images/flag-us.webp" alt=""></span>
    </button>
</nav>
<script>
    (function () {
        function syncNavHeight() {
            var nav = document.querySelector('nav');
            if (nav) document.documentElement.style.setProperty('--nav-height', nav.offsetHeight + 'px');
        }
        syncNavHeight();
        window.addEventListener('resize', syncNavHeight);
        window.addEventListener('load', syncNavHeight);
        if (window.document.fonts && window.document.fonts.ready) {
            window.document.fonts.ready.then(syncNavHeight);
        }
    })();
</script>

<div class="min-h-screen w-full flex flex-col items-stretch p-4 sm:p-6 md:p-8 portal-hero-padding"
     style="background: linear-gradient(180deg, #252326 0%, #1F1D20 54.34%, #131314 98.29%);">

    <div class="flex-1 flex flex-col items-center justify-center w-full" style="gap: clamp(28px, 5vw, 56px); padding: clamp(16px, 3vw, 32px) 0;">

        <!-- Seção Superior: Logo e Boas-vindas -->
        <div class="flex flex-col items-center w-full" style="gap: clamp(20px, 3vw, 32px);">
            <div class="flex items-center justify-center" style="width: clamp(170px, 25vw, 300px);">
                <img src="/images/landing/titans-pass-logo.webp"
                     alt="Titan's Pass Logo" class="w-full h-auto object-contain" style="max-height: clamp(130px, 18vw, 210px);">
            </div>

            <div class="text-center px-4">
                <p class="section-title leading-tight mb-1" style="font-size: clamp(16px, 2.2vw, 26px);">
                    <span data-i18n-pt>BEM VINDO AO PORTAL DE TITAN'S PASS</span>
                    <span data-i18n-en>WELCOME TO THE TITAN'S PASS PORTAL</span>
                </p>
                <p class="text-titan-cream" style="font-family: 'Poppins', sans-serif; font-size: clamp(12px, 1.3vw, 16px);">
                    <% if (typeof locked !== 'undefined' && locked) { %>
                        <span data-i18n-pt>Voltamos em breve</span><span data-i18n-en>We'll be back soon</span>
                    <% } else if (user) { %>
                        <span data-i18n-pt>O que quer fazer hoje?</span><span data-i18n-en>What do you want to do today?</span>
                    <% } else { %>
                        <span data-i18n-pt>Entre para gerenciar seus servidores</span><span data-i18n-en>Log in to manage your servers</span>
                    <% } %>
                </p>
            </div>
        </div>

        <% if (typeof locked !== 'undefined' && locked) { %>
            <div class="dev-overlay">
                <%- include('partials/dev-overlay-card') %>
            </div>
        <% } else if (!user) { %>
            <div class="flex flex-col items-center gap-6">
                <a href="/login" class="btn-primary">
                    <span class="btn-primary-icon"></span>
                    <span data-i18n-pt>ENTRAR COM DISCORD</span><span data-i18n-en>LOG IN WITH DISCORD</span>
                </a>
            </div>
        <% } else { %>
            <%#
                Colunas (pedido do dono, 2026-08-06). Empilha em telas
                estreitas (flex-col) — ver regra web_ui_always_responsive.
                Preenche a tela (sem max-width), margem lateral de 80px
                (clamp — encolhe em telas estreitas), proporção parecida com
                as colunas de preço do Player/Server Premium na home (ver
                hero.ejs #premium). Coluna "Entrar na Toca" foi removida
                (pedido do dono, 2026-08-06: "não faz muito sentido ter o
                card de perfil e a toca") — o próprio card de perfil é o
                link pra /perfil, sem head nem separador entre as colunas
                (o gap do container já dá respiro suficiente). Coluna
                "Dashboard do seu servidor" só existe pra quem administra
                algum servidor com o bot (mesmo getAdminGuildsWithBot de
                sempre) — grade sempre com no mínimo 6 ícones, ver
                portalFillerVariants mais abaixo.
            %>
            <div class="w-full flex flex-col md:flex-row items-stretch justify-center" style="gap: 40px; padding: 0 clamp(16px, 6vw, 80px);">
                <div class="flex-1 flex flex-col items-center text-center gap-5" style="padding: 8px 24px; min-width: 0;">
                    <% if (profile) { %>
                        <a href="/perfil" class="portal-profile-link">
                            <div class="portal-profile-card">
                                <div class="portal-profile-bg-frame">
                                    <div class="portal-profile-bg">
                                        <div class="portal-profile-stars">
                                            <% for (let i = 1; i <= 5; i++) { %><span class="portal-profile-star<%= i <= profile.honorStars ? ' is-filled' : '' %>">★</span><% } %>
                                        </div>
                                    </div>
                                </div>
                                <div class="portal-profile-text">
                                    <span class="portal-profile-name"><%= profile.nickname %></span>
                                    <span class="portal-profile-row">
                                        <img src="/images/pot-logo.webp" alt="" class="portal-profile-icon">
                                        <%= profile.alderonId %>
                                    </span>
                                    <span class="portal-profile-row">
                                        <span class="portal-profile-icon portal-profile-icon-badge">
                                            <svg viewBox="0 0 24 24" fill="#F8DCC0" aria-hidden="true"><path d="M20.317 4.369A19.79 19.79 0 0 0 15.885 3c-.211.375-.444.879-.608 1.276a18.27 18.27 0 0 0-5.487 0A12.6 12.6 0 0 0 9.182 3a19.74 19.74 0 0 0-4.435 1.372C1.42 8.945.663 13.41.995 17.813a19.9 19.9 0 0 0 5.993 3.03c.483-.66.913-1.36 1.284-2.098a12.9 12.9 0 0 1-2.023-.975c.17-.124.336-.253.497-.386 3.902 1.803 8.13 1.803 11.986 0 .163.133.329.262.497.386-.646.386-1.323.71-2.025.976.372.737.8 1.437 1.284 2.098a19.86 19.86 0 0 0 6-3.031c.39-5.104-.664-9.53-2.79-13.444ZM8.02 15.116c-1.172 0-2.136-1.087-2.136-2.419 0-1.333.944-2.42 2.136-2.42s2.157 1.087 2.136 2.42c.002 1.332-.944 2.42-2.136 2.42Zm7.96 0c-1.172 0-2.136-1.087-2.136-2.419 0-1.333.944-2.42 2.136-2.42s2.157 1.087 2.136 2.42c0 1.332-.944 2.42-2.136 2.42Z"/></svg>
                                        </span>
                                        <%= profile.discordUsername %>
                                    </span>
                                </div>
                            </div>
                        </a>
                    <% } else { %>
                        <p style="font-family: 'Poppins', sans-serif; font-size: 13px; opacity: 0.6; max-width: 320px;">
                            <span data-i18n-pt>Sua conta Discord ainda não está vinculada a um jogador de Path of Titans. Use <code>/registrar</code> no Discord pra ver seu card aqui.</span>
                            <span data-i18n-en>Your Discord account isn't linked to a Path of Titans player yet. Use <code>/registrar</code> on Discord to see your card here.</span>
                        </p>
                        <a href="/perfil" class="btn-primary" style="min-width:0; height:36px; font-size:14px; padding:5px 20px;">
                            <span data-i18n-pt>IR PRO PERFIL</span><span data-i18n-en>GO TO PROFILE</span>
                        </a>
                    <% } %>
                </div>

                <% if (guilds.length > 0) { %>
                    <%
                        // Grade sempre com no mínimo 6 ícones (pedido do dono,
                        // 2026-08-06: "manter sempre no mínimo 6 ícones... usar
                        // os ícones de dinossauro aleatoriamente pra preencher,
                        // assim visualmente criamos uma harmonia mesmo que o
                        // usuário só tenha um servidor pra administrar") —
                        // completa com dinossauros (ver partials/dino-icon.ejs,
                        // sorteados entre as 4 variantes exportadas do Figma)
                        // só decorativos, sem link (não existe servidor real
                        // por trás deles). Layout/tamanho/sombra do tile vêm do
                        // Frame 11934 do Figma (ver .portal-server-tile no
                        // <style>) — servidor real usa border #3E3D38 e link
                        // pra /moderacao/:guildID, igual já era antes.
                        const PORTAL_DINO_VARIANTS = ['trike', 'rex', 'bronto', 'stego'];
                        const PORTAL_MIN_TILES = 6;
                        const portalFillerCount = Math.max(0, PORTAL_MIN_TILES - guilds.length);
                        function portalShuffledDinoDeck() {
                            const deck = PORTAL_DINO_VARIANTS.slice();
                            for (let i = deck.length - 1; i > 0; i--) {
                                const j = Math.floor(Math.random() * (i + 1));
                                [deck[i], deck[j]] = [deck[j], deck[i]];
                            }
                            return deck;
                        }
                        // Reembaralha a cada volta completa pelas 4 variantes —
                        // só importa quando portalFillerCount > 4 (usuário com
                        // 0-1 servidor real), pra não repetir a mesma logo em
                        // seguida ao "dar a volta" no baralho.
                        const portalFillerVariants = [];
                        let portalDinoDeck = [];
                        for (let i = 0; i < portalFillerCount; i++) {
                            if (i % PORTAL_DINO_VARIANTS.length === 0) portalDinoDeck = portalShuffledDinoDeck();
                            portalFillerVariants.push(portalDinoDeck[i % PORTAL_DINO_VARIANTS.length]);
                        }
                    %>
                    <div class="flex-1 flex flex-col items-center text-center gap-5" style="padding: 8px 24px; min-width: 0;">
                        <h3 class="portal-col-head">DASHBOARD</h3>
                        <div class="grid"
                             style="grid-template-columns: repeat(3, minmax(60px, 100px)); gap: clamp(12px, 2.5vw, 25px); width: 100%; max-width: 375px;">
                            <% guilds.forEach(guild => { %>
                                <a href="/moderacao/<%= guild.id %>" class="portal-server-tile">
                                    <% if (guild.icon) { %>
                                        <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" class="guild-icon-img">
                                    <% } else { %>
                                        <img src="/images/guild-fallback-<%= (guild.id % 4) + 1 %>.svg" class="guild-icon-img">
                                    <% } %>
                                </a>
                            <% }); %>
                            <% portalFillerVariants.forEach((variant, i) => { %>
                                <div class="portal-server-tile is-filler" aria-hidden="true">
                                    <%- include('partials/dino-icon', { variant, instanceId: 'portalfill' + i }) %>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>

    <!-- Footer -->
    <div class="text-center py-2 flex flex-col items-center gap-1">
        <a href="/termos" class="text-titan-cream opacity-60 hover:opacity-100 underline" style="font-family: 'Poppins', sans-serif; font-size: 14px;">
            <span data-i18n-pt>Termos de Serviço</span><span data-i18n-en>Terms of Service</span>
        </a>
        <% if (user) { %>
            <a href="/logout" class="text-titan-cream opacity-60 hover:opacity-100 underline" style="font-family: 'Poppins', sans-serif; font-size: 14px;">
                <span data-i18n-pt>Sair</span><span data-i18n-en>Log out</span>
            </a>
        <% } %>
        <span class="text-titan-cream opacity-60" style="font-family: 'Poppins', sans-serif; font-size: 16px;">
            BY: KNUST SEIER VI
        </span>
    </div>
</div>

<%# Overlay do botão Portal travado, mesmo padrão de hero.ejs (ver DASHBOARD_LOCKED_TO_OWNER em dashboard.js). %>
<div class="dev-overlay-backdrop" id="devOverlay" hidden>
    <%- include('partials/dev-overlay-card') %>
</div>

<script>
    (function () {
        var overlay = document.getElementById('devOverlay');
        if (!overlay) return;

        function openOverlay() { overlay.hidden = false; }
        function closeOverlay() { overlay.hidden = true; }

        document.querySelectorAll('.dashboard-link[data-locked]').forEach(function (link) {
            link.addEventListener('click', function (e) {
                e.preventDefault();
                openOverlay();
            });
        });
        overlay.addEventListener('click', function (e) {
            if (e.target === overlay) closeOverlay();
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeOverlay();
        });
    })();

    (function () {
        const stored = localStorage.getItem('titanspass_lang') || 'pt';
        document.documentElement.setAttribute('data-lang', stored);
        updateLangToggleLabel(stored);
    })();

    function updateLangToggleLabel(current) {
        const btn = document.getElementById('langToggleBtn');
        if (btn) btn.setAttribute('aria-label', current === 'pt' ? 'Switch language to English' : 'Mudar idioma para português');
    }

    function toggleLang() {
        const current = document.documentElement.getAttribute('data-lang') || 'pt';
        const next = current === 'pt' ? 'en' : 'pt';
        document.documentElement.setAttribute('data-lang', next);
        localStorage.setItem('titanspass_lang', next);
        updateLangToggleLabel(next);
    }
</script>

</body>
</html>
