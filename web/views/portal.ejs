<%#
  web/views/portal.ejs
  "Portal" (pedido do dono, 2026-08-06) — nova entrada única pra quem está
  logado, no lugar dos antigos botões separados DASHBOARD/PERFIL na nav.
  Renomeado de index.ejs (era a página em /dashboard, "Seleção de
  Servidores") — mesma rota GET /dashboard em dashboard.js, só o
  res.render/conteúdo mudou. 2 colunas: card de perfil (atalho pra
  /perfil completo, "Toca") e escolha de servidor (só pra quem administra
  algum, mesmo getAdminGuildsWithBot de sempre). /perfil continua
  existindo do jeito que está, com a mesma sidebar restrita — só deixou
  de ter link direto na nav do site.

  Card de perfil — a MESMA imagem PNG que o /perfil gera no Discord
  (renderProfileCard, ver playerRegistrationSystem.sendProfile),
  reaproveitada direto aqui. Chegou a virar um card HTML/CSS ao vivo
  (Figma "Group 14", pedido do dono 2026-08-06) mas voltou pra imagem
  oficial (pedido do dono, 2026-08-06: "vai voltar a ser a imagem
  oficial que geramos pelo Discord, remova o que fizemos em HTML sobre
  ela") — sem vínculo (ou falha no render), profileCard fica null e a
  página mostra a mensagem de "use /registrar" no lugar.

  Grade de servidores sempre com no mínimo 6 ícones (pedido do dono,
  2026-08-06) — preenchida com ícones de dinossauro decorativos quando o
  usuário administra menos de 6 servidores reais (ver partials/
  dino-icon.ejs).

  Uso: res.render('portal', { guilds, locked, profileCard }) — ver
  dashboard.js GET /dashboard.
%>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal | <%= bot.user.username %></title>

    <!-- Fontes -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Tilt+Warp&family=Bebas+Neue&display=swap" rel="stylesheet">

    <!-- Tailwind CDN (mesmo padrão do resto do dashboard) -->
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'titan-dark': '#1F1D20',
                        'titan-cream': '#F8DCC0',
                        'titan-accent': '#803E30',
                    }
                }
            }
        }
    </script>

    <style>
        html, body { margin: 0; padding: 0; overflow-x: hidden; max-width: 100%; background: #111111; }
        [data-i18n-en] { display: none; }
        html[data-lang="en"] [data-i18n-pt] { display: none; }
        html[data-lang="en"] [data-i18n-en] { display: initial; }

        .guild-icon-img { width: 100%; height: 100%; object-fit: cover; border-radius: inherit; }

        /* Tile da grade "DASHBOARD" (Figma Frame 11934, pedido do dono
           2026-08-06) — servidor real E preenchimento (.is-filler, ver
           partials/dino-icon.ejs) usam a MESMA moldura CSS (border/
           box-shadow/border-radius, família "USER/SERVER Icon" já usada
           no resto do site). Bug encontrado pelo dono, 2026-08-06 ("ainda
           está péssimo essa construção"): antes cada dino trazia a
           própria moldura dentro do <svg> (herdada do export do Figma),
           escalada junto com um monte de espaço morto ao redor só pra
           sombra sangrar — ficava bem menor que o ícone de servidor real
           (que preenche o tile inteiro) e desalinhado. Unificar a moldura
           aqui fora (dino-icon.ejs manda só a arte, recortada pro
           conteúdo de verdade) resolve os dois: tamanho igual E cor de
           borda certa (só a cor muda por tile — real usa #3E3D38 fixo
           daqui, dino recebe a cor certa via style inline, ver
           PORTAL_DINO_BORDER_COLORS mais abaixo). */
        .portal-server-tile {
            display: flex;
            align-items: center;
            justify-content: center;
            aspect-ratio: 1 / 1;
            cursor: pointer;
            box-sizing: border-box;
            border-radius: 15px;
            border: 2px solid #3E3D38;
            background: #2A2A2A;
            box-shadow: 0px 12px 18px 11px rgba(1, 2, 10, 0.45);
            overflow: hidden;
            transition: transform 0.2s ease, border-color 0.2s ease;
        }
        .portal-server-tile:not(.is-filler):hover { border-color: #803E30; transform: scale(1.05); }
        .portal-server-tile.is-filler { pointer-events: none; }

        /* Componente .btn-primary (Figma node 250-59) - mesma definicao de web/public/css/style.css,
           duplicada aqui pq esta pagina usa um <style> proprio em vez do stylesheet compartilhado. */
        .btn-primary {
            box-sizing: border-box;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 5px 20px;
            gap: 10px;
            min-width: 232px;
            height: 39px;
            background: #2A2A2A;
            border: 1px solid #803E30;
            border-radius: 15px;
            box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5), -5px -5px 10px rgba(0, 0, 0, 0.7);
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 20px;
            line-height: 30px;
            color: #F8DCC0;
            text-decoration: none;
            cursor: pointer;
            transition: background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
        }
        .btn-primary-icon {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: currentColor;
            flex: none;
        }
        .btn-primary:hover {
            background: #803E30;
            border-color: #F8DCC0;
            box-shadow: -5px -5px 10px rgba(0, 0, 0, 0.5), 5px 5px 10px rgba(0, 0, 0, 0.5),
                        10px 10px 20px rgba(0, 0, 0, 0.5), -10px -10px 20px rgba(0, 0, 0, 0.5);
        }
        .btn-primary:active {
            background: #4B2427;
            border-color: #803E30;
            box-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5), -1px -1px 2px rgba(0, 0, 0, 0.5),
                        inset 0px 8px 7.8px rgba(0, 0, 0, 0.59);
        }

        /* Barra de navegação padrão do site (mesma de hero.ejs — pedido do
           dono, 2026-08-06: "devemos ter ainda a mesma barra de navegação
           no top de home"). Fixa, então o conteúdo abaixo compensa com
           --nav-height via padding-top INLINE no <div> do gradiente
           (ver mais abaixo) — não um padding-top em classe própria,
           porque colidiria em especificidade com o padding do próprio
           Tailwind (p-4/sm:p-6/md:p-8) que já está no mesmo elemento;
           inline sempre ganha, sem depender da ordem de injeção do
           script do Tailwind. */
        .nav-btn {
            box-sizing: border-box;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 5px 20px;
            gap: 10px;
            height: 30px;
            background: #2A2A2A;
            border: 1px solid #803E30;
            border-radius: 15px;
            box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5), -5px -5px 10px rgba(0, 0, 0, 0.7);
            font-family: 'Poppins', sans-serif;
            font-weight: 300;
            font-size: 14px;
            color: #F8DCC0;
            text-decoration: none;
            white-space: nowrap;
            transition: background 0.15s ease, border-color 0.15s ease;
        }
        .nav-btn:hover { background: #803E30; border-color: #F8DCC0; }
        .nav-btn.is-active { background: #4B2427; border-color: #DCA15E; }
        .nav-btn:active {
            background: #4B2427;
            border-color: #803E30;
            box-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5), -1px -1px 2px rgba(0, 0, 0, 0.5), inset 0px 8px 7.8px rgba(0, 0, 0, 0.59);
        }
        /* Botão de idioma redesenhado (pedido do dono, 2026-08-06) — ver
           comentário completo em hero.ejs. */
        .lang-toggle {
            position: relative;
            display: inline-flex;
            align-items: center;
            width: 52px;
            height: 36px;
            background: none;
            border: none;
            padding: 0;
            cursor: pointer;
            flex: none;
        }
        .lang-toggle-flag {
            position: absolute;
            top: 2px;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            overflow: hidden;
            background: #2A2A2A;
            border: 1px solid #803E30;
            box-shadow: 3px 4px 8px rgba(0, 0, 0, 0.5);
            transition: left 0.2s ease, border-color 0.15s ease;
        }
        .lang-toggle-flag img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .lang-toggle:hover .lang-toggle-flag { border-color: #F8DCC0; }
        .lang-toggle-flag-pt { left: 0; z-index: 2; }
        .lang-toggle-flag-en { left: 18px; z-index: 1; }
        html[data-lang="en"] .lang-toggle-flag-pt { left: 18px; z-index: 1; }
        html[data-lang="en"] .lang-toggle-flag-en { left: 0; z-index: 2; }

        .section-title {
            font-family: 'Tilt Warp', sans-serif;
            font-size: clamp(22px, 3vw, 32px);
            text-transform: uppercase;
            color: #F8DCC0;
        }
        .portal-col-head {
            font-family: 'Tilt Warp', cursive;
            font-size: clamp(20px, 2.4vw, 26px);
            text-transform: uppercase;
            color: #F8DCC0;
        }
        /* Separador entre o card de perfil e a coluna Dashboard (pedido do
           dono, 2026-08-06: "aumente a distância em 2x... adicione um
           pequeno separador padrão vertical entre eles") — mesma cor/
           espessura (#3E3D38, 1px) dos separadores horizontais padrão do
           site (ver hero.ejs), só girado 90°. Não precisou mexer no gap
           do container pra dobrar a distância: virando um 3º item do
           flex, o MESMO gap:50px passa a valer duas vezes (col->separador,
           separador->col) — 50+linha+50 já é o dobro dos 50px de antes.
           align-self:stretch faz a linha acompanhar a altura da fileira
           inteira (governada por items-center no container pai — as duas
           colunas não são mais forçadas à mesma altura, ver comentário
           da imagem de perfil mais abaixo). Horizontal no mobile
           (empilhado) — uma linha vertical entre dois blocos empilhados
           não faria sentido visual nenhum. */
        .portal-col-separator {
            flex: none;
            align-self: stretch;
            width: 100%;
            max-width: 280px;
            border-top: 1px solid #3E3D38;
        }
        @media (min-width: 768px) {
            .portal-col-separator {
                width: 1px;
                max-width: none;
                border-top: none;
                border-left: 1px solid #3E3D38;
            }
        }
        /* Imagem do card de perfil é o link pra "Toca" (/perfil, pedido do
           dono, 2026-08-06) — mesmo tipo de affordance de hover já usado
           nos ícones de servidor da coluna ao lado (leve scale + borda
           acesa). */
        .portal-profile-link { display: inline-block; transition: transform 0.15s ease; }
        .portal-profile-link:hover { transform: scale(1.02); }
        .portal-profile-link img { display: block; transition: box-shadow 0.15s ease; }
        .portal-profile-link:hover img { box-shadow: -10px 20px 35px rgba(0, 0, 0, 0.6), 0 0 0 2px #DCA15E; }
        /* Só usado enquanto DASHBOARD_LOCKED_TO_OWNER estiver true de novo
           (dashboard.js) — mostra o cartão "em desenvolvimento" no lugar do
           corpo normal do Portal (ver `locked` mais abaixo). Trava de
           clique redundante na nav (interceptava .dashboard-link mesmo com
           a rota já destravada) removida em 2026-08-10, pedido do dono:
           "Libere a trava de todo o site para que todos testem". */
        .dev-overlay { display: flex; align-items: center; justify-content: center; width: 100%; }
    </style>
</head>
<body>

<!-- ===================== NAV (fixa, padrão do site) ===================== -->
<nav class="w-full flex flex-wrap items-center justify-center fixed top-0 left-0 right-0 z-50" style="gap: clamp(10px, 2vw, 20px); padding: 14px 16px; background: rgba(17, 17, 17, 0.92); backdrop-filter: blur(6px); border-bottom: 1px solid #3E3D38;">
    <%# Mesmo slot dinâmico Entrar/Portal de hero.ejs, ver comentário completo lá. %>
    <% if (user) { %>
        <a href="/dashboard" class="dashboard-link absolute left-4 top-1/2 -translate-y-1/2 hidden md:flex items-center gap-2 text-sm opacity-80 hover:opacity-100" style="font-family:'Poppins',sans-serif; color:#F8DCC0; text-decoration:none;">
            <img src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png` : `https://cdn.discordapp.com/embed/avatars/${(user.id % 5)}.png` %>" alt="" style="width:24px; height:24px; border-radius:50%; object-fit:cover; flex:none;">
            <%= (user.nickname || user.global_name || user.username) %>
        </a>
    <% } %>
    <a href="/" class="nav-btn"><span data-i18n-pt>HOME</span><span data-i18n-en>HOME</span></a>
    <% if (user) { %>
        <a href="/dashboard" class="dashboard-link nav-btn is-active"><span data-i18n-pt>PORTAL</span><span data-i18n-en>PORTAL</span></a>
    <% } else { %>
        <a href="/login" class="nav-btn"><span data-i18n-pt>ENTRAR</span><span data-i18n-en>LOGIN</span></a>
    <% } %>
    <a href="/#premium" class="nav-btn"><span data-i18n-pt>PREMIUM</span><span data-i18n-en>PREMIUM</span></a>
    <a href="/loja" class="nav-btn"><span data-i18n-pt>LOJA</span><span data-i18n-en>SHOP</span></a>
    <a href="/documentacao" class="nav-btn"><span data-i18n-pt>DOCUMENTAÇÃO</span><span data-i18n-en>DOCUMENTATION</span></a>
    <a href="https://discord.gg/fkD5FQktn6" target="_blank" rel="noopener" class="nav-btn"><span data-i18n-pt>SUPORTE</span><span data-i18n-en>SUPPORT</span></a>
    <button type="button" class="lang-toggle" id="langToggleBtn" onclick="toggleLang()" aria-label="Switch language to English">
        <span class="lang-toggle-flag lang-toggle-flag-pt" aria-hidden="true"><img src="/images/flag-br.webp" alt=""></span>
        <span class="lang-toggle-flag lang-toggle-flag-en" aria-hidden="true"><img src="/images/flag-us.webp" alt=""></span>
    </button>
</nav>
<script>
    (function () {
        function syncNavHeight() {
            var nav = document.querySelector('nav');
            if (nav) document.documentElement.style.setProperty('--nav-height', nav.offsetHeight + 'px');
        }
        syncNavHeight();
        window.addEventListener('resize', syncNavHeight);
        window.addEventListener('load', syncNavHeight);
        if (window.document.fonts && window.document.fonts.ready) {
            window.document.fonts.ready.then(syncNavHeight);
        }
    })();
</script>

<div class="min-h-screen w-full flex flex-col items-stretch p-4 sm:p-6 md:p-8"
     style="background: linear-gradient(180deg, #252326 0%, #1F1D20 54.34%, #131314 98.29%); padding-top: calc(var(--nav-height, 84px) + 16px);">

    <div class="flex-1 flex flex-col items-center justify-center w-full" style="gap: clamp(28px, 5vw, 56px); padding: clamp(16px, 3vw, 32px) 0;">

        <!-- Seção Superior: Logo e Boas-vindas -->
        <div class="flex flex-col items-center w-full" style="gap: clamp(20px, 3vw, 32px);">
            <div class="flex items-center justify-center" style="width: clamp(170px, 25vw, 300px);">
                <img src="/images/landing/titans-pass-logo.webp"
                     alt="Titan's Pass Logo" class="w-full h-auto object-contain" style="max-height: clamp(130px, 18vw, 210px);">
            </div>

            <div class="text-center px-4">
                <p class="section-title leading-tight mb-1" style="font-size: clamp(16px, 2.2vw, 26px);">
                    <span data-i18n-pt>BEM VINDO AO PORTAL DE TITAN'S PASS</span>
                    <span data-i18n-en>WELCOME TO THE TITAN'S PASS PORTAL</span>
                </p>
                <p class="text-titan-cream" style="font-family: 'Poppins', sans-serif; font-size: clamp(12px, 1.3vw, 16px);">
                    <% if (typeof locked !== 'undefined' && locked) { %>
                        <span data-i18n-pt>Voltamos em breve</span><span data-i18n-en>We'll be back soon</span>
                    <% } else if (user) { %>
                        <span data-i18n-pt>O que quer fazer hoje?</span><span data-i18n-en>What do you want to do today?</span>
                    <% } else { %>
                        <span data-i18n-pt>Entre para gerenciar seus servidores</span><span data-i18n-en>Log in to manage your servers</span>
                    <% } %>
                </p>
            </div>
            <%- include('partials/testing-phase-banner-standalone') %>
        </div>

        <% if (typeof locked !== 'undefined' && locked) { %>
            <div class="dev-overlay">
                <%- include('partials/dev-overlay-card') %>
            </div>
        <% } else if (!user) { %>
            <div class="flex flex-col items-center gap-6">
                <a href="/login" class="btn-primary">
                    <span class="btn-primary-icon"></span>
                    <span data-i18n-pt>ENTRAR COM DISCORD</span><span data-i18n-en>LOG IN WITH DISCORD</span>
                </a>
            </div>
        <% } else { %>
            <%#
                Colunas (pedido do dono, 2026-08-06, ajustado 2026-08-06:
                "alinhe os dois ao centro da página com uma margem de
                50px entre os dois") — grupo compacto centralizado na
                página (sem flex-1 nas colunas, senão cada uma cresce pra
                preencher o espaço disponível e o gap visual fica maior
                que os 50px pedidos), não mais esticado de ponta a ponta.
                Empilha em telas estreitas (flex-col) — ver regra
                web_ui_always_responsive. Coluna "Entrar na Toca" foi
                removida (pedido do dono: "não faz muito sentido ter o
                card de perfil e a toca") — o próprio card de perfil é o
                link pra /perfil. Coluna "Dashboard" só existe pra quem
                administra algum servidor com o bot (mesmo
                getAdminGuildsWithBot de sempre) — grade sempre com no
                mínimo 6 ícones, ver portalFillerVariants mais abaixo.

                Card de perfil voltou a ser a imagem PNG oficial (pedido
                do dono, 2026-08-06: "vai voltar a ser a imagem oficial
                que geramos pelo Discord, remova o que fizemos em HTML
                sobre ela") — sem sincronia de altura com a coluna
                Dashboard (isso era específico do card HTML/CSS que saiu;
                forçar uma imagem de proporção fixa a bater altura com
                outra coluna espremeria ou vazaria largura à toa). Volta
                ao tamanho de sempre (width:100%, max-width:520px).
            %>
            <div class="w-full flex flex-col md:flex-row justify-center items-center" style="gap: 50px; padding: 0 16px;">
                <div class="flex flex-col items-center text-center gap-5" style="min-width: 0;">
                    <% if (profileCard) { %>
                        <a href="/perfil" class="portal-profile-link">
                            <img src="<%= profileCard %>" alt="" style="width: 100%; max-width: 520px; border-radius: 14px; box-shadow: -10px 20px 35px rgba(0, 0, 0, 0.6);">
                        </a>
                    <% } else { %>
                        <p style="font-family: 'Poppins', sans-serif; font-size: 13px; opacity: 0.6; max-width: 320px;">
                            <span data-i18n-pt>Sua conta Discord ainda não está vinculada a um jogador de Path of Titans. Use <code>/registrar</code> no Discord pra ver seu card aqui.</span>
                            <span data-i18n-en>Your Discord account isn't linked to a Path of Titans player yet. Use <code>/registrar</code> on Discord to see your card here.</span>
                        </p>
                        <a href="/perfil" class="btn-primary" style="min-width:0; height:36px; font-size:14px; padding:5px 20px;">
                            <span data-i18n-pt>IR PRO PERFIL</span><span data-i18n-en>GO TO PROFILE</span>
                        </a>
                    <% } %>
                </div>

                <% if (profileCard && guilds.length > 0) { %>
                    <div class="portal-col-separator" aria-hidden="true"></div>
                <% } %>

                <% if (guilds.length > 0) { %>
                    <%
                        // Grade sempre com no mínimo 6 ícones (pedido do dono,
                        // 2026-08-06: "manter sempre no mínimo 6 ícones... usar
                        // os ícones de dinossauro aleatoriamente pra preencher,
                        // assim visualmente criamos uma harmonia mesmo que o
                        // usuário só tenha um servidor pra administrar") —
                        // completa com dinossauros (ver partials/dino-icon.ejs,
                        // sorteados entre as 4 variantes exportadas do Figma)
                        // só decorativos, sem link (não existe servidor real
                        // por trás deles). Layout/tamanho/sombra do tile vêm do
                        // Frame 11934 do Figma (ver .portal-server-tile no
                        // <style>) — servidor real usa border #3E3D38 e link
                        // pra /moderacao/:guildID, igual já era antes.
                        const PORTAL_DINO_VARIANTS = ['trike', 'rex', 'bronto', 'stego'];
                        // Cor de borda por variante (Figma Frame 11934: Trike/
                        // Bronto=#803E30, Rex/Stego=#4B2427) — agora aplicada
                        // pelo .portal-server-tile de fora (ver comentário no
                        // <style>), não mais desenhada dentro do <svg>.
                        const PORTAL_DINO_BORDER_COLORS = { trike: '#803E30', rex: '#4B2427', bronto: '#803E30', stego: '#4B2427' };
                        const PORTAL_MIN_TILES = 6;
                        const portalFillerCount = Math.max(0, PORTAL_MIN_TILES - guilds.length);
                        function portalShuffledDinoDeck() {
                            const deck = PORTAL_DINO_VARIANTS.slice();
                            for (let i = deck.length - 1; i > 0; i--) {
                                const j = Math.floor(Math.random() * (i + 1));
                                [deck[i], deck[j]] = [deck[j], deck[i]];
                            }
                            return deck;
                        }
                        // Reembaralha a cada volta completa pelas 4 variantes —
                        // só importa quando portalFillerCount > 4 (usuário com
                        // 0-1 servidor real), pra não repetir a mesma logo em
                        // seguida ao "dar a volta" no baralho.
                        const portalFillerVariants = [];
                        let portalDinoDeck = [];
                        for (let i = 0; i < portalFillerCount; i++) {
                            if (i % PORTAL_DINO_VARIANTS.length === 0) portalDinoDeck = portalShuffledDinoDeck();
                            portalFillerVariants.push(portalDinoDeck[i % PORTAL_DINO_VARIANTS.length]);
                        }
                    %>
                    <div class="flex flex-col items-center justify-center text-center gap-5" style="min-width: 0;">
                        <h3 class="portal-col-head">DASHBOARD</h3>
                        <div class="grid"
                             style="grid-template-columns: repeat(3, minmax(60px, 100px)); gap: clamp(12px, 2.5vw, 25px); width: 100%; max-width: 375px;">
                            <% guilds.forEach(guild => { %>
                                <a href="/moderacao/<%= guild.id %>" class="portal-server-tile">
                                    <% if (guild.icon) { %>
                                        <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" class="guild-icon-img">
                                    <% } else { %>
                                        <img src="/images/guild-fallback-<%= (guild.id % 4) + 1 %>.svg" class="guild-icon-img">
                                    <% } %>
                                </a>
                            <% }); %>
                            <% portalFillerVariants.forEach((variant, i) => { %>
                                <div class="portal-server-tile is-filler" style="border-color: <%= PORTAL_DINO_BORDER_COLORS[variant] %>;" aria-hidden="true">
                                    <%- include('partials/dino-icon', { variant, instanceId: 'portalfill' + i }) %>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>

    <!-- Footer -->
    <div class="text-center py-2 flex flex-col items-center gap-1">
        <a href="/termos" class="text-titan-cream opacity-60 hover:opacity-100 underline" style="font-family: 'Poppins', sans-serif; font-size: 14px;">
            <span data-i18n-pt>Termos de Serviço</span><span data-i18n-en>Terms of Service</span>
        </a>
        <% if (user) { %>
            <a href="/logout" class="text-titan-cream opacity-60 hover:opacity-100 underline" style="font-family: 'Poppins', sans-serif; font-size: 14px;">
                <span data-i18n-pt>Sair</span><span data-i18n-en>Log out</span>
            </a>
        <% } %>
        <span class="text-titan-cream opacity-60" style="font-family: 'Poppins', sans-serif; font-size: 16px;">
            BY: KNUST SEIER VI
        </span>
    </div>
</div>

<script>
    (function () {
        const stored = localStorage.getItem('titanspass_lang') || 'pt';
        document.documentElement.setAttribute('data-lang', stored);
        updateLangToggleLabel(stored);
    })();

    function updateLangToggleLabel(current) {
        const btn = document.getElementById('langToggleBtn');
        if (btn) btn.setAttribute('aria-label', current === 'pt' ? 'Switch language to English' : 'Mudar idioma para português');
    }

    function toggleLang() {
        const current = document.documentElement.getAttribute('data-lang') || 'pt';
        const next = current === 'pt' ? 'en' : 'pt';
        document.documentElement.setAttribute('data-lang', next);
        localStorage.setItem('titanspass_lang', next);
        updateLangToggleLabel(next);
    }
</script>

</body>
</html>
