<%#
  web/views/partials/top-nav.ejs
  ============================================================================
  Barra de navegação fixa do topo — pedido do dono, 2026-08-13: "Pegue a
  barra de navegação do topo que temos em home e documentação e deixa ela
  permanente em todos os sites." Antes disto, esta barra (HOME/PORTAL-
  ENTRAR/PREMIUM/LOJA/DOCUMENTAÇÃO/SUPORTE + toggle de idioma) existia
  duplicada 4x, quase idêntica (hero.ejs/documentacao.ejs/portal.ejs/
  termos.ejs — documentacao.ejs tinha uma deriva não-intencional,
  .nav-btn a 16px em vez de 14px como as outras 3; padronizado aqui pra
  14px). Agora vive só aqui, incluída também nas ~10 páginas que só
  tinham a sidebar (dashboard) e em dev-lojas.ejs (que não tem sidebar
  nem barra nenhuma hoje).

  Também consolida o JS de troca de idioma (toggleLang/
  updateLangToggleLabel/syncI18nAttrs + inicialização de data-lang) que
  ANTES existia duplicado tanto nas 4 páginas públicas quanto dentro de
  partials/sidebar-v2.ejs (que tinha seu PRÓPRIO botão de idioma — removido
  de lá no mesmo pedido, agora só existe aqui). syncI18nAttrs precisa
  continuar como função GLOBAL solta (sem namespace) — web/public/js/
  poll-fragment.js chama ela por fora, defensivamente
  (`typeof syncI18nAttrs === 'function'`), pra re-traduzir placeholders/
  options depois de recarregar um fragmento via AJAX.

  Uso: include( partials/top-nav , {
    active,          // OPCIONAL — 'home'|'documentacao'|'perfil'|'dashboard'|
                      // 'loja'|'dev-loja'|null — qual botão marcar como
                      // página atual (mesmo padrão .is-active de sempre).
                      // null/omitido = nenhum marcado (a maioria das
                      // páginas com sidebar não tem botão correspondente
                      // aqui). 'dashboard' era 'portal' até 2026-08-19.
    hideOnScroll,     // OPCIONAL, default false — true só nas páginas COM
                      // sidebar: a barra some ao rolar (só fica visível
                      // com a página no topo), porque ela e a sidebar
                      // disputariam espaço vertical o tempo todo senão.
    reserveSpace,     // OPCIONAL, default false — true nas páginas COM
                      // sidebar E em dev-lojas.ejs (que não tem sidebar,
                      // mas também não tem hoje nenhum jeito de reservar
                      // espaço pro topo) — reserva a altura da barra via
                      // padding-top no <body> (nunca via <div> espaçador
                      // solto: essas páginas usam <body class="flex
                      // min-h-screen">, um container em LINHA — um
                      // espaçador ali viraria um 3º item da linha, não
                      // reservaria espaço vertical nenhum). As 4 páginas
                      // públicas (hero/documentacao/portal/termos) NÃO
                      // passam isso — cada uma já reserva espaço com seu
                      // próprio margin-top: calc(var(--nav-height...)+X),
                      // que continua funcionando sem mudança nenhuma
                      // (esta partial ainda seta --nav-height do mesmo
                      // jeito de sempre).
  } )

  user/bot (globais, res.locals, ver dashboard.js) e isOwner (idem, ver
  mesmo middleware) chegam de graça — não precisam ser passados no
  include(), EJS herda o contexto do render inteiro pra dentro de
  qualquer include().
%>
<%
    const tnUser = typeof user !== 'undefined' ? user : null;
    const tnIsOwner = typeof isOwner !== 'undefined' && isOwner;
    // hasStaffGuild vem de graça via res.locals (mesmo mecanismo de
    // user/isOwner, ver dashboard.js) — pedido do dono, 2026-08-19: botão
    // "Dashboard" (ver abaixo) só aparece pra quem é staff de pelo menos
    // 1 servidor com o bot.
    const tnHasStaffGuild = typeof hasStaffGuild !== 'undefined' && hasStaffGuild;
    const tnActive = typeof active !== 'undefined' ? active : null;
    const tnHideOnScroll = typeof hideOnScroll !== 'undefined' && hideOnScroll;
    const tnReserveSpace = typeof reserveSpace !== 'undefined' && reserveSpace;
%>
<nav id="tpTopNav" class="tp-top-nav w-full flex flex-wrap items-center justify-center fixed top-0 left-0 right-0 z-50" style="gap: clamp(10px, 2vw, 20px); padding: 14px 16px; background: rgba(17, 17, 17, 0.92); backdrop-filter: blur(6px); border-bottom: 1px solid #3E3D38;">
    <%#
        Botão hamburguer (pedido do dono, 2026-08-16: "solução de
        navegação para celulares... incluindo todos os botões da barra de
        topo e da sidebar") — só existe visualmente abaixo de 767px (ver
        .tp-mobile-menu-btn no <style> abaixo; os .nav-btn/.dashboard-link
        normais somem nessa mesma faixa, só o hamburguer + o botão de
        idioma continuam visíveis na barra).

        Sempre chama toggleMobileDrawer() (função global, guard
        `window.toggleMobileDrawer &&` pro raro caso de um clique
        acontecer antes do script que a define terminar de rodar) — mas
        QUAL script define essa função muda conforme a página:
        - Nas ~10 páginas COM sidebar (tnHideOnScroll:true), vem de
          partials/sidebar-v2.ejs, que já tem os dados de guild/
          restricted/isOwner pra montar a lista completa categorizada.
        - Nas ~5 páginas SEM sidebar (hero/documentacao/portal/termos/
          dev-lojas), sidebar-v2.ejs nem é incluído — o drawer local logo
          abaixo deste <nav> define sua PRÓPRIA toggleMobileDrawer() com
          o mesmo nome/IDs (tpMobileDrawer/tpMobileDrawerBackdrop), sem
          colisão possível porque as duas variantes nunca coexistem na
          mesma página.

        BUG REAL corrigido (pedido do dono, 2026-08-16, testado ao vivo):
        o hamburguer já tinha sido escrito uma vez renderizando sempre,
        mas nessa 1ª versão o drawer só existia em sidebar-v2.ejs — nas
        páginas sem sidebar o botão aparecia sem ícone e sem fazer nada
        ao clicar (confirmado via console: "drawer encontrado? false").
        Corrigido dando a essas páginas seu próprio drawer local (ver
        abaixo), em vez de simplesmente esconder o botão nelas.
    %>
    <button type="button" class="tp-mobile-menu-btn" id="tpMobileMenuBtn" onclick="if (window.toggleMobileDrawer) toggleMobileDrawer();" aria-label="Abrir menu" aria-expanded="false">
        <i data-lucide="menu"></i>
    </button>
    <%#
        Logo em branco no canto direito (pedido do dono, 2026-08-17:
        "adicione a logo em svg em branco como icone na barra de
        navegação... lateral direita... em todas as barras de navegação
        do topo, no canto superior direito") — mesmo mecanismo de
        posicionamento do .dashboard-link à esquerda logo abaixo (absolute
        + top-1/2 -translate-y-1/2 pra centralizar verticalmente na
        barra), espelhado pro lado direito. web/public/images/logo-white.svg
        NÃO é gerado a partir de assets/Logo/logo.svg (esse é o logo
        desenhado à mão atual, cor própria — trocado em 2026-08-17, ver
        histórico) — é uma cópia direta de assets/Logo/Logo branca.svg,
        variante branca feita à parte pelo dono (pedido, 2026-08-18: "Logo
        adiciona na barra de navegação do topo esta preta, adicionei uma
        versão branca use a mesma"). Sempre que o logo principal for
        redesenhado de novo, esta cópia precisa ser atualizada manualmente
        a partir da variante branca correspondente — não existe conversão
        automática entre os dois arquivos.
        Sempre visível, inclusive no mobile (pedido do dono, 2026-08-18:
        "Ela deve aparecer na versão mobile também") — revertido do
        `hidden md:block` original (mesmo breakpoint do .dashboard-link à
        esquerda, que continua escondido no mobile, feature diferente).
        Sem risco de disputar espaço com hamburguer/bandeira de idioma:
        os dois ficam em fluxo normal (flex) e são CENTRALIZADOS juntos
        no meio da barra assim que os .nav-btn somem abaixo de 767px
        (.tp-top-nav tem justify-content:center) — a logo, por ser
        position:absolute presa no canto direito, nunca compete pelo
        mesmo espaço horizontal que esse grupo centralizado ocupa.
    %>
    <img src="/images/logo-white.svg" alt="Titan's Pass" class="absolute right-4 top-1/2 -translate-y-1/2 block" style="height: 32px; width: auto;">
    <%#
        Avatar+nome (pedido do dono, 2026-08-19: "Nome do usuário na top
        bar fica encima dos botões quando tela diminuida, faça o nome
        sumir e mantenha só o icone do jogador no ponto de largura 1200
        ou menos" + "Coloque o icone do usuário tambem na topbar da
        versão mobile") — mesmo raciocínio de "sempre visível" já
        aplicado à logo em branco no canto oposto (ver comentário dela
        acima): hidden md:flex virou só flex (sempre visível, inclusive
        mobile), e o NOME (não o avatar) ganha .dashboard-link-name pra
        poder sumir sozinho abaixo de 1200px (ver @media no <style>
        abaixo) sem esconder o avatar junto — o avatar sozinho é a
        marca d'água equivalente à logo, cabe em qualquer largura;
        BUG REAL corrigido: era o nome (variável, pode ser longo — ex:
        "Knust VI [ARTIST]") que ficava por cima dos botões da barra em
        larguras médias, não o avatar (tamanho fixo, nunca colide).
    %>
    <% if (tnUser) { %>
        <a href="/dashboard" class="dashboard-link absolute left-4 top-1/2 -translate-y-1/2 flex items-center gap-2 text-sm opacity-80 hover:opacity-100" style="font-family:'Poppins',sans-serif; color:#F8DCC0; text-decoration:none;">
            <img src="<%= tnUser.avatar ? `https://cdn.discordapp.com/avatars/${tnUser.id}/${tnUser.avatar}.png` : `https://cdn.discordapp.com/embed/avatars/${(tnUser.id % 5)}.png` %>" alt="" style="width:24px; height:24px; border-radius:50%; object-fit:cover; flex:none;">
            <span class="dashboard-link-name"><%= (tnUser.nickname || tnUser.global_name || tnUser.username) %></span>
        </a>
    <% } %>
    <a href="/" class="nav-btn<%= tnActive === 'home' ? ' is-active' : '' %>"><span data-i18n-pt>HOME</span><span data-i18n-en>HOME</span></a>
    <a href="/#premium" class="nav-btn"><span data-i18n-pt>PREMIUM</span><span data-i18n-en>PREMIUM</span></a>
    <%#
        Ordem exata pedida pelo dono, 2026-08-19 (2ª rodada): "Home,
        Premium, Dashboard, Perfil, Loja, Documentação, Suporte,
        Controle de lojas (dev) idioma" — Premium subiu pra logo depois
        de Home (antes vinha só depois deste bloco). "Portal" continua
        sendo "Dashboard" (só quem é staff de algum servidor) — Loja
        deixou de aparecer pra visitante deslogado (fazia pouco sentido
        mostrar loja de moeda pra quem não tem conta nenhuma pra ter
        saldo); ENTRAR ocupa o lugar do bloco inteiro nesse caso.
    %>
    <% if (tnUser) { %>
        <% if (tnHasStaffGuild) { %>
            <a href="/dashboard" class="dashboard-link nav-btn<%= tnActive === 'dashboard' ? ' is-active' : '' %>"><span data-i18n-pt>DASHBOARD</span><span data-i18n-en>DASHBOARD</span></a>
        <% } %>
        <a href="/perfil" class="nav-btn<%= tnActive === 'perfil' ? ' is-active' : '' %>"><span data-i18n-pt>PERFIL</span><span data-i18n-en>PROFILE</span></a>
        <a href="/loja" class="nav-btn<%= tnActive === 'loja' ? ' is-active' : '' %>"><span data-i18n-pt>LOJA</span><span data-i18n-en>SHOP</span></a>
    <% } else { %>
        <a href="/login" class="nav-btn"><span data-i18n-pt>ENTRAR</span><span data-i18n-en>LOGIN</span></a>
    <% } %>
    <a href="/documentacao" class="nav-btn<%= tnActive === 'documentacao' ? ' is-active' : '' %>"><span data-i18n-pt>DOCUMENTAÇÃO</span><span data-i18n-en>DOCUMENTATION</span></a>
    <a href="https://discord.gg/fkD5FQktn6" target="_blank" rel="noopener" class="nav-btn"><span data-i18n-pt>SUPORTE</span><span data-i18n-en>SUPPORT</span></a>
    <%#
        Controle de Lojas (pedido do dono, 2026-08-13: "Para o acesso do
        dev adicione controle loja na barra de navegação no topo") — só o
        dono do bot vê este item, mesmo nome já usado na sidebar antes
        dele sair de lá (ver PREMIUM.txt seção 183: "Controle de Lojas"/
        "Shops Control", maiúsculo aqui pra bater com o resto dos
        .nav-btn, que são todos digitados em caixa alta direto no HTML).
    %>
    <% if (tnIsOwner) { %>
        <a href="/dev/Loja" class="nav-btn<%= tnActive === 'dev-loja' ? ' is-active' : '' %>"><span data-i18n-pt>CONTROLE DE LOJAS</span><span data-i18n-en>SHOPS CONTROL</span></a>
    <% } %>
    <button type="button" class="lang-toggle" id="langToggleBtn" onclick="toggleLang()" aria-label="Switch language to English">
        <span class="lang-toggle-flag lang-toggle-flag-pt" aria-hidden="true"><img src="/images/flag-br.webp" alt=""></span>
        <span class="lang-toggle-flag lang-toggle-flag-en" aria-hidden="true"><img src="/images/flag-us.webp" alt=""></span>
    </button>
</nav>

<% if (!tnHideOnScroll) { %>
    <%#
        Drawer mobile pras páginas SEM sidebar (pedido do dono, 2026-08-16,
        parte 2: "seria interessante ter essa opção pras páginas sem
        sidebar também"). partials/sidebar-v2.ejs não é incluído aqui,
        então não dá pra reaproveitar o drawer categorizado de lá — mas
        sua categoria "Navegação" já era EXATAMENTE a mesma lista que os
        .nav-btn logo acima, então replica essa lista, sem cabeçalho de
        categoria (não há estrutura real a sinalizar numa lista de poucos
        itens só). Mesmo IDs/classes/função (tpMobileDrawer/
        tpMobileDrawerBackdrop/toggleMobileDrawer) do drawer de
        sidebar-v2.ejs — nunca convivem na mesma página (uma tem sidebar,
        a outra não), sem risco de colisão.

        Premium SAIU deste drawer (pedido do dono, 2026-08-19: "Remova o
        botão premium das sidebars de todos os sites... Mantenha só na
        top bar") — continua existindo só no .nav-btn visível da barra
        acima (`/#premium`, nunca removido de lá), por isso o drawer NÃO
        é mais "exatamente a mesma lista" dos .nav-btn (um item a menos).
    %>
    <div class="tp-mobile-drawer-backdrop" id="tpMobileDrawerBackdrop" onclick="toggleMobileDrawer(false)"></div>
    <aside class="tp-mobile-drawer" id="tpMobileDrawer" aria-hidden="true">
        <button type="button" class="tp-mobile-drawer-close" onclick="toggleMobileDrawer(false)" aria-label="Fechar menu">
            <i data-lucide="x"></i>
        </button>
        <% if (tnUser) { %>
            <a href="/perfil" class="tp-mobile-drawer-profile" onclick="toggleMobileDrawer(false)">
                <div class="tp-mobile-drawer-avatar">
                    <img src="<%= tnUser.avatar ? `https://cdn.discordapp.com/avatars/${tnUser.id}/${tnUser.avatar}.png` : `https://cdn.discordapp.com/embed/avatars/${(tnUser.id % 5)}.png` %>" alt="">
                </div>
                <div class="tp-mobile-drawer-profile-info">
                    <span class="tp-mobile-drawer-nickname"><%= (tnUser.nickname || tnUser.global_name || tnUser.username) %></span>
                </div>
            </a>
        <% } %>
        <div class="tp-mobile-drawer-section">
            <a href="/" class="tp-mobile-drawer-item<%= tnActive === 'home' ? ' active' : '' %>" onclick="toggleMobileDrawer(false)">
                <i data-lucide="home"></i>
                <span><span data-i18n-pt>Home</span><span data-i18n-en>Home</span></span>
            </a>
            <%# Mesma reordenação do .nav-btn acima — ver comentário lá
                (Premium não entra aqui, segue removido do drawer desde
                2026-08-19 primeira rodada: "mantenha só na top bar"). %>
            <% if (tnUser) { %>
                <% if (tnHasStaffGuild) { %>
                    <a href="/dashboard" class="tp-mobile-drawer-item dashboard-link<%= tnActive === 'dashboard' ? ' active' : '' %>" onclick="toggleMobileDrawer(false)">
                        <i data-lucide="layout-dashboard"></i>
                        <span><span data-i18n-pt>Dashboard</span><span data-i18n-en>Dashboard</span></span>
                    </a>
                <% } %>
                <a href="/perfil" class="tp-mobile-drawer-item<%= tnActive === 'perfil' ? ' active' : '' %>" onclick="toggleMobileDrawer(false)">
                    <i data-lucide="user"></i>
                    <span><span data-i18n-pt>Perfil</span><span data-i18n-en>Profile</span></span>
                </a>
                <a href="/loja" class="tp-mobile-drawer-item<%= tnActive === 'loja' ? ' active' : '' %>" onclick="toggleMobileDrawer(false)">
                    <i data-lucide="shopping-bag"></i>
                    <span><span data-i18n-pt>Loja</span><span data-i18n-en>Shop</span></span>
                </a>
            <% } else { %>
                <a href="/login" class="tp-mobile-drawer-item" onclick="toggleMobileDrawer(false)">
                    <i data-lucide="log-in"></i>
                    <span><span data-i18n-pt>Entrar</span><span data-i18n-en>Login</span></span>
                </a>
            <% } %>
            <a href="/documentacao" class="tp-mobile-drawer-item<%= tnActive === 'documentacao' ? ' active' : '' %>" onclick="toggleMobileDrawer(false)">
                <i data-lucide="book-open"></i>
                <span><span data-i18n-pt>Documentação</span><span data-i18n-en>Documentation</span></span>
            </a>
            <a href="https://discord.gg/fkD5FQktn6" target="_blank" rel="noopener" class="tp-mobile-drawer-item" onclick="toggleMobileDrawer(false)">
                <i data-lucide="life-buoy"></i>
                <span><span data-i18n-pt>Suporte</span><span data-i18n-en>Support</span></span>
            </a>
            <% if (tnIsOwner) { %>
                <a href="/dev/Loja" class="tp-mobile-drawer-item<%= tnActive === 'dev-loja' ? ' active' : '' %>" onclick="toggleMobileDrawer(false)">
                    <i data-lucide="settings"></i>
                    <span><span data-i18n-pt>Controle de Lojas</span><span data-i18n-en>Shops Control</span></span>
                </a>
            <% } %>
        </div>
        <% if (tnUser) { %>
            <a href="/logout" class="tp-mobile-drawer-logout">
                <span data-i18n-pt>Sair</span><span data-i18n-en>Log Out</span>
            </a>
        <% } %>
    </aside>
<% } %>

<style>
    .nav-btn {
        box-sizing: border-box;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 5px 20px;
        gap: 10px;
        height: 30px;
        background: #2A2A2A;
        border: 1px solid #803E30;
        border-radius: 15px;
        box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5), -5px -5px 10px rgba(0, 0, 0, 0.7);
        font-family: 'Poppins', sans-serif;
        font-weight: 300;
        font-size: 14px;
        color: #F8DCC0;
        text-decoration: none;
        white-space: nowrap;
        transition: background 0.15s ease, border-color 0.15s ease;
    }
    .nav-btn:hover { background: #803E30; border-color: #F8DCC0; }
    .nav-btn.is-active { background: #4B2427; border-color: #DCA15E; }
    .nav-btn:active {
        background: #4B2427;
        border-color: #803E30;
        box-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5), -1px -1px 2px rgba(0, 0, 0, 0.5), inset 0px 8px 7.8px rgba(0, 0, 0, 0.59);
    }
    /* Padrão de botão desativado — sem uso hoje nesta barra, mantido só
       porque itens futuros podem precisar (era usado nas versões antigas
       da página, ver histórico de hero.ejs). */
    .nav-btn.disabled {
        border-color: #3E3D38;
        color: #3E3D38;
        box-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5), -1px -1px 2px rgba(0, 0, 0, 0.5);
        cursor: not-allowed;
        pointer-events: none;
    }
    .lang-toggle {
        position: relative;
        display: inline-flex;
        align-items: center;
        width: 52px;
        height: 36px;
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        flex: none;
    }
    .lang-toggle-flag {
        position: absolute;
        top: 2px;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        overflow: hidden;
        background: #2A2A2A;
        border: 1px solid #803E30;
        box-shadow: 3px 4px 8px rgba(0, 0, 0, 0.5);
        transition: left 0.2s ease, border-color 0.15s ease;
    }
    .lang-toggle-flag img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .lang-toggle:hover .lang-toggle-flag { border-color: #F8DCC0; }
    .lang-toggle-flag-pt { left: 0; z-index: 2; }
    .lang-toggle-flag-en { left: 18px; z-index: 1; }
    html[data-lang="en"] .lang-toggle-flag-pt { left: 18px; z-index: 1; }
    html[data-lang="en"] .lang-toggle-flag-en { left: 0; z-index: 2; }

    @media (max-width: 640px) {
        .nav-btn { padding: 4px 12px; height: 26px; font-size: 12px; }
    }

    /* Botão hamburguer — invisível por padrão (desktop/tablet: a barra
       cheia de .nav-btn já resolve), some no lugar dos .nav-btn/
       .dashboard-link abaixo de 767px (pedido do dono, 2026-08-16 —
       ver drawer completo em partials/sidebar-v2.ejs). Mesmo visual dos
       outros botões redondos do site (.tp-sidebar-toggle/.lang-toggle-
       flag) pra não parecer um elemento estranho na barra. */
    .tp-mobile-menu-btn {
        display: none;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        flex: none;
        background: #2A2A2A;
        border: 1px solid #803E30;
        border-radius: 50%;
        color: #F8DCC0;
        cursor: pointer;
    }
    .tp-mobile-menu-btn:hover { background: #803E30; border-color: #F8DCC0; }
    .tp-mobile-menu-btn svg { width: 18px; height: 18px; }
    @media (max-width: 767px) {
        .tp-mobile-menu-btn { display: flex; }
        .tp-top-nav .nav-btn { display: none; }
    }
    /* Nome ao lado do avatar (pedido do dono, 2026-08-19) — só o NOME
       some em telas médias/estreitas, nunca o avatar (marca d'água
       equivalente à logo do canto oposto, sempre visível). Abaixo de
       767px o próprio .dashboard-link-name já herdaria isso, mas o
       limite de verdade pedido foi 1200px (a barra cheia de .nav-btn
       ainda cabe larga o bastante pra colidir com o nome bem antes de
       767px). */
    @media (max-width: 1200px) {
        .dashboard-link-name { display: none; }
    }

    <% if (!tnHideOnScroll) { %>
    /* ==================== DRAWER MOBILE (páginas sem sidebar) ====================
       Pedido do dono, 2026-08-16, parte 2 — mesmo visual/comportamento do
       drawer de partials/sidebar-v2.ejs (CSS copiado de lá: só existe
       reaproveitamento possível ENTRE os dois arquivos via duplicação,
       porque sidebar-v2.ejs não é incluído aqui — ver nota na memória
       "mobile-nav-drawer" sobre isso já ser um custo conhecido da divisão
       em 2 arquivos). Só emitido quando `!tnHideOnScroll` (i.e. quando
       sidebar-v2.ejs NÃO está na página) pra não duplicar a mesma regra
       CSS nas ~10 páginas que já a recebem de lá. */
    .tp-mobile-drawer-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        z-index: 90;
    }
    /* Cantos arredondados + flutuante (pedido do dono, 2026-08-19) —
       mesma mudança de partials/sidebar-v2.ejs, ver comentário completo
       lá (este arquivo duplica o CSS do drawer pras ~5 páginas sem
       sidebar, custo conhecido da divisão em 2 arquivos). */
    .tp-mobile-drawer {
        box-sizing: border-box;
        position: fixed;
        top: 16px;
        left: 16px;
        bottom: 16px;
        width: min(320px, calc(100vw - 32px));
        z-index: 100;
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 20px 18px;
        overflow-y: auto;
        background: linear-gradient(180deg, #252326 0%, #1F1D20 54.34%, #131314 98.29%);
        border: 1px solid rgba(0, 0, 0, 0.4);
        border-right: 1.5px solid rgba(248, 220, 192, 0.3);
        border-radius: 20px;
        box-shadow: -15px 30px 50px rgba(0, 0, 0, 0.8), inset 0.5px 0.5px 0px rgba(248, 220, 192, 0.12);
        font-family: 'Poppins', sans-serif;
        transform: translateX(calc(-100% - 32px));
        transition: transform 0.25s ease;
    }
    @media (prefers-reduced-motion: reduce) {
        .tp-mobile-drawer { transition: none; }
    }
    @media (max-width: 767px) {
        .tp-mobile-drawer.is-open { transform: translateX(0); }
        .tp-mobile-drawer-backdrop.is-open { display: block; }
    }
    .tp-mobile-drawer-close {
        align-self: flex-end;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        flex: none;
        background: #2A2A2A;
        border: 1px solid #803E30;
        border-radius: 50%;
        color: #F8DCC0;
        cursor: pointer;
        margin-bottom: 4px;
    }
    .tp-mobile-drawer-close:hover { background: #803E30; border-color: #F8DCC0; }
    .tp-mobile-drawer-close svg { width: 18px; height: 18px; }
    .tp-mobile-drawer-profile {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 6px 16px;
        text-decoration: none;
        border-bottom: 1px solid rgba(248, 220, 192, 0.12);
        margin-bottom: 10px;
    }
    .tp-mobile-drawer-avatar {
        box-sizing: border-box;
        flex: none;
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #4B2427;
        border: 3px solid #803E30;
        border-radius: 50%;
        overflow: hidden;
    }
    .tp-mobile-drawer-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .tp-mobile-drawer-avatar svg { width: 30px; height: 30px; color: #803E30; }
    .tp-mobile-drawer-profile-info { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .tp-mobile-drawer-nickname {
        font-family: 'Tilt Warp', sans-serif;
        font-size: 16px;
        color: #F8DCC0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .tp-mobile-drawer-section + .tp-mobile-drawer-section { margin-top: 14px; }
    .tp-mobile-drawer-heading {
        font-family: 'Tilt Warp', sans-serif;
        font-size: 12px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #DCA15E;
        opacity: 0.8;
        margin: 0 0 8px 6px;
    }
    .tp-mobile-drawer-item {
        box-sizing: border-box;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border-radius: 12px;
        text-decoration: none;
        color: #F8DCC0;
        font-size: 15px;
        font-weight: 600;
        transition: background 0.15s ease;
    }
    .tp-mobile-drawer-item:hover { background: rgba(128, 62, 48, 0.35); }
    .tp-mobile-drawer-item.active { background: #4B2427; }
    .tp-mobile-drawer-item svg { width: 19px; height: 19px; flex: none; color: #DCA15E; }
    .tp-mobile-drawer-logout {
        margin-top: auto;
        padding-top: 16px;
        text-align: center;
        font-size: 13px;
        color: #F8DCC0;
        opacity: 0.55;
        text-decoration: none;
    }
    .tp-mobile-drawer-logout:hover { opacity: 0.9; text-decoration: underline; }
    <% } %>

    /* Esconde ao rolar (pedido do dono, 2026-08-13) — só quando
       hideOnScroll:true (ver JS abaixo). Nas páginas públicas (sem essa
       flag) a barra continua sempre visível, exatamente como antes. */
    .tp-top-nav { transition: transform 0.25s ease, opacity 0.25s ease; }
    .tp-top-nav.tp-nav-hidden { transform: translateY(-100%); opacity: 0; pointer-events: none; }
    @media (prefers-reduced-motion: reduce) {
        .tp-top-nav { transition: none; }
    }

    /* Reserva o espaço da barra (pedido do dono: barra permanente em toda
       página) — só quando reserveSpace:true (ver JS abaixo). Aplicado no
       <body> (o CONTAINER flex das páginas com sidebar), nunca via <div>
       espaçador solto: <body class="flex min-h-screen"> nessas páginas é
       uma linha (aside+main lado a lado) — um espaçador ali viraria um 3º
       item da linha, não reservaria altura nenhuma. padding-top no
       container desloca a linha inteira pra baixo igual, sem depender de
       flex-direction. */
    body.tp-reserve-nav-space { padding-top: var(--nav-height, 84px); }

    /* FIX (pedido do dono, 2026-08-15: "Sidebar esta sendo cortada nas
       paginas na parte de baixo") — o <aside class="shrink-0 h-screen
       sticky top-0 ..."> de toda página com sidebar (moderacao/reports/
       events/perfil/loja/lojajogo/gameserver/etc.) é filho direto de
       <body>, então o padding-top acima empurra ele pra baixo — mas
       h-screen (100vh) continua sendo a altura INTEIRA da viewport, não
       "100vh menos o padding". No repouso (scroll=0), o rodapé da
       sidebar fica exatamente `--nav-height` pixels ABAIXO do fim da
       viewport — só volta a caber quando o usuário rola a página pra
       baixo pelo menos esse tanto. Em páginas com pouco conteúdo (sem
       altura suficiente pra rolar tanto), o rodapé da sidebar fica
       PERMANENTEMENTE inacessível — bug real, não só cosmético.
       `height: calc(100vh - var(--nav-height))` corrige isso: o rodapé
       passa a encostar exatamente no fim da viewport, em vez de
       sobrar/faltar.

       CORREÇÃO 2026-08-16 (pedido do dono, com número exato tirado do
       DevTools): a 1ª versão desta correção também botava `top:
       var(--nav-height)` no sticky (em vez de manter `0`), achando que
       precisava "grudar a sidebar ABAIXO do espaço reservado" — errado.
       O padding-top do body ACIMA já empurra a posição de repouso da
       sidebar pra `--nav-height`; somar OUTRO `top: --nav-height` no
       sticky por cima disso DOBRAVA o deslocamento (confirmado ao vivo:
       `getBoundingClientRect().top` sempre saía EXATAMENTE 2x
       `--nav-height`, em 2 medições com valores diferentes — 65→130,
       115→230). `top: 0` é o valor certo: o padding do body já cuida do
       repouso, o sticky só precisa impedir que ela suba além do topo da
       viewport ao rolar — o que é seguro em toda página que usa esta
       reserva de espaço porque TODAS (exceto dev-lojas.ejs, que não tem
       <aside> nenhum) também passam hideOnScroll:true, ou seja, a barra
       já some antes da sidebar sequer chegar perto de sobrepor ela.
       Seletor por filho direto (`> aside`) pra não afetar nenhum outro
       <aside> eventual da página. */
    body.tp-reserve-nav-space > aside {
        top: 0;
        height: calc(100vh - var(--nav-height, 84px));
    }
</style>

<% if (!tnHideOnScroll) { %>
    <%#
        Lucide (pedido do dono, 2026-08-16, parte 2) — só carregado aqui
        quando a página NÃO tem sidebar-v2.ejs, que já traz o mesmo CDN
        pras outras ~10 páginas. dev-lojas.ejs já carrega lucide de novo
        no fim do próprio body (pros ícones dela mesma, ex: data-lucide=
        "server") — duplicar o <script src> ali é inofensivo (cacheado
        pelo navegador na 2ª vez, createIcons() é idempotente), mais
        simples que coordenar entre os dois arquivos só por essa página.
    %>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <script>if (window.lucide) window.lucide.createIcons();</script>
<% } %>

<script>
    (function () {
        var nav = document.getElementById('tpTopNav');
        // A barra quebra em números de linha diferentes dependendo da
        // largura da tela — mede a altura real em vez de "chutar" um
        // valor fixo, pra continuar responsivo mesmo se algum item for
        // adicionado/removido no futuro (ex: CONTROLE DE LOJAS só
        // aparece pro dono). getElementById (não querySelector('nav')
        // genérico, como era antes de existir esta partial) — necessário
        // porque a sidebar (partials/sidebar-v2.ejs) tem seu PRÓPRIO
        // <nav class="tp-sidebar-nav">, então um seletor genérico vira
        // ambíguo assim que as duas convivem na mesma página.
        function syncNavHeight() {
            if (nav) document.documentElement.style.setProperty('--nav-height', nav.offsetHeight + 'px');
        }
        syncNavHeight();
        window.addEventListener('resize', syncNavHeight);
        window.addEventListener('load', syncNavHeight);
        // A webfont (Poppins) pode terminar de carregar DEPOIS do 'load' e
        // reflowar o texto dos botões, mudando quantas linhas a barra
        // ocupa — sem isso, o conteúdo abaixo fica com espaço de menos.
        if (window.document.fonts && window.document.fonts.ready) {
            window.document.fonts.ready.then(syncNavHeight);
        }

        <% if (tnReserveSpace) { %>
        document.body.classList.add('tp-reserve-nav-space');
        <% } %>

        <% if (tnHideOnScroll) { %>
        var HIDE_THRESHOLD = 8;
        function onScroll() {
            if (nav) nav.classList.toggle('tp-nav-hidden', window.scrollY > HIDE_THRESHOLD);
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
        <% } %>
    })();

    <% if (!tnHideOnScroll) { %>
    // Portal do drawer pro <body> (pedido do dono, 2026-08-17: bug real
    // de empilhamento encontrado nas páginas COM sidebar, ver o mesmo
    // trecho em partials/sidebar-v2.ejs pro raciocínio completo — um
    // ancestral `position: sticky` prendia o z-index do drawer num
    // contexto de empilhamento local, incapaz de ficar por cima de
    // conteúdo mais abaixo no DOM). Estas páginas (sem sidebar) hoje não
    // têm esse wrapper sticky específico, mas o mesmo risco existiria se
    // uma delas ganhasse um no futuro — replicado aqui por consistência
    // e defesa, custo zero.
    (function () {
        var backdrop = document.getElementById('tpMobileDrawerBackdrop');
        var drawer = document.getElementById('tpMobileDrawer');
        if (backdrop) document.body.appendChild(backdrop);
        if (drawer) document.body.appendChild(drawer);
    })();

    // Drawer mobile pras páginas sem sidebar (pedido do dono, 2026-08-16,
    // parte 2) — mesma função/mesmo comportamento de partials/
    // sidebar-v2.ejs (só existe nas páginas COM sidebar), copiada aqui
    // porque esta página não inclui aquele arquivo. GLOBAL de propósito
    // (função solta, sem namespace) pro botão hamburguer no <nav> acima
    // conseguir chamar.
    function toggleMobileDrawer(force) {
        var drawer = document.getElementById('tpMobileDrawer');
        var backdrop = document.getElementById('tpMobileDrawerBackdrop');
        var btn = document.getElementById('tpMobileMenuBtn');
        if (!drawer || !backdrop) return;
        var open = typeof force === 'boolean' ? force : !drawer.classList.contains('is-open');
        drawer.classList.toggle('is-open', open);
        backdrop.classList.toggle('is-open', open);
        drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
        if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        document.body.style.overflow = open ? 'hidden' : '';
    }
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') toggleMobileDrawer(false);
    });
    <% } %>

    // Idioma (pedido do dono, 2026-08-06) — html[data-lang] controla quais
    // data-i18n-pt/en aparecem (regra CSS já existente em cada página
    // pública e em web/public/css/style.css pras páginas com sidebar),
    // persistido em localStorage.titanspass_lang. Consolidado aqui — antes
    // existia duplicado tanto nas 4 páginas públicas quanto dentro de
    // partials/sidebar-v2.ejs (removido de lá no mesmo pedido).
    (function () {
        var stored = localStorage.getItem('titanspass_lang') || 'pt';
        document.documentElement.setAttribute('data-lang', stored);
        updateLangToggleLabel(stored);
        syncI18nAttrs(stored);
    })();

    // aria-label dinâmico do botão de bandeiras — o rótulo só existe pra
    // leitor de tela, o visual é 100% as duas bandeiras sobrepostas.
    function updateLangToggleLabel(current) {
        var btn = document.getElementById('langToggleBtn');
        if (btn) btn.setAttribute('aria-label', current === 'pt' ? 'Switch language to English' : 'Mudar idioma para português');
    }

    // placeholder/<option> não aceitam os pares data-i18n-pt/data-i18n-en
    // de sempre em forma de <span> filho (não são elementos com filhos de
    // verdade — o navegador só lê o texto puro), então esses dois atributos
    // carregam as duas versões e a gente troca o que está ativo na mão.
    // GLOBAL de propósito (função solta, sem namespace) — web/public/js/
    // poll-fragment.js chama ela por fora, defensivamente, pra
    // re-traduzir um fragmento recém recarregado via AJAX (o HTML que
    // volta do servidor é sempre em português "puro").
    function syncI18nAttrs(lang) {
        document.querySelectorAll('[data-i18n-ph-pt]').forEach(function (el) {
            var text = lang === 'en' ? el.getAttribute('data-i18n-ph-en') : el.getAttribute('data-i18n-ph-pt');
            if (text !== null) el.setAttribute('placeholder', text);
        });
        document.querySelectorAll('option[data-i18n-opt-pt]').forEach(function (el) {
            var text = lang === 'en' ? el.getAttribute('data-i18n-opt-en') : el.getAttribute('data-i18n-opt-pt');
            if (text !== null) el.textContent = text;
        });
    }

    function toggleLang() {
        var current = document.documentElement.getAttribute('data-lang') || 'pt';
        var next = current === 'pt' ? 'en' : 'pt';
        document.documentElement.setAttribute('data-lang', next);
        localStorage.setItem('titanspass_lang', next);
        updateLangToggleLabel(next);
        syncI18nAttrs(next);
    }
</script>
