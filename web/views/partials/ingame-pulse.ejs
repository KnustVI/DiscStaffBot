<%#
  web/views/partials/ingame-pulse.ejs
  Bloco "IN GAME" do Figma (Moderação.txt/Reports.txt/Events.txt repetem
  essa seção) — grade STAFF ONLINE/STAFF OFFLINE (Moderação e Events
  only — Reports só tem os donuts, ver showRoster abaixo) PRIMEIRO,
  depois o título "IN GAME" + 3 donuts dentro de partials/graph-card
  (Jogando / Em modo espectador / Jogadores Online). Ordem trocada a
  pedido do dono (lista de staff acima dos gráficos, não abaixo).

  Cada staff vira uma LINHA em .staff-list (pedido do dono, 2026-08-07:
  "o visual atual não caiu bem para uma lista grande, faça uma lista mais
  confortável de visualizar" — trocado do grid de chips pequenos de
  205x94 que quebrava linha de forma confusa com listas grandes por uma
  lista vertical de linhas full-width, cada uma com todo o contexto:
  nome, maior cargo do Discord, função configurada (Moderador/Supervisor/
  Equipe de Eventos — ver dashboard.js:staffRoleCategoryLabel, DIFERENTE
  do "cargo" que é só o nome literal do cargo do Discord), ID em jogo
  (Alderon ID, "Não vinculado" se nunca rodou /registrar), status com
  duração (ver dashboard.js:computeGameStatus), dinossauro jogando (só
  fora do modo espectador) e um link "Ver perfil" (ver GET /staff-
  perfil/:guildID/:userId). Continua só 2 cores de borda (verde=online
  inclusive espectador, vermelho=offline) — "Espectador" é só uma
  variação de texto sobre o estado "online".

  A LISTA em si já vem PRÉ-FILTRADA pela categoria certa (Moderação só
  Moderador/Supervisor, Eventos só Equipe de Eventos — pedido do dono,
  ver dashboard.js:getServerPulse `category`) — este parcial só
  renderiza o que `pulse.roster` já trouxe, sem filtrar nada sozinho.

  O donut maior fica SEMPRE por último (mais à direita, com
  justify-content:flex-end do card) e é SEMPRE "Jogadores Online" sobre
  120 (capacidade máxima de um servidor de Path of Titans) — pedido do
  dono, não é staff, é a contagem geral de jogadores no jogo. "Jogando"/
  "Em modo espectador" continuam sendo sobre STAFF (pot_spectator_sessions
  = sessão de AdminSpectate aberta no jogo, dado real, não presença do
  Discord — o bot não tem a intent GuildPresences).

  Uso: include( partials/ingame-pulse , { pulse, showRoster } ) —
  showRoster é opcional, default true.

  Este é um comentário de verdade do EJS (abre com "menor, porcento"),
  não um comentário de HTML — um comentário de HTML aparece no código
  fonte que o navegador recebe (o navegador só esconde visualmente, o
  texto continua lá), enquanto este daqui o EJS descarta antes de gerar a
  página. Mesmo assim, sem os delimitadores reais de tag do EJS no exemplo
  acima de propósito: um comentário deste tipo NÃO aceita outra tag de EJS
  aninhada dentro dele (testado — quebra o parser), então nada de tag real
  aqui dentro, nem pra exemplo.
%>
<%
    const ipShowRoster = typeof showRoster === 'undefined' || showRoster;
    const IP_MAX_PLAYERS = 120; // capacidade máxima de um servidor de Path of Titans

    // Título bilíngue (pedido do dono, 2026-08-06: "título de gráficos no
    // card ingame" sem tradução) — stat-donut.ejs/ingame-donut-cluster.ejs
    // agora renderizam title SEM escape, então essa string já pronta com
    // os dois <span> é o que efetivamente vira o HTML do rótulo.
    function i18nTitle(pt, en) {
        return `<span data-i18n-pt>${pt}</span><span data-i18n-en>${en}</span>`;
    }

    // Ordem fixa (posição no canvas do Figma, não muda): [pequeno-esquerda,
    // pequeno-meio, grande-direita] — ver ingame-donut-cluster.ejs.
    const ipDonuts = [
        {
            title: i18nTitle('Jogando', 'Playing'),
            value: `${pulse.staffPlaying}/${pulse.staffTotal}`,
            percent: pulse.staffTotal > 0 ? (pulse.staffPlaying / pulse.staffTotal) * 100 : 0,
            accent: 'gold',
        },
        {
            title: i18nTitle('Em modo espectador', 'Spectating'),
            value: `${pulse.staffSpectating}/${pulse.staffTotal}`,
            percent: pulse.staffTotal > 0 ? (pulse.staffSpectating / pulse.staffTotal) * 100 : 0,
            accent: 'gold',
        },
        {
            title: i18nTitle('Jogadores Online', 'Players Online'),
            value: `${pulse.playersOnline}/${IP_MAX_PLAYERS}`,
            percent: (pulse.playersOnline / IP_MAX_PLAYERS) * 100,
            accent: 'red',
        },
    ];
    const ipDonutsHtml = include('ingame-donut-cluster', { donuts: ipDonuts, clusterId: 'ingame' });
%>
<section class="ingame-pulse">
    <% if (ipShowRoster) { %>
        <% const online = pulse.roster.filter(s => s.online); const offline = pulse.roster.filter(s => !s.online); %>
        <% if (pulse.roster.length === 0) { %>
            <p class="text-sm opacity-40 text-center ingame-staff-grid-spacing"><span data-i18n-pt>Nenhum cargo de staff configurado ainda.</span><span data-i18n-en>No staff role configured yet.</span></p>
        <% } else { %>
            <%#
                Pedido do dono, 2026-08-07: "separe" — os 2 grupos (Online/
                Offline) ganham um título pequeno próprio em vez de só a
                cor da borda diferenciando, ajuda a escanear listas grandes.
                Cada linha vem de partials/staff-row.ejs (ver lá o motivo de
                ser um include em vez de montado aqui).
            %>
            <div class="staff-list-wrap ingame-staff-grid-spacing">
                <% if (online.length > 0) { %>
                    <h3 class="staff-list-heading"><span data-i18n-pt>Online</span><span data-i18n-en>Online</span> (<%= online.length %>)</h3>
                    <div class="staff-list">
                        <% online.forEach(staff => { %><%- include('staff-row', { staff }) %><% }); %>
                    </div>
                <% } %>
                <% if (offline.length > 0) { %>
                    <h3 class="staff-list-heading is-offline"><span data-i18n-pt>Offline</span><span data-i18n-en>Offline</span> (<%= offline.length %>)</h3>
                    <div class="staff-list">
                        <% offline.forEach(staff => { %><%- include('staff-row', { staff }) %><% }); %>
                    </div>
                <% } %>
            </div>
        <% } %>
    <% } %>

    <h2 class="ingame-pulse-title">IN GAME</h2>
    <%- include('graph-card', { bodyHtml: ipDonutsHtml }) %>
</section>
<style>
    .ingame-pulse { display: flex; flex-direction: column; gap: 12px; width: 100%; }
    /* .ingame-pulse-title mudou pra web/public/css/style.css (pedido do
       dono: "Punições"/"Automoderação" de moderation-stats.ejs usam o
       mesmo estilo agora) — classe global, não fica mais só neste
       parcial. */

    /* 20px de respiro entre a lista de staff e o que vem antes/depois dela
       no site (pedido do dono) — separado do gap:12px genérico do
       .ingame-pulse (que é só entre título/card/lista). */
    .ingame-staff-grid-spacing { margin-top: 20px; margin-bottom: 20px; }
    .staff-list-wrap { display: flex; flex-direction: column; gap: 8px; width: 100%; }
    .staff-list-heading {
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        font-size: 11px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #A5FFA1;
        opacity: 0.8;
        margin-top: 4px;
    }
    .staff-list-heading.is-offline { color: #FF4E3B; }
    .staff-list-heading:first-child { margin-top: 0; }
    /* Lista vertical (pedido do dono, 2026-08-07: "o visual atual não caiu
       bem para uma lista grande, faça uma lista mais confortável de
       visualizar") — trocado do grid de chips pequenos que quebrava linha
       de forma confusa numa lista longa por linhas full-width, cada uma
       com todo o contexto do staff (ver staff-row.ejs); escala pra
       qualquer tamanho de lista só crescendo verticalmente, sem
       reorganizar nada. */
    .staff-list { display: flex; flex-direction: column; gap: 8px; width: 100%; }

    /* Linha de staff — borda verde/vermelha (mesma ideia visual do antigo
       .staff-chip) + ícone + nome/status numa linha de topo, meta info
       (cargo/função/AGID/dinossauro) numa linha secundária que QUEBRA
       livremente (flex-wrap, pedido do dono: lista "confortável" mesmo
       com muito texto por linha, diferente do chip antigo que cortava com
       reticências). Link "Ver perfil" fica à direita em telas largas e
       desce pra própria linha em telas estreitas (flex-wrap no container
       inteiro). */
    .staff-row {
        --row-color: #A5FFA1;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px 14px;
        padding: 10px 16px;
        border: 1px solid var(--row-color);
        border-radius: 10px;
        background: #131314;
    }
    .staff-row.is-offline { --row-color: #FF4E3B; }
    .staff-row-icon { width: 26px; height: 26px; flex: none; color: var(--row-color); }
    .staff-row-body { display: flex; flex-direction: column; gap: 4px; min-width: 0; flex: 1 1 220px; }
    .staff-row-top { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; }
    .staff-row-name {
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        font-size: 14px;
        color: #DCA15E;
    }
    .staff-row-status {
        font-family: 'Poppins', sans-serif;
        font-weight: 400;
        font-size: 12px;
        color: #F8DCC0;
        opacity: 0.85;
    }
    .staff-row-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 14px;
        font-family: 'Poppins', sans-serif;
        font-size: 11px;
        color: #A89986;
    }
    .staff-row-link {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        flex: none;
        margin-left: auto;
        padding: 6px 12px;
        border: 1px solid #DCA15E;
        border-radius: 147.5px;
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        font-size: 11px;
        color: #DCA15E;
        text-decoration: none;
        transition: background 0.15s ease;
    }
    .staff-row-link:hover { background: rgba(220, 161, 94, 0.12); }
    @media (max-width: 640px) {
        .staff-row { padding: 8px 12px; gap: 8px; }
        .staff-row-link { margin-left: 0; }
    }
</style>
