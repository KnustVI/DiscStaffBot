<%#
  web/views/partials/ingame-pulse.ejs
  Bloco "IN GAME" do Figma (Moderação.txt/Reports.txt/Events.txt repetem
  essa seção) — grade STAFF ONLINE/STAFF OFFLINE (Moderação e Events
  only — Reports só tem os donuts, ver showRoster abaixo) PRIMEIRO,
  depois o título "IN GAME" + 3 donuts dentro de partials/graph-card
  (Jogando / Em modo espectador / Jogadores Online). Ordem trocada a
  pedido do dono (lista de staff acima dos gráficos, não abaixo).

  Cada card de staff usa .staff-chip (Figma: "Property 1=Online"/
  "Property 1=Offline", 205x94, confirmado pelo dono — tamanho menor que
  o antigo .outline-chip de 314x90 usado aqui antes). Nome/cargo/status
  em 3 linhas dentro do card: STAFFNAME (maior, dourado), CARGO (maior
  cargo de staff no Discord — não existe conceito de cargo/rank EM JOGO
  nos dados do PoT hoje, ver dashboard.js:getServerPulse) e STATUS (texto
  literal "Online"/"Offline"/"Espectador", pedido do dono). A borda
  continua só 2 cores (verde=online inclusive espectador, vermelho=
  offline) — o Figma só define esses 2 estados visuais; "Espectador" é
  só uma variação de texto sobre o estado "online".

  O donut maior fica SEMPRE por último (mais à direita, com
  justify-content:flex-end do card) e é SEMPRE "Jogadores Online" sobre
  120 (capacidade máxima de um servidor de Path of Titans) — pedido do
  dono, não é staff, é a contagem geral de jogadores no jogo. "Jogando"/
  "Em modo espectador" continuam sendo sobre STAFF (pot_spectator_sessions
  = sessão de AdminSpectate aberta no jogo, dado real, não presença do
  Discord — o bot não tem a intent GuildPresences).

  Uso: include( partials/ingame-pulse , { pulse, showRoster } ) —
  showRoster é opcional, default true.

  Este é um comentário de verdade do EJS (abre com "menor, porcento"),
  não um comentário de HTML — um comentário de HTML aparece no código
  fonte que o navegador recebe (o navegador só esconde visualmente, o
  texto continua lá), enquanto este daqui o EJS descarta antes de gerar a
  página. Mesmo assim, sem os delimitadores reais de tag do EJS no exemplo
  acima de propósito: um comentário deste tipo NÃO aceita outra tag de EJS
  aninhada dentro dele (testado — quebra o parser), então nada de tag real
  aqui dentro, nem pra exemplo.
%>
<%
    const ipShowRoster = typeof showRoster === 'undefined' || showRoster;
    const IP_MAX_PLAYERS = 120; // capacidade máxima de um servidor de Path of Titans

    // Ordem fixa (posição no canvas do Figma, não muda): [pequeno-esquerda,
    // pequeno-meio, grande-direita] — ver ingame-donut-cluster.ejs.
    const ipDonuts = [
        {
            title: 'Jogando',
            value: `${pulse.staffPlaying}/${pulse.staffTotal}`,
            percent: pulse.staffTotal > 0 ? (pulse.staffPlaying / pulse.staffTotal) * 100 : 0,
            accent: 'gold',
        },
        {
            title: 'Em modo espectador',
            value: `${pulse.staffSpectating}/${pulse.staffTotal}`,
            percent: pulse.staffTotal > 0 ? (pulse.staffSpectating / pulse.staffTotal) * 100 : 0,
            accent: 'gold',
        },
        {
            title: 'Jogadores Online',
            value: `${pulse.playersOnline}/${IP_MAX_PLAYERS}`,
            percent: (pulse.playersOnline / IP_MAX_PLAYERS) * 100,
            accent: 'red',
        },
    ];
    const ipDonutsHtml = include('ingame-donut-cluster', { donuts: ipDonuts, clusterId: 'ingame' });
%>
<section class="ingame-pulse">
    <% if (ipShowRoster) { %>
        <% const online = pulse.roster.filter(s => s.online); const offline = pulse.roster.filter(s => !s.online); %>
        <% if (pulse.roster.length === 0) { %>
            <p class="text-sm opacity-40 text-center ingame-staff-grid-spacing">Nenhum cargo de staff configurado ainda.</p>
        <% } else { %>
            <div class="ingame-staff-grid ingame-staff-grid-spacing">
                <% online.forEach(staff => { %>
                    <div class="staff-chip">
                        <i data-lucide="power" class="staff-chip-icon"></i>
                        <div class="staff-chip-col">
                            <span class="staff-chip-name"><%= staff.name %></span>
                            <span class="staff-chip-role"><%= staff.cargo %></span>
                            <span class="staff-chip-status"><%= staff.statusLabel %></span>
                        </div>
                    </div>
                <% }); %>
                <% offline.forEach(staff => { %>
                    <div class="staff-chip is-offline">
                        <i data-lucide="power" class="staff-chip-icon"></i>
                        <div class="staff-chip-col">
                            <span class="staff-chip-name"><%= staff.name %></span>
                            <span class="staff-chip-role"><%= staff.cargo %></span>
                            <span class="staff-chip-status"><%= staff.statusLabel %></span>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    <% } %>

    <h2 class="ingame-pulse-title">IN GAME</h2>
    <%- include('graph-card', { bodyHtml: ipDonutsHtml }) %>
</section>
<style>
    .ingame-pulse { display: flex; flex-direction: column; gap: 12px; width: 100%; }
    /* .ingame-pulse-title mudou pra web/public/css/style.css (pedido do
       dono: "Punições"/"Automoderação" de moderation-stats.ejs usam o
       mesmo estilo agora) — classe global, não fica mais só neste
       parcial. */

    /* 20px de respiro entre a lista de staff e o que vem antes/depois dela
       no site (pedido do dono) — separado do gap:12px genérico do
       .ingame-pulse (que é só entre título/card/lista). */
    .ingame-staff-grid-spacing { margin-top: 20px; margin-bottom: 20px; }
    /* Linha de cards de staff — trocado de CSS grid (3 colunas fixas,
       travadas em 655px de largura total) pra flexbox com wrap (pedido do
       dono): cada .staff-chip agora abraça o próprio conteúdo (largura
       natural, não mais esticado pra preencher uma coluna de grid), e a
       linha inteira preenche a largura máxima do corpo (sem max-width
       aqui — o container já herda 100% do body da página). Alinhado à
       esquerda (justify-content:flex-start) — testado centralizado
       primeiro a pedido do dono, mas ficou ruim (linha incompleta
       "flutuando" no meio), então virou esquerda pra direita preenchendo
       a linha. Isso substitui a decisão anterior de "sempre 3 por linha"
       — agora quantos cards cabem por linha depende da largura de cada
       card + do espaço disponível. */
    .ingame-staff-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-start;
        gap: 20px;
        width: 100%;
    }

    /* Card de staff (Figma: "Property 1=Online"/"Property 1=Offline",
       205x94 usado como referência de padding/gap/fontes, não mais como
       tamanho travado) — borda verde/vermelha + ícone + 3 linhas de texto
       (nome/cargo/status, ver doc-comment no topo do arquivo). Próprio
       daqui, não reaproveita .outline-chip: o Figma empilha o texto em 3
       linhas com o status numa linha própria embaixo, layout diferente do
       chip de 2 linhas usado no quadro de alerta (moderacao.ejs).
       min-width mantém o "peso" visual do Figma pra nomes curtos; o card
       cresce além disso se o nome/cargo precisar de mais espaço. Tamanho
       reduzido ~25% (pedido do dono: estava grande demais, competindo
       visualmente com os gráficos de donut abaixo). */
    .staff-chip {
        --chip-color: #A5FFA1;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 12px;
        border: 1px solid var(--chip-color);
        border-radius: 10px;
        background: none;
        flex: 0 0 auto;
        min-width: 155px;
    }
    .staff-chip.is-offline { --chip-color: #FF4E3B; }
    .staff-chip-icon { width: 38px; height: 38px; flex: none; color: var(--chip-color); }
    /* max-width é só uma rede de segurança pra nicknames do Discord fora
       do comum (até 32 caracteres) não esticarem o card demais — nomes/
       cargos normais ficam bem abaixo disso e o card hugga em volta deles
       sem sobrar espaço. */
    .staff-chip-col { display: flex; flex-direction: column; justify-content: center; min-width: 0; max-width: 170px; gap: 2px; }
    .staff-chip-name {
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        font-size: clamp(11px, 1.3vw, 16px);
        line-height: 1.4;
        color: #DCA15E;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .staff-chip-role {
        font-family: 'Poppins', sans-serif;
        font-weight: 400;
        font-size: clamp(8px, 0.8vw, 9px);
        line-height: 1.4;
        color: #F8DCC0;
        opacity: 0.85;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .staff-chip-status {
        font-family: 'Poppins', sans-serif;
        font-weight: 400;
        font-size: clamp(9px, 1vw, 13px);
        line-height: 1.4;
        color: #F8DCC0;
    }
    @media (max-width: 640px) {
        .ingame-staff-grid { gap: 10px; }
        .staff-chip { padding: 6px 8px; gap: 5px; }
        .staff-chip-icon { width: 26px; height: 26px; }
    }
</style>
