    .tp-mobile-drawer {
        box-sizing: border-box;
        position: fixed;
        top: 16px;
        bottom: 16px;
        left: 16px;
        margin: auto 0;
        max-height: calc(100vh - 32px);
        width: min(320px, calc(100vw - 32px));
        z-index: 100;
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 20px 18px;
        overflow-y: auto;
        background: linear-gradient(180deg, #252326 0%, #1F1D20 54.34%, #131314 98.29%);
        border: 1px solid rgba(0, 0, 0, 0.4);
        border-right: 1.5px solid rgba(248, 220, 192, 0.3);
        border-radius: 20px;
        box-shadow: -15px 30px 50px rgba(0, 0, 0, 0.8), inset 0.5px 0.5px 0px rgba(248, 220, 192, 0.12);
        font-family: 'Poppins', sans-serif;
        transform: translateX(calc(-100% - 32px));
        transition: transform 0.25s ease;
    }
    @media (prefers-reduced-motion: reduce) {
        .tp-mobile-drawer { transition: none; }
    }
    /* .is-open (JS, ver toggleMobileDrawer no <script> abaixo) — só tem
       efeito visual dentro desta mesma faixa de tela; acima de 767px o
       drawer nem existe (.tp-mobile-drawer-backdrop continua
       display:none, sobrescrito só aqui dentro do media query), então
       não corre risco de aparecer sozinho numa tela grande por engano
       (ex: usuário abre no celular, gira/redimensiona a janela sem
       fechar o drawer primeiro). Centralização vertical (top/bottom/
       margin acima) é sempre automática, não precisa de transform —
       só o eixo X anima entre fora/dentro da tela. */
    @media (max-width: 767px) {
        .tp-mobile-drawer.is-open { transform: translateX(0); }
        .tp-mobile-drawer-backdrop.is-open { display: block; }
    }
