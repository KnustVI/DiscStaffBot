           [data-collapsed="true"] acima (comentário completo lá). */
        .tp-sidebar:not([data-user-set]) .tp-sidebar-profile { flex-direction: column; gap: 8px; }
        .tp-sidebar:not([data-user-set]) .tp-sidebar-avatar { width: var(--tp-collapsed-avatar); height: var(--tp-collapsed-avatar); }
