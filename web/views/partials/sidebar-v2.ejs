<!-- Lucide (mesmo CDN já usado pra ícones em outras telas do projeto,
     confiável e MIT — evita redesenhar 10 paths de SVG na mão) -->
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
<script>
    (function () {
        var sidebar = document.getElementById('tpSidebar');
        var toggle = document.getElementById('tpSidebarToggle');
        if (!sidebar || !toggle) return;

        // Estado FORÇADO nesta página (ver parâmetro defaultCollapsed no
        // topo do arquivo) — ignora a preferência salva do localStorage NO
        // CARREGAMENTO (já nasce no estado escolhido por data-collapsed no
        // <aside> acima) e não GRAVA de volta nele quando o usuário clica
        // no toggle, pra essa página não "vazar" a escolha pras outras nem
        // herdar a escolha delas — cada carregamento desta página volta a
        // nascer no mesmo estado, aberta ou fechada conforme data-collapsed.
        var forceDefault = sidebar.hasAttribute('data-force-default');
        // Estado com que o <aside> nasceu do servidor (sbDefaultCollapsed)
        // — usado como fallback abaixo quando não há preferência salva E a
        // tela está larga o bastante pra não forçar nada.
        var serverDefaultCollapsed = sidebar.getAttribute('data-collapsed') === 'true';

        function applyState(collapsed) {
            sidebar.setAttribute('data-collapsed', collapsed ? 'true' : 'false');
            toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
        }

        // BUG REAL corrigido (pedido do dono, 2026-08-19: "isso aqui não
        // está ocorrendo", sobre o degrau "≤1000px fecha sozinha" da seção
        // 242) — o piso responsivo (CSS ":not([data-user-set])") só
        // funcionava pra quem NUNCA tinha clicado no toggle antes. Qualquer
        // clique anterior (em QUALQUER tela, mesmo larga) grava uma
        // preferência no localStorage que passa a "vencer" pra sempre,
        // inclusive abaixo de 1000px — depois de meses testando o botão à
        // mão, o dono certamente já tinha uma preferência salva, então o
        // degrau novo nunca tinha chance de rodar no navegador dele. Fix:
        // largura ≤1000px agora é um PISO que sempre vence, mesmo sobre
        // uma preferência salva — sem apagar essa preferência (só ignora
        // ela enquanto a tela estiver estreita; volta a valer normal assim
        // que a tela alarga de novo). matchMedia (não só o load) reavalia
        // isso toda vez que a largura cruza os 1000px, então redimensionar
        // a janela também dispara o comportamento, não só o carregamento
        // inicial da página.
        var narrowQuery = window.matchMedia('(max-width: 1000px)');

        function applyResponsiveState() {
            if (narrowQuery.matches) {
                applyState(true);
                return;
            }
            var stored = forceDefault ? null : localStorage.getItem('tpSidebarCollapsed');
            if (stored !== null) {
                sidebar.setAttribute('data-user-set', '');
                applyState(stored === 'true');
            } else {
                applyState(serverDefaultCollapsed);
            }
        }

        applyResponsiveState();
        // BUG REAL corrigido (pedido do dono, 2026-08-19: "quebrou o menu
        // de navegação mobile") — MediaQueryList.addEventListener não
        // existe em navegadores mais antigos (Safari <14, e sobretudo o
        // WebView embutido do próprio app do Discord no Android, que
        // costuma ficar atrás do Chrome "de verdade" do aparelho — bem
        // relevante aqui, já que o público real clica nesse link DE
        // DENTRO do Discord mobile). Sem addEventListener, essa linha
        // lançava TypeError e travava o resto do <script> — incluindo o
        // trecho MAIS ABAIXO no mesmo arquivo que redefine
        // window.toggleMobileDrawer, deixando o botão hamburguer
        // apertando e não fazendo NADA (o onclick já é defensivo, "if
        // (window.toggleMobileDrawer)", mas a função nunca chegava a
        // existir). Fallback pro método antigo (addListener) cobre esses
        // navegadores sem lançar erro nenhum.
        if (narrowQuery.addEventListener) {
            narrowQuery.addEventListener('change', applyResponsiveState);
        } else if (narrowQuery.addListener) {
            narrowQuery.addListener(applyResponsiveState);
        }

        // Clique no toggle continua sendo uma ação explícita do usuário —
        // funciona normalmente em qualquer largura, inclusive abaixo de
        // 1000px (quem quiser abrir manualmente numa tela estreita pode).
        // Só o CARREGAMENTO/redimensionamento automático respeita o piso
        // acima; o clique sempre reflete a escolha de quem clicou.
        toggle.addEventListener('click', function () {
            var next = sidebar.getAttribute('data-collapsed') !== 'true';
            sidebar.setAttribute('data-user-set', '');
            applyState(next);
            if (!forceDefault) localStorage.setItem('tpSidebarCollapsed', String(next));
        });

        if (window.lucide) window.lucide.createIcons();
    })();

    // BUG REAL corrigido (pedido do dono, 2026-08-17: "Menu de navegação
    // para mobile as vezes fica por baixo de alguns outros itens do
    // site, como por exemplo o aviso de testes e o perfil do jogados na
    // pagina perfil"). Causa raiz: em TODA página com sidebar, o
    // <aside class="shrink-0 h-screen sticky top-0 ..."> que envolve
    // esta partial (definido em cada página — perfil.ejs/moderacao.ejs/
    // etc, nunca aqui dentro) tem `position: sticky`, que SEMPRE cria um
    // novo contexto de empilhamento (mesmo sem nenhum z-index definido —
    // confirmado na spec de CSS, não é um detalhe de implementação). O
    // backdrop/drawer nascem DENTRO desse wrapper (mesmo bloco incluído
    // pela página via include), então o `z-index: 100` deles fica PRESO
    // nesse contexto local — por
    // maior que seja o número, nunca consegue ficar por cima de <main>
    // (que vem DEPOIS do <aside> no DOM, sem position nenhum, empilhando
    // na ordem normal) — exatamente o "aviso de testes"/card de perfil
    // reportados, os primeiros elementos de <main> em /perfil.
    // Fix sem reescrever a estrutura das ~10 páginas que usam esta
    // sidebar: move o backdrop/drawer pra serem filhos DIRETOS de
    // <body> em runtime (mesmo padrão de "portal" usado por bibliotecas
    // de modal/dialog) — escapa por completo do contexto de
    // empilhamento do wrapper sticky. Seguro: os dois usam só seletores
    // de classe própria (nunca dependem de um ancestral específico) e já
    // são `position: fixed` (relativo à viewport, não ao pai) — mover o
    // nó no DOM não muda posição/tamanho visual nenhum, só a ordem de
    // empilhamento. `getElementById` em toggleMobileDrawer continua
    // funcionando igual depois do move (busca o documento inteiro, não
    // depende de onde o nó está).
    (function () {
        var backdrop = document.getElementById('tpMobileDrawerBackdrop');
        var drawer = document.getElementById('tpMobileDrawer');
        if (backdrop) document.body.appendChild(backdrop);
        if (drawer) document.body.appendChild(drawer);
    })();

    // Drawer mobile (pedido do dono, 2026-08-16) — GLOBAL de propósito
    // (função solta, sem namespace, mesmo padrão de toggleLang/
    // syncI18nAttrs em top-nav.ejs): o botão hamburguer que abre isso
    // vive no OUTRO arquivo (partials/top-nav.ejs, sempre incluído ANTES
    // deste no <body> de toda página) — window.toggleMobileDrawer
    // precisa existir fora do IIFE acima pra esse botão conseguir
    // chamar. force (boolean opcional) permite fechar explicitamente
    // (backdrop/X/clique num item) sem depender do estado atual — sem
    // argumento, alterna (usado só pelo próprio botão hamburguer).
    function toggleMobileDrawer(force) {
        var drawer = document.getElementById('tpMobileDrawer');
        var backdrop = document.getElementById('tpMobileDrawerBackdrop');
        var btn = document.getElementById('tpMobileMenuBtn');
        if (!drawer || !backdrop) return;
        var open = typeof force === 'boolean' ? force : !drawer.classList.contains('is-open');
        drawer.classList.toggle('is-open', open);
        backdrop.classList.toggle('is-open', open);
        drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
        if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        // Trava o scroll da PÁGINA enquanto o drawer está aberto — é um
        // overlay por cima do conteúdo (backdrop escurecido), sem isso
        // dava pra rolar o que está por trás dele, confuso num elemento
        // que se comporta como modal.
        document.body.style.overflow = open ? 'hidden' : '';
    }
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') toggleMobileDrawer(false);
    });

    // Botão + JS de idioma (toggleLang/updateLangToggleLabel/
    // syncI18nAttrs) REMOVIDOS daqui (pedido do dono, 2026-08-13) — vivem
    // só em partials/top-nav.ejs agora, que acompanha esta sidebar em
    // toda página que a inclui. syncI18nAttrs continua global (função
    // solta, sem namespace) a partir de lá — web/public/js/
    // poll-fragment.js continua chamando ela por fora sem mudança
    // nenhuma (checagem defensiva `typeof syncI18nAttrs === 'function'`).
</script>
