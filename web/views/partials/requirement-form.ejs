<%#
  web/views/partials/requirement-form.ejs
  Editor de requisitos de resgate de emblema/título — extraído num
  parcial só (pedido do dono, 2026-08-12: "Configuração e emblemas
  parece meio quebrado, não esta claro como devem ser os requisitos...
  e titulo esta sem essa confguração tambem") pra usar EXATAMENTE o
  mesmo formulário nos dois tipos (badge E titulo) sem duplicar a
  marcação/JS duas vezes.

  LISTA de requisitos, não só um (pedido do dono, 2026-08-13: "preciso
  que ele adicione os requisitos como uma lista onde o player só
  consiga reivindicar se fez todos os requisitos") — cada emblema/
  título pode ter 0-5 requisitos, TODOS obrigatórios ao mesmo tempo
  (E, não OU — ver AchievementSystem.checkRequirementMet). Renderiza
  uma linha de campos (tipo/valor/espécie) por requisito já salvo
  (`img.requirement`, sempre um array — ver AchievementSystem.
  parseRequirement) + um botão "+ Adicionar requisito" que clona um
  <template> em branco via JS (renderRequirementRowHtml abaixo gera o
  MESMO HTML pras linhas reais e pro template, sem duplicar a lista de
  <option> em JS solto). Remover uma linha (botão "×") só tira ela do
  DOM — salvar com 0 linhas preenchidas limpa o requisito por completo
  (volta a ser só concessão manual, ver dashboard.js POST /requisito).

  Clareza da UX (pedido do dono, 2026-08-12): o rótulo do campo "Valor"
  e a frase de ajuda embaixo mudam sozinhos conforme o tipo de
  requisito escolhido (ver requirementTypes[*].valueLabel/hint em
  achievementSystem.js), e o campo de Espécie só aparece pros tipos que
  realmente usam espécie (needsSpecies).

  3 campos condicionais novos (pedido do dono, 2026-08-14 — servidor
  específico/abate de espécie/está online, ver achievementSystem.js):
  campo de Servidor (<select>, não texto livre) só aparece pra tipos
  needsServer:true; campo de Valor inteiro SOME pra tipos noValue:true
  (ex: "Está online", que não tem valor numérico nenhum — o campo fica
  escondido mas continua existindo no DOM/form, o backend em
  dashboard.js é quem ignora o que vier nele e grava um placeholder
  fixo).

  Campo de PERÍODO novo (pedido do dono, 2026-08-19, junto com o
  criador de Missões — "Registrou entre as datas...") — 2 <input
  type="date"> (requirement_date_from[]/requirement_date_to[]) só
  aparecem pro tipo registered_between (needsDateRange:true). O outro
  tipo novo do mesmo pedido (registered_on_server) NÃO precisa de UI
  nova nenhuma — já é noValue+needsServer, as 2 flags que este parcial
  já sabia togglear independentemente.

  Uso: include( partials/requirement-form , { img, type, requirementTypes, configuredServers } )
    img — linha do pool (badge ou titulo), já com img.requirement
      (ARRAY parseado ou null — ver AchievementSystem.parseRequirement)
      e img.requirementLabel (string legível já com todos os requisitos
      juntados, ver AchievementSystem.describeRequirement) vindos de
      dashboard.js.
    type — 'badge' ou 'titulo', usado só pra montar a action do form.
    requirementTypes — AchievementSystem.REQUIREMENT_TYPES.
    configuredServers — [{guildId, name}], só servidores com PoT
      configurado de verdade (PoTConfigSystem.getAllConfiguredGuildIds),
      não toda guild que o bot está — ver dashboard.js GET /dev/Loja.

  OVERLAY (pedido do dono, 2026-08-15: "Edição de requisitos ainda
  parece meio quebrado, não podemos alterar e salvar requisitos em uma
  overlay?") — o formulário inteiro (linhas + adicionar + salvar) agora
  mora dentro de um <dialog> nativo, aberto por um botão "Configurar
  requisito" na já familiar "resumo" do card (só o texto de
  img.requirementLabel + o botão, sempre visível). <dialog> nativo
  resolve empilhamento/centralização sozinho (renderiza no top layer do
  navegador, sem depender de z-index/overflow do .pool-item apertado que
  o continha) e já dá confirmação por Esc de graça — só falta JS pra
  fechar clicando fora e pra descartar edições não salvas (ver
  requirementFormOpen/o listener de 'close' em dev-lojas.ejs). O motivo
  de precisar descartar: como abrir/fechar o dialog NÃO recarrega a
  página (diferente de salvar, que sempre navega pra ?saved=...), uma
  linha adicionada/removida só no DOM sobreviveria "fantasma" pra
  próxima vez que o dono abrisse o mesmo dialog se não fosse resetada.
%>
<%
    const rfId = `rf-${type}-${img.id}`;
    const rfRequirements = Array.isArray(img.requirement) ? img.requirement : [];
    // Mesmo teto do backend (dashboard.js POST /requisito) — o botão
    // "+ Adicionar requisito" se desabilita ao chegar aqui, evitando um
    // submit que o servidor cortaria de qualquer forma.
    const RF_MAX_REQUIREMENTS = 5;

    // Só usado nos poucos valores livres (espécie) que passam por um
    // template literal cru (renderRequirementRowHtml) em vez da
    // interpolação escapada de sempre — requirementTypes/rowIdx nunca vêm de entrada de
    // usuário, só requirement.species (texto que o próprio dono digitou
    // num save anterior).
    const rfEsc = (str) => String(str ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    // Gera o HTML de UMA linha de campos (tipo/valor/espécie/remover) —
    // reaproveitada tanto pelas linhas JÁ salvas (requirement != null)
    // quanto pelo <template> em branco que o JS clona ao clicar em
    // "+ Adicionar requisito" (requirement = null, rowIdx = '__IDX__',
    // nunca renderizado de verdade — só existe dentro de um <template>,
    // invisível e fora do form até ser clonado).
    function renderRequirementRowHtml(rowIdx, requirement) {
        const rowId = `${rfId}-${rowIdx}`;
        const currentType = requirement?.type || '';
        const currentDef = requirementTypes[currentType];
        const optionsHtml = Object.keys(requirementTypes).map((key) => {
            const def = requirementTypes[key];
            return `<option value="${key}" data-value-label="${rfEsc(def.valueLabel)}" data-hint="${rfEsc(def.hint)}" data-needs-species="${def.needsSpecies ? '1' : '0'}" data-needs-server="${def.needsServer ? '1' : '0'}" data-no-value="${def.noValue ? '1' : '0'}" data-needs-date-range="${def.needsDateRange ? '1' : '0'}" ${currentType === key ? 'selected' : ''}>${rfEsc(def.label)}</option>`;
        }).join('');
        const serverOptionsHtml = configuredServers.map((s) => `<option value="${rfEsc(s.guildId)}" ${requirement && requirement.guildId === s.guildId ? 'selected' : ''}>${rfEsc(s.name)}</option>`).join('');
        return `
            <div class="pool-req-row" data-row-id="${rowId}">
                <div class="pool-price-row">
                    <select name="requirement_type[]" id="${rowId}-type" onchange="requirementFormSync('${rowId}')">
                        <option value="" data-hint="Nenhum requisito — deixe em branco pra não contar esta linha.">Nenhum</option>
                        ${optionsHtml}
                    </select>
                    <button type="button" class="pool-req-remove" onclick="requirementFormRemoveRow(this)" aria-label="Remover este requisito" title="Remover este requisito">&times;</button>
                </div>
                <div id="${rowId}-value-row" class="pool-req-value-row" style="${currentDef?.noValue ? 'display:none;' : ''}">
                    <label id="${rowId}-value-label" for="${rowId}-value">${rfEsc(currentDef?.valueLabel || 'Valor')}:</label>
                    <input type="number" id="${rowId}-value" name="requirement_value[]" min="1" step="1" placeholder="Ex: 100" value="${requirement ? rfEsc(requirement.value) : ''}">
                </div>
                <div id="${rowId}-species-row" class="pool-req-value-row" style="${currentDef?.needsSpecies ? '' : 'display:none;'}">
                    <label for="${rowId}-species">Espécie:</label>
                    <input type="text" id="${rowId}-species" name="requirement_species[]" placeholder="Ex: Deinosuchus" value="${requirement && requirement.species ? rfEsc(requirement.species) : ''}">
                </div>
                <div id="${rowId}-server-row" class="pool-req-value-row" style="${currentDef?.needsServer ? '' : 'display:none;'}">
                    <label for="${rowId}-server">Servidor:</label>
                    <select id="${rowId}-server" name="requirement_server[]">
                        <option value="">Selecione um servidor...</option>
                        ${serverOptionsHtml}
                    </select>
                </div>
                <div id="${rowId}-daterange-row" class="pool-req-value-row" style="${currentDef?.needsDateRange ? '' : 'display:none;'}">
                    <label for="${rowId}-date-from">De:</label>
                    <input type="date" id="${rowId}-date-from" name="requirement_date_from[]" value="${requirement && requirement.startDate ? rfEsc(requirement.startDate) : ''}">
                    <label for="${rowId}-date-to">Até:</label>
                    <input type="date" id="${rowId}-date-to" name="requirement_date_to[]" value="${requirement && requirement.endDate ? rfEsc(requirement.endDate) : ''}">
                </div>
                <p id="${rowId}-hint" class="pool-req-hint">${rfEsc(currentDef?.hint || 'Escolha um tipo de requisito acima para ver a explicação.')}</p>
            </div>`;
    }
%>
<div class="pool-requirement-summary">
    <span class="pool-price-current"><%= img.requirementLabel || 'Sem requisito (só concessão manual)' %></span>
    <button type="button" class="pool-req-configure-btn" onclick="requirementFormOpen('<%= rfId %>')">Configurar requisito</button>
</div>

<dialog id="<%= rfId %>-dialog" class="pool-req-dialog">
    <form action="/dev/Loja/<%= type %>/<%= img.id %>/requisito" method="POST" class="flex flex-col gap-3" data-rf-id="<%= rfId %>" data-rf-max="<%= RF_MAX_REQUIREMENTS %>">
        <div class="pool-req-dialog-head">
            <h3>Requisito — <%= img.label %></h3>
            <button type="button" class="pool-req-dialog-close" onclick="this.closest('dialog').close()" aria-label="Fechar sem salvar" title="Fechar sem salvar">&times;</button>
        </div>
        <div class="pool-req-rows">
            <% if (rfRequirements.length === 0) { %>
                <%- renderRequirementRowHtml(0, null) %>
            <% } else { %>
                <% rfRequirements.forEach((requirement, i) => { %>
                    <%- renderRequirementRowHtml(i, requirement) %>
                <% }); %>
            <% } %>
        </div>
        <button type="button" class="pool-req-add" onclick="requirementFormAddRow(this)"<%= rfRequirements.length >= RF_MAX_REQUIREMENTS ? ' disabled' : '' %>>+ Adicionar requisito</button>
        <div class="pool-req-dialog-actions">
            <button type="button" class="pool-toggle-btn" onclick="this.closest('dialog').close()">Cancelar</button>
            <button type="submit" class="pool-price-submit">Salvar requisitos</button>
        </div>
    </form>
</dialog>
<%# <template> nunca é exibido nem enviado no submit — só existe pro
    JS (requirementFormAddRow, em dev-lojas.ejs) clonar o conteúdo.
    rowIdx literal "__IDX__" é trocado por um índice novo (timestamp)
    na hora de clonar, pra nunca colidir com uma linha já existente
    nem entre chamadas seguidas de "+ Adicionar". %>
<template id="<%= rfId %>-template"><%- renderRequirementRowHtml('__IDX__', null) %></template>
