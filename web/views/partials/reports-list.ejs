            <input type="hidden" name="openPage" value="<%= openPagination.page %>">
            <input type="hidden" name="openSearch" value="<%= openPagination.search %>">
            <input type="text" name="closedSearch" value="<%= closedPagination.search %>" placeholder="Buscar por ID ou usuário..." data-i18n-ph-pt="Buscar por ID ou usuário..." data-i18n-ph-en="Search by ID or username..." class="report-search-input">
            <button type="submit" class="report-search-btn"><i data-lucide="search" class="w-4 h-4"></i></button>
