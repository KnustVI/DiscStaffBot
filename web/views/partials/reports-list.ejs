<%#
  web/views/partials/reports-list.ejs
  Seções "Reportes Abertos" e "Reportes Fechados" de reports.ejs —
  extraído pra partial pra dar pra atualizar em tempo real (poll, ver
  public/js/poll-fragment.js e GET /fragments/reports-list/:guildID em
  dashboard.js), pedido do dono ("chats de reportes" também em tempo
  real).

  Uso: include( partials/reports-list , { guild, openReports, closedReports } )
    guild         — precisa de guild.id pro link "Investigar" (canal/thread)
    openReports   — array já enriquecido (agid/playerName/discordUsername/
                    closedByName/threadDeletedByName/statusLabel), ver
                    dashboard.js:getReportsData()
    closedReports — idem, filtrado por status fechado

  discordUsername/playerName (pedido do dono: a lista não mostrava nem um
  nem outro — "<@user_id>" é sintaxe de menção do PRÓPRIO Discord, não
  resolve em HTML, aparecia como texto cru) vêm resolvidos prontos de
  dashboard.js (cache do client + fallback pra tabela `users`), não
  precisam de nenhuma resolução aqui.

  O botão "Investigar" (link pro tópico) só aparece quando o tópico ainda
  existe (r.thread_id E não tem threadDeletedByName) — se foi apagado, no
  lugar aparece quem apagou (thread_deleted_by, resolvido via audit log em
  src/events/threadDelete.js). "Fechado por" sempre aparece nos fechados,
  mesmo quando foi o sistema que fechou sozinho (thread apagada com o
  report ainda aberto — closed_by fica null nesse caso).

  As classes .report-card/.report-status/.report-card-meta ficam no
  <style> de reports.ejs (a página que sempre inclui este parcial), não
  duplicadas aqui.
%>
<!-- REPORTES ABERTOS -->
<section class="titan-card-premium flex-col gap-4">
    <h2 class="section-title text-lg">Reportes Abertos</h2>
    <% if (openReports.length === 0) { %>
        <p class="text-sm opacity-40">Nenhum reporte aberto no momento.</p>
    <% } else { %>
        <div class="flex flex-col gap-3">
            <% openReports.forEach(r => { %>
                <div class="report-card">
                    <div class="flex items-center gap-2">
                        <i data-lucide="flag" class="w-4 h-4 text-titan-accent"></i>
                        <span class="font-semibold"><%= r.report_id %></span>
                        <span class="report-status"><%= r.statusLabel %></span>
                    </div>
                    <div class="report-card-meta">
                        <span><i data-lucide="user" class="w-3.5 h-3.5"></i> <%= r.discordUsername %></span>
                        <% if (r.playerName) { %><span><i data-lucide="gamepad-2" class="w-3.5 h-3.5"></i> <%= r.playerName %><% if (r.agid) { %> (AGID <%= r.agid %>)<% } %></span>
                        <% } else if (r.agid) { %><span><i data-lucide="gamepad-2" class="w-3.5 h-3.5"></i> AGID <%= r.agid %></span><% } %>
                        <span><i data-lucide="calendar" class="w-3.5 h-3.5"></i> <%= new Date(r.created_at).toLocaleString('pt-BR') %></span>
                    </div>
                    <% if (r.thread_id && !r.threadDeletedByName) { %>
                        <a href="https://discord.com/channels/<%= guild.id %>/<%= r.thread_id %>" target="_blank" class="btn-primary !min-w-0 !h-auto !py-2 !px-4 !text-sm self-start">
                            <i data-lucide="telescope" class="w-4 h-4"></i> Investigar
                        </a>
                    <% } else if (r.threadDeletedByName) { %>
                        <p class="text-xs" style="color:#FF4E3B;">Tópico apagado por: <%= r.threadDeletedByName %></p>
                    <% } %>
                </div>
            <% }); %>
        </div>
    <% } %>
</section>

<!-- REPORTES FECHADOS -->
<section class="titan-card-premium flex-col gap-4">
    <h2 class="section-title text-lg">Reportes Fechados</h2>
    <p class="text-xs opacity-40 -mt-2">O Titan's Pass não guarda a conversa dos reportes fora do Discord — mantenha os tópicos criados para histórico.</p>
    <% if (closedReports.length === 0) { %>
        <p class="text-sm opacity-40">Nenhum reporte fechado ainda.</p>
    <% } else { %>
        <div class="flex flex-col gap-3">
            <% closedReports.forEach(r => { %>
                <div class="report-card">
                    <div class="flex items-center gap-2">
                        <i data-lucide="flag" class="w-4 h-4 text-titan-accent"></i>
                        <span class="font-semibold"><%= r.report_id %></span>
                        <span class="report-status"><%= r.statusLabel %></span>
                    </div>
                    <div class="report-card-meta">
                        <span><i data-lucide="user" class="w-3.5 h-3.5"></i> <%= r.discordUsername %></span>
                        <% if (r.playerName) { %><span><i data-lucide="gamepad-2" class="w-3.5 h-3.5"></i> <%= r.playerName %><% if (r.agid) { %> (AGID <%= r.agid %>)<% } %></span>
                        <% } else if (r.agid) { %><span><i data-lucide="gamepad-2" class="w-3.5 h-3.5"></i> AGID <%= r.agid %></span><% } %>
                        <span><i data-lucide="calendar" class="w-3.5 h-3.5"></i> <%= new Date(r.created_at).toLocaleString('pt-BR') %></span>
                    </div>
                    <% if (r.punishment) { %><p class="text-xs opacity-60">Punição aplicada: <%= r.punishment %></p><% } %>
                    <% if (r.closed_reason) { %><p class="text-xs opacity-60">Motivo de fechamento: <%= r.closed_reason %></p><% } %>
                    <p class="text-xs opacity-60">Fechado por: <%= r.closedByName || 'Automático (sistema)' %></p>
                    <% if (r.rating) { %><p class="text-xs opacity-60">Avaliação: <%= r.rating %>/5<% if (r.rating_comment) { %> — "<%= r.rating_comment %>"<% } %></p><% } %>
                    <% if (r.threadDeletedByName) { %>
                        <p class="text-xs" style="color:#FF4E3B;">Tópico apagado por: <%= r.threadDeletedByName %></p>
                    <% } else if (r.thread_id) { %>
                        <a href="https://discord.com/channels/<%= guild.id %>/<%= r.thread_id %>" target="_blank" class="btn-primary !min-w-0 !h-auto !py-2 !px-4 !text-sm self-start">
                            <i data-lucide="telescope" class="w-4 h-4"></i> Investigar
                        </a>
                    <% } %>
                </div>
            <% }); %>
        </div>
    <% } %>
</section>
