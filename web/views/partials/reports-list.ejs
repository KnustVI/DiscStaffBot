<%#
  web/views/partials/reports-list.ejs
  Seções "Reportes Abertos" e "Reportes Fechados" de reports.ejs —
  extraído pra partial pra dar pra atualizar em tempo real (poll, ver
  public/js/poll-fragment.js e GET /fragments/reports-list/:guildID em
  dashboard.js), pedido do dono ("chats de reportes" também em tempo
  real).

  Uso: include( partials/reports-list , { basePath, openReports, openPagination, closedReports, closedPagination, showGuildBadge } )
    basePath         — prefixo pra montar as URLs de busca/paginação (ex:
                       '/reports/123456' na página de um servidor,
                       '/perfil/denuncias' na página global "Suas
                       Denúncias" — ver perfil-denuncias.ejs). O link
                       "Investigar" (canal/thread) usa r.guild_id de CADA
                       linha, não depende de basePath — funciona igual em
                       contexto de 1 servidor só ou de vários misturados.
    showGuildBadge   — OPCIONAL (padrão false). Mostra um selo com o nome
                       do servidor em cada card — só faz sentido numa
                       lista com reports de VÁRIOS servidores misturados
                       (ver r.guildName, resolvido em
                       dashboard.js:getUserReportsData). Nas páginas de um
                       servidor só (reports.ejs) fica desligado — todo
                       card já é obviamente do mesmo servidor.
    openReports      — array já enriquecido (agid/playerName/discordUsername/
                       discordRoleLabel/closedByName/closedByRoleLabel/
                       threadDeletedByName/threadDeletedByRoleLabel/
                       statusLabel/guild_id, +guildName se showGuildBadge)
                       — já vem SÓ com a página atual (10 por vez), ver
                       dashboard.js:getReportsData()/getUserReportsData()
    openPagination   — { page, totalPages, total, search }
    closedReports    — idem openReports, filtrado por status fechado
    closedPagination — idem openPagination

  discordUsername/playerName (pedido do dono: a lista não mostrava nem um
  nem outro — "<@user_id>" é sintaxe de menção do PRÓPRIO Discord, não
  resolve em HTML, aparecia como texto cru) vêm resolvidos prontos de
  dashboard.js (cache do client + fallback pra tabela `users`), não
  precisam de nenhuma resolução aqui.

  *RoleLabel (discordRoleLabel/closedByRoleLabel/threadDeletedByRoleLabel)
  — pedido do dono: informar sempre se quem é mencionado (autor do
  report, quem fechou, quem apagou o tópico) é staff ou não, validado
  pelos cargos configurados em config-roles. Já vem pronto de
  dashboard.js:resolveStaffRoleLabel — "Não é staff" ou o nome do maior
  cargo de staff (posição mais alta no Discord) que a pessoa tem.

  O botão "Investigar" (link pro tópico) só aparece quando o tópico ainda
  existe (r.thread_id E não tem threadDeletedByName) — se foi apagado, no
  lugar aparece quem apagou (thread_deleted_by, resolvido via audit log em
  src/events/threadDelete.js). "Fechado por" sempre aparece nos fechados,
  mesmo quando foi o sistema que fechou sozinho (thread apagada com o
  report ainda aberto — closed_by fica null nesse caso).

  Busca/paginação (pedido do dono: "reports pode virar uma lista enorme no
  futuro") — reportsHref() abaixo monta a URL da PÁGINA CHEIA
  (/reports/:guildID), não do fragment: os controles de busca/paginação
  sempre navegam via GET normal (sem JS/fetch), mesmo padrão do resto do
  dashboard. Os 2 blocos são independentes (buscar/paginar Abertos não mexe
  em Fechados e vice-versa) — cada formulário carrega a página/busca ATUAL
  do outro bloco em campos hidden pra não resetá-lo.

  As classes .report-card/.report-status/.report-card-meta/.report-search-*/
  .report-page-* ficam no <style> de reports.ejs (a página que sempre
  inclui este parcial), não duplicadas aqui.
%>
<%
const rlShowGuildBadge = typeof showGuildBadge !== 'undefined' && showGuildBadge;
function reportsHref(overrides) {
    const state = Object.assign({
        openPage: openPagination.page,
        openSearch: openPagination.search,
        closedPage: closedPagination.page,
        closedSearch: closedPagination.search,
    }, overrides);
    const params = new URLSearchParams();
    if (state.openPage > 1) params.set('openPage', state.openPage);
    if (state.openSearch) params.set('openSearch', state.openSearch);
    if (state.closedPage > 1) params.set('closedPage', state.closedPage);
    if (state.closedSearch) params.set('closedSearch', state.closedSearch);
    const qs = params.toString();
    return basePath + (qs ? '?' + qs : '');
}
%>
<!-- REPORTES ABERTOS -->
<section class="titan-card-premium flex-col gap-4">
    <div class="flex items-center justify-between flex-wrap gap-3">
        <h2 class="section-title text-lg">Reportes Abertos</h2>
        <form method="GET" action="<%= basePath %>" class="report-search-form">
            <input type="hidden" name="openPage" value="1">
            <input type="hidden" name="closedPage" value="<%= closedPagination.page %>">
            <input type="hidden" name="closedSearch" value="<%= closedPagination.search %>">
            <input type="text" name="openSearch" value="<%= openPagination.search %>" placeholder="Buscar por ID ou usuário..." class="report-search-input">
            <button type="submit" class="report-search-btn"><i data-lucide="search" class="w-4 h-4"></i></button>
            <% if (openPagination.search) { %>
                <a href="<%= reportsHref({ openSearch: '', openPage: 1 }) %>" class="report-search-clear">Limpar</a>
            <% } %>
        </form>
    </div>
    <% if (openReports.length === 0) { %>
        <p class="text-sm opacity-40"><%= openPagination.search ? `Nenhum reporte encontrado para "${openPagination.search}".` : 'Nenhum reporte aberto no momento.' %></p>
    <% } else { %>
        <div class="flex flex-col gap-3">
            <% openReports.forEach(r => { %>
                <div class="report-card">
                    <div class="flex items-center gap-2">
                        <i data-lucide="flag" class="w-4 h-4 text-titan-accent"></i>
                        <span class="font-semibold"><%= r.report_id %></span>
                        <span class="report-status"><%= r.statusLabel %></span>
                        <% if (rlShowGuildBadge) { %>
                            <span class="report-guild-badge">
                                <% if (r.guildIconUrl) { %>
                                    <img src="<%= r.guildIconUrl %>" alt="">
                                <% } else { %>
                                    <span class="report-guild-badge-fallback"><i data-lucide="server"></i></span>
                                <% } %>
                                <%= r.guildName %>
                            </span>
                        <% } %>
                    </div>
                    <div class="report-card-meta">
                        <span><i data-lucide="user" class="w-3.5 h-3.5"></i> <%= r.discordUsername %> (<%= r.discordRoleLabel %>)</span>
                        <% if (r.playerName) { %><span><i data-lucide="gamepad-2" class="w-3.5 h-3.5"></i> <%= r.playerName %><% if (r.agid) { %> (AGID <%= r.agid %>)<% } %></span>
                        <% } else if (r.agid) { %><span><i data-lucide="gamepad-2" class="w-3.5 h-3.5"></i> AGID <%= r.agid %></span><% } %>
                        <span><i data-lucide="calendar" class="w-3.5 h-3.5"></i> <%= new Date(r.created_at).toLocaleString('pt-BR') %></span>
                    </div>
                    <% if (r.thread_id && !r.threadDeletedByName) { %>
                        <a href="https://discord.com/channels/<%= r.guild_id %>/<%= r.thread_id %>" target="_blank" class="btn-primary !min-w-0 !h-auto !py-2 !px-4 !text-sm self-start mt-2">
                            <i data-lucide="telescope" class="w-4 h-4"></i> Investigar
                        </a>
                    <% } else if (r.threadDeletedByName) { %>
                        <p class="text-xs" style="color:#FF4E3B;">Tópico apagado por: <%= r.threadDeletedByName %> (<%= r.threadDeletedByRoleLabel %>)</p>
                    <% } %>
                </div>
            <% }); %>
        </div>
        <% if (openPagination.totalPages > 1) { %>
            <div class="report-pagination">
                <% if (openPagination.page > 1) { %>
                    <a href="<%= reportsHref({ openPage: openPagination.page - 1 }) %>" class="report-page-btn"><i data-lucide="chevron-left" class="w-4 h-4"></i> Anterior</a>
                <% } else { %>
                    <span class="report-page-btn disabled"><i data-lucide="chevron-left" class="w-4 h-4"></i> Anterior</span>
                <% } %>
                <span class="report-page-info">Página <%= openPagination.page %> de <%= openPagination.totalPages %> (<%= openPagination.total %> reportes)</span>
                <% if (openPagination.page < openPagination.totalPages) { %>
                    <a href="<%= reportsHref({ openPage: openPagination.page + 1 }) %>" class="report-page-btn">Próxima <i data-lucide="chevron-right" class="w-4 h-4"></i></a>
                <% } else { %>
                    <span class="report-page-btn disabled">Próxima <i data-lucide="chevron-right" class="w-4 h-4"></i></span>
                <% } %>
            </div>
        <% } %>
    <% } %>
</section>

<!-- REPORTES FECHADOS -->
<section class="titan-card-premium flex-col gap-4">
    <div class="flex items-center justify-between flex-wrap gap-3">
        <h2 class="section-title text-lg">Reportes Fechados</h2>
        <form method="GET" action="<%= basePath %>" class="report-search-form">
            <input type="hidden" name="closedPage" value="1">
            <input type="hidden" name="openPage" value="<%= openPagination.page %>">
            <input type="hidden" name="openSearch" value="<%= openPagination.search %>">
            <input type="text" name="closedSearch" value="<%= closedPagination.search %>" placeholder="Buscar por ID ou usuário..." class="report-search-input">
            <button type="submit" class="report-search-btn"><i data-lucide="search" class="w-4 h-4"></i></button>
            <% if (closedPagination.search) { %>
                <a href="<%= reportsHref({ closedSearch: '', closedPage: 1 }) %>" class="report-search-clear">Limpar</a>
            <% } %>
        </form>
    </div>
    <p class="text-xs opacity-40 -mt-2">O Titan's Pass não guarda a conversa dos reportes fora do Discord — mantenha os tópicos criados para histórico.</p>
    <% if (closedReports.length === 0) { %>
        <p class="text-sm opacity-40"><%= closedPagination.search ? `Nenhum reporte encontrado para "${closedPagination.search}".` : 'Nenhum reporte fechado ainda.' %></p>
    <% } else { %>
        <div class="flex flex-col gap-3">
            <% closedReports.forEach(r => { %>
                <div class="report-card">
                    <div class="flex items-center gap-2">
                        <i data-lucide="flag" class="w-4 h-4 text-titan-accent"></i>
                        <span class="font-semibold"><%= r.report_id %></span>
                        <span class="report-status"><%= r.statusLabel %></span>
                        <% if (rlShowGuildBadge) { %>
                            <span class="report-guild-badge">
                                <% if (r.guildIconUrl) { %>
                                    <img src="<%= r.guildIconUrl %>" alt="">
                                <% } else { %>
                                    <span class="report-guild-badge-fallback"><i data-lucide="server"></i></span>
                                <% } %>
                                <%= r.guildName %>
                            </span>
                        <% } %>
                    </div>
                    <div class="report-card-meta">
                        <span><i data-lucide="user" class="w-3.5 h-3.5"></i> <%= r.discordUsername %> (<%= r.discordRoleLabel %>)</span>
                        <% if (r.playerName) { %><span><i data-lucide="gamepad-2" class="w-3.5 h-3.5"></i> <%= r.playerName %><% if (r.agid) { %> (AGID <%= r.agid %>)<% } %></span>
                        <% } else if (r.agid) { %><span><i data-lucide="gamepad-2" class="w-3.5 h-3.5"></i> AGID <%= r.agid %></span><% } %>
                        <span><i data-lucide="calendar" class="w-3.5 h-3.5"></i> <%= new Date(r.created_at).toLocaleString('pt-BR') %></span>
                    </div>
                    <% if (r.punishment) { %><p class="text-xs opacity-60">Punição aplicada: <%= r.punishment %></p><% } %>
                    <% if (r.closed_reason) { %><p class="text-xs opacity-60">Motivo de fechamento: <%= r.closed_reason %></p><% } %>
                    <p class="text-xs opacity-60">Fechado por: <%= r.closedByName || 'Automático (sistema)' %><% if (r.closedByRoleLabel) { %> (<%= r.closedByRoleLabel %>)<% } %></p>
                    <% if (r.rating) { %><p class="text-xs opacity-60">Avaliação: <%= r.rating %>/5<% if (r.rating_comment) { %> — "<%= r.rating_comment %>"<% } %></p><% } %>
                    <% if (r.threadDeletedByName) { %>
                        <p class="text-xs" style="color:#FF4E3B;">Tópico apagado por: <%= r.threadDeletedByName %> (<%= r.threadDeletedByRoleLabel %>)</p>
                    <% } else if (r.thread_id) { %>
                        <a href="https://discord.com/channels/<%= r.guild_id %>/<%= r.thread_id %>" target="_blank" class="btn-primary !min-w-0 !h-auto !py-2 !px-4 !text-sm self-start mt-2">
                            <i data-lucide="telescope" class="w-4 h-4"></i> Investigar
                        </a>
                    <% } %>
                </div>
            <% }); %>
        </div>
        <% if (closedPagination.totalPages > 1) { %>
            <div class="report-pagination">
                <% if (closedPagination.page > 1) { %>
                    <a href="<%= reportsHref({ closedPage: closedPagination.page - 1 }) %>" class="report-page-btn"><i data-lucide="chevron-left" class="w-4 h-4"></i> Anterior</a>
                <% } else { %>
                    <span class="report-page-btn disabled"><i data-lucide="chevron-left" class="w-4 h-4"></i> Anterior</span>
                <% } %>
                <span class="report-page-info">Página <%= closedPagination.page %> de <%= closedPagination.totalPages %> (<%= closedPagination.total %> reportes)</span>
                <% if (closedPagination.page < closedPagination.totalPages) { %>
                    <a href="<%= reportsHref({ closedPage: closedPagination.page + 1 }) %>" class="report-page-btn">Próxima <i data-lucide="chevron-right" class="w-4 h-4"></i></a>
                <% } else { %>
                    <span class="report-page-btn disabled">Próxima <i data-lucide="chevron-right" class="w-4 h-4"></i></span>
                <% } %>
            </div>
        <% } %>
    <% } %>
</section>
