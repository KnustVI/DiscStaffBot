    <% if (closedReports.length === 0) { %>
        <p class="text-sm opacity-40">
            <% if (closedPagination.search) { %>
                <span data-i18n-pt>Nenhum reporte encontrado para "<%= closedPagination.search %>".</span><span data-i18n-en>No report found for "<%= closedPagination.search %>".</span>
            <% } else { %>
                <span data-i18n-pt>Nenhum reporte fechado ainda.</span><span data-i18n-en>No closed reports yet.</span>
            <% } %>
        </p>
    <% } else { %>
        <div class="flex flex-col gap-3">
            <% closedReports.forEach(r => { %>
                <div class="report-card">
                    <div class="flex items-center gap-2">
                        <i data-lucide="flag" class="w-4 h-4 text-titan-accent"></i>
                        <span class="font-semibold"><%= r.report_id %></span>
                        <span class="report-status"><%= r.statusLabel %></span>
                        <% if (rlShowGuildBadge) { %>
                            <span class="report-guild-badge">
                                <% if (r.guildIconUrl) { %>
                                    <img src="<%= r.guildIconUrl %>" alt="">
                                <% } else { %>
                                    <span class="report-guild-badge-fallback"><i data-lucide="server"></i></span>
                                <% } %>
                                <%= r.guildName %>
                            </span>
                        <% } %>
                    </div>
                    <div class="report-card-meta">
                        <span><i data-lucide="user" class="w-3.5 h-3.5"></i> <%= r.discordUsername %> (<%= r.discordRoleLabel %>)</span>
                        <% if (r.playerName) { %><span><i data-lucide="gamepad-2" class="w-3.5 h-3.5"></i> <%= r.playerName %><% if (r.agid) { %> (AGID <%= r.agid %>)<% } %></span>
                        <% } else if (r.agid) { %><span><i data-lucide="gamepad-2" class="w-3.5 h-3.5"></i> AGID <%= r.agid %></span><% } %>
                        <span><i data-lucide="calendar" class="w-3.5 h-3.5"></i> <%= new Date(r.created_at).toLocaleString('pt-BR') %></span>
                    </div>
                    <% if (r.punishment) { %><p class="text-xs opacity-60"><span data-i18n-pt>Punição aplicada:</span><span data-i18n-en>Punishment applied:</span> <%= r.punishment %></p><% } %>
                    <% if (r.closed_reason) { %><p class="text-xs opacity-60"><span data-i18n-pt>Motivo de fechamento:</span><span data-i18n-en>Closing reason:</span> <%= r.closed_reason %></p><% } %>
                    <p class="text-xs opacity-60"><span data-i18n-pt>Fechado por:</span><span data-i18n-en>Closed by:</span> <% if (r.closedByName) { %><%= r.closedByName %><% } else { %><span data-i18n-pt>Automático (sistema)</span><span data-i18n-en>Automatic (system)</span><% } %><% if (r.closedByRoleLabel) { %> (<%= r.closedByRoleLabel %>)<% } %></p>
                    <% if (r.rating) { %><p class="text-xs opacity-60"><span data-i18n-pt>Avaliação:</span><span data-i18n-en>Rating:</span> <%= r.rating %>/5<% if (r.rating_comment) { %> — "<%= r.rating_comment %>"<% } %></p><% } %>
                    <% if (r.threadDeletedByName) { %>
                        <p class="text-xs" style="color:#FF4E3B;"><span data-i18n-pt>Tópico apagado por:</span><span data-i18n-en>Topic deleted by:</span> <%= r.threadDeletedByName %> (<%= r.threadDeletedByRoleLabel %>)</p>
                    <% } else if (r.thread_id) { %>
                        <a href="https://discord.com/channels/<%= r.guild_id %>/<%= r.thread_id %>" target="_blank" class="btn-primary !min-w-0 !h-auto !py-2 !px-4 !text-sm self-start mt-2" onclick="return openInDiscordApp(event, '<%= r.guild_id %>', '<%= r.thread_id %>')">
                            <i data-lucide="telescope" class="w-4 h-4"></i> <span data-i18n-pt>Investigar</span><span data-i18n-en>Investigate</span>
                        </a>
                    <% } %>
                </div>
            <% }); %>
        </div>
        <% if (closedPagination.totalPages > 1) { %>
            <div class="report-pagination">
                <% if (closedPagination.page > 1) { %>
                    <a href="<%= reportsHref({ closedPage: closedPagination.page - 1 }) %>" class="report-page-btn"><i data-lucide="chevron-left" class="w-4 h-4"></i> <span data-i18n-pt>Anterior</span><span data-i18n-en>Previous</span></a>
                <% } else { %>
                    <span class="report-page-btn disabled"><i data-lucide="chevron-left" class="w-4 h-4"></i> <span data-i18n-pt>Anterior</span><span data-i18n-en>Previous</span></span>
                <% } %>
                <span class="report-page-info"><span data-i18n-pt>Página</span><span data-i18n-en>Page</span> <%= closedPagination.page %> <span data-i18n-pt>de</span><span data-i18n-en>of</span> <%= closedPagination.totalPages %> (<%= closedPagination.total %> <span data-i18n-pt>reportes</span><span data-i18n-en>reports</span>)</span>
                <% if (closedPagination.page < closedPagination.totalPages) { %>
                    <a href="<%= reportsHref({ closedPage: closedPagination.page + 1 }) %>" class="report-page-btn"><span data-i18n-pt>Próxima</span><span data-i18n-en>Next</span> <i data-lucide="chevron-right" class="w-4 h-4"></i></a>
                <% } else { %>
                    <span class="report-page-btn disabled"><span data-i18n-pt>Próxima</span><span data-i18n-en>Next</span> <i data-lucide="chevron-right" class="w-4 h-4"></i></span>
                <% } %>
            </div>
        <% } %>
    <% } %>
</section>

<%#
  "Investigar" tenta abrir direto no app do Discord antes de cair pro
  navegador (pedido do dono, 2026-08-11: "no botão investigar sempre peça
  para abrir o app" — depois de rejeitar um 2º botão "Abrir no app"
  separado, ver correção anterior nesta mesma sessão). Padrão clássico de
  "custom protocol com fallback": tenta navegar pro esquema discord://
  (registrado pelo app desktop/mobile); se a aba perder o foco logo em
  seguida, o app abriu de verdade e o fallback é cancelado; senão, depois
  de ~900ms sem perder o foco (nenhum app registrado pra interceptar),
  abre a versão web (mesma URL que já era o href original) numa aba nova.
  Só existe UM único script no fim do arquivo mesmo com N cards na lista
  (delegado por card via onclick, não duplicado). Script roda normalmente
  no carregamento inicial da página (include normal do EJS); se este
  fragmento for re-substituído depois via poll-fragment.js (inserido via
  innerHTML), o <script> não re-executa — sem problema, a função já fica
  definida globalmente desde o primeiro carregamento.
%>
<script>
    function openInDiscordApp(event, guildId, threadId) {
        event.preventDefault();
        const appUrl = 'discord://-/channels/' + guildId + '/' + threadId;
        const webUrl = 'https://discord.com/channels/' + guildId + '/' + threadId;

        const fallback = setTimeout(function () {
            window.open(webUrl, '_blank');
        }, 900);
        window.addEventListener('blur', function onBlur() {
            clearTimeout(fallback);
            window.removeEventListener('blur', onBlur);
        });

        window.location.href = appUrl;
        return false;
    }
</script>
