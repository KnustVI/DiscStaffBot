<%#
  web/views/partials/tier-badge.ejs
  Selo "HUNTER"/"TRACKER" (Figma: "user.icon") — pedido do dono pra marcar
  visualmente seções exclusivas de um plano pago (nome em inglês do tier,
  mesma convenção de hero.ejs:797-800 — Free/Tracker/Hunter).

  Uso: include( partials/tier-badge ) — Caçador ("HUNTER") por padrão, ou
       include( partials/tier-badge, { tier: 'rastreador' } ) — "TRACKER".
%>
<% const _tbTier = typeof tier !== 'undefined' && tier === 'rastreador' ? 'rastreador' : 'cacador'; %>
<span class="tier-badge <%= _tbTier === 'rastreador' ? 'is-rastreador' : '' %>">
    <span class="tier-badge-text"><%= _tbTier === 'rastreador' ? 'TRACKER' : 'HUNTER' %></span>
</span>
