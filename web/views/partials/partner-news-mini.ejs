<%#
  web/views/partials/partner-news-mini.ejs
  Carrossel horizontal de anúncios de servidores parceiros, pro topo de
  /perfil e /loja (pedido do dono, 2026-08-10: "Adicione um pequeno
  carrosseu desses anúncios de servers na parfina de perfil e na pagina de
  loja, no topo"). O feed completo (card grande + overlay de detalhe)
  continua exclusivo da home — ver web/views/hero.ejs
  .partner-news-grid/#partnerNewsOverlay — aqui é só uma prévia, sem
  overlay de detalhe: cada card já é um link direto pro evento (Bônus
  Caçador, getPartnerNews) quando existe; sem evento, é só informativo
  (sem destino nenhum pra levar o clique).

  Aumentado (pedido do dono, 2026-08-10, segunda rodada: "esta extremamente
  pequeno como mostra na imagem, deixei mais visivel") — v1 (só ícone
  circular 30px + 2 linhas de texto minúsculo) ficava quase invisível
  contra o fundo escuro da página. v2: card mais alto com miniatura de
  imagem de verdade (quando o anúncio tem uma), título/nome maiores, e um
  cabeçalho próprio (ícone + rótulo) pra ancorar visualmente a seção em
  vez de cair solta no meio da página.

  Uso: include('partials/partner-news-mini', { partnerNews })
    partnerNews — mesmo array de getPartnerNews (dashboard.js) usado pela
    home: [{ guildId, guildName, iconUrl, title, text, imageUrl,
    latestEvent, inviteUrl }]. Nada renderiza se vier vazio.

  Card virou sempre <div> (pedido do dono, 2026-08-11: "adicione um link
  para o servidor do discord") — antes, com evento, o card INTEIRO já era
  um <a> pro evento; colocar um 2º link (convite) dentro de um <a> seria
  <a> aninhado em <a>, HTML inválido que navegadores tratam de forma
  inconsistente (mesmo cuidado tomado em hero.ejs .partner-news-card).
  Agora os links (evento/convite) são ações explícitas numa linha própria
  no rodapé do card, nunca aninhadas numa área clicável maior.
%>
<% if (partnerNews && partnerNews.length > 0) { %>
<div class="partner-news-mini-section">
    <div class="partner-news-mini-heading">
        <i data-lucide="megaphone" class="partner-news-mini-heading-icon"></i>
        <span><span data-i18n-pt>Novidades dos Servidores Parceiros</span><span data-i18n-en>Partner Server Updates</span></span>
    </div>
    <div class="partner-news-mini-strip">
        <% partnerNews.forEach(pn => { %>
            <div class="partner-news-mini-card">
                <% if (pn.imageUrl) { %>
                    <div class="partner-news-mini-image" style="background-image:url('<%= pn.imageUrl %>')"></div>
                <% } %>
                <div class="partner-news-mini-row">
                    <% if (pn.iconUrl) { %>
                        <img src="<%= pn.iconUrl %>" alt="" class="partner-news-mini-icon">
                    <% } else { %>
                        <div class="partner-news-mini-icon partner-news-mini-icon-fallback"><i data-lucide="megaphone"></i></div>
                    <% } %>
                    <div class="partner-news-mini-body">
                        <span class="partner-news-mini-guild"><%= pn.guildName %></span>
                        <span class="partner-news-mini-title"><%= pn.title %></span>
                    </div>
                </div>
                <% if (pn.latestEvent || pn.inviteUrl) { %>
                    <div class="partner-news-mini-actions">
                        <% if (pn.latestEvent) { %>
                            <a href="<%= pn.latestEvent.url %>" target="_blank" rel="noopener" class="partner-news-mini-action">
                                <i data-lucide="calendar-days"></i>
                                <span data-i18n-pt>Evento</span><span data-i18n-en>Event</span>
                            </a>
                        <% } %>
                        <% if (pn.inviteUrl) { %>
                            <a href="<%= pn.inviteUrl %>" target="_blank" rel="noopener" class="partner-news-mini-action">
                                <i data-lucide="external-link"></i>
                                <span data-i18n-pt>Entrar no Discord</span><span data-i18n-en>Join Discord</span>
                            </a>
                        <% } %>
                    </div>
                <% } %>
            </div>
        <% }); %>
    </div>
</div>
<style>
    .partner-news-mini-section {
        display: flex;
        flex-direction: column;
        gap: 10px;
        width: 100%;
    }
    .partner-news-mini-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 14px;
        color: #F8DCC0;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }
    .partner-news-mini-heading-icon { width: 18px; height: 18px; color: #DCA15E; flex: none; }
    .partner-news-mini-strip {
        display: flex;
        flex-wrap: nowrap;
        gap: 14px;
        width: 100%;
        overflow-x: auto;
        padding-bottom: 4px;
    }
    .partner-news-mini-card {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        flex: none;
        width: 280px;
        background: #131314;
        border: 1px solid rgba(217, 163, 98, 0.35);
        border-radius: 12px;
        overflow: hidden;
        transition: border-color 0.15s ease;
    }
    .partner-news-mini-card:hover { border-color: #DCA15E; }
    .partner-news-mini-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        padding: 0 12px 12px;
    }
    .partner-news-mini-action {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 10px;
        border-radius: 20px;
        background: rgba(220, 161, 94, 0.12);
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        font-size: 11px;
        color: #DCA15E;
        text-decoration: none;
        white-space: nowrap;
        transition: background 0.15s ease;
    }
    .partner-news-mini-action:hover { background: rgba(220, 161, 94, 0.24); }
    .partner-news-mini-action i { width: 13px; height: 13px; flex: none; }
    .partner-news-mini-image {
        width: 100%;
        aspect-ratio: 280 / 110;
        background-size: cover;
        background-position: center;
        flex: none;
    }
    .partner-news-mini-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
    }
    .partner-news-mini-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        object-fit: cover;
        flex: none;
    }
    .partner-news-mini-icon-fallback {
        display: flex;
        align-items: center;
        justify-content: center;
        background: #4B2427;
        color: #DCA15E;
    }
    .partner-news-mini-icon-fallback i { width: 18px; height: 18px; }
    .partner-news-mini-body {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
        flex: 1;
    }
    .partner-news-mini-guild {
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        font-size: 11px;
        opacity: 0.6;
        color: #F8DCC0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .partner-news-mini-title {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 14px;
        color: #F8DCC0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>
<% } %>
