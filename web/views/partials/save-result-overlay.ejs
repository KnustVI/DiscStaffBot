<%#
  web/views/partials/save-result-overlay.ejs
  Overlay de sucesso/falha ao salvar Configurações (Moderação/Eventos) —
  pedido do dono. As rotas POST /moderacao/:guildID/save e
  /events/:guildID/save redirecionam de volta pra página com
  ?saved=success ou ?saved=error (a última só quando o try/catch da rota
  pega uma exceção de verdade salvando — ver dashboard.js) — este parcial
  só decide o que mostrar a partir desse parâmetro, sem lógica própria.

  Fecha sozinho (sucesso: 3.5s; erro: fica até o usuário fechar, é mais
  importante ele ler/agir) ou no clique fora/Esc/botão — e limpa o
  ?saved= da URL ao fechar (history.replaceState) pra um F5 não reabrir o
  aviso à toa.

  Usa ícones lucide (data-lucide), não SVG cru — diferente do
  dev-overlay-card.ejs (hero.ejs/index.ejs, que não carregam o script do
  lucide), moderacao.ejs/events.ejs já chamam lucide.createIcons() no
  fim da página.

  Uso: include( partials/save-result-overlay , { saved } ) — saved vem
  direto de req.query.saved ('success'/'error'/undefined).

  PRESERVAÇÃO DE SCROLL (pedido do dono, 2026-08-07: "ao salvar e
  aparecer a overlay ele sobe o rolamento da página inteira, é possível
  manter fixa onde estava? para todas as páginas") — todo POST daqui
  (criar/editar/deletar nível, salvar configurações, etc) redireciona de
  volta pra mesma página com um GET novo, e um GET novo sempre volta pro
  topo por padrão do navegador; não tem relação com a overlay em si (que
  é position:fixed, não desloca nada). Corrigido SEMPRE que este parcial
  é incluído (script abaixo roda incondicional, fora do `if (saved)` —
  precisa estar ativo ANTES do form dar submit, não só quando a overlay
  aparece) — grava a posição de rolagem em sessionStorage no momento do
  submit de QUALQUER <form> da página, e restaura na próxima carga
  (mesmo pathname só, por segurança). Como está neste parcial
  compartilhado (moderacao/events/reports/perfil/lojajogo/dev-lojas.ejs),
  cobre "todas as páginas" que usam esse fluxo de uma vez só.
%>
<script>
    (function () {
        var STORAGE_KEY = 'tp_scroll_restore';
        var storedY = null;
        try {
            var raw = sessionStorage.getItem(STORAGE_KEY);
            if (raw) {
                sessionStorage.removeItem(STORAGE_KEY);
                var data = JSON.parse(raw);
                if (data && data.path === window.location.pathname && typeof data.y === 'number') {
                    storedY = data.y;
                }
            }
        } catch (e) {}

        if (storedY !== null) {
            var apply = function () { window.scrollTo(0, storedY); };
            // Aplica já (se o DOM já estiver pronto o bastante) e de novo
            // em DOMContentLoaded/load — página pode ainda não ter a
            // altura final quando este script roda (ele fica cedo na
            // página, logo depois do cabeçalho).
            apply();
            document.addEventListener('DOMContentLoaded', apply);
            window.addEventListener('load', apply);
        }

        // Grava a posição ANTES de qualquer form nativo navegar pra
        // longe da página — cobre todo <form> existente, sem precisar
        // marcar um por um.
        document.addEventListener('submit', function (e) {
            if (e.defaultPrevented) return;
            try {
                sessionStorage.setItem(STORAGE_KEY, JSON.stringify({ path: window.location.pathname, y: window.scrollY }));
            } catch (err) {}
        }, true);
    })();
</script>
<% if (typeof saved !== 'undefined' && (saved === 'success' || saved === 'error')) { %>
    <% const srIsOk = saved === 'success'; %>
    <div class="dev-overlay" id="saveResultOverlay">
        <div class="dev-overlay-card <%= srIsOk ? 'is-success' : 'is-error' %>">
            <div class="dev-overlay-icon">
                <i data-lucide="<%= srIsOk ? 'check-circle' : 'circle-alert' %>"></i>
            </div>
            <h2 class="dev-overlay-title">
                <% if (srIsOk) { %><span data-i18n-pt>Configurações salvas</span><span data-i18n-en>Settings saved</span><% } else { %><span data-i18n-pt>Falha ao salvar</span><span data-i18n-en>Failed to save</span><% } %>
            </h2>
            <p class="dev-overlay-text">
                <% if (srIsOk) { %>
                    <span data-i18n-pt>Suas alterações foram aplicadas com sucesso.</span><span data-i18n-en>Your changes were applied successfully.</span>
                <% } else { %>
                    <span data-i18n-pt>Alguma coisa deu errado e as alterações não foram salvas. Tente novamente — se persistir, avise o suporte.</span><span data-i18n-en>Something went wrong and the changes weren't saved. Try again — if it keeps happening, contact support.</span>
                <% } %>
            </p>
            <button type="button" class="btn-primary" id="saveResultClose" style="min-width:0; padding:10px 32px;"><span data-i18n-pt>FECHAR</span><span data-i18n-en>CLOSE</span></button>
        </div>
    </div>
    <script>
        (function () {
            var overlay = document.getElementById('saveResultOverlay');
            var closeBtn = document.getElementById('saveResultClose');
            if (!overlay) return;

            function stripQueryParam() {
                var url = new URL(window.location.href);
                url.searchParams.delete('saved');
                window.history.replaceState({}, '', url);
            }
            function close() {
                overlay.remove();
                stripQueryParam();
            }
            closeBtn.addEventListener('click', close);
            overlay.addEventListener('click', function (e) {
                if (e.target === overlay) close();
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') close();
            });
            <% if (srIsOk) { %>
            setTimeout(close, 3500);
            <% } %>
        })();
    </script>
<% } %>
