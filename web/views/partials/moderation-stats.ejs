<%#
  web/views/partials/moderation-stats.ejs
  Seções "Punições" e "Automoderação" de moderacao.ejs (4 donuts cada, 3
  dourados + 1 grande em terracota — confirmado por extração +
  conferência do Moderação.txt, ver docblock antigo em moderacao.ejs) —
  extraído pra partial pra dar pra atualizar em tempo real (poll, ver
  public/js/poll-fragment.js e GET /fragments/moderation-stats/:guildID
  em dashboard.js), pedido do dono ("gráficos" também em tempo real,
  mesmo padrão já usado em ingame-pulse.ejs).

  Uso: include( partials/moderation-stats , { punActive, punTotal,
    punRevoked, punHighSeverity, filterWordCount, filterLevelCount,
    autoPunishments } ) — os 7 valores vêm de
  dashboard.js:getModerationStats().
%>
<%
    const punDonutsHtml =
        include('stat-donut', { id: 'pun-ativas', title: 'Ativas', value: `${punActive}`, percent: punTotal > 0 ? (punActive / punTotal) * 100 : 0, accent: 'gold' }) +
        include('stat-donut', { id: 'pun-revogadas', title: 'Revogadas', value: `${punRevoked}`, percent: punTotal > 0 ? (punRevoked / punTotal) * 100 : 0, accent: 'gold' }) +
        include('stat-donut', { id: 'pun-graves', title: 'Graves/Severas', value: `${punHighSeverity}`, percent: punTotal > 0 ? (punHighSeverity / punTotal) * 100 : 0, accent: 'gold' }) +
        include('stat-donut', { id: 'pun-total', title: 'Total Aplicadas', value: `${punTotal}`, percent: 100, accent: 'red', size: 'big' });

    const autoDonutsHtml =
        include('stat-donut', { id: 'auto-palavras', title: 'Palavras Filtradas', value: `${filterWordCount}`, percent: 100, accent: 'gold' }) +
        include('stat-donut', { id: 'auto-niveis', title: 'Níveis Configurados', value: `${filterLevelCount}`, percent: 100, accent: 'gold' }) +
        include('stat-donut', { id: 'auto-punicoes', title: 'Punições Automáticas', value: `${autoPunishments}/${punTotal}`, percent: punTotal > 0 ? (autoPunishments / punTotal) * 100 : 0, accent: 'gold' }) +
        include('stat-donut', { id: 'auto-total', title: 'Total de Punições', value: `${punTotal}`, percent: 100, accent: 'red', size: 'big' });
%>
<!-- MODERAÇÃO -->
<section class="flex flex-col gap-3">
    <h2 class="section-title text-sm px-2">Punições</h2>
    <%- include('graph-card', { bodyHtml: punDonutsHtml }) %>
</section>

<!-- AUTOMODERAÇÃO -->
<section class="flex flex-col gap-3">
    <h2 class="section-title text-sm px-2">Automoderação</h2>
    <%- include('graph-card', { bodyHtml: autoDonutsHtml }) %>
</section>
