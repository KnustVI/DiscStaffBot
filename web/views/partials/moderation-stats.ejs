<%#
  web/views/partials/moderation-stats.ejs
  Seções "Punições" e "Automoderação" de moderacao.ejs (4 donuts cada, 3
  dourados + 1 grande em terracota — confirmado por extração +
  conferência do Moderação.txt, ver docblock antigo em moderacao.ejs) —
  extraído pra partial pra dar pra atualizar em tempo real (poll, ver
  public/js/poll-fragment.js e GET /fragments/moderation-stats/:guildID
  em dashboard.js), pedido do dono ("gráficos" também em tempo real,
  mesmo padrão já usado em ingame-pulse.ejs).

  Uso: include( partials/moderation-stats , { punActive, punTotal,
    punRevoked, punHighSeverity, filterWordCount, filterLevelCount,
    autoPunishments } ) — os 7 valores vêm de
  dashboard.js:getModerationStats().

  Títulos "Punições"/"Automoderação" usam .ingame-pulse-title (pedido do
  dono: mesmo espaçamento/fonte/tamanho do título "IN GAME" que fica logo
  acima deles na página) — classe global em web/public/css/style.css,
  não .section-title (esse aqui é usado em várias outras páginas/títulos
  que não devem mudar).
%>
<%
    // Título bilíngue (pedido do dono, 2026-08-06: "título de cards de
    // gráficos" sem tradução) — mesmo helper/mecanismo de ingame-pulse.ejs
    // (stat-donut.ejs renderiza title SEM escape).
    function i18nTitle(pt, en) {
        return `<span data-i18n-pt>${pt}</span><span data-i18n-en>${en}</span>`;
    }

    const punDonutsHtml =
        include('stat-donut', { id: 'pun-ativas', title: i18nTitle('Ativas', 'Active'), value: `${punActive}`, percent: punTotal > 0 ? (punActive / punTotal) * 100 : 0, accent: 'gold' }) +
        include('stat-donut', { id: 'pun-revogadas', title: i18nTitle('Revogadas', 'Revoked'), value: `${punRevoked}`, percent: punTotal > 0 ? (punRevoked / punTotal) * 100 : 0, accent: 'gold' }) +
        include('stat-donut', { id: 'pun-graves', title: i18nTitle('Graves/Severas', 'Grave/Severe'), value: `${punHighSeverity}`, percent: punTotal > 0 ? (punHighSeverity / punTotal) * 100 : 0, accent: 'gold' }) +
        include('stat-donut', { id: 'pun-total', title: i18nTitle('Total Aplicadas', 'Total Applied'), value: `${punTotal}`, percent: 100, accent: 'red', size: 'big' });

    const autoDonutsHtml =
        include('stat-donut', { id: 'auto-palavras', title: i18nTitle('Palavras Filtradas', 'Filtered Words'), value: `${filterWordCount}`, percent: 100, accent: 'gold' }) +
        include('stat-donut', { id: 'auto-niveis', title: i18nTitle('Níveis Configurados', 'Levels Configured'), value: `${filterLevelCount}`, percent: 100, accent: 'gold' }) +
        include('stat-donut', { id: 'auto-punicoes', title: i18nTitle('Punições Automáticas', 'Automatic Punishments'), value: `${autoPunishments}/${punTotal}`, percent: punTotal > 0 ? (autoPunishments / punTotal) * 100 : 0, accent: 'gold' }) +
        include('stat-donut', { id: 'auto-total', title: i18nTitle('Total de Punições', 'Total Punishments'), value: `${punTotal}`, percent: 100, accent: 'red', size: 'big' });
%>
<!-- MODERAÇÃO -->
<section class="flex flex-col gap-3">
    <h2 class="ingame-pulse-title"><span data-i18n-pt>Punições</span><span data-i18n-en>Punishments</span></h2>
    <%- include('graph-card', { bodyHtml: punDonutsHtml }) %>
</section>

<!-- AUTOMODERAÇÃO -->
<section class="flex flex-col gap-3">
    <h2 class="ingame-pulse-title"><span data-i18n-pt>Automoderação</span><span data-i18n-en>Auto-Moderation</span></h2>
    <%- include('graph-card', { bodyHtml: autoDonutsHtml }) %>
</section>
