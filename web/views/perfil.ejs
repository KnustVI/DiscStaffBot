<%#
  web/views/perfil.ejs
  Página GLOBAL (sem :guildID — identidade do jogador é global, ver
  player_links) de perfil do usuário logado no dashboard. Espelha o
  /perfil-edit do Discord (ConfigSystem.buildPerfilEditPanelPayload) pra
  personalização e o /perfil (playerRegistrationSystem.sendProfile) pra
  identidade/stats — um formulário só em vez do fluxo por botão+modal do
  Discord. Aberta pelo botão-avatar da sidebar (pedido do dono,
  2026-08-05).

  Uso: res.render('perfil', { ... }) — ver dashboard.js GET /perfil pra
  lista completa de locals.
%>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meu Perfil | <%= bot.user.username %></title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Tilt+Warp&family=Bebas+Neue&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'titan-bg': '#0D0D0D',
                        'titan-accent': '#803E30',
                        'titan-cream': '#F8DCC0',
                        'titan-gold': '#D9A362',
                    }
                }
            }
        }
    </script>
    <style>
        /* Estilos só desta página (mesmo padrão de dev-image-pool.ejs:
           componente usado numa página só não precisa entrar no
           style.css compartilhado). */
        /* Fundo personalizado direto no <body> (pedido do dono, 2026-08-06:
           "a imagem de plano de fundo de perfil deve cobrir a página
           inteira abaixo dos cards" — a tentativa anterior usava uma
           <div> própria position:fixed + z-index:-1 como camada
           separada, mas não apareceu de verdade pro dono; setar direto
           no <body> é mais robusto porque o fundo do <body>/<html> é
           SEMPRE a camada mais baixa da página por definição da spec de
           CSS — não depende de nenhuma regra de empilhamento (z-index)
           entre <body> e os elementos normais dela por cima
           (aside/main), então não tem como um deles "tampar" sem querer.
           !important necessário pra vencer o `background-color: ...
           !important` do style.css compartilhado (garante fundo escuro
           padrão em todo o dashboard) — um !important só perde pra outro
           !important de MAIOR especificidade, e um estilo inline
           sempre tem mais especificidade que qualquer seletor de classe.
           background-attachment:fixed (não computa contra a altura TOTAL
           da página, que pode ser bem mais alta que a tela — computaria
           contra isso e o cover ficaria bem mais "zoomado"/cortado do
           que devia) — degrada bem no Safari iOS: na pior das hipóteses
           vira scroll normal ali, não quebra nem some. */
        body.perfil-has-bg {
            background-image: url('<%= backgroundPreviewUrl %>') !important;
            background-size: cover !important;
            background-position: center !important;
            background-repeat: no-repeat !important;
            background-attachment: fixed !important;
        }
        /* align-items:flex-start (não mais center) — pedido do dono,
           2026-08-05: o selo de Hunt (canto superior direito) precisa
           alinhar com o TOPO do bloco de avatar/nome, não com o centro
           dele. O grupo avatar+nome continua centralizado ENTRE SI (ver
           .flex.items-center por cima dos dois no HTML), só a linha
           externa (esse grupo vs. o selo de Hunt) é que virou flex-start. */
        .perfil-hero {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
        }
        .perfil-hero-avatar {
            box-sizing: border-box;
            flex: none;
            width: 96px;
            height: 96px;
            border-radius: 50%;
            background: #4B2427;
            border: 4px solid #803E30;
            box-shadow: 0px 12px 18px 11px rgba(1, 2, 10, 0.45);
            overflow: hidden;
        }
        .perfil-hero-avatar img { width: 100%; height: 100%; object-fit: cover; }
        /* line-height apertado nas 2 linhas de texto (pedido do dono:
           "espaçamentos não parecem muito proporcionais") — sem isso, a
           métrica de fonte do Tilt Warp/Poppins soma uma folga invisível
           por cima do gap-3 do flex, fazendo o espaço nome->ID parecer
           diferente do espaço ID->selo de tier (que não sofre isso, é uma
           cápsula com padding próprio). Com os 3 no mesmo line-height
           "apertado" + mesmo gap-3 do container pai, a distância visual
           entre os 3 fica igual de verdade, não só no código. */
        .perfil-hero-name { font-family: 'Tilt Warp', cursive; font-size: clamp(20px, 3vw, 28px); line-height: 1.2; color: #F8DCC0; }
        .perfil-hero-id { font-family: 'Poppins', sans-serif; font-size: 13px; line-height: 1.2; opacity: 0.5; }
        .perfil-tier-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 16px;
            border-radius: 147.5px;
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 13px;
            line-height: 1.2;
            border: 1px solid var(--pt-color, #F8DCC0);
            color: var(--pt-color, #F8DCC0);
        }
        .perfil-hunt-pill {
            box-sizing: border-box;
            flex: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 16px;
            border-radius: 147.5px;
            background: #131314;
            border: 1px solid rgba(217, 163, 98, 0.35);
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 13px;
            color: #DCA15E;
        }
        .perfil-hunt-pill i { width: 16px; height: 16px; flex: none; }
        .perfil-hunt-pill img { width: 18px; height: 18px; flex: none; border-radius: 4px; object-fit: cover; }
        <%# Cor por moeda (pedido do dono, 2026-08-12): Caçadas sempre vermelho,
            Ossos sempre amarelo, XP a cor "quase branca" padrão do bot — mesmas
            classes/valores usados em loja.ejs (is-hunt/is-bones/is-xp) pra manter
            o mesmo vocabulário visual entre as 2 páginas. %>
        .perfil-hunt-pill.is-hunt { border-color: rgba(255, 78, 59, 0.35); color: #FF4E3B; }
        .perfil-hunt-pill.is-bones { border-color: rgba(217, 163, 98, 0.35); color: #D9A362; }
        .perfil-hunt-pill.is-xp { border-color: rgba(248, 220, 192, 0.35); color: #F8DCC0; }
        .perfil-guild-list { display: flex; flex-wrap: wrap; gap: 10px; }
        .perfil-guild-chip {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px 6px 6px;
            background: #131314;
            border: 1px solid rgba(217, 163, 98, 0.25);
            border-radius: 147.5px;
            text-decoration: none;
            transition: border-color 0.15s ease;
        }
        .perfil-guild-chip:hover { border-color: #DCA15E; }
        .perfil-guild-chip img { width: 26px; height: 26px; border-radius: 50%; object-fit: cover; }
        .perfil-guild-chip span { font-family: 'Poppins', sans-serif; font-size: 13px; color: #F8DCC0; }
        /* Chip de "servidores que você já jogou" ganhou uma 2ª linha (tempo
           de jogo, pedido do dono 2026-08-10) — só essa lista usa a coluna
           de texto; o chip de "servidores que administra" continua com
           span solto (sem quebrar layout ali, .perfil-guild-chip span
           acima segue valendo pros dois). */
        .perfil-guild-chip-text { display: flex; flex-direction: column; gap: 1px; }
        /* .perfil-guild-chip-text .perfil-guild-chip-playtime (2 classes)
           de propósito, não só .perfil-guild-chip-playtime sozinho — precisa
           bater a especificidade de ".perfil-guild-chip span" (1 classe + 1
           elemento) acima sem depender de !important nem de ordem no CSS. */
        .perfil-guild-chip-text .perfil-guild-chip-playtime { display: inline-flex; align-items: center; gap: 3px; font-size: 11px; color: #A89986; }
        .perfil-stars { font-size: 20px; letter-spacing: 3px; color: #3E3D38; }
        .perfil-stars .is-filled { color: #DCA15E; }
        .perfil-stat-line { font-family: 'Poppins', sans-serif; font-size: 13px; opacity: 0.7; }
        /* Histórico de Staff (pedido do dono, 2026-08-10) — 1 card por
           servidor onde a pessoa é Moderador/Equipe de Eventos. */
        .perfil-staff-history-card {
            display: flex;
            flex-direction: column;
            gap: 8px;
            padding: 12px 16px;
            background: #131314;
            border: 1px solid rgba(217, 163, 98, 0.25);
            border-radius: 12px;
        }
        .perfil-staff-history-head { display: flex; align-items: center; gap: 8px; font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 14px; color: #F8DCC0; }
        .perfil-staff-history-head img { width: 24px; height: 24px; border-radius: 50%; object-fit: cover; flex: none; }
        .perfil-staff-history-stats { display: flex; flex-wrap: wrap; gap: 14px; font-family: 'Poppins', sans-serif; font-size: 12px; color: #F8DCC0; opacity: 0.8; }
        .perfil-staff-history-stats span { display: inline-flex; align-items: center; gap: 4px; }
        .perfil-staff-history-today { font-family: 'Poppins', sans-serif; font-size: 11px; color: #DCA15E; opacity: 0.85; margin: 0; }
        .perfil-soon-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-align: center;
            /* padding-left/right (bug encontrado pelo dono, 2026-08-06:
               "texto sem margem lateral, muito próximo da borda") — este
               seletor tem a MESMA especificidade de .titan-card-premium
               (ambos uma classe só, no mesmo elemento) e vem depois no
               HTML (style.css compartilhado é carregado antes do <style>
               desta página), então o padding:40px do card base perdia
               por inteiro pra este padding:10px 0 (0 nas laterais) —
               não só o vertical, o shorthand substitui os 4 lados juntos. */
            padding: 10px 24px;
        }
        .perfil-soon-card i { width: 32px; height: 32px; color: #803E30; }
        .perfil-soon-title { font-family: 'Tilt Warp', cursive; font-size: 16px; color: #F8DCC0; }
        .perfil-soon-text { font-family: 'Poppins', sans-serif; font-size: 12px; opacity: 0.5; max-width: 320px; }
        /* Dado real (não placeholder "em breve") — mais destaque que o
           texto padrão do card. .perfil-soon-text.perfil-playtime-total
           (2 classes) de propósito, pra bater a especificidade do
           .perfil-soon-text sozinho sem !important. */
        .perfil-soon-text.perfil-playtime-total { font-size: 20px; font-weight: 600; opacity: 1; color: #DCA15E; }

        /* Abas Perfil/Personalização (pedido do dono, 2026-08-05) — só
           existem quando a conta está vinculada (sem link não tem stats
           nem o que personalizar, ver bloco !link mais abaixo). Mesmo
           visual de "aba ativa" já padronizado no resto do site
           (.tp-sidebar-btn.active/.nav-btn.is-active: fundo #4B2427,
           borda #DCA15E). JS troca só a classe is-active/is-hidden, sem
           navegação/reload — mesmo estilo de script pequeno e autocontido
           já usado em sidebar-v2.ejs (toggle)/page-header.ejs (switcher). */
        .pf-tab-nav { display: flex; gap: 12px; flex-wrap: wrap; }
        .pf-tab-btn {
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 14px;
            padding: 10px 24px;
            border-radius: 15px;
            background: #2A2A2A;
            border: 1px solid #803E30;
            color: #F8DCC0;
            cursor: pointer;
            transition: background 0.15s ease, border-color 0.15s ease;
        }
        .pf-tab-btn:hover { background: #803E30; border-color: #F8DCC0; }
        .pf-tab-btn.is-active { background: #4B2427; border-color: #DCA15E; }
        .pf-tab-panel.is-hidden { display: none; }
    </style>
</head>
<%#
    Fundo personalizado atrás dos cards, cobrindo a PÁGINA INTEIRA (pedido
    do dono, 2026-08-06: "podemos colocar de fundo por trás dos cards a
    imagem de fundo que ele tem personalizado no perfil?" + "a imagem de
    plano de fundo de perfil deve cobrir a página inteira abaixo dos
    cards") — MESMO backgroundPreviewUrl já calculado em dashboard.js pra
    aba Personalização; null pra quem não tem Compy+ ou não personalizou
    nada, aí a classe abaixo nem entra e a página continua igual a antes.
    Classe .perfil-has-bg (ver <style> no <head>) em vez de checar
    backgroundPreviewUrl de novo lá dentro — mantém a lógica condicional
    só aqui.
%>
<body class="flex min-h-screen<%= backgroundPreviewUrl ? ' perfil-has-bg' : '' %>">
    <%# Barra de navegação de topo — acompanha a sidebar em toda página
        (pedido do dono, 2026-08-13, ver partials/top-nav.ejs). %>
    <%- include('partials/top-nav', { hideOnScroll: true, reserveSpace: true }) %>

    <aside class="shrink-0 h-screen sticky top-0 py-[15px] pl-[15px] lg:py-[30px] lg:pl-[30px]">
        <%- include('partials/sidebar-v2', { active: 'perfil', guild: otherGuilds[0] || null, nickname, role, isOwner, restricted: true, defaultCollapsed: false }) %>
    </aside>

    <%# Sem overflow-y-auto (pedido do dono, 2026-08-05) — ver comentário completo em moderacao.ejs. Página inteira rola via <body>, não mais o <main> por dentro (evita cortar a sombra dos cards perto da sidebar). %>
    <main class="flex-1 w-full flex flex-col p-[15px] gap-[20px] lg:p-[30px] lg:gap-[30px]">

        <%
            // Sem partials/page-header aqui (pedido do dono, 2026-08-05:
            // "não precisa estar escrito DASHBOARD/MEU PERFIL, pode
            // remover essa head, e não precisa do ícone do usuário no
            // topo direito também") — o bloco logo abaixo (perfil-hero,
            // avatar+nome+tier) já apresenta quem é o usuário, então o
            // cabeçalho genérico + segundo avatar no canto ficava
            // redundante só nesta página.
            const pfAvatarUrl = discordUser.avatar
                ? `https://cdn.discordapp.com/avatars/${discordUser.id}/${discordUser.avatar}.png`
                : `https://cdn.discordapp.com/embed/avatars/${discordUser.id % 5}.png`;
            const pfTierColors = { free: '#F8DCC0', compy: '#DCA15E', raptor: '#FF4E3B' };
            const pfTierLabels = { free: 'Free', compy: 'Compy', raptor: 'Raptor' };
        %>
        <%#
            Cabeçalho novo (pedido do dono, 2026-08-05: "lembra a head que
            eu pedi pra remover? coloque novo só texto") — SÓ texto desta
            vez, sem repetir o componente antigo (título "DASHBOARD" +
            ícone de usuário no canto, ver page-header.ejs) que já tinha
            sido removido daqui por ser redundante com o perfil-hero logo
            abaixo.
        %>
        <%- include('partials/testing-phase-banner') %>

        <%# text-shadow (só aqui, não no resto de .section-title) — este H1 é o único texto da página que pode ficar direto sobre o plano de fundo personalizado (ver style condicional no <main> acima), sem um .titan-card-premium opaco por baixo. %>
        <h1 class="section-title text-2xl" style="text-shadow: 3px 3px 8px rgba(0, 0, 0, 0.6), -2px -2px 6px rgba(0, 0, 0, 0.5);"><span data-i18n-pt>Bem vindo de volta,</span><span data-i18n-en>Welcome back,</span> <%= nickname %></h1>

        <%- include('partials/save-result-overlay', { saved }) %>

        <section class="titan-card-premium flex-col gap-5">
            <div class="perfil-hero">
                <div class="flex items-center gap-5">
                    <div class="perfil-hero-avatar"><img src="<%= pfAvatarUrl %>" alt=""></div>
                    <div class="flex flex-col gap-3 items-start">
                        <span class="perfil-hero-name"><%= discordUser.global_name || discordUser.username %></span>
                        <span class="perfil-hero-id">Discord ID: <%= discordUser.id %></span>
                        <span class="perfil-tier-pill" style="--pt-color: <%= pfTierColors[playerTier] %>">
                            <i data-lucide="badge" class="w-4 h-4"></i> <span data-i18n-pt>Player Premium:</span><span data-i18n-en>Player Premium:</span> <%= pfTierLabels[playerTier] %>
                            <% if (playerTier !== 'free' && premiumInfo.expires_at) { %> — <span data-i18n-pt>expira em</span><span data-i18n-en>expires on</span> <%= new Date(premiumInfo.expires_at).toLocaleDateString('pt-BR') %><% } %>
                            <% if (playerTier !== 'free' && !premiumInfo.expires_at) { %> — <span data-i18n-pt>vitalício</span><span data-i18n-en>lifetime</span><% } %>
                        </span>
                        <%#
                            Cargo(s) de staff (pedido do dono, 2026-08-07:
                            "quando um usuário tiver o cargo staff
                            configurado no discord, adicionar esse cargo ao
                            perfil dele no site") — não depende de `link`
                            (é sobre a conta Discord, não sobre vínculo
                            PoT), por isso fica aqui na hero, fora do bloco
                            que exige vínculo. Uma pill por servidor onde a
                            pessoa é staff (pode ser mais de um) — ver
                            getStaffRoles em dashboard.js.
                        %>
                        <% staffRoles.forEach(sr => { %>
                            <span class="perfil-tier-pill" style="--pt-color: #DCA15E;" title="<%= sr.guildName %>">
                                <i data-lucide="shield" class="w-4 h-4"></i> <span data-i18n-pt>Staff:</span><span data-i18n-en>Staff:</span> <%= sr.category %> — <%= sr.guildName %>
                            </span>
                        <% }); %>
                    </div>
                </div>
                <%#
                    Saldo de Caçadas (pedido do dono, 2026-08-05: "pode
                    ficar no primeiro bloco de perfil no canto direito
                    superior do mesmo") — real a partir de 2026-08-07
                    (pedido do dono: "Libere o farm dos itens por hora
                    jogada agora"), ver PlayerRegistry.getHuntBalance/
                    _creditPlaytimeCurrency em potPlayerRegistry.js. Nome
                    da moeda bilíngue (pedido do dono, 2026-08-07: "traduza
                    a moeda hunt para Caçadas no português") — PT mostra
                    "Caçadas", EN continua "Hunt" (nome original, sem
                    tradução).
                %>
                <%#
                    Ossos e XP (pedido do dono, 2026-08-10: "Adicionar
                    todos os saldos de moedas no perfil" + "logo abaixo
                    adicione o inventario de ossos" — "abaixo" do saldo de
                    Caçadas acima) — mesma pill, empilhadas. Ícones dedicados
                    e cores fixas por moeda (pedido do dono, 2026-08-12):
                    Caçadas sempre vermelho, Ossos sempre amarelo, XP a cor
                    "quase branca" padrão do bot — mesmo vocabulário visual
                    de loja.ejs (classes is-hunt/is-bones/is-xp).
                %>
                <div class="flex flex-col gap-2 items-end">
                    <div class="perfil-hunt-pill is-hunt">
                        <img src="/images/icons/hunt.webp" alt="">
                        <span><span data-i18n-pt>Caçadas</span><span data-i18n-en>Hunt</span>: <strong><%= huntBalance %></strong></span>
                    </div>
                    <div class="perfil-hunt-pill is-bones">
                        <img src="/images/icons/bone.webp" alt="">
                        <span><span data-i18n-pt>Ossos</span><span data-i18n-en>Bones</span>: <strong><%= bonesBalance %></strong></span>
                    </div>
                    <div class="perfil-hunt-pill is-xp">
                        <img src="/images/icons/DinoFootprint.webp" alt="">
                        <span>XP: <strong><%= xpBalance %></strong></span>
                    </div>
                </div>
            </div>

            <% if (otherGuilds.length > 0) { %>
                <div>
                    <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Servidores que você administra</span><span data-i18n-en>Servers you manage</span></h3>
                    <div class="perfil-guild-list">
                        <% otherGuilds.forEach(g => { %>
                            <% const gIconUrl = g.icon ? `https://cdn.discordapp.com/icons/${g.id}/${g.icon}.png` : `/images/guild-fallback-${(g.id % 4) + 1}.svg`; %>
                            <a href="/moderacao/<%= g.id %>" class="perfil-guild-chip">
                                <img src="<%= gIconUrl %>" alt="">
                                <span><%= g.name %></span>
                            </a>
                        <% }); %>
                    </div>
                </div>
            <% } %>

            <%#
                Histórico de Staff (pedido do dono, 2026-08-10: "Adicionar
                histórico de staff no perfil de staffs apenas para
                vizualização de quem é parte da equipe do servidor como
                staff... no comando do discord e no site") — self-view
                sempre (esta página é sempre a do PRÓPRIO usuário logado),
                então não precisa do gate de "quem pode ver" que o /perfil
                do Discord precisa (lá dá pra ver o perfil de qualquer um).
                Um card por servidor onde a pessoa é Moderador/Equipe de
                Eventos (Supervisor puro fica de fora, mesma regra de
                /historico staff — ver getStaffHistoryForProfile em
                dashboard.js). Dado já é apagado sozinho ao perder todos os
                cargos de staff (AnalyticsSystem.purgeStaffOnRoleLoss).
            %>
            <% if (staffHistory.length > 0) { %>
                <div>
                    <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Histórico de Staff</span><span data-i18n-en>Staff History</span></h3>
                    <div class="flex flex-col gap-3">
                        <% staffHistory.forEach(sh => { %>
                            <div class="perfil-staff-history-card">
                                <div class="perfil-staff-history-head">
                                    <% if (sh.guildIconUrl) { %><img src="<%= sh.guildIconUrl %>" alt=""><% } %>
                                    <span><%= sh.guildName %></span>
                                    <span class="opacity-50 text-xs">— <%= sh.category %></span>
                                </div>
                                <% if (sh.totals) { %>
                                    <div class="perfil-staff-history-stats">
                                        <span><i data-lucide="gavel" class="w-3.5 h-3.5"></i> <span data-i18n-pt>Punições</span><span data-i18n-en>Punishments</span>: <strong><%= sh.totals.punishmentsApplied %></strong></span>
                                        <span><i data-lucide="ticket" class="w-3.5 h-3.5"></i> Reports: <strong><%= sh.totals.reportsJoined %></strong> <span data-i18n-pt>entrados</span><span data-i18n-en>joined</span> / <strong><%= sh.totals.reportsClosed %></strong> <span data-i18n-pt>fechados</span><span data-i18n-en>closed</span></span>
                                        <span><i data-lucide="calendar-days" class="w-3.5 h-3.5"></i> <span data-i18n-pt>Eventos</span><span data-i18n-en>Events</span>: <strong><%= sh.totals.eventsCreated %></strong></span>
                                    </div>
                                <% } else { %>
                                    <p class="text-xs opacity-40"><span data-i18n-pt>Nenhum registro de atividade ainda.</span><span data-i18n-en>No activity recorded yet.</span></p>
                                <% } %>
                                <p class="perfil-staff-history-today">
                                    <span data-i18n-pt>Hoje:</span><span data-i18n-en>Today:</span>
                                    <% if (sh.today) { %>
                                        <%= sh.today.punishmentsApplied %> <span data-i18n-pt>punições</span><span data-i18n-en>punishments</span>, <%= sh.today.reportsJoined %> reports
                                    <% } else { %>
                                        <span data-i18n-pt>nenhuma atividade ainda</span><span data-i18n-en>no activity yet</span>
                                    <% } %>
                                </p>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% } %>
        </section>

        <% if (!link) { %>
            <section class="titan-card-premium flex-col gap-3">
                <h2 class="section-title text-lg flex items-center gap-3">
                    <img src="/images/pot-logo.webp" alt="" class="w-8 h-8 rounded-full">
                    Path of Titans
                </h2>
                <p class="text-sm opacity-60"><span data-i18n-pt>Sua conta Discord ainda não está vinculada a um jogador de Path of Titans.</span><span data-i18n-en>Your Discord account isn't linked to a Path of Titans player yet.</span></p>
                <p class="text-[13px] opacity-40"><span data-i18n-pt>Use</span><span data-i18n-en>Use</span> <code>/registrar</code> <span data-i18n-pt>no Discord pra vincular sua conta — depois disso seu perfil, emblema e personalização ficam disponíveis aqui.</span><span data-i18n-en>on Discord to link your account — after that your profile, badge and customization become available here.</span></p>
            </section>
        <% } else { %>
            <div class="pf-tab-nav">
                <button type="button" class="pf-tab-btn is-active" data-pf-tab="perfil"><span data-i18n-pt>Perfil</span><span data-i18n-en>Profile</span></button>
                <button type="button" class="pf-tab-btn" data-pf-tab="personalizacao"><span data-i18n-pt>Personalização</span><span data-i18n-en>Customization</span></button>
            </div>

            <div class="pf-tab-panel flex flex-col gap-[20px] lg:gap-[30px]" data-pf-panel="perfil">
                <section class="titan-card-premium flex-col gap-5">
                    <h2 class="section-title text-lg flex items-center gap-3">
                        <img src="/images/pot-logo.webp" alt="" class="w-8 h-8 rounded-full">
                        Path of Titans
                    </h2>
                    <div class="flex flex-col gap-2">
                        <span class="perfil-stat-line"><strong class="text-titan-cream opacity-100"><span data-i18n-pt>Nome no jogo:</span><span data-i18n-en>In-game name:</span></strong> <%= link.player_name || '—' %></span>
                        <span class="perfil-stat-line"><strong class="text-titan-cream opacity-100">Alderon ID:</strong> <%= link.alderon_id %></span>
                        <%# Data de registro (pedido do dono, 2026-08-07: "Registre a data de registro dos jogadores, adicione ao perfil") — player_links.registered_at, carimbada desde o primeiro /registrar. %>
                        <% if (link.registered_at) { %>
                            <span class="perfil-stat-line"><strong class="text-titan-cream opacity-100"><span data-i18n-pt>Registrado em:</span><span data-i18n-en>Registered on:</span></strong> <%= new Date(link.registered_at).toLocaleDateString('pt-BR') %></span>
                        <% } %>
                        <span class="perfil-stat-line"><strong class="text-titan-cream opacity-100"><span data-i18n-pt>Título:</span><span data-i18n-en>Title:</span></strong> <% if (link.profile_title) { %><%= link.profile_title %><% } else { %><span data-i18n-pt>Em breve (missões)</span><span data-i18n-en>Coming soon (quests)</span><% } %></span>
                        <span class="perfil-stat-line"><strong class="text-titan-cream opacity-100"><span data-i18n-pt>Espécie mais jogada:</span><span data-i18n-en>Most played species:</span></strong> <% if (mostPlayedDinosaur) { %><%= mostPlayedDinosaur %><% } else { %><span data-i18n-pt>Ainda sem registro</span><span data-i18n-en>No record yet</span><% } %></span>
                        <%#
                            Nível (pedido do dono, 2026-08-11: "Implemente
                            um sistema de progressão de níveis infinito
                            baseado em horas jogadas") — antes fixo em "1
                            (sistema de XP em breve)"; agora calculado
                            dinamicamente a partir do XP total (ver
                            levelProgress, passado pelas rotas /perfil e
                            /loja em dashboard.js — src/systems/pot/
                            levelSystem.js faz a matemática, sem nível
                            máximo).
                        %>
                        <span class="perfil-stat-line"><strong class="text-titan-cream opacity-100"><span data-i18n-pt>Nível:</span><span data-i18n-en>Level:</span></strong> <%= levelProgress.level %> <span class="opacity-50">(<span data-i18n-pt>faltam <%= levelProgress.xpRemainingForNextLevel %> XP para o Nível <%= levelProgress.level + 1 %></span><span data-i18n-en><%= levelProgress.xpRemainingForNextLevel %> XP left for Level <%= levelProgress.level + 1 %></span> — <%= levelProgress.percent.toFixed(0) %>%)</span></span>
                        <% if (kdStats) { %>
                            <span class="perfil-stat-line"><strong class="text-titan-cream opacity-100">Kills:</strong> <%= kdStats.kills %> <strong class="text-titan-cream opacity-100 ml-2">Deaths:</strong> <%= kdStats.deaths %> <strong class="text-titan-cream opacity-100 ml-2">K/D:</strong> <%= kdStats.kd %> <span class="opacity-50">(<span data-i18n-pt>soma de todos os servidores</span><span data-i18n-en>sum of all servers</span>)</span></span>
                        <% } %>
                        <div class="flex items-center gap-2 mt-1">
                            <span class="perfil-stat-line"><strong class="text-titan-cream opacity-100"><span data-i18n-pt>Honra:</span><span data-i18n-en>Honor:</span></strong></span>
                            <span class="perfil-stars">
                                <% for (let i = 1; i <= 5; i++) { %><span class="<%= i <= honorStars ? 'is-filled' : '' %>">★</span><% } %>
                            </span>
                        </div>
                    </div>

                    <%#
                        Servidores que já jogou (pedido do dono, 2026-08-05)
                        — DIFERENTE da lista "administra" lá em cima (essa é
                        de permissão/Discord; esta é histórico de jogo, ver
                        dashboard.js getPlayedGuilds/pot_players). Não é
                        link pra lugar nenhum (diferente do chip de
                        "administra"): jogar num servidor não dá acesso
                        nenhum ao dashboard dele, então o chip aqui é só
                        informativo (<div>, não <a>).
                    %>
                    <% if (playedGuilds.length > 0) { %>
                        <div>
                            <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Servidores que você já jogou</span><span data-i18n-en>Servers you've played on</span></h3>
                            <div class="perfil-guild-list">
                                <% playedGuilds.forEach(pg => { %>
                                    <div class="perfil-guild-chip" title="Última vez: <%= pg.lastSeen ? new Date(pg.lastSeen).toLocaleDateString('pt-BR') : '—' %>">
                                        <% if (pg.iconUrl) { %>
                                            <img src="<%= pg.iconUrl %>" alt="">
                                        <% } else { %>
                                            <img src="/images/guild-fallback-1.svg" alt="">
                                        <% } %>
                                        <div class="perfil-guild-chip-text">
                                            <span><%= pg.name %></span>
                                            <% if (pg.playtimeLabel) { %>
                                                <span class="perfil-guild-chip-playtime"><i data-lucide="clock" class="w-3 h-3"></i> <%= pg.playtimeLabel %></span>
                                            <% } %>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    <% } %>

                    <%#
                        Seus Itens (pedido do dono, 2026-08-10: "Adicionar
                        itens de jogo no perfil do site") — inventário REAL
                        de compras da Loja de Personalização (image_inventory,
                        ver ImageShopSystem.getInventory em dashboard.js),
                        só leitura. Diferente do card "Lista de Badges" (mais
                        abaixo, ainda "em breve") — aquele é a VITRINE de
                        emblemas disponíveis pra colecionar; este é só o que
                        o jogador JÁ comprou, de qualquer tipo (avatar/fundo/
                        emblema).
                    %>
                    <%#
                        Seção sempre visível pra quem tem vínculo (mesmo com
                        0 itens) — antes sumia inteira com o inventário
                        vazio, o que na prática parecia "o recurso não
                        existe" pra quem nunca comprou nada na Loja
                        (confirmado como confusão real, 2026-08-10: o dono
                        reportou o inventário como "faltando" testando uma
                        conta sem compra nenhuma). Estado vazio agora mostra
                        uma dica com link direto pra /loja em vez de nada.
                    %>
                    <div>
                        <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Seus Itens</span><span data-i18n-en>Your Items</span></h3>
                        <% if (ownedItems.length > 0) { %>
                            <div class="perfil-guild-list">
                                <% ownedItems.forEach(item => { %>
                                    <div class="perfil-guild-chip" title="<%= item.label %>">
                                        <% if (item.url) { %>
                                            <img src="<%= item.url %>" alt="">
                                        <% } %>
                                        <span><%= item.label %></span>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <p class="text-sm" style="font-family:'Poppins',sans-serif; opacity: 0.5;">
                                <span data-i18n-pt>Você ainda não comprou nenhum item. Dê uma olhada na <a href="/loja" style="color:#DCA15E; text-decoration:underline;">Loja</a>.</span>
                                <span data-i18n-en>You haven't bought any items yet. Check out the <a href="/loja" style="color:#DCA15E; text-decoration:underline;">Shop</a>.</span>
                            </p>
                        <% } %>
                    </div>
                </section>
            </div>

            <%#
                Sem "contents" aqui de propósito (diferente do padrão usado
                em moderacao.ejs/events.ejs) — este <form> É o próprio
                painel da aba (.pf-tab-panel), então precisa continuar
                sendo uma caixa de verdade pra JS conseguir escondê-lo com
                display:none (classe is-hidden). display:contents +
                is-hidden juntos na mesma classe conflitariam em
                especificidade igual com a ordem de carregamento do
                Tailwind (CDN, injeta depois deste <style>) — resultado
                imprevisível, por isso evitado aqui.
            %>
            <form action="/perfil/save" method="POST" enctype="multipart/form-data" class="pf-tab-panel is-hidden flex flex-col gap-6" data-pf-panel="personalizacao">
                <section class="titan-card-premium flex-col gap-6">
                    <h2 class="section-title text-lg"><span data-i18n-pt>PERSONALIZAR PERFIL</span><span data-i18n-en>CUSTOMIZE PROFILE</span></h2>
                    <p class="text-[13px] opacity-50"><span data-i18n-pt>Ajuste como seu perfil aparece pros outros no</span><span data-i18n-en>Adjust how your profile appears to others in</span> <code>/perfil</code> <span data-i18n-pt>— título e emblema incluídos.</span><span data-i18n-en>— title and badge included.</span></p>

                    <% if (redeemableItems.length > 0) { %>
                        <div>
                            <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Disponível para Resgatar</span><span data-i18n-en>Available to Redeem</span></h3>
                            <p class="text-xs opacity-40 mb-2"><span data-i18n-pt>Você cumpriu o requisito — resgate sem gastar moeda nenhuma.</span><span data-i18n-en>You met the requirement — redeem it for free.</span></p>
                            <div class="flex flex-wrap gap-2">
                                <% redeemableItems.forEach(item => { %>
                                    <form action="/perfil/resgatar" method="POST">
                                        <input type="hidden" name="item" value="<%= item.type %>:<%= item.id %>">
                                        <button type="submit" class="btn-chip btn-chip-success"><i data-lucide="gift"></i> <%= item.label %></button>
                                    </form>
                                <% }); %>
                            </div>
                        </div>
                    <% } %>

                    <div>
                        <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Emblema</span><span data-i18n-en>Badge</span></h3>
                        <p class="text-xs opacity-40 mb-2"><span data-i18n-pt>Disponível em qualquer plano.</span><span data-i18n-en>Available on any plan.</span></p>
                        <% if (badgeOptions.length === 0) { %>
                            <p class="text-xs opacity-40"><span data-i18n-pt>Nenhum emblema disponível no momento.</span><span data-i18n-en>No badge available right now.</span></p>
                        <% } else { %>
                            <div class="banner-picker">
                                <label class="banner-picker-option is-narrow">
                                    <input type="radio" name="badge_key" value="" <%= !link.selected_badge_key ? 'checked' : '' %>>
                                    <span class="banner-picker-thumb is-square"></span>
                                    <span class="banner-picker-label"><span data-i18n-pt>Nenhum</span><span data-i18n-en>None</span></span>
                                </label>
                                <% badgeOptions.forEach(opt => { %>
                                    <label class="banner-picker-option is-narrow">
                                        <input type="radio" name="badge_key" value="<%= opt.value %>" <%= opt.value === link.selected_badge_key ? 'checked' : '' %>>
                                        <span class="banner-picker-thumb is-square"></span>
                                        <span class="banner-picker-label"><%= opt.label %></span>
                                    </label>
                                <% }); %>
                            </div>
                        <% } %>
                    </div>

                    <div>
                        <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Foto de Perfil</span><span data-i18n-en>Profile Picture</span></h3>
                        <% if (isRaptor) { %>
                            <p class="text-xs opacity-40 mb-2"><span data-i18n-pt>Envie sua própria imagem. Sem upload, usa o seu próprio avatar do Discord.</span><span data-i18n-en>Upload your own image. Without an upload, it uses your own Discord avatar.</span></p>
                            <% if (avatarPreviewUrl) { %>
                                <div class="rounded-lg mb-2" style="width:96px; aspect-ratio:1/1; background-image:url('<%= avatarPreviewUrl %>'); background-size:cover; background-position:center;"></div>
                            <% } %>
                            <div class="input-container-premium">
                                <div class="icon-box"><i data-lucide="upload"></i></div>
                                <input type="file" name="avatar_file" accept="image/png,image/jpeg,image/webp" class="input-premium-field">
                            </div>
                        <% } else if (avatarOptions.length > 0) { %>
                            <%# Free e Compy chegam aqui igual — restrito ao que comprou na Loja (bug do Compy com acesso livre corrigido em 2026-08-15), ver dashboard.js GET /perfil. %>
                            <p class="text-xs opacity-40 mb-2"><span data-i18n-pt>Escolha uma das fotos que você comprou na Loja.</span><span data-i18n-en>Choose one of the photos you bought in the Shop.</span></p>
                            <div class="banner-picker">
                                <label class="banner-picker-option is-narrow">
                                    <input type="radio" name="photo_key" value="" <%= !link.selected_photo_key ? 'checked' : '' %>>
                                    <span class="banner-picker-thumb is-square"></span>
                                    <span class="banner-picker-label"><span data-i18n-pt>Padrão do tier</span><span data-i18n-en>Tier default</span></span>
                                </label>
                                <% avatarOptions.forEach(opt => { %>
                                    <label class="banner-picker-option is-narrow">
                                        <input type="radio" name="photo_key" value="<%= opt.value %>" <%= opt.value === link.selected_photo_key ? 'checked' : '' %>>
                                        <span class="banner-picker-thumb is-square"></span>
                                        <span class="banner-picker-label"><%= opt.label %></span>
                                    </label>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <p class="text-xs opacity-40"><span data-i18n-pt>Você ainda não comprou nenhuma foto na</span><span data-i18n-en>You haven't bought any photo in the</span> <a href="/loja"><span data-i18n-pt>Loja</span><span data-i18n-en>Shop</span></a> <span data-i18n-pt>— compre uma foto específica com Caçadas.</span><span data-i18n-en>yet — buy a specific photo with Hunt.</span></p>
                        <% } %>
                    </div>

                    <div>
                        <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Plano de Fundo</span><span data-i18n-en>Background</span></h3>
                        <% if (isRaptor) { %>
                            <p class="text-xs opacity-40 mb-2"><span data-i18n-pt>Envie sua própria imagem (ideal 1300x300). Sem upload, usa o banner do seu próprio perfil do Discord, se você tiver um.</span><span data-i18n-en>Upload your own image (ideal 1300x300). Without an upload, it uses your own Discord profile banner, if you have one.</span></p>
                            <% if (backgroundPreviewUrl) { %>
                                <div class="rounded-lg mb-2" style="aspect-ratio: 1300/300; max-width:300px; background-image:url('<%= backgroundPreviewUrl %>'); background-size:cover; background-position:center;"></div>
                            <% } %>
                            <div class="input-container-premium">
                                <div class="icon-box"><i data-lucide="upload"></i></div>
                                <input type="file" name="background_file" accept="image/png,image/jpeg,image/webp" class="input-premium-field">
                            </div>
                        <% } else if (backgroundOptions.length > 0) { %>
                            <%# Free e Compy chegam aqui igual — restrito ao que comprou na Loja (bug do Compy com acesso livre corrigido em 2026-08-15), ver dashboard.js GET /perfil. %>
                            <p class="text-xs opacity-40 mb-2"><span data-i18n-pt>Escolha um dos planos de fundo que você comprou na Loja.</span><span data-i18n-en>Choose one of the backgrounds you bought in the Shop.</span></p>
                            <div class="banner-picker">
                                <label class="banner-picker-option">
                                    <input type="radio" name="background_key" value="" <%= !link.selected_background_key ? 'checked' : '' %>>
                                    <span class="banner-picker-thumb"></span>
                                    <span class="banner-picker-label"><span data-i18n-pt>Nenhum</span><span data-i18n-en>None</span></span>
                                </label>
                                <% backgroundOptions.forEach(opt => { %>
                                    <label class="banner-picker-option">
                                        <input type="radio" name="background_key" value="<%= opt.value %>" <%= opt.value === link.selected_background_key ? 'checked' : '' %>>
                                        <span class="banner-picker-thumb"></span>
                                        <span class="banner-picker-label"><%= opt.label %></span>
                                    </label>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <p class="text-xs opacity-40"><span data-i18n-pt>Você ainda não comprou nenhum plano de fundo na</span><span data-i18n-en>You haven't bought any background in the</span> <a href="/loja"><span data-i18n-pt>Loja</span><span data-i18n-en>Shop</span></a> <span data-i18n-pt>— compre um plano de fundo específico com Caçadas.</span><span data-i18n-en>yet — buy a specific background with Hunt.</span></p>
                        <% } %>
                        <%# Checkbox de remoção — Raptor (upload) ou compra na Loja (Free/Compy), nunca no ramo sem acesso acima. %>
                        <% if (isRaptor || backgroundOptions.length > 0) { %>
                            <% const hasBackground = isRaptor ? !!link.background_message_id : !!link.selected_background_key; %>
                            <% if (hasBackground) { %>
                                <label class="text-xs opacity-60 flex items-center gap-2 mt-2">
                                    <input type="checkbox" name="remove_background" value="on"> <span data-i18n-pt>Remover plano de fundo atual</span><span data-i18n-en>Remove current background</span>
                                </label>
                            <% } %>
                        <% } %>
                    </div>

                    <% if (isCompyPlus) { %>
                        <div>
                            <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Combate</span><span data-i18n-en>Combat</span></h3>
                            <label class="text-xs opacity-60 flex items-center gap-2">
                                <input type="checkbox" name="hide_kda" value="on" <%= link.hide_kda ? 'checked' : '' %>> <span data-i18n-pt>Esconder Kills/Deaths/K-D no meu /perfil</span><span data-i18n-en>Hide Kills/Deaths/K-D on my /perfil</span>
                            </label>
                        </div>
                    <% } %>

                    <% if (isRaptor) { %>
                        <div>
                            <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Título</span><span data-i18n-en>Title</span></h3>
                            <div class="input-container-premium">
                                <div class="icon-box"><i data-lucide="edit"></i></div>
                                <input type="text" maxlength="100" class="input-premium-field" name="profile_title" placeholder="Em breve (missões)" value="<%= link.profile_title || '' %>">
                            </div>
                        </div>
                    <% } %>

                    <button type="submit" class="btn-salvar-final self-start mt-2"><span data-i18n-pt>Salvar Alterações</span><span data-i18n-en>Save Changes</span></button>
                </section>
            </form>
        <% } %>

        <%#
            Saldo de Hunt saiu daqui e virou o selo no canto superior
            direito do primeiro bloco (pedido do dono, 2026-08-05) — as
            outras vitrines "em breve" continuam juntas aqui. Títulos
            não tem catálogo nenhum ainda (só o campo de texto livre do
            Raptor, ver aba Personalização) — placeholder igual aos
            outros. Badges TEM um pool de verdade (profile_image_pool
            tipo 'badge', mesmo picker da aba Personalização), mas uma
            "lista" própria de vitrine ainda não existe nesta página —
            mesmo tratamento "em breve" por enquanto, pra não duplicar o
            picker com um segundo componente parcialmente funcional.

            Tempo de Jogo (pedido do dono, 2026-08-06: "prepare... mas
            não comece a contar ainda"; LIGADO em 2026-08-10: "Adicione
            horas jogadas... nas informações de perfil") — antes reservava
            o espaço igual aos outros 3, sem mostrar número nenhum. Cada
            chip de "Servidores que você já jogou" acima já mostra o tempo
            POR SERVIDOR (pg.playtimeLabel); este card mostra a SOMA de
            todos, exatamente como planejado (dashboard.js getPlayedGuilds
            calcula pg.totalPlaytime, já com o tempo AO VIVO da sessão
            atual somado se estiver jogando agora nalgum servidor).
        %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-[20px] lg:gap-[30px]">
            <section class="titan-card-premium perfil-soon-card">
                <i data-lucide="users"></i>
                <span class="perfil-soon-title"><span data-i18n-pt>Lista de Amigos</span><span data-i18n-en>Friends List</span></span>
                <span class="perfil-soon-text"><span data-i18n-pt>Em breve.</span><span data-i18n-en>Coming soon.</span></span>
            </section>
            <section class="titan-card-premium perfil-soon-card">
                <i data-lucide="scroll-text"></i>
                <span class="perfil-soon-title"><span data-i18n-pt>Lista de Títulos</span><span data-i18n-en>Titles List</span></span>
                <span class="perfil-soon-text"><span data-i18n-pt>Catálogo de títulos pra desbloquear (sistema de missões) — em breve.</span><span data-i18n-en>Catalog of unlockable titles (quest system) — coming soon.</span></span>
            </section>
            <section class="titan-card-premium perfil-soon-card">
                <i data-lucide="badge"></i>
                <span class="perfil-soon-title"><span data-i18n-pt>Lista de Badges</span><span data-i18n-en>Badges List</span></span>
                <span class="perfil-soon-text"><span data-i18n-pt>Vitrine dos emblemas disponíveis pra coletar — em breve.</span><span data-i18n-en>Showcase of collectible badges — coming soon.</span></span>
            </section>
            <section class="titan-card-premium perfil-soon-card">
                <i data-lucide="clock"></i>
                <span class="perfil-soon-title"><span data-i18n-pt>Tempo de Jogo</span><span data-i18n-en>Playtime</span></span>
                <% if (totalPlaytimeLabel) { %>
                    <span class="perfil-soon-text perfil-playtime-total"><%= totalPlaytimeLabel %></span>
                    <span class="perfil-soon-text"><span data-i18n-pt>Somado entre todos os servidores.</span><span data-i18n-en>Summed across every server.</span></span>
                <% } else { %>
                    <span class="perfil-soon-text"><span data-i18n-pt>Ainda sem tempo registrado — jogue em algum servidor com o bot.</span><span data-i18n-en>No playtime recorded yet — play on a server with the bot.</span></span>
                <% } %>
            </section>
        </div>

        <footer class="flex justify-end pb-2">
            <span class="bebas text-[12px] uppercase tracking-[6px] text-titan-cream opacity-10 hover:opacity-30 transition-opacity">
                BY: KNUST SEIER VI
            </span>
        </footer>
    </main>

    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <script>if (window.lucide) window.lucide.createIcons();</script>
    <script>
        (function () {
            var buttons = document.querySelectorAll('.pf-tab-btn');
            var panels = document.querySelectorAll('.pf-tab-panel');
            if (!buttons.length || !panels.length) return;
            buttons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var target = btn.getAttribute('data-pf-tab');
                    buttons.forEach(function (b) { b.classList.toggle('is-active', b === btn); });
                    panels.forEach(function (p) { p.classList.toggle('is-hidden', p.getAttribute('data-pf-panel') !== target); });
                });
            });
        })();
    </script>
</body>
</html>
