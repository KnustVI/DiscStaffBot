<%#
  web/views/perfil.ejs
  Página GLOBAL (sem :guildID — identidade do jogador é global, ver
  player_links) de perfil do usuário logado no dashboard. Espelha o
  /perfil-edit do Discord (ConfigSystem.buildPerfilEditPanelPayload) pra
  personalização e o /perfil (playerRegistrationSystem.sendProfile) pra
  identidade/stats — um formulário só em vez do fluxo por botão+modal do
  Discord. Aberta pelo botão-avatar da sidebar (pedido do dono,
  2026-08-05).

  Uso: res.render('perfil', { ... }) — ver dashboard.js GET /perfil pra
  lista completa de locals.
%>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meu Perfil | <%= bot.user.username %></title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Tilt+Warp&family=Bebas+Neue&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'titan-bg': '#0D0D0D',
                        'titan-accent': '#803E30',
                        'titan-cream': '#F8DCC0',
                        'titan-gold': '#D9A362',
                    }
                }
            }
        }
    </script>
    <style>
        /* Estilos só desta página (mesmo padrão de dev-image-pool.ejs:
           componente usado numa página só não precisa entrar no
           style.css compartilhado). */
        /* Camada de fundo personalizado — ver doc-comment completo junto
           da div.perfil-page-bg no body mais abaixo. */
        .perfil-page-bg {
            position: fixed;
            inset: 0;
            z-index: -1;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }
        /* align-items:flex-start (não mais center) — pedido do dono,
           2026-08-05: o selo de Hunt (canto superior direito) precisa
           alinhar com o TOPO do bloco de avatar/nome, não com o centro
           dele. O grupo avatar+nome continua centralizado ENTRE SI (ver
           .flex.items-center por cima dos dois no HTML), só a linha
           externa (esse grupo vs. o selo de Hunt) é que virou flex-start. */
        .perfil-hero {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
        }
        .perfil-hero-avatar {
            box-sizing: border-box;
            flex: none;
            width: 96px;
            height: 96px;
            border-radius: 50%;
            background: #4B2427;
            border: 4px solid #803E30;
            box-shadow: 0px 12px 18px 11px rgba(1, 2, 10, 0.45);
            overflow: hidden;
        }
        .perfil-hero-avatar img { width: 100%; height: 100%; object-fit: cover; }
        /* line-height apertado nas 2 linhas de texto (pedido do dono:
           "espaçamentos não parecem muito proporcionais") — sem isso, a
           métrica de fonte do Tilt Warp/Poppins soma uma folga invisível
           por cima do gap-3 do flex, fazendo o espaço nome->ID parecer
           diferente do espaço ID->selo de tier (que não sofre isso, é uma
           cápsula com padding próprio). Com os 3 no mesmo line-height
           "apertado" + mesmo gap-3 do container pai, a distância visual
           entre os 3 fica igual de verdade, não só no código. */
        .perfil-hero-name { font-family: 'Tilt Warp', cursive; font-size: clamp(20px, 3vw, 28px); line-height: 1.2; color: #F8DCC0; }
        .perfil-hero-id { font-family: 'Poppins', sans-serif; font-size: 13px; line-height: 1.2; opacity: 0.5; }
        .perfil-tier-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 16px;
            border-radius: 147.5px;
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 13px;
            line-height: 1.2;
            border: 1px solid var(--pt-color, #F8DCC0);
            color: var(--pt-color, #F8DCC0);
        }
        .perfil-hunt-pill {
            box-sizing: border-box;
            flex: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 16px;
            border-radius: 147.5px;
            background: #131314;
            border: 1px solid rgba(217, 163, 98, 0.35);
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 13px;
            color: #DCA15E;
        }
        .perfil-hunt-pill i { width: 16px; height: 16px; flex: none; }
        .perfil-guild-list { display: flex; flex-wrap: wrap; gap: 10px; }
        .perfil-guild-chip {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px 6px 6px;
            background: #131314;
            border: 1px solid rgba(217, 163, 98, 0.25);
            border-radius: 147.5px;
            text-decoration: none;
            transition: border-color 0.15s ease;
        }
        .perfil-guild-chip:hover { border-color: #DCA15E; }
        .perfil-guild-chip img { width: 26px; height: 26px; border-radius: 50%; object-fit: cover; }
        .perfil-guild-chip span { font-family: 'Poppins', sans-serif; font-size: 13px; color: #F8DCC0; }
        .perfil-stars { font-size: 20px; letter-spacing: 3px; color: #3E3D38; }
        .perfil-stars .is-filled { color: #DCA15E; }
        .perfil-stat-line { font-family: 'Poppins', sans-serif; font-size: 13px; opacity: 0.7; }
        .perfil-soon-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-align: center;
            /* padding-left/right (bug encontrado pelo dono, 2026-08-06:
               "texto sem margem lateral, muito próximo da borda") — este
               seletor tem a MESMA especificidade de .titan-card-premium
               (ambos uma classe só, no mesmo elemento) e vem depois no
               HTML (style.css compartilhado é carregado antes do <style>
               desta página), então o padding:40px do card base perdia
               por inteiro pra este padding:10px 0 (0 nas laterais) —
               não só o vertical, o shorthand substitui os 4 lados juntos. */
            padding: 10px 24px;
        }
        .perfil-soon-card i { width: 32px; height: 32px; color: #803E30; }
        .perfil-soon-title { font-family: 'Tilt Warp', cursive; font-size: 16px; color: #F8DCC0; }
        .perfil-soon-text { font-family: 'Poppins', sans-serif; font-size: 12px; opacity: 0.5; max-width: 320px; }

        /* Abas Perfil/Personalização (pedido do dono, 2026-08-05) — só
           existem quando a conta está vinculada (sem link não tem stats
           nem o que personalizar, ver bloco !link mais abaixo). Mesmo
           visual de "aba ativa" já padronizado no resto do site
           (.tp-sidebar-btn.active/.nav-btn.is-active: fundo #4B2427,
           borda #DCA15E). JS troca só a classe is-active/is-hidden, sem
           navegação/reload — mesmo estilo de script pequeno e autocontido
           já usado em sidebar-v2.ejs (toggle)/page-header.ejs (switcher). */
        .pf-tab-nav { display: flex; gap: 12px; flex-wrap: wrap; }
        .pf-tab-btn {
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 14px;
            padding: 10px 24px;
            border-radius: 15px;
            background: #2A2A2A;
            border: 1px solid #803E30;
            color: #F8DCC0;
            cursor: pointer;
            transition: background 0.15s ease, border-color 0.15s ease;
        }
        .pf-tab-btn:hover { background: #803E30; border-color: #F8DCC0; }
        .pf-tab-btn.is-active { background: #4B2427; border-color: #DCA15E; }
        .pf-tab-panel.is-hidden { display: none; }
    </style>
</head>
<body class="flex min-h-screen">

    <%#
        Fundo personalizado atrás dos cards, cobrindo a PÁGINA INTEIRA
        (pedido do dono, 2026-08-06: "podemos colocar de fundo por trás
        dos cards a imagem de fundo que ele tem personalizado no perfil?"
        + "o fundo da página de perfil pode ocupar a página inteira?") —
        MESMO backgroundPreviewUrl já calculado em dashboard.js pra aba
        Personalização (linked Compy+ com um plano de fundo escolhido/
        enviado); null pra quem não tem Compy+ ou não personalizou nada,
        aí esta div nem renderiza e a página continua igual a antes
        (fundo escuro padrão do <body>, ver style.css).

        Camada própria position:fixed (não background no <body> nem no
        <main>) — o <body> tem um `background-color: ... !important` no
        style.css compartilhado (garante fundo escuro em toda página do
        dashboard) que bloquearia qualquer coisa setada ali; um background
        só no <main> cobriria apenas a área ao lado da sidebar, não a
        página inteira. fixed+inset:0 cobre o viewport INTEIRO (atrás da
        sidebar inclusive — ela é opaca, continua por cima normalmente) e
        continua cobrindo mesmo se a página rolar (o <body> é quem rola
        aqui, não o <main>, ver comentário de sempre "Sem overflow-y-auto"
        abaixo). z-index:-1 garante que fique ATRÁS de tudo sem precisar
        dar z-index em cada elemento normal da página (eles já pintam por
        cima de um irmão com z-index negativo, é assim que a pilha de
        empilhamento funciona).

        Sem overlay escuro por cima da imagem: os cards (.titan-card-premium)
        já são OPACOS (gradiente sólido, sem transparência), então o texto
        dentro deles nunca fica sobre a imagem — ela só aparece nos vãos
        entre os cards (gap-[20px]/[30px]) e na margem ao redor do H1
        "Bem vindo de volta", que ganhou um text-shadow defensivo lá embaixo
        pra continuar legível em qualquer imagem.
    %>
    <% if (backgroundPreviewUrl) { %>
        <div class="perfil-page-bg" style="background-image: url('<%= backgroundPreviewUrl %>');" aria-hidden="true"></div>
    <% } %>

    <aside class="shrink-0 h-screen sticky top-0 py-[15px] pl-[15px] lg:py-[30px] lg:pl-[30px]">
        <%- include('partials/sidebar-v2', { active: null, guild: otherGuilds[0] || null, nickname, role, isOwner, restricted: true, defaultCollapsed: true }) %>
    </aside>

    <%# Sem overflow-y-auto (pedido do dono, 2026-08-05) — ver comentário completo em moderacao.ejs. Página inteira rola via <body>, não mais o <main> por dentro (evita cortar a sombra dos cards perto da sidebar). %>
    <main class="flex-1 w-full flex flex-col p-[15px] gap-[20px] lg:p-[30px] lg:gap-[30px]">

        <%
            // Sem partials/page-header aqui (pedido do dono, 2026-08-05:
            // "não precisa estar escrito DASHBOARD/MEU PERFIL, pode
            // remover essa head, e não precisa do ícone do usuário no
            // topo direito também") — o bloco logo abaixo (perfil-hero,
            // avatar+nome+tier) já apresenta quem é o usuário, então o
            // cabeçalho genérico + segundo avatar no canto ficava
            // redundante só nesta página.
            const pfAvatarUrl = discordUser.avatar
                ? `https://cdn.discordapp.com/avatars/${discordUser.id}/${discordUser.avatar}.png`
                : `https://cdn.discordapp.com/embed/avatars/${discordUser.id % 5}.png`;
            const pfTierColors = { free: '#F8DCC0', compy: '#DCA15E', raptor: '#FF4E3B' };
            const pfTierLabels = { free: 'Free', compy: 'Compy', raptor: 'Raptor' };
        %>
        <%#
            Cabeçalho novo (pedido do dono, 2026-08-05: "lembra a head que
            eu pedi pra remover? coloque novo só texto") — SÓ texto desta
            vez, sem repetir o componente antigo (título "DASHBOARD" +
            ícone de usuário no canto, ver page-header.ejs) que já tinha
            sido removido daqui por ser redundante com o perfil-hero logo
            abaixo.
        %>
        <%# text-shadow (só aqui, não no resto de .section-title) — este H1 é o único texto da página que pode ficar direto sobre o plano de fundo personalizado (ver style condicional no <main> acima), sem um .titan-card-premium opaco por baixo. %>
        <h1 class="section-title text-2xl" style="text-shadow: 3px 3px 8px rgba(0, 0, 0, 0.6), -2px -2px 6px rgba(0, 0, 0, 0.5);"><span data-i18n-pt>Bem vindo de volta,</span><span data-i18n-en>Welcome back,</span> <%= nickname %></h1>

        <%- include('partials/save-result-overlay', { saved }) %>

        <%# Novidades (gerais + servidores parceiros) migraram pra home em 2026-08-06 — ver web/views/hero.ejs. %>

        <section class="titan-card-premium flex-col gap-5">
            <div class="perfil-hero">
                <div class="flex items-center gap-5">
                    <div class="perfil-hero-avatar"><img src="<%= pfAvatarUrl %>" alt=""></div>
                    <div class="flex flex-col gap-3 items-start">
                        <span class="perfil-hero-name"><%= discordUser.global_name || discordUser.username %></span>
                        <span class="perfil-hero-id">Discord ID: <%= discordUser.id %></span>
                        <span class="perfil-tier-pill" style="--pt-color: <%= pfTierColors[playerTier] %>">
                            <i data-lucide="badge" class="w-4 h-4"></i> <span data-i18n-pt>Player Premium:</span><span data-i18n-en>Player Premium:</span> <%= pfTierLabels[playerTier] %>
                            <% if (playerTier !== 'free' && premiumInfo.expires_at) { %> — <span data-i18n-pt>expira em</span><span data-i18n-en>expires on</span> <%= new Date(premiumInfo.expires_at).toLocaleDateString('pt-BR') %><% } %>
                            <% if (playerTier !== 'free' && !premiumInfo.expires_at) { %> — <span data-i18n-pt>vitalício</span><span data-i18n-en>lifetime</span><% } %>
                        </span>
                    </div>
                </div>
                <%#
                    Saldo de Hunt (pedido do dono, 2026-08-05: "pode ficar
                    no primeiro bloco de perfil no canto direito superior
                    do mesmo") — sistema ainda não implementado (ver
                    PREMIUM.txt, "MOEDA HUNT"), por isso só o selo "Em
                    breve" por enquanto, sem valor nenhum pra mostrar.
                %>
                <div class="perfil-hunt-pill">
                    <i data-lucide="coins"></i>
                    <span>Hunt: <strong><span data-i18n-pt>Em breve</span><span data-i18n-en>Coming soon</span></strong></span>
                </div>
            </div>

            <% if (otherGuilds.length > 0) { %>
                <div>
                    <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Servidores que você administra</span><span data-i18n-en>Servers you manage</span></h3>
                    <div class="perfil-guild-list">
                        <% otherGuilds.forEach(g => { %>
                            <% const gIconUrl = g.icon ? `https://cdn.discordapp.com/icons/${g.id}/${g.icon}.png` : `/images/guild-fallback-${(g.id % 4) + 1}.svg`; %>
                            <a href="/moderacao/<%= g.id %>" class="perfil-guild-chip">
                                <img src="<%= gIconUrl %>" alt="">
                                <span><%= g.name %></span>
                            </a>
                        <% }); %>
                    </div>
                </div>
            <% } %>
        </section>

        <% if (!link) { %>
            <section class="titan-card-premium flex-col gap-3">
                <h2 class="section-title text-lg flex items-center gap-3">
                    <img src="/images/pot-logo.webp" alt="" class="w-8 h-8 rounded-full">
                    Path of Titans
                </h2>
                <p class="text-sm opacity-60"><span data-i18n-pt>Sua conta Discord ainda não está vinculada a um jogador de Path of Titans.</span><span data-i18n-en>Your Discord account isn't linked to a Path of Titans player yet.</span></p>
                <p class="text-[13px] opacity-40"><span data-i18n-pt>Use</span><span data-i18n-en>Use</span> <code>/registrar</code> <span data-i18n-pt>no Discord pra vincular sua conta — depois disso seu perfil, emblema e personalização ficam disponíveis aqui.</span><span data-i18n-en>on Discord to link your account — after that your profile, badge and customization become available here.</span></p>
            </section>
        <% } else { %>
            <div class="pf-tab-nav">
                <button type="button" class="pf-tab-btn is-active" data-pf-tab="perfil"><span data-i18n-pt>Perfil</span><span data-i18n-en>Profile</span></button>
                <button type="button" class="pf-tab-btn" data-pf-tab="personalizacao"><span data-i18n-pt>Personalização</span><span data-i18n-en>Customization</span></button>
            </div>

            <div class="pf-tab-panel flex flex-col gap-[20px] lg:gap-[30px]" data-pf-panel="perfil">
                <section class="titan-card-premium flex-col gap-5">
                    <h2 class="section-title text-lg flex items-center gap-3">
                        <img src="/images/pot-logo.webp" alt="" class="w-8 h-8 rounded-full">
                        Path of Titans
                    </h2>
                    <div class="flex flex-col gap-2">
                        <span class="perfil-stat-line"><strong class="text-titan-cream opacity-100"><span data-i18n-pt>Nome no jogo:</span><span data-i18n-en>In-game name:</span></strong> <%= link.player_name || '—' %></span>
                        <span class="perfil-stat-line"><strong class="text-titan-cream opacity-100">Alderon ID:</strong> <%= link.alderon_id %></span>
                        <span class="perfil-stat-line"><strong class="text-titan-cream opacity-100"><span data-i18n-pt>Título:</span><span data-i18n-en>Title:</span></strong> <% if (link.profile_title) { %><%= link.profile_title %><% } else { %><span data-i18n-pt>Em breve (missões)</span><span data-i18n-en>Coming soon (quests)</span><% } %></span>
                        <span class="perfil-stat-line"><strong class="text-titan-cream opacity-100"><span data-i18n-pt>Espécie mais jogada:</span><span data-i18n-en>Most played species:</span></strong> <% if (mostPlayedDinosaur) { %><%= mostPlayedDinosaur %><% } else { %><span data-i18n-pt>Ainda sem registro</span><span data-i18n-en>No record yet</span><% } %></span>
                        <span class="perfil-stat-line"><strong class="text-titan-cream opacity-100"><span data-i18n-pt>Nível:</span><span data-i18n-en>Level:</span></strong> 1 <span class="opacity-50">(<span data-i18n-pt>sistema de XP em breve</span><span data-i18n-en>XP system coming soon</span>)</span></span>
                        <% if (kdStats) { %>
                            <span class="perfil-stat-line"><strong class="text-titan-cream opacity-100">Kills:</strong> <%= kdStats.kills %> <strong class="text-titan-cream opacity-100 ml-2">Deaths:</strong> <%= kdStats.deaths %> <strong class="text-titan-cream opacity-100 ml-2">K/D:</strong> <%= kdStats.kd %> <span class="opacity-50">(<span data-i18n-pt>soma de todos os servidores</span><span data-i18n-en>sum of all servers</span>)</span></span>
                        <% } %>
                        <div class="flex items-center gap-2 mt-1">
                            <span class="perfil-stat-line"><strong class="text-titan-cream opacity-100"><span data-i18n-pt>Honra:</span><span data-i18n-en>Honor:</span></strong></span>
                            <span class="perfil-stars">
                                <% for (let i = 1; i <= 5; i++) { %><span class="<%= i <= honorStars ? 'is-filled' : '' %>">★</span><% } %>
                            </span>
                        </div>
                    </div>

                    <%#
                        Servidores que já jogou (pedido do dono, 2026-08-05)
                        — DIFERENTE da lista "administra" lá em cima (essa é
                        de permissão/Discord; esta é histórico de jogo, ver
                        dashboard.js getPlayedGuilds/pot_players). Não é
                        link pra lugar nenhum (diferente do chip de
                        "administra"): jogar num servidor não dá acesso
                        nenhum ao dashboard dele, então o chip aqui é só
                        informativo (<div>, não <a>).
                    %>
                    <% if (playedGuilds.length > 0) { %>
                        <div>
                            <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Servidores que você já jogou</span><span data-i18n-en>Servers you've played on</span></h3>
                            <div class="perfil-guild-list">
                                <% playedGuilds.forEach(pg => { %>
                                    <div class="perfil-guild-chip" title="Última vez: <%= pg.lastSeen ? new Date(pg.lastSeen).toLocaleDateString('pt-BR') : '—' %>">
                                        <% if (pg.iconUrl) { %>
                                            <img src="<%= pg.iconUrl %>" alt="">
                                        <% } else { %>
                                            <img src="/images/guild-fallback-1.svg" alt="">
                                        <% } %>
                                        <span><%= pg.name %></span>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    <% } %>
                </section>
            </div>

            <%#
                Sem "contents" aqui de propósito (diferente do padrão usado
                em moderacao.ejs/events.ejs) — este <form> É o próprio
                painel da aba (.pf-tab-panel), então precisa continuar
                sendo uma caixa de verdade pra JS conseguir escondê-lo com
                display:none (classe is-hidden). display:contents +
                is-hidden juntos na mesma classe conflitariam em
                especificidade igual com a ordem de carregamento do
                Tailwind (CDN, injeta depois deste <style>) — resultado
                imprevisível, por isso evitado aqui.
            %>
            <form action="/perfil/save" method="POST" enctype="multipart/form-data" class="pf-tab-panel is-hidden flex flex-col gap-6" data-pf-panel="personalizacao">
                <section class="titan-card-premium flex-col gap-6">
                    <h2 class="section-title text-lg"><span data-i18n-pt>PERSONALIZAR PERFIL</span><span data-i18n-en>CUSTOMIZE PROFILE</span></h2>
                    <p class="text-[13px] opacity-50"><span data-i18n-pt>Ajuste como seu perfil aparece pros outros no</span><span data-i18n-en>Adjust how your profile appears to others in</span> <code>/perfil</code> <span data-i18n-pt>— título e emblema incluídos.</span><span data-i18n-en>— title and badge included.</span></p>

                    <div>
                        <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Emblema</span><span data-i18n-en>Badge</span></h3>
                        <p class="text-xs opacity-40 mb-2"><span data-i18n-pt>Disponível em qualquer plano.</span><span data-i18n-en>Available on any plan.</span></p>
                        <% if (badgeOptions.length === 0) { %>
                            <p class="text-xs opacity-40"><span data-i18n-pt>Nenhum emblema disponível no momento.</span><span data-i18n-en>No badge available right now.</span></p>
                        <% } else { %>
                            <div class="banner-picker">
                                <label class="banner-picker-option is-narrow">
                                    <input type="radio" name="badge_key" value="" <%= !link.selected_badge_key ? 'checked' : '' %>>
                                    <span class="banner-picker-thumb is-square"></span>
                                    <span class="banner-picker-label"><span data-i18n-pt>Nenhum</span><span data-i18n-en>None</span></span>
                                </label>
                                <% badgeOptions.forEach(opt => { %>
                                    <label class="banner-picker-option is-narrow">
                                        <input type="radio" name="badge_key" value="<%= opt.value %>" <%= opt.value === link.selected_badge_key ? 'checked' : '' %>>
                                        <span class="banner-picker-thumb is-square"></span>
                                        <span class="banner-picker-label"><%= opt.label %></span>
                                    </label>
                                <% }); %>
                            </div>
                        <% } %>
                    </div>

                    <div>
                        <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Foto de Perfil</span><span data-i18n-en>Profile Picture</span></h3>
                        <% if (!isCompyPlus) { %>
                            <p class="text-xs opacity-40"><span data-i18n-pt>Recurso do Player Premium Compy ou superior — use</span><span data-i18n-en>Player Premium Compy or higher feature — use</span> <code>/premium</code> <span data-i18n-pt>no Discord pra saber mais.</span><span data-i18n-en>on Discord to learn more.</span></p>
                        <% } else if (isRaptor) { %>
                            <p class="text-xs opacity-40 mb-2"><span data-i18n-pt>Envie sua própria imagem. Sem upload, usa o banner do seu próprio perfil do Discord (se você tiver um).</span><span data-i18n-en>Upload your own image. Without an upload, it uses your own Discord profile banner (if you have one).</span></p>
                            <% if (avatarPreviewUrl) { %>
                                <div class="rounded-lg mb-2" style="width:96px; aspect-ratio:1/1; background-image:url('<%= avatarPreviewUrl %>'); background-size:cover; background-position:center;"></div>
                            <% } %>
                            <div class="input-container-premium">
                                <div class="icon-box"><i data-lucide="upload"></i></div>
                                <input type="file" name="avatar_file" accept="image/png,image/jpeg,image/webp" class="input-premium-field">
                            </div>
                        <% } else { %>
                            <p class="text-xs opacity-40 mb-2"><span data-i18n-pt>Escolha uma foto da galeria.</span><span data-i18n-en>Choose a photo from the gallery.</span></p>
                            <% if (avatarOptions.length === 0) { %>
                                <p class="text-xs opacity-40"><span data-i18n-pt>Nenhuma foto disponível no momento.</span><span data-i18n-en>No photo available right now.</span></p>
                            <% } else { %>
                                <div class="banner-picker">
                                    <label class="banner-picker-option is-narrow">
                                        <input type="radio" name="photo_key" value="" <%= !link.selected_photo_key ? 'checked' : '' %>>
                                        <span class="banner-picker-thumb is-square"></span>
                                        <span class="banner-picker-label"><span data-i18n-pt>Padrão do tier</span><span data-i18n-en>Tier default</span></span>
                                    </label>
                                    <% avatarOptions.forEach(opt => { %>
                                        <label class="banner-picker-option is-narrow">
                                            <input type="radio" name="photo_key" value="<%= opt.value %>" <%= opt.value === link.selected_photo_key ? 'checked' : '' %>>
                                            <span class="banner-picker-thumb is-square"></span>
                                            <span class="banner-picker-label"><%= opt.label %></span>
                                        </label>
                                    <% }); %>
                                </div>
                            <% } %>
                        <% } %>
                    </div>

                    <div>
                        <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Plano de Fundo</span><span data-i18n-en>Background</span></h3>
                        <% if (!isCompyPlus) { %>
                            <p class="text-xs opacity-40"><span data-i18n-pt>Recurso do Player Premium Compy ou superior — use</span><span data-i18n-en>Player Premium Compy or higher feature — use</span> <code>/premium</code> <span data-i18n-pt>no Discord pra saber mais.</span><span data-i18n-en>on Discord to learn more.</span></p>
                        <% } else { %>
                            <% if (isRaptor) { %>
                                <p class="text-xs opacity-40 mb-2"><span data-i18n-pt>Envie sua própria imagem (ideal 1300x300).</span><span data-i18n-en>Upload your own image (ideal 1300x300).</span></p>
                                <% if (backgroundPreviewUrl) { %>
                                    <div class="rounded-lg mb-2" style="aspect-ratio: 1300/300; max-width:300px; background-image:url('<%= backgroundPreviewUrl %>'); background-size:cover; background-position:center;"></div>
                                <% } %>
                                <div class="input-container-premium">
                                    <div class="icon-box"><i data-lucide="upload"></i></div>
                                    <input type="file" name="background_file" accept="image/png,image/jpeg,image/webp" class="input-premium-field">
                                </div>
                            <% } else { %>
                                <p class="text-xs opacity-40 mb-2"><span data-i18n-pt>Escolha um plano de fundo da galeria.</span><span data-i18n-en>Choose a background from the gallery.</span></p>
                                <% if (backgroundOptions.length === 0) { %>
                                    <p class="text-xs opacity-40"><span data-i18n-pt>Nenhum plano de fundo disponível no momento.</span><span data-i18n-en>No background available right now.</span></p>
                                <% } else { %>
                                    <div class="banner-picker">
                                        <label class="banner-picker-option">
                                            <input type="radio" name="background_key" value="" <%= !link.selected_background_key ? 'checked' : '' %>>
                                            <span class="banner-picker-thumb"></span>
                                            <span class="banner-picker-label"><span data-i18n-pt>Nenhum</span><span data-i18n-en>None</span></span>
                                        </label>
                                        <% backgroundOptions.forEach(opt => { %>
                                            <label class="banner-picker-option">
                                                <input type="radio" name="background_key" value="<%= opt.value %>" <%= opt.value === link.selected_background_key ? 'checked' : '' %>>
                                                <span class="banner-picker-thumb"></span>
                                                <span class="banner-picker-label"><%= opt.label %></span>
                                            </label>
                                        <% }); %>
                                    </div>
                                <% } %>
                            <% } %>
                            <% const hasBackground = isRaptor ? !!link.background_message_id : !!link.selected_background_key; %>
                            <% if (hasBackground) { %>
                                <label class="text-xs opacity-60 flex items-center gap-2 mt-2">
                                    <input type="checkbox" name="remove_background" value="on"> <span data-i18n-pt>Remover plano de fundo atual</span><span data-i18n-en>Remove current background</span>
                                </label>
                            <% } %>
                        <% } %>
                    </div>

                    <% if (isCompyPlus) { %>
                        <div>
                            <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Combate</span><span data-i18n-en>Combat</span></h3>
                            <label class="text-xs opacity-60 flex items-center gap-2">
                                <input type="checkbox" name="hide_kda" value="on" <%= link.hide_kda ? 'checked' : '' %>> <span data-i18n-pt>Esconder Kills/Deaths/K-D no meu /perfil</span><span data-i18n-en>Hide Kills/Deaths/K-D on my /perfil</span>
                            </label>
                        </div>
                    <% } %>

                    <% if (isRaptor) { %>
                        <div>
                            <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Título</span><span data-i18n-en>Title</span></h3>
                            <div class="input-container-premium">
                                <div class="icon-box"><i data-lucide="edit"></i></div>
                                <input type="text" maxlength="100" class="input-premium-field" name="profile_title" placeholder="Em breve (missões)" value="<%= link.profile_title || '' %>">
                            </div>
                        </div>
                    <% } %>

                    <button type="submit" class="btn-salvar-final self-start mt-2"><span data-i18n-pt>Salvar Alterações</span><span data-i18n-en>Save Changes</span></button>
                </section>
            </form>
        <% } %>

        <%#
            Saldo de Hunt saiu daqui e virou o selo no canto superior
            direito do primeiro bloco (pedido do dono, 2026-08-05) — as
            outras vitrines "em breve" continuam juntas aqui. Títulos
            não tem catálogo nenhum ainda (só o campo de texto livre do
            Raptor, ver aba Personalização) — placeholder igual aos
            outros. Badges TEM um pool de verdade (profile_image_pool
            tipo 'badge', mesmo picker da aba Personalização), mas uma
            "lista" própria de vitrine ainda não existe nesta página —
            mesmo tratamento "em breve" por enquanto, pra não duplicar o
            picker com um segundo componente parcialmente funcional.

            Tempo de Jogo (pedido do dono, 2026-08-06: "prepare... mas
            não comece a contar ainda") — reserva o espaço no perfil
            igual aos outros 3, de propósito SEM mostrar nenhum número
            ainda. O dado em si (por servidor) já existe e já é
            calculado de verdade a partir de PlayerLogin/PlayerLogout
            (pot_players.total_playtime, incrementado a cada logout com
            sessão — ver potPlayerRegistry.js upsertPlayerFromEvent) e
            já chega aqui pronto em playedGuilds[].totalPlaytime (ver
            dashboard.js getPlayedGuilds) — só não é usado neste card de
            propósito. Quando o dono pedir pra "ligar", é só trocar o
            texto abaixo por algo como playedGuilds.reduce((sum, pg) =>
            sum + (pg.totalPlaytime || 0), 0), formatado com o mesmo
            formatPlaytime já usado no /perfil do Discord.
        %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-[20px] lg:gap-[30px]">
            <section class="titan-card-premium perfil-soon-card">
                <i data-lucide="users"></i>
                <span class="perfil-soon-title"><span data-i18n-pt>Lista de Amigos</span><span data-i18n-en>Friends List</span></span>
                <span class="perfil-soon-text"><span data-i18n-pt>Em breve.</span><span data-i18n-en>Coming soon.</span></span>
            </section>
            <section class="titan-card-premium perfil-soon-card">
                <i data-lucide="scroll-text"></i>
                <span class="perfil-soon-title"><span data-i18n-pt>Lista de Títulos</span><span data-i18n-en>Titles List</span></span>
                <span class="perfil-soon-text"><span data-i18n-pt>Catálogo de títulos pra desbloquear (sistema de missões) — em breve.</span><span data-i18n-en>Catalog of unlockable titles (quest system) — coming soon.</span></span>
            </section>
            <section class="titan-card-premium perfil-soon-card">
                <i data-lucide="badge"></i>
                <span class="perfil-soon-title"><span data-i18n-pt>Lista de Badges</span><span data-i18n-en>Badges List</span></span>
                <span class="perfil-soon-text"><span data-i18n-pt>Vitrine dos emblemas disponíveis pra coletar — em breve.</span><span data-i18n-en>Showcase of collectible badges — coming soon.</span></span>
            </section>
            <section class="titan-card-premium perfil-soon-card">
                <i data-lucide="clock"></i>
                <span class="perfil-soon-title"><span data-i18n-pt>Tempo de Jogo</span><span data-i18n-en>Playtime</span></span>
                <span class="perfil-soon-text"><span data-i18n-pt>Tempo jogado por servidor — em breve.</span><span data-i18n-en>Time played per server — coming soon.</span></span>
            </section>
        </div>

        <footer class="flex justify-end pb-2">
            <span class="bebas text-[12px] uppercase tracking-[6px] text-titan-cream opacity-10 hover:opacity-30 transition-opacity">
                BY: KNUST SEIER VI
            </span>
        </footer>
    </main>

    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <script>if (window.lucide) window.lucide.createIcons();</script>
    <script>
        (function () {
            var buttons = document.querySelectorAll('.pf-tab-btn');
            var panels = document.querySelectorAll('.pf-tab-panel');
            if (!buttons.length || !panels.length) return;
            buttons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var target = btn.getAttribute('data-pf-tab');
                    buttons.forEach(function (b) { b.classList.toggle('is-active', b === btn); });
                    panels.forEach(function (p) { p.classList.toggle('is-hidden', p.getAttribute('data-pf-panel') !== target); });
                });
            });
        })();
    </script>
</body>
</html>
