<%#
  web/views/perfil.ejs
  Página GLOBAL (sem :guildID — identidade do jogador é global, ver
  player_links) de perfil do usuário logado no dashboard. Espelha o
  /perfil-edit do Discord (ConfigSystem.buildPerfilEditPanelPayload) pra
  personalização e o /perfil (playerRegistrationSystem.sendProfile) pra
  identidade/stats — um formulário só em vez do fluxo por botão+modal do
  Discord. Aberta pelo botão-avatar da sidebar (pedido do dono,
  2026-08-05).

  Uso: res.render('perfil', { ... }) — ver dashboard.js GET /perfil pra
  lista completa de locals.
%>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meu Perfil | <%= bot.user.username %></title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Tilt+Warp&family=Bebas+Neue&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'titan-bg': '#0D0D0D',
                        'titan-accent': '#803E30',
                        'titan-cream': '#F8DCC0',
                        'titan-gold': '#D9A362',
                    }
                }
            }
        }
    </script>
    <style>
        /* Estilos só desta página (mesmo padrão de dev-image-pool.ejs:
           componente usado numa página só não precisa entrar no
           style.css compartilhado). */
        /* Variáveis globais do card de identidade (.pf-id-*) — cor/tipo
           padrão da marca, usadas em cima das cores por tier
           (--pf-tier-* / --pf-rim-*, essas sim aplicadas via style inline
           por jogador, ver pfIdCardGradients no JS mais abaixo). ATENÇÃO:
           espaço antes da barra é proposital — asterisco colado numa
           barra fecha o comentário sem querer e derruba a regra CSS
           inteira (já aconteceu aqui 3x, ver histórico). */
        :root {
            --pf-text: #F8DCC0;
            --pf-accent: #DCA15E;
            --font-head: 'Tilt Warp', cursive;
            --font-body: 'Poppins', sans-serif;
        }
        /* Fundo personalizado direto no <body> (pedido do dono, 2026-08-06:
           "a imagem de plano de fundo de perfil deve cobrir a página
           inteira abaixo dos cards" — a tentativa anterior usava uma
           <div> própria position:fixed + z-index:-1 como camada
           separada, mas não apareceu de verdade pro dono; setar direto
           no <body> é mais robusto porque o fundo do <body>/<html> é
           SEMPRE a camada mais baixa da página por definição da spec de
           CSS — não depende de nenhuma regra de empilhamento (z-index)
           entre <body> e os elementos normais dela por cima
           (aside/main), então não tem como um deles "tampar" sem querer.
           !important necessário pra vencer o `background-color: ...
           !important` do style.css compartilhado (garante fundo escuro
           padrão em todo o dashboard) — um !important só perde pra outro
           !important de MAIOR especificidade, e um estilo inline
           sempre tem mais especificidade que qualquer seletor de classe.
           background-attachment:fixed (não computa contra a altura TOTAL
           da página, que pode ser bem mais alta que a tela — computaria
           contra isso e o cover ficaria bem mais "zoomado"/cortado do
           que devia) — degrada bem no Safari iOS: na pior das hipóteses
           vira scroll normal ali, não quebra nem some. */
        body.perfil-has-bg {
            background-image: url('<%= backgroundPreviewUrl %>') !important;
            background-size: cover !important;
            background-position: center !important;
            background-repeat: no-repeat !important;
            background-attachment: fixed !important;
        }
        /* align-items:flex-start (não mais center) — pedido do dono,
           2026-08-05: o selo de Hunt (canto superior direito) precisa
           alinhar com o TOPO do bloco de avatar/nome, não com o centro
           dele. O grupo avatar+nome continua centralizado ENTRE SI (ver
           .flex.items-center por cima dos dois no HTML), só a linha
           externa (esse grupo vs. o selo de Hunt) é que virou flex-start. */
        /* .perfil-hero, .perfil-tier-pill, .perfil-hunt-pill, .perfil-level-*,
           .perfil-guild-*, .perfil-staff-history-* removidas daqui (pedido
           do dono, 2026-08-20: cards que usavam essas classes foram
           removidos da página, ver comentário no HTML mais abaixo). */
        .perfil-stars { font-size: 20px; letter-spacing: 3px; color: #3E3D38; }
        .perfil-stars .is-filled { color: #DCA15E; }
        .perfil-stat-line { font-family: 'Poppins', sans-serif; font-size: 13px; opacity: 0.7; }
        .perfil-soon-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-align: center;
            /* padding-left/right (bug encontrado pelo dono, 2026-08-06:
               "texto sem margem lateral, muito próximo da borda") — este
               seletor tem a MESMA especificidade de .titan-card-premium
               (ambos uma classe só, no mesmo elemento) e vem depois no
               HTML (style.css compartilhado é carregado antes do <style>
               desta página), então o padding:40px do card base perdia
               por inteiro pra este padding:10px 0 (0 nas laterais) —
               não só o vertical, o shorthand substitui os 4 lados juntos. */
            padding: 10px 24px;
        }
        .perfil-soon-card i { width: 32px; height: 32px; color: #803E30; }
        .perfil-soon-title { font-family: 'Tilt Warp', cursive; font-size: 16px; color: #F8DCC0; }
        .perfil-soon-text { font-family: 'Poppins', sans-serif; font-size: 12px; opacity: 0.5; max-width: 320px; }
        /* Dado real (não placeholder "em breve") — mais destaque que o
           texto padrão do card. .perfil-soon-text.perfil-playtime-total
           (2 classes) de propósito, pra bater a especificidade do
           .perfil-soon-text sozinho sem !important. */
        .perfil-soon-text.perfil-playtime-total { font-size: 20px; font-weight: 600; opacity: 1; color: #DCA15E; }

        /* ==================== CARD DE IDENTIDADE ====================
           Reconstrução do card novo aprovado no rascunho (Figma "Profile
           Display big") — moldura/foto usam o MESMO path SVG exato já em
           produção (clipPaths logo abaixo, nunca reaproximados). Sem
           contorno/sombra de "card" — pedido do dono: os componentes
           (foto/pílula/linhas/barra de nível/caçadas) ficam "flutuando na
           página", cada um com a própria sombra, sem um container visível
           por trás. Cores por tier (--pf-tier-* / --pf-rim-*) aplicadas via
           style inline no HTML a partir de pfIdCardGradients (ver JS
           acima) — mesmo padrão já usado antes (--pf-id-grad-a/b/text). */
        /* flex-shrink:0 (pedido do dono, 2026-08-20: card "quebrou" de novo
           mesmo com display:flex funcionando — dessa vez o card em si
           estava sendo COMPRIMIDO) — <body> no style.css compartilhado
           tem height:100vh (fixo, não min-height) e <main> é esticado por
           align-items:stretch pra caber exatamente nisso; quando o
           conteúdo de <main> (banner+título+este card+grupo de 4 cards)
           não cabe numa tela só, o flexbox precisa encolher algum filho
           pra "sobrar" espaço. .pf-id-card é o único com aspect-ratio (uma
           altura "elástica", que o flexbox trata como negociável, ao
           contrário de altura vinda só de conteúdo normal) então ele
           sozinho absorvia toda a compressão, sendo espremido até bater no
           min-height — sobrando pouco espaço interno e o grupo de 4 cards
           colando por cima. flex-shrink:0 tira este card da negociação:
           ele sempre usa sua altura real (aspect-ratio/max-height/
           min-height próprios), e se ainda assim não couber numa tela,
           quem resolve é o scroll da própria página (<body>,
           overflow:auto), do jeito que já era o comportamento pretendido. */
        .pf-id-card {
            width: 100%;
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            padding: 20px;
            background: transparent;
        }
        /* Coluna de conteúdo — trava num tamanho máximo mesmo que o card
           por fora fique bem mais largo/alto pra caber a foto de fundo
           (Compy/Raptor, ver .pf-id-card.has-bg abaixo); sem isso o grupo
           de identidade estica junto e vira enorme numa tela grande.
           flex:1 é o que deixa .pf-id-bottom-row grudar no fim via
           margin-top:auto mais abaixo. */
        /* min-height:0 (pedido do dono, 2026-08-20: card "quebrou" — o
           bloco de XP/Caçadas vazava por cima do grupo de 4 cards abaixo)
           — um item flex (flex:1) dentro de um pai de altura travada
           (.pf-id-card.has-bg, max-height:800px) tem min-height:auto por
           padrão, que RECUSA encolher abaixo do tamanho do próprio
           conteúdo — se o conteúdo real (fontes de verdade, mais alto que
           qualquer estimativa) precisar de mais que os 800px do pai, esse
           item simplesmente vaza pra fora da caixa (overflow:visible é o
           padrão), pintando por cima do que vem depois na página. Com
           min-height:0 o flexbox tem permissão de negociar o espaço de
           verdade em vez de estourar o pai. */
        .pf-id-inner { display: flex; flex-direction: column; flex: 1; min-height: 0; width: 100%; max-width: 1041px; gap: 20px; }
        .pf-id-top { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }

        /* ---- Coluna esquerda: foto + pílula de espécie ---- */
        .pf-id-photo-col { flex: 1 1 380px; min-width: 260px; display: flex; flex-direction: column; gap: 0; }
        /* Wrapper sem filter próprio, irmão (não pai) de .pf-id-photo-
           shadow-wrap e .pf-id-photo-badges — um filter numa ancestral se
           aplica a TODA a subárvore renderizada dela, então os emblemas
           precisam ficar FORA da subárvore que carrega o glow da foto (só
           dentro do MESMO wrapper posicional, pra ancorar no canto certo),
           senão herdam o brilho junto da própria sombra deles. */
        .pf-id-photo-frame { position: relative; }
        /* filter:drop-shadow sozinho no MESMO elemento que tem
           overflow:hidden fica invisível: overflow:hidden corta a própria
           sombra ANTES dela conseguir aparecer (limitação real de CSS).
           Fix: filter só neste wrapper de fora (sem overflow/clip nenhum)
           — o recorte continua em .pf-id-photo, sem mudança na foto em
           si. Glow do meio por tier (--pf-tier-accent) evita um dourado
           fixo lavar a cor de bordas não-douradas (Raptor). */
        .pf-id-photo-shadow-wrap {
            position: relative;
            width: 100%;
            filter: drop-shadow(0px 0px 1px #FFFDF5) drop-shadow(0px 0px 3px var(--pf-tier-accent)) drop-shadow(12px 15px 11.5px rgba(0, 0, 0, 0.36));
        }
        /* Filete metálico — mesma técnica já usada no contorno das
           estrelas (.pf-id-star-outline): cópia da MESMA forma (mesmo
           clip-path), um pouco maior, atrás da foto — só a "sobra" nas
           bordas fica visível. Gradiente claro/escuro alternado simula
           reflexo de metal escovado; cor por tier via --pf-rim-*. */
        .pf-id-photo-rim {
            position: absolute;
            inset: 0;
            transform: scale(1.012);
            background: linear-gradient(135deg, var(--pf-rim-light) 0%, var(--pf-rim-mid) 20%, var(--pf-rim-dark) 38%, var(--pf-rim-light) 52%, var(--pf-rim-dark) 68%, var(--pf-rim-mid) 85%, var(--pf-rim-light) 100%);
            clip-path: url(#pf-id-photo-clip);
        }
        /* Recorte da foto (path REAL exportado do Figma, mesmo de sempre,
           não reaproximado) — preserva os 2 cantos curvos e o degrau no
           canto inferior-direito, onde os emblemas se encaixam (ver
           .pf-id-photo-badges). */
        .pf-id-photo {
            position: relative;
            width: 100%;
            aspect-ratio: 350 / 238;
            background-color: #1F1D20;
            background-size: cover;
            background-position: center;
            /* Só a sombra INSET fica aqui — precisa do recorte pra seguir
               o contorno da forma, diferente das de fora (no wrapper). */
            box-shadow: inset 0px 4px 4px rgba(0, 0, 0, 0.25);
            overflow: hidden;
            clip-path: url(#pf-id-photo-clip);
        }
        .pf-id-stars {
            position: absolute;
            left: 0; bottom: 0;
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 20px 0 18px 16px;
        }
        .pf-id-star-wrap {
            position: relative;
            width: clamp(18px, 2.6vw, 24px);
            height: clamp(18px, 2.6vw, 24px);
            filter: drop-shadow(0px -2px 10px rgba(255, 226, 129, 0.65)) drop-shadow(0px 4px 4px rgba(0, 0, 0, 0.49));
        }
        .pf-id-star-outline, .pf-id-star-fill { position: absolute; inset: 0; clip-path: url(#pf-id-star-shape); }
        .pf-id-star-outline { background: #1F1D20; transform: scale(1.08); }
        .pf-id-star-fill {
            background: linear-gradient(0deg, rgba(255, 145, 60, 0.22), rgba(255, 145, 60, 0.22)), conic-gradient(from 180deg at 50% 50%, #FFE9B8 0deg, #FFFDF5 360deg);
            background-blend-mode: plus-lighter, normal;
        }

        /* Emblemas conquistados (mesmo dado real de ownedItems tipo
           'badge', só que agora encaixados no chanfro/degrau da moldura
           em vez de numa linha embaixo do card inteiro) — PNG sem fundo,
           sem círculo/borda, só uma sombra preta simples na LINHA inteira
           (não por ícone, export exato do Figma). */
        .pf-id-photo-badges {
            position: absolute;
            right: 12px; bottom: 0px;
            display: flex;
            flex-direction: row;
            align-items: center;
            padding: 0px;
            gap: 10px;
            filter: drop-shadow(3px 2px 6px rgba(0, 0, 0, 0.9)) drop-shadow(-3px -2px 6px rgba(0, 0, 0, 0.9));
        }
        .pf-id-photo-badges .badge-circle { width: 33px; height: 33px; display: flex; align-items: center; justify-content: center; flex: none; }
        .pf-id-photo-badges .badge-circle img { width: 100%; height: 100%; object-fit: contain; }

        /* Pílula de espécie — mesma técnica de gradiente por tier de
           antes (--pf-tier-a/b/text), 1 pílula só, larga, colada embaixo
           da foto. */
        .pf-id-species {
            box-sizing: border-box;
            display: flex;
            align-items: center;
            gap: 12px;
            margin-top: 18px;
            padding: 12px 18px;
            border-radius: 10px;
            border: 1px solid var(--pf-tier-accent);
            background: linear-gradient(179.54deg, var(--pf-tier-a) 47.59%, var(--pf-tier-b) 99.6%);
            /* "SIMPLE SHADOW" — mesma receita em todo item que não seja
               texto (texto já tem o próprio text-shadow/filter). */
            box-shadow: 0px 0px 2.3px #DCA15E, 8px 11px 6px rgba(0, 0, 0, 0.43);
            color: var(--pf-tier-text);
            font-family: var(--font-head);
            font-size: 18px;
            text-transform: uppercase;
        }
        .pf-id-species img { width: 35px; height: 35px; flex: none; object-fit: contain; }

        /* ---- Coluna direita: nome/título + linhas de identificação ---- */
        .pf-id-info { flex: 1 1 420px; min-width: 260px; display: flex; flex-direction: column; gap: 10px; padding-top: 4px; }
        .pf-id-nickname {
            font-family: var(--font-head);
            font-size: clamp(28px, 4vw, 48px);
            line-height: 1.15;
            color: var(--pf-text);
            text-shadow: 3px 2px 6px rgba(0,0,0,0.9), -3px -2px 6px rgba(0,0,0,0.9);
            text-wrap: balance;
        }
        /* text-shadow só sombreia TEXTO — os ícones (<img>) precisam de
           filter:drop-shadow na linha inteira (ícone + texto juntos) pra
           continuarem legíveis em cima de qualquer foto de fundo. */
        .pf-id-row {
            display: flex;
            align-items: center;
            gap: 12px;
            font-family: var(--font-body);
            font-weight: 600;
            font-size: 18px;
            color: var(--pf-text);
            filter: drop-shadow(3px 2px 6px rgba(0,0,0,0.9)) drop-shadow(-3px -2px 6px rgba(0,0,0,0.9));
        }
        .pf-id-row img { width: 35px; height: 35px; flex: none; object-fit: contain; }
        /* .dim removida (pedido do dono, 2026-08-20: "numero de ID alderon
           esta em fonte diferente e sem sombra" / "Player premium esta com
           o mesmo problema") — a opacidade reduzida enfraquecia o próprio
           filter:drop-shadow herdado da linha (sombra calculada a partir
           do alfa, então um texto a 60% de opacidade produz uma sombra
           bem mais fraca) e o peso/tamanho menores liam como "outra
           fonte". Texto de ambas as linhas agora é normal, igual ao resto
           da linha. */

        /* ---- Barra inferior: nível + caçadas ---- */
        /* margin-top:auto empurra a barra pro FIM de .pf-id-inner (flex:1,
           preenche a altura toda de .pf-id-card) — é isso que deixa a
           barra "no fim da foto" quando o card fica alto (Compy/Raptor com
           foto de fundo), com a imagem respirando no meio. */
        .pf-id-bottom-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: auto; }
        .pf-id-level {
            box-sizing: border-box;
            flex: 1 1 500px;
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 10px 20px;
            background: linear-gradient(179.54deg, var(--pf-tier-a) 47.59%, var(--pf-tier-b) 99.6%);
            border: 1px solid var(--pf-tier-accent);
            box-shadow: 0px 0px 2.3px #DCA15E, 8px 11px 6px rgba(0, 0, 0, 0.43);
            border-radius: 10px;
            color: var(--pf-tier-text);
        }
        .pf-id-level img { width: 35px; height: 35px; flex: none; object-fit: contain; }
        .pf-id-level-label { font-family: var(--font-head); font-size: 16px; flex: none; white-space: nowrap; }
        .pf-id-level-track-wrap { flex: 1 1 auto; display: flex; flex-direction: column; align-items: center; gap: 3px; min-width: 0; }
        .pf-id-level-count { font-family: var(--font-head); font-size: 13px; }
        .pf-id-level-track { width: 100%; height: 8px; border-radius: 10px; background: #3E3D38; border: 1px solid #2A2A2A; overflow: hidden; }
        .pf-id-level-fill { height: 100%; background: var(--pf-accent); border-radius: 10px 0 0 10px; }
        .pf-id-level-caption { font-family: var(--font-head); font-size: 12px; text-align: center; opacity: 0.85; }

        .pf-id-hunt {
            box-sizing: border-box;
            flex: 0 0 200px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 10px 20px;
            background: linear-gradient(90deg, #1F1D20 36.06%, #803E30 100%);
            border: 1px solid #803E30;
            box-shadow: 0px 0px 2.3px #DCA15E, 8px 11px 6px rgba(0, 0, 0, 0.43);
            border-radius: 10px;
        }
        .pf-id-hunt img { width: 35px; height: 35px; flex: none; object-fit: contain; }
        .pf-id-hunt-label { font-family: var(--font-body); font-weight: 900; font-size: 16px; color: var(--pf-tier-hunt-color, var(--pf-text)); }

        @media (max-width: 640px) { .pf-id-hunt { flex: 1 1 100%; } }

        /* Foto de fundo real (Compy/Raptor com backgroundPreviewUrl
           definido — via style inline no HTML, mesmo padrão de antes) —
           altura pra dar valor à foto: aspect-ratio mantém a PROPORÇÃO
           enquanto a largura encolhe (tablet/mobile), max-height trava em
           800px pra não crescer além disso em telas enormes, min-height é
           só um piso de segurança pra telas estreitas onde o conteúdo
           empilhado (foto+coluna vira 1 coluna) precisa de mais altura do
           que a proporção sozinha daria. Sem foto escolhida (mesmo em
           tier com direito a uma), o card fica compacto igual ao Free —
           sem simular um fundo que o jogador não configurou. */
        .pf-id-card.has-bg {
            padding: 24px;
            border-radius: 24px;
            background-size: cover;
            background-position: center;
            aspect-ratio: 4 / 3;
            /* 850 (era 800) — pequena folga de segurança em cima do
             * min-height:0 acima: mesmo negociando o espaço direito, o
             * conteúdo real (fonte Tilt Warp de verdade, mais alta que
             * qualquer estimativa) precisa de um pouco mais que 800 pra
             * não comprimir a foto/pílula visualmente. */
            max-height: 850px;
            min-height: 420px;
        }
        /* "CardShadow" — substitui o SIMPLE SHADOW só na barra de nível
           quando tem fundo, pra descolar mais de uma foto ocupada atrás
           (offset/blur bem maiores). Caçadas/pílula de espécie continuam
           no SIMPLE SHADOW — só a cor deles muda (variável por tier). */
        .pf-id-card.has-bg .pf-id-level {
            box-shadow: 0.5px -0.5px 0.5px #F8DCC0, -25px 47px 68.1px rgba(0, 0, 0, 0.74);
        }

        /* ==================== CARDS DE SERVIDOR JOGADO ====================
           Um card por servidor onde o jogador já apareceu (pedido do dono,
           2026-08-20: "Pagina de perfil deve ter os cards de cada servidor
           que a pessoa jogou abaixo dos cargs de listas"), portado do
           Figma (medidas fixas do Figma viram responsivas aqui, mesmo
           tratamento já usado no card de identidade — proporção/hierarquia
           preservadas, não os px exatos, que eram pra UM card só). Cores
           customizadas: --srv-accent só existe inline no HTML quando o
           servidor é Caçador E configurou uma cor em /config personalizar
           (ver ConfigSystem.getPanelPersonalization em dashboard.js — MESMA
           cor usada nos painéis de report/log do Discord, pedido explícito
           do dono de reaproveitar em vez de criar uma cor nova só pra
           isto). color-mix() deriva borda/fundo/divisória a partir dela —
           sem fórmula "oficial" do Figma pra isso (só um exemplo único,
           Atlas, pra ilustrar o conceito), pesos escolhidos visualmente. */
        .pf-srv-card {
            --srv-border: #000000;
            --srv-bg-a: #1F1D20;
            --srv-bg-b: #111111;
            --srv-divider: #F8DCC0;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 15px;
            gap: 12px;
            border: 3px solid var(--srv-border);
            border-radius: 10px;
            background: radial-gradient(225.25% 94.36% at 0% 86.37%, var(--srv-bg-a) 0%, var(--srv-bg-b) 100%);
            /* "CardShadow" — mesma receita de .pf-id-card.has-bg .pf-id-level acima. */
            box-shadow: 0.5px -0.5px 0.5px #F8DCC0, -25px 47px 68.1px rgba(0, 0, 0, 0.74);
        }
        .pf-srv-card--accent {
            --srv-border: color-mix(in srgb, var(--srv-accent) 45%, #000000);
            --srv-bg-a: color-mix(in srgb, var(--srv-accent) 22%, #1F1D20);
            --srv-divider: var(--srv-accent);
        }
        .pf-srv-head { display: flex; align-items: center; gap: 10px; width: 100%; }
        .pf-srv-logo { width: 56px; height: 56px; flex: none; object-fit: contain; opacity: 0.8; border-radius: 12px; }
        .pf-srv-name {
            font-family: 'Tilt Warp', cursive;
            font-size: clamp(18px, 2vw, 24px);
            color: #F8DCC0;
            text-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5), -5px -5px 10px rgba(0, 0, 0, 0.7);
            min-width: 0;
            overflow-wrap: break-word;
        }
        .pf-srv-divider { width: 100%; height: 0; border: none; border-top: 1px solid var(--srv-divider); margin: 0; }
        .pf-srv-stats { display: flex; flex-direction: column; gap: 6px; width: 100%; }
        .pf-srv-stat {
            display: flex;
            align-items: center;
            gap: 10px;
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 16px;
            color: #F8DCC0;
            filter: drop-shadow(5px 5px 10px rgba(0, 0, 0, 0.5)) drop-shadow(-5px -5px 10px rgba(0, 0, 0, 0.7));
        }
        .pf-srv-stat i { width: 26px; height: 26px; flex: none; color: #F8DCC0; }
        .pf-srv-panel-btn {
            box-sizing: border-box;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 6px 22px;
            background: radial-gradient(225.25% 94.36% at 0% 86.37%, #111111 0%, #1F1D20 57.07%, #29272A 91.53%);
            border: 1px solid #F8DCC0;
            box-shadow: 5px 5px 10px rgba(0, 0, 0, 0.5), -5px -5px 10px rgba(0, 0, 0, 0.7);
            border-radius: 15px;
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 14px;
            color: #F8DCC0;
            text-decoration: none;
            white-space: nowrap;
        }

        .pf-tab-panel.is-hidden { display: none; }
    </style>
</head>
<%#
    Fundo personalizado atrás dos cards, cobrindo a PÁGINA INTEIRA (pedido
    do dono, 2026-08-06: "podemos colocar de fundo por trás dos cards a
    imagem de fundo que ele tem personalizado no perfil?" + "a imagem de
    plano de fundo de perfil deve cobrir a página inteira abaixo dos
    cards") — MESMO backgroundPreviewUrl já calculado em dashboard.js pra
    aba Personalização; null pra quem não tem Compy+ ou não personalizou
    nada, aí a classe abaixo nem entra e a página continua igual a antes.
    Classe .perfil-has-bg (ver <style> no <head>) em vez de checar
    backgroundPreviewUrl de novo lá dentro — mantém a lógica condicional
    só aqui.
%>
<body class="flex min-h-screen<%= backgroundPreviewUrl ? ' perfil-has-bg' : '' %>">
    <%# Barra de navegação de topo — acompanha a sidebar em toda página
        (pedido do dono, 2026-08-13, ver partials/top-nav.ejs). %>
    <%- include('partials/top-nav', { active: 'perfil', hideOnScroll: true, reserveSpace: true }) %>

    <aside class="shrink-0 h-screen sticky top-0 py-[15px] pl-[15px] lg:py-[30px] lg:pl-[30px]">
        <%- include('partials/sidebar-v2', { active: 'perfil', guild: otherGuilds[0] || null, nickname, role, isOwner, restricted: true, defaultCollapsed: false }) %>
    </aside>

    <%# Sem overflow-y-auto (pedido do dono, 2026-08-05) — ver comentário completo em moderacao.ejs. Página inteira rola via <body>, não mais o <main> por dentro (evita cortar a sombra dos cards perto da sidebar). %>
    <main class="flex-1 w-full flex flex-col p-[15px] gap-[20px] lg:p-[30px] lg:gap-[30px]">

        <%
            // Sem partials/page-header aqui (pedido do dono, 2026-08-05:
            // "não precisa estar escrito DASHBOARD/MEU PERFIL, pode
            // remover essa head, e não precisa do ícone do usuário no
            // topo direito também") — o card de identidade logo abaixo já
            // apresenta quem é o usuário, então o cabeçalho genérico +
            // segundo avatar no canto ficava redundante só nesta página.
            const pfTierLabels = { free: 'Free', compy: 'Compy', raptor: 'Raptor' };
        %>
        <%#
            Cabeçalho novo (pedido do dono, 2026-08-05: "lembra a head que
            eu pedi pra remover? coloque novo só texto") — SÓ texto desta
            vez, sem repetir o componente antigo (título "DASHBOARD" +
            ícone de usuário no canto, ver page-header.ejs) que já tinha
            sido removido daqui por ser redundante com o card de
            identidade logo abaixo.
        %>
        <%- include('partials/testing-phase-banner') %>

        <%# text-shadow (só aqui, não no resto de .section-title) — este H1 é o único texto da página que pode ficar direto sobre o plano de fundo personalizado (ver style condicional no <main> acima), sem um .titan-card-premium opaco por baixo. %>
        <h1 class="section-title text-2xl" style="text-shadow: 3px 3px 8px rgba(0, 0, 0, 0.6), -2px -2px 6px rgba(0, 0, 0, 0.5);"><span data-i18n-pt>Bem vindo de volta,</span><span data-i18n-en>Welcome back,</span> <%= nickname %></h1>

        <%- include('partials/save-result-overlay', { saved }) %>

        <%
            // Card de identidade novo (pedido do dono, 2026-08-16 até
            // 2026-08-20) — ver docblock do <style> .pf-id-card acima pra
            // explicação completa (fonte da foto/fundo, cores por tier,
            // responsividade). ÚNICO card no topo da página agora (pedido
            // do dono, 2026-08-20: "remover todos os outros cards" — o
            // bloco "hero" que antes existia aqui foi removido). Só existe
            // com `link` (precisa de AGID pra título/nível/espécie/foto) —
            // sem vínculo, cai no aviso "ainda não vinculado" mais abaixo.
            // Emblemas: até 4 ícones de EMBLEMA JÁ RESGATADO pelo jogador
            // (não decorativo fixo como o mockup do Figma sugeria — o dono
            // confirmou que representam conquistas de verdade, mesmo pool
            // type='badge' já usado na Loja/Missões e Recompensas).
            // ownedItems já vem calculado (todos os tipos) — só filtra por
            // tipo aqui, sem query nova.
            // Cores por tier (mesmos hex do card do Discord —
            // TIER_PALETTE em profileCardRenderer.js, mantidas em
            // sincronia manual: mudar uma cor aqui sem mudar lá faz o
            // site e o Discord divergirem de propósito, então trocar as
            // duas juntas sempre que for ajustar o visual do card).
            const pfIdCardGradients = {
                free: { a: '#A6917D', b: '#F8DCC0', text: '#1F1D20', accent: '#F8DCC0', rimDark: '#A6917D', rimMid: '#F8DCC0', rimLight: '#FFF8EF', huntColor: null },
                compy: { a: '#A25E2D', b: '#DCA15E', text: '#F8DCC0', accent: '#FFAB4C', rimDark: '#8C5E2A', rimMid: '#FFAB4C', rimLight: '#FFD9AE', huntColor: '#DCA15E' },
                raptor: { a: '#4B2427', b: '#803E30', text: '#DCA15E', accent: '#DE6045', rimDark: '#7A3526', rimMid: '#E89078', rimLight: '#F0B7AB', huntColor: '#DCA15E' },
            };
            const pfIdCardGrad = pfIdCardGradients[playerTier] || pfIdCardGradients.free;
            const pfIdCardDefaultPhotos = { free: '/images/perfil-foto-free.webp', compy: '/images/perfil-foto-compy.webp', raptor: '/images/perfil-foto-raptor.webp' };
            const pfIdCardPhoto = link ? (avatarPreviewUrl || pfIdCardDefaultPhotos[playerTier] || pfIdCardDefaultPhotos.free) : null;
            const pfIdBadges = link ? ownedItems.filter((i) => i.type === 'badge').slice(0, 4) : [];
            const pfIdSpeciesIcon = mostPlayedDinosaurIsCarnivore ? '/images/icons/CarniSkull.webp' : '/images/icons/HerbSkull.webp';
            // Cargo de staff — pode ter mais de um (staffRoles é por
            // servidor, ver getStaffRoles em dashboard.js); a linha só
            // cabe 1, mostra o primeiro + contador do resto.
            const pfIdStaffLabel = staffRoles.length > 0
                ? staffRoles[0].category + (staffRoles.length > 1 ? ` +${staffRoles.length - 1}` : '')
                : null;
            const pfIdCardStyle = [
                `--pf-tier-a: ${pfIdCardGrad.a}`, `--pf-tier-b: ${pfIdCardGrad.b}`, `--pf-tier-text: ${pfIdCardGrad.text}`,
                `--pf-tier-accent: ${pfIdCardGrad.accent}`, `--pf-rim-dark: ${pfIdCardGrad.rimDark}`, `--pf-rim-mid: ${pfIdCardGrad.rimMid}`, `--pf-rim-light: ${pfIdCardGrad.rimLight}`,
            ];
            if (pfIdCardGrad.huntColor) pfIdCardStyle.push(`--pf-tier-hunt-color: ${pfIdCardGrad.huntColor}`);
            if (backgroundPreviewUrl) pfIdCardStyle.push(`background-image: url('${backgroundPreviewUrl}')`);
        %>
        <% if (link) { %>
            <%# clipPaths do recorte da foto e da forma da estrela (path
                exato exportado do Figma pros dois, ver comentários
                completos em .pf-id-photo/.pf-id-star-wrap no <style>
                acima) — svg width/height 0, invisível, só guarda as
                definições referenciadas por url(#pf-id-photo-clip) e
                url(#pf-id-star-shape). %>
            <svg width="0" height="0" style="position:absolute">
                <defs>
                    <clipPath id="pf-id-photo-clip" clipPathUnits="objectBoundingBox">
                        <path d="M0.1372,0.0463 C0.1570,0.0154 0.1653,0.0000 0.2033,0.0000 H0.9355 C0.9818,0.0000 1.0000,0.0334 1.0000,0.0900 V0.7635 C1.0000,0.8101 0.9851,0.8380 0.9391,0.8380 H0.6642 C0.6278,0.8380 0.6169,0.8380 0.6007,0.8740 C0.5907,0.8964 0.5802,0.9152 0.5603,0.9537 C0.5405,0.9923 0.5256,1.0000 0.5008,1.0000 H0.0547 C0.0081,1.0000 0.0000,0.9589 0.0000,0.9203 V0.3753 C0.0000,0.2931 0.0066,0.2751 0.0231,0.2442 C0.0397,0.2134 0.1174,0.0771 0.1372,0.0463 Z" />
                    </clipPath>
                    <clipPath id="pf-id-star-shape" clipPathUnits="objectBoundingBox">
                        <path d="M0.5000,0.0000 L0.6180,0.3820 L1.0000,0.3820 L0.6910,0.6180 L0.8090,1.0000 L0.5000,0.7639 L0.1910,1.0000 L0.3090,0.6180 L0.0000,0.3820 L0.3820,0.3820 L0.5000,0.0000 Z" />
                    </clipPath>
                </defs>
            </svg>
            <section class="titan-card-premium pf-id-card<%= backgroundPreviewUrl ? ' has-bg' : '' %>" style="<%= pfIdCardStyle.join('; ') %>">
                <div class="pf-id-inner">
                <div class="pf-id-top">
                    <div class="pf-id-photo-col">
                        <div class="pf-id-photo-frame">
                            <div class="pf-id-photo-shadow-wrap">
                                <div class="pf-id-photo-rim"></div>
                                <div class="pf-id-photo" style="background-image:url('<%= pfIdCardPhoto %>')">
                                    <div class="pf-id-stars">
                                        <% for (let i = 1; i <= 5; i++) { %>
                                            <span class="pf-id-star-wrap <%= i <= honorStars ? 'is-filled' : '' %>">
                                                <span class="pf-id-star-outline"></span>
                                                <span class="pf-id-star-fill"></span>
                                            </span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                            <% if (pfIdBadges.length > 0) { %>
                                <div class="pf-id-photo-badges">
                                    <% pfIdBadges.forEach((b) => { %>
                                        <span class="badge-circle"><img src="<%= b.url %>" alt="" title="<%= b.label %>"></span>
                                    <% }); %>
                                </div>
                            <% } %>
                        </div>
                        <div class="pf-id-species">
                            <img src="<%= pfIdSpeciesIcon %>" alt="">
                            <span><% if (mostPlayedDinosaur) { %><%= mostPlayedDinosaur %><% } else { %><span data-i18n-pt>Ainda sem registro</span><span data-i18n-en>No record yet</span><% } %></span>
                        </div>
                    </div>

                    <%#
                        Nome/título + Alderon ID/Premium Tier/Cargo de staff
                        (pedido do dono, 2026-08-20: card novo consolida
                        tudo que antes ficava espalhado entre o card de
                        identidade, o bloco "hero" e o card de nível/XP —
                        ver remoção desses cards mais abaixo na página).
                    %>
                    <div class="pf-id-info">
                        <span class="pf-id-nickname"><%= link.player_name || discordUser.username %></span>
                        <span class="pf-id-row">
                            <img src="/images/icons/medal.webp" alt="">
                            <span><% if (link.profile_title) { %><%= link.profile_title %><% } else { %><span data-i18n-pt>Em breve (missões)</span><span data-i18n-en>Coming soon (quests)</span><% } %></span>
                        </span>
                        <span class="pf-id-row">
                            <img src="/images/pot-logo.webp" alt="">
                            <span><%= link.player_name || discordUser.username %> | <%= link.alderon_id %></span>
                        </span>
                        <%#
                            Só o nome do tier (pedido do dono, 2026-08-20:
                            "não deve estar escrito player premium, só
                            mostrar o nome do premium, não mostre o tempo")
                            — sem label "Player Premium" e sem data de
                            expiração/vitalício, que apareciam antes.
                        %>
                        <span class="pf-id-row">
                            <img src="/images/icons/gem.webp" alt="">
                            <span><%= pfTierLabels[playerTier] %></span>
                        </span>
                        <% if (pfIdStaffLabel) { %>
                            <span class="pf-id-row">
                                <img src="/images/icons/DiscordLOGO.webp" alt="">
                                <span><%= pfIdStaffLabel %></span>
                            </span>
                        <% } %>
                    </div>
                </div>

                <div class="pf-id-bottom-row">
                    <div class="pf-id-level">
                        <img src="/images/icons/DinoFootprint.webp" alt="">
                        <span class="pf-id-level-label"><span data-i18n-pt>Nível</span><span data-i18n-en>Level</span> <%= levelProgress.level %></span>
                        <div class="pf-id-level-track-wrap">
                            <span class="pf-id-level-count"><%= levelProgress.xpTotal %> XP</span>
                            <div class="pf-id-level-track"><div class="pf-id-level-fill" style="width: <%= levelProgress.percent.toFixed(1) %>%;"></div></div>
                            <span class="pf-id-level-caption"><span data-i18n-pt>XP para o próximo nível</span><span data-i18n-en>XP to next level</span></span>
                        </div>
                    </div>
                    <div class="pf-id-hunt">
                        <img src="/images/icons/hunt.webp" alt="">
                        <span class="pf-id-hunt-label"><%= huntBalance %></span>
                    </div>
                </div>
                </div>
            </section>
        <% } %>

        <%#
            Bloco "hero" (avatar Discord grande, Premium Tier/staff pills,
            saldos de Ossos/Caçadas/XP, servidores administrados/jogados,
            Histórico de Staff, Seus Itens) REMOVIDO daqui (pedido do dono,
            2026-08-20: "remover todos os outros cards, permanecendo
            apenas o perfil... e o grupo com 4 cards"). O card de
            identidade novo acima já cobre nickname/título/Alderon ID/
            Premium Tier/cargo de staff/espécie/estrelas/emblemas/XP/
            Caçadas — o resto (Ossos, avatar/ID grande, listas de
            servidores, Seus Itens, Histórico de Staff, KDA) fica sem
            substituto nesta página por decisão explícita (o dado
            continua no banco, só parou de aparecer aqui).
        %>
        <% if (!link) { %>
            <section class="titan-card-premium flex-col gap-3">
                <h2 class="section-title text-lg flex items-center gap-3">
                    <img src="/images/pot-logo.webp" alt="" class="w-8 h-8 rounded-full">
                    Path of Titans
                </h2>
                <p class="text-sm opacity-60"><span data-i18n-pt>Sua conta Discord ainda não está vinculada a um jogador de Path of Titans.</span><span data-i18n-en>Your Discord account isn't linked to a Path of Titans player yet.</span></p>
                <p class="text-[13px] opacity-40"><span data-i18n-pt>Use</span><span data-i18n-en>Use</span> <code>/registrar</code> <span data-i18n-pt>no Discord pra vincular sua conta — depois disso seu perfil, emblema e personalização ficam disponíveis aqui.</span><span data-i18n-en>on Discord to link your account — after that your profile, badge and customization become available here.</span></p>
            </section>
        <% } else { %>
            <%#
                Card de Nível/XP e o card "servidores jogados + Seus Itens"
                (ambos REMOVIDOS daqui, pedido do dono, 2026-08-20 — Nível/
                XP já vive dentro do card de identidade novo acima, os
                outros dois ficam sem substituto nesta página). O botão
                "Personalização" (era .pf-tab-nav aqui) migrou pra virar
                item de verdade na sidebar (ver NAV_ITEMS restrito em
                sidebar-v2.ejs) — o script no fim do arquivo abre este
                <form> quando a página carrega com ?tab=personalizacao na
                URL, em vez de um clique de botão nesta mesma página.
            %>
            <%#
                Sem "contents" aqui de propósito (diferente do padrão usado
                em moderacao.ejs/events.ejs) — este <form> É o próprio
                painel da aba (.pf-tab-panel), então precisa continuar
                sendo uma caixa de verdade pra JS conseguir escondê-lo com
                display:none (classe is-hidden). display:contents +
                is-hidden juntos na mesma classe conflitariam em
                especificidade igual com a ordem de carregamento do
                Tailwind (CDN, injeta depois deste <style>) — resultado
                imprevisível, por isso evitado aqui.
            %>
            <form action="/perfil/save" method="POST" enctype="multipart/form-data" class="pf-tab-panel is-hidden flex flex-col gap-6" data-pf-panel="personalizacao">
                <section class="titan-card-premium flex-col gap-6">
                    <h2 class="section-title text-lg"><span data-i18n-pt>PERSONALIZAR PERFIL</span><span data-i18n-en>CUSTOMIZE PROFILE</span></h2>
                    <p class="text-[13px] opacity-50"><span data-i18n-pt>Ajuste como seu perfil aparece pros outros no</span><span data-i18n-en>Adjust how your profile appears to others in</span> <code>/perfil</code> <span data-i18n-pt>— título e emblema incluídos.</span><span data-i18n-en>— title and badge included.</span></p>

                    <% if (redeemableItems.length > 0) { %>
                        <div>
                            <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Disponível para Resgatar</span><span data-i18n-en>Available to Redeem</span></h3>
                            <p class="text-xs opacity-40 mb-2"><span data-i18n-pt>Você cumpriu o requisito — resgate sem gastar moeda nenhuma.</span><span data-i18n-en>You met the requirement — redeem it for free.</span></p>
                            <div class="flex flex-wrap gap-2">
                                <% redeemableItems.forEach(item => { %>
                                    <form action="/perfil/resgatar" method="POST">
                                        <input type="hidden" name="item" value="<%= item.type %>:<%= item.id %>">
                                        <button type="submit" class="btn-chip btn-chip-success"><i data-lucide="gift"></i> <%= item.label %></button>
                                    </form>
                                <% }); %>
                            </div>
                        </div>
                    <% } %>

                    <div>
                        <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Emblema</span><span data-i18n-en>Badge</span></h3>
                        <p class="text-xs opacity-40 mb-2"><span data-i18n-pt>Disponível em qualquer plano.</span><span data-i18n-en>Available on any plan.</span></p>
                        <% if (badgeOptions.length === 0) { %>
                            <p class="text-xs opacity-40"><span data-i18n-pt>Nenhum emblema disponível no momento.</span><span data-i18n-en>No badge available right now.</span></p>
                        <% } else { %>
                            <div class="banner-picker">
                                <label class="banner-picker-option is-narrow">
                                    <input type="radio" name="badge_key" value="" <%= !link.selected_badge_key ? 'checked' : '' %>>
                                    <span class="banner-picker-thumb is-square"></span>
                                    <span class="banner-picker-label"><span data-i18n-pt>Nenhum</span><span data-i18n-en>None</span></span>
                                </label>
                                <% badgeOptions.forEach(opt => { %>
                                    <label class="banner-picker-option is-narrow">
                                        <input type="radio" name="badge_key" value="<%= opt.value %>" <%= opt.value === link.selected_badge_key ? 'checked' : '' %>>
                                        <span class="banner-picker-thumb is-square"></span>
                                        <span class="banner-picker-label"><%= opt.label %></span>
                                    </label>
                                <% }); %>
                            </div>
                        <% } %>
                    </div>

                    <div>
                        <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Foto de Perfil</span><span data-i18n-en>Profile Picture</span></h3>
                        <% if (isRaptor) { %>
                            <p class="text-xs opacity-40 mb-2"><span data-i18n-pt>Envie sua própria imagem. Sem upload, usa o seu próprio avatar do Discord.</span><span data-i18n-en>Upload your own image. Without an upload, it uses your own Discord avatar.</span></p>
                            <% if (avatarPreviewUrl) { %>
                                <div class="rounded-lg mb-2" style="width:96px; aspect-ratio:1/1; background-image:url('<%= avatarPreviewUrl %>'); background-size:cover; background-position:center;"></div>
                            <% } %>
                            <div class="input-container-premium">
                                <div class="icon-box"><i data-lucide="upload"></i></div>
                                <input type="file" name="avatar_file" accept="image/png,image/jpeg,image/webp" class="input-premium-field">
                            </div>
                            <%# Raptor TAMBÉM pode escolher pela Loja (pedido do dono,
                                2026-08-19: "usar a loja se quiser"), além do upload acima
                                — as duas opções ficam disponíveis juntas, não uma no lugar
                                da outra. Envio de arquivo novo tem prioridade sobre a
                                escolha aqui embaixo se os dois vierem preenchidos no mesmo
                                submit (ver dashboard.js POST /perfil/save). %>
                            <% if (avatarOptions.length > 0) { %>
                                <p class="text-xs opacity-40 mt-3 mb-2"><span data-i18n-pt>Ou escolha uma das fotos que você comprou na Loja:</span><span data-i18n-en>Or choose one of the photos you bought in the Shop:</span></p>
                                <div class="banner-picker">
                                    <label class="banner-picker-option is-narrow">
                                        <input type="radio" name="photo_key" value="" <%= !link.selected_photo_key ? 'checked' : '' %>>
                                        <span class="banner-picker-thumb is-square"></span>
                                        <span class="banner-picker-label"><span data-i18n-pt>Nenhuma (upload/padrão)</span><span data-i18n-en>None (upload/default)</span></span>
                                    </label>
                                    <% avatarOptions.forEach(opt => { %>
                                        <label class="banner-picker-option is-narrow">
                                            <input type="radio" name="photo_key" value="<%= opt.value %>" <%= opt.value === link.selected_photo_key ? 'checked' : '' %>>
                                            <span class="banner-picker-thumb is-square"></span>
                                            <span class="banner-picker-label"><%= opt.label %></span>
                                        </label>
                                    <% }); %>
                                </div>
                            <% } %>
                        <% } else if (avatarOptions.length > 0) { %>
                            <%# Free e Compy chegam aqui igual — restrito ao que comprou na Loja (bug do Compy com acesso livre corrigido em 2026-08-15), ver dashboard.js GET /perfil. %>
                            <p class="text-xs opacity-40 mb-2"><span data-i18n-pt>Escolha uma das fotos que você comprou na Loja.</span><span data-i18n-en>Choose one of the photos you bought in the Shop.</span></p>
                            <div class="banner-picker">
                                <label class="banner-picker-option is-narrow">
                                    <input type="radio" name="photo_key" value="" <%= !link.selected_photo_key ? 'checked' : '' %>>
                                    <span class="banner-picker-thumb is-square"></span>
                                    <span class="banner-picker-label"><span data-i18n-pt>Padrão do tier</span><span data-i18n-en>Tier default</span></span>
                                </label>
                                <% avatarOptions.forEach(opt => { %>
                                    <label class="banner-picker-option is-narrow">
                                        <input type="radio" name="photo_key" value="<%= opt.value %>" <%= opt.value === link.selected_photo_key ? 'checked' : '' %>>
                                        <span class="banner-picker-thumb is-square"></span>
                                        <span class="banner-picker-label"><%= opt.label %></span>
                                    </label>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <p class="text-xs opacity-40"><span data-i18n-pt>Você ainda não comprou nenhuma foto na</span><span data-i18n-en>You haven't bought any photo in the</span> <a href="/loja"><span data-i18n-pt>Loja</span><span data-i18n-en>Shop</span></a> <span data-i18n-pt>— compre uma foto específica com Caçadas.</span><span data-i18n-en>yet — buy a specific photo with Hunt.</span></p>
                        <% } %>
                    </div>

                    <div>
                        <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Plano de Fundo</span><span data-i18n-en>Background</span></h3>
                        <% if (isRaptor) { %>
                            <p class="text-xs opacity-40 mb-2"><span data-i18n-pt>Envie sua própria imagem (ideal 1300x300). Sem upload, usa o banner do seu próprio perfil do Discord, se você tiver um.</span><span data-i18n-en>Upload your own image (ideal 1300x300). Without an upload, it uses your own Discord profile banner, if you have one.</span></p>
                            <% if (backgroundPreviewUrl) { %>
                                <div class="rounded-lg mb-2" style="aspect-ratio: 1300/300; max-width:300px; background-image:url('<%= backgroundPreviewUrl %>'); background-size:cover; background-position:center;"></div>
                            <% } %>
                            <div class="input-container-premium">
                                <div class="icon-box"><i data-lucide="upload"></i></div>
                                <input type="file" name="background_file" accept="image/png,image/jpeg,image/webp" class="input-premium-field">
                            </div>
                            <%# Raptor TAMBÉM pode escolher pela Loja, mesmo raciocínio
                                da Foto de Perfil acima — ver comentário lá. %>
                            <% if (backgroundOptions.length > 0) { %>
                                <p class="text-xs opacity-40 mt-3 mb-2"><span data-i18n-pt>Ou escolha um dos planos de fundo que você comprou na Loja:</span><span data-i18n-en>Or choose one of the backgrounds you bought in the Shop:</span></p>
                                <div class="banner-picker">
                                    <label class="banner-picker-option">
                                        <input type="radio" name="background_key" value="" <%= !link.selected_background_key ? 'checked' : '' %>>
                                        <span class="banner-picker-thumb"></span>
                                        <span class="banner-picker-label"><span data-i18n-pt>Nenhum (upload/padrão)</span><span data-i18n-en>None (upload/default)</span></span>
                                    </label>
                                    <% backgroundOptions.forEach(opt => { %>
                                        <label class="banner-picker-option">
                                            <input type="radio" name="background_key" value="<%= opt.value %>" <%= opt.value === link.selected_background_key ? 'checked' : '' %>>
                                            <span class="banner-picker-thumb"></span>
                                            <span class="banner-picker-label"><%= opt.label %></span>
                                        </label>
                                    <% }); %>
                                </div>
                            <% } %>
                        <% } else if (!isCompyPlus) { %>
                            <%# Free (pedido do dono, 2026-08-19: "Tier Free... não pode
                                ter plano de fundo no perfil, somente personalização de
                                foto de perfil") — mensagem explícita em vez de cair na
                                "você ainda não comprou" (que erradamente insinuaria que
                                dá pra comprar um). %>
                            <p class="text-xs opacity-40"><span data-i18n-pt>Plano de fundo é um recurso do Player Premium Compy ou superior.</span><span data-i18n-en>Background is a Compy tier or higher Player Premium feature.</span></p>
                        <% } else if (backgroundOptions.length > 0) { %>
                            <%# Compy — restrito ao que comprou na Loja (bug do acesso livre corrigido em 2026-08-15), ver dashboard.js GET /perfil. %>
                            <p class="text-xs opacity-40 mb-2"><span data-i18n-pt>Escolha um dos planos de fundo que você comprou na Loja.</span><span data-i18n-en>Choose one of the backgrounds you bought in the Shop.</span></p>
                            <div class="banner-picker">
                                <label class="banner-picker-option">
                                    <input type="radio" name="background_key" value="" <%= !link.selected_background_key ? 'checked' : '' %>>
                                    <span class="banner-picker-thumb"></span>
                                    <span class="banner-picker-label"><span data-i18n-pt>Nenhum</span><span data-i18n-en>None</span></span>
                                </label>
                                <% backgroundOptions.forEach(opt => { %>
                                    <label class="banner-picker-option">
                                        <input type="radio" name="background_key" value="<%= opt.value %>" <%= opt.value === link.selected_background_key ? 'checked' : '' %>>
                                        <span class="banner-picker-thumb"></span>
                                        <span class="banner-picker-label"><%= opt.label %></span>
                                    </label>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <p class="text-xs opacity-40"><span data-i18n-pt>Você ainda não comprou nenhum plano de fundo na</span><span data-i18n-en>You haven't bought any background in the</span> <a href="/loja"><span data-i18n-pt>Loja</span><span data-i18n-en>Shop</span></a> <span data-i18n-pt>— compre um plano de fundo específico com Caçadas.</span><span data-i18n-en>yet — buy a specific background with Hunt.</span></p>
                        <% } %>
                        <%# Checkbox de remoção — Raptor (upload OU Loja) ou compra na Loja (Compy), nunca Free (backgroundOptions sempre [] pra ele, ver dashboard.js). %>
                        <% if (isRaptor || backgroundOptions.length > 0) { %>
                            <% const hasBackground = !!link.background_message_id || !!link.selected_background_key; %>
                            <% if (hasBackground) { %>
                                <label class="text-xs opacity-60 flex items-center gap-2 mt-2">
                                    <input type="checkbox" name="remove_background" value="on"> <span data-i18n-pt>Remover plano de fundo atual</span><span data-i18n-en>Remove current background</span>
                                </label>
                            <% } %>
                        <% } %>
                    </div>

                    <% if (isCompyPlus) { %>
                        <div>
                            <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Combate</span><span data-i18n-en>Combat</span></h3>
                            <label class="text-xs opacity-60 flex items-center gap-2">
                                <input type="checkbox" name="hide_kda" value="on" <%= link.hide_kda ? 'checked' : '' %>> <span data-i18n-pt>Esconder Kills/Deaths/K-D no meu /perfil</span><span data-i18n-en>Hide Kills/Deaths/K-D on my /perfil</span>
                            </label>
                        </div>
                    <% } %>

                    <% if (isRaptor) { %>
                        <div>
                            <h3 class="text-titan-gold text-sm uppercase tracking-widest mb-3"><span data-i18n-pt>Título</span><span data-i18n-en>Title</span></h3>
                            <div class="input-container-premium">
                                <div class="icon-box"><i data-lucide="edit"></i></div>
                                <input type="text" maxlength="100" class="input-premium-field" name="profile_title" placeholder="Em breve (missões)" value="<%= link.profile_title || '' %>">
                            </div>
                        </div>
                    <% } %>

                    <button type="submit" class="btn-salvar-final self-start mt-2"><span data-i18n-pt>Salvar Alterações</span><span data-i18n-en>Save Changes</span></button>
                </section>
            </form>
        <% } %>

        <%#
            Saldo de Hunt saiu daqui e virou o selo no canto superior
            direito do primeiro bloco (pedido do dono, 2026-08-05) — as
            outras vitrines "em breve" continuam juntas aqui. Títulos
            não tem catálogo nenhum ainda (só o campo de texto livre do
            Raptor, ver aba Personalização) — placeholder igual aos
            outros. Badges TEM um pool de verdade (profile_image_pool
            tipo 'badge', mesmo picker da aba Personalização), mas uma
            "lista" própria de vitrine ainda não existe nesta página —
            mesmo tratamento "em breve" por enquanto, pra não duplicar o
            picker com um segundo componente parcialmente funcional.

            Tempo de Jogo (pedido do dono, 2026-08-06: "prepare... mas
            não comece a contar ainda"; LIGADO em 2026-08-10: "Adicione
            horas jogadas... nas informações de perfil") — antes reservava
            o espaço igual aos outros 3, sem mostrar número nenhum. Cada
            chip de "Servidores que você já jogou" acima já mostra o tempo
            POR SERVIDOR (pg.playtimeLabel); este card mostra a SOMA de
            todos, exatamente como planejado (dashboard.js getPlayedGuilds
            calcula pg.totalPlaytime, já com o tempo AO VIVO da sessão
            atual somado se estiver jogando agora nalgum servidor).
        %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-[20px] lg:gap-[30px]">
            <section class="titan-card-premium perfil-soon-card">
                <i data-lucide="users"></i>
                <span class="perfil-soon-title"><span data-i18n-pt>Lista de Amigos</span><span data-i18n-en>Friends List</span></span>
                <span class="perfil-soon-text"><span data-i18n-pt>Em breve.</span><span data-i18n-en>Coming soon.</span></span>
            </section>
            <section class="titan-card-premium perfil-soon-card">
                <i data-lucide="scroll-text"></i>
                <span class="perfil-soon-title"><span data-i18n-pt>Lista de Títulos</span><span data-i18n-en>Titles List</span></span>
                <span class="perfil-soon-text"><span data-i18n-pt>Catálogo de títulos pra desbloquear (sistema de missões) — em breve.</span><span data-i18n-en>Catalog of unlockable titles (quest system) — coming soon.</span></span>
            </section>
            <section class="titan-card-premium perfil-soon-card">
                <i data-lucide="badge"></i>
                <span class="perfil-soon-title"><span data-i18n-pt>Lista de Badges</span><span data-i18n-en>Badges List</span></span>
                <span class="perfil-soon-text"><span data-i18n-pt>Vitrine dos emblemas disponíveis pra coletar — em breve.</span><span data-i18n-en>Showcase of collectible badges — coming soon.</span></span>
            </section>
            <section class="titan-card-premium perfil-soon-card">
                <i data-lucide="clock"></i>
                <span class="perfil-soon-title"><span data-i18n-pt>Tempo de Jogo</span><span data-i18n-en>Playtime</span></span>
                <% if (totalPlaytimeLabel) { %>
                    <span class="perfil-soon-text perfil-playtime-total"><%= totalPlaytimeLabel %></span>
                    <span class="perfil-soon-text"><span data-i18n-pt>Somado entre todos os servidores.</span><span data-i18n-en>Summed across every server.</span></span>
                <% } else { %>
                    <span class="perfil-soon-text"><span data-i18n-pt>Ainda sem tempo registrado — jogue em algum servidor com o bot.</span><span data-i18n-en>No playtime recorded yet — play on a server with the bot.</span></span>
                <% } %>
            </section>
        </div>

        <%#
            Cards de servidor jogado (pedido do dono, 2026-08-20, ver
            docblock do <style> .pf-srv-card acima) — um card por entrada
            de playedGuilds (já vem enriquecido com kills/bones/accentHex/
            panelHref em dashboard.js). Só renderiza a seção quando existe
            pelo menos 1 servidor jogado — sem isso (conta nova, nunca
            jogou em servidor nenhum com o bot) a página simplesmente não
            mostra grade vazia.
        %>
        <% if (playedGuilds && playedGuilds.length > 0) { %>
            <h2 class="section-title text-lg opacity-70"><span data-i18n-pt>Servidores que você jogou</span><span data-i18n-en>Servers you've played</span></h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[20px] lg:gap-[30px]">
                <% playedGuilds.forEach(pg => { %>
                    <div class="pf-srv-card<%= pg.accentHex ? ' pf-srv-card--accent' : '' %>"<% if (pg.accentHex) { %> style="--srv-accent: #<%= pg.accentHex %>;"<% } %>>
                        <div class="pf-srv-head">
                            <% if (pg.iconUrl) { %>
                                <img class="pf-srv-logo" src="<%= pg.iconUrl %>" alt="">
                            <% } else { %>
                                <img class="pf-srv-logo" src="/images/pot-logo.webp" alt="">
                            <% } %>
                            <span class="pf-srv-name"><%= pg.name %></span>
                        </div>
                        <hr class="pf-srv-divider">
                        <div class="pf-srv-stats">
                            <span class="pf-srv-stat">
                                <i data-lucide="clock"></i>
                                <span data-i18n-pt><%= pg.playtimeLabel || '0h' %> jogadas</span><span data-i18n-en><%= pg.playtimeLabel || '0h' %> played</span>
                            </span>
                            <span class="pf-srv-stat">
                                <img src="/images/icons/hunt.webp" alt="" style="width: 26px; height: 26px; flex: none;">
                                <span data-i18n-pt><%= pg.kills %> caçadas</span><span data-i18n-en><%= pg.kills %> hunts</span>
                            </span>
                            <span class="pf-srv-stat">
                                <img src="/images/icons/bone.webp" alt="" style="width: 26px; height: 26px; flex: none;">
                                <span><%= pg.bones %></span>
                            </span>
                        </div>
                        <% if (pg.panelHref) { %>
                            <a class="pf-srv-panel-btn" href="<%= pg.panelHref %>"><span data-i18n-pt>Painel</span><span data-i18n-en>Panel</span></a>
                        <% } %>
                    </div>
                <% }); %>
            </div>
        <% } %>

        <footer class="flex justify-end pb-2">
            <span class="bebas text-[12px] uppercase tracking-[6px] text-titan-cream opacity-10 hover:opacity-30 transition-opacity">
                BY: KNUST SEIER VI
            </span>
        </footer>
    </main>

    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <script>if (window.lucide) window.lucide.createIcons();</script>
    <script>
        // Botão "Personalizar" migrou da aba desta página pra virar item de
        // verdade na sidebar (pedido do dono, 2026-08-20) — href="/perfil?
        // tab=personalizacao" (ver NAV_ITEMS em sidebar-v2.ejs), então em
        // vez de um clique trocando classes na mesma página, abre esse
        // painel (único .pf-tab-panel que sobrou aqui) já ao carregar,
        // quando a URL pede. Sem o parâmetro, a página mostra só o card de
        // identidade + o grupo de 4 (comportamento padrão do <form>, que já
        // nasce com is-hidden).
        (function () {
            if (new URLSearchParams(location.search).get('tab') !== 'personalizacao') return;
            var panel = document.querySelector('.pf-tab-panel[data-pf-panel="personalizacao"]');
            if (panel) panel.classList.remove('is-hidden');
            // A sidebar marca "active" (fundo vermelho) via activeKey no
            // servidor (sidebar-v2.ejs) — sempre 'perfil' nesta página,
            // então o item "Personalizar" nunca ganhava a classe mesmo
            // com a aba dele aberta (pedido do dono, 2026-08-20: "botão de
            // personalização não está ficando vermelho quando aberto").
            // Corrigido aqui no cliente em vez de no servidor pra não
            // precisar passar ?tab por toda a cadeia de locals do
            // dashboard.js — troca a classe active do item "Perfil" pro
            // "Personalizar" nos dois nav (sidebar desktop + menu mobile).
            document.querySelectorAll('a[href="/perfil"].tp-sidebar-btn, a[href="/perfil"].tp-mobile-drawer-item').forEach(function (el) {
                el.classList.remove('active');
            });
            document.querySelectorAll('a[href="/perfil?tab=personalizacao"]').forEach(function (el) {
                el.classList.add('active');
            });
        })();
    </script>
</body>
</html>
