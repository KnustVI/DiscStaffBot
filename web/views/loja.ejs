<%#
  web/views/loja.ejs
  Página GLOBAL (sem :guildID — moeda é do JOGADOR, não do servidor),
  pedido do dono 2026-08-06: "Monte um site com uma prévia da loja
  parecida com o que combinamos que fez com o image-pool" — ver
  PREMIUM.txt seção 116 pra especificação completa (moedas Hunt/Ossos,
  regras de conversão, catálogo da loja de jogo).

  PRÉVIA VISUAL só — nenhuma compra de verdade acontece aqui. Sem saldo
  real (as colunas hunt_balance/bones_balance/xp ainda não existem em
  player_links), sem RCON disparado, sem missão nenhuma. Mesmo
  tratamento "em breve" já usado nos outros cards do /perfil (Lista de
  Amigos/Títulos/Badges/Tempo de Jogo).

  Uso: res.render('loja', { nickname, role, isOwner, otherGuilds,
    avatars, backgrounds, badges }) — as 3 listas de imagens são o
    mesmo pool dinâmico do /perfil-edit (só as PÚBLICAS), reaproveitado
    aqui como inventário de EXEMPLO da Loja de Personalização em vez de
    itens inventados — ver dashboard.js GET /loja.
%>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loja | <%= bot.user.username %></title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Tilt+Warp&family=Bebas+Neue&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'titan-bg': '#0D0D0D',
                        'titan-accent': '#803E30',
                        'titan-cream': '#F8DCC0',
                        'titan-gold': '#D9A362',
                    }
                }
            }
        }
    </script>
    <style>
        /* Cards das 2 moedas + nível — mesma cápsula .titan-card-premium
           por fora, só o miolo é próprio desta página. */
        .loja-currency-card { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
        .loja-currency-icon {
            width: 44px; height: 44px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            flex: none;
        }
        .loja-currency-icon.is-hunt { background: rgba(220, 161, 94, 0.15); color: #DCA15E; }
        .loja-currency-icon.is-bones { background: rgba(248, 220, 192, 0.12); color: #F8DCC0; }
        .loja-currency-icon.is-xp { background: rgba(165, 255, 161, 0.12); color: #A5FFA1; }
        .loja-currency-icon i { width: 22px; height: 22px; }
        .loja-currency-title { font-family: 'Tilt Warp', cursive; font-size: 15px; color: #F8DCC0; }
        .loja-currency-text { font-family: 'Poppins', sans-serif; font-size: 12.5px; opacity: 0.6; line-height: 1.5; }

        /* Grade de itens (personalização + jogo) — mesmo espírito de
           .pool-item já usado em dev-image-pool.ejs, adaptado pra
           catálogo de prévia (sem ações de CRUD, com selo "Em breve"). */
        .loja-grid { display: flex; flex-wrap: wrap; gap: 16px; }
        .loja-item {
            position: relative;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            gap: 8px;
            width: 170px;
            padding: 10px;
            background: #131314;
            border: 1px solid rgba(217, 163, 98, 0.2);
            border-radius: 10px;
            overflow: hidden;
        }
        .loja-item-thumb {
            width: 100%;
            aspect-ratio: 4 / 3;
            border-radius: 8px;
            background-color: #1F1D20;
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .loja-item-thumb i { width: 28px; height: 28px; color: #803E30; }
        .loja-item-label { font-family: 'Poppins', sans-serif; font-weight: 600; font-size: 0.8rem; color: #F8DCC0; }
        .loja-item-desc { font-family: 'Poppins', sans-serif; font-size: 0.7rem; opacity: 0.5; line-height: 1.4; }
        .loja-item-price {
            margin-top: auto;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 0.72rem;
        }
        .loja-item-price.is-hunt { color: #DCA15E; }
        .loja-item-price.is-bones { color: #F8DCC0; }
        .loja-item-price i { width: 13px; height: 13px; }
        .loja-soon-ribbon {
            position: absolute;
            top: 8px;
            right: -26px;
            transform: rotate(35deg);
            background: #4B2427;
            color: #F8DCC0;
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 0.6rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 3px 30px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.4);
        }
    </style>
</head>
<body class="flex min-h-screen">

    <aside class="shrink-0 h-screen sticky top-0 py-[15px] pl-[15px] lg:py-[30px] lg:pl-[30px]">
        <%- include('partials/sidebar-v2', { active: 'loja', guild: otherGuilds[0] || null, nickname, role, isOwner, restricted: true }) %>
    </aside>

    <%# Sem overflow-y-auto (pedido do dono, 2026-08-05) — ver comentário completo em moderacao.ejs. %>
    <main class="flex-1 w-full flex flex-col p-[15px] gap-[20px] lg:p-[30px] lg:gap-[30px]">

        <h1 class="section-title text-2xl"><span data-i18n-pt>LOJA</span><span data-i18n-en>SHOP</span></h1>
        <p class="text-sm opacity-50 -mt-2"><span data-i18n-pt>Uma prévia do que está por vir — nada aqui pode ser comprado ainda.</span><span data-i18n-en>A preview of what's coming — nothing here can be purchased yet.</span></p>

        <div class="outline-chip">
            <i data-lucide="construction" class="outline-chip-icon"></i>
            <div class="outline-chip-text">
                <span class="outline-chip-headline"><span data-i18n-pt>Loja em construção</span><span data-i18n-en>Shop under construction</span></span>
                <span class="outline-chip-subtitle"><span data-i18n-pt>Esta página mostra como a loja vai funcionar. Saldo de Caçadas/Ossos, níveis e compras ainda não existem de verdade.</span><span data-i18n-en>This page shows how the shop will work. Hunt/Bones balances, levels, and purchases don't exist yet.</span></span>
            </div>
        </div>

        <%#
            3 cards explicando as moedas (pedido do dono, ver PREMIUM.txt
            seção 116): Hunt (personalização, ganha por hora/missão,
            NUNCA vira vantagem em jogo), Ossos/Bones (loja de jogo, ganha
            por hora, só de missão aberta a todo mundo — nunca de missão
            exclusiva premium) e XP/Nível (1h = 1 XP, separado das
            moedas). Ordem importa: Hunt primeiro (moeda "mais segura"/já
            documentada há mais tempo), Ossos no meio (a novidade desta
            revisão), Nível por último (não é moeda, é progressão).
        %>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-[20px]">
            <section class="titan-card-premium loja-currency-card">
                <div class="loja-currency-icon is-hunt"><i data-lucide="gem"></i></div>
                <span class="loja-currency-title"><span data-i18n-pt>CAÇADAS — Personalização</span><span data-i18n-en>HUNT — Customization</span></span>
                <p class="loja-currency-text"><span data-i18n-pt>Ganhe 1 Caçada por hora jogada, ou completando missões. Só troca por itens de personalização de perfil — nunca por vantagens dentro do jogo.</span><span data-i18n-en>Earn 1 Hunt per hour played, or by completing quests. Only spent on profile customization — never on in-game advantages.</span></p>
            </section>
            <section class="titan-card-premium loja-currency-card">
                <div class="loja-currency-icon is-bones"><i data-lucide="bone"></i></div>
                <span class="loja-currency-title"><span data-i18n-pt>OSSOS — Loja de Jogo</span><span data-i18n-en>BONES — Game Shop</span></span>
                <p class="loja-currency-text"><span data-i18n-pt>Ganhe 5 Ossos por hora jogada. Use na Loja de Jogo ou converta em Caçadas (até 100 Ossos/semana). Só vêm de missões abertas a qualquer jogador.</span><span data-i18n-en>Earn 5 Bones per hour played. Spend them in the Game Shop or convert to Hunt (up to 100 Bones/week). Only earned from quests open to any player.</span></p>
            </section>
            <section class="titan-card-premium loja-currency-card">
                <div class="loja-currency-icon is-xp"><i data-lucide="trending-up"></i></div>
                <span class="loja-currency-title"><span data-i18n-pt>NÍVEL — Experiência</span><span data-i18n-en>LEVEL — Experience</span></span>
                <p class="loja-currency-text"><span data-i18n-pt>1 hora jogada = 1 XP. Sobe o "Nível" do seu card de /perfil (hoje sempre "Nível 1") conforme você joga.</span><span data-i18n-en>1 hour played = 1 XP. Raises the "Level" badge on your /perfil card (currently always "Level 1") as you play.</span></p>
            </section>
        </div>

        <%#
            LOJA DE PERSONALIZAÇÃO — só imagens (pedido do dono: "a loja
            de personalização só vai conter imagens para o perfil"),
            reaproveitando o pool dinâmico REAL (avatares/planos de
            fundo/emblemas) em vez de itens fake — mesmas imagens que já
            aparecem nos menus de /perfil-edit hoje.
        %>
        <section class="titan-card-premium flex-col gap-4">
            <div>
                <h2 class="section-title text-lg flex items-center gap-2">
                    <i data-lucide="gem" class="w-5 h-5" style="color:#DCA15E;"></i>
                    <span data-i18n-pt>LOJA DE PERSONALIZAÇÃO</span><span data-i18n-en>CUSTOMIZATION SHOP</span>
                </h2>
                <p class="text-[13px] opacity-50 mt-1"><span data-i18n-pt>Paga com Caçadas. Só imagens de perfil — nada que mude qualquer coisa dentro do jogo.</span><span data-i18n-en>Paid with Hunt. Only profile images — nothing that changes anything in-game.</span></p>
            </div>

            <%
                const lojaPersonalizacaoGroups = [
                    { key: 'avatar', labelPt: 'Avatares', labelEn: 'Avatars', items: avatars },
                    { key: 'background', labelPt: 'Planos de Fundo', labelEn: 'Backgrounds', items: backgrounds },
                    { key: 'badge', labelPt: 'Emblemas', labelEn: 'Badges', items: badges },
                ];
            %>
            <% lojaPersonalizacaoGroups.forEach(group => { %>
                <div class="flex flex-col gap-3">
                    <h3 class="text-titan-gold text-sm uppercase tracking-widest"><span data-i18n-pt><%= group.labelPt %></span><span data-i18n-en><%= group.labelEn %></span></h3>
                    <% if (group.items.length === 0) { %>
                        <p class="text-sm opacity-40"><span data-i18n-pt>Nenhuma imagem pública no pool ainda.</span><span data-i18n-en>No public image in the pool yet.</span></p>
                    <% } else { %>
                        <div class="loja-grid">
                            <% group.items.forEach(img => { %>
                                <div class="loja-item">
                                    <span class="loja-soon-ribbon"><span data-i18n-pt>Em breve</span><span data-i18n-en>Soon</span></span>
                                    <div class="loja-item-thumb" style="<%= img.url ? `background-image:url('${img.url}')` : '' %>"></div>
                                    <span class="loja-item-label"><%= img.label %></span>
                                    <span class="loja-item-price is-hunt"><i data-lucide="gem"></i> <span data-i18n-pt>Preço a definir</span><span data-i18n-en>Price TBD</span></span>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                </div>
            <% }); %>
        </section>

        <%#
            LOJA DE JOGO — bônus DENTRO do Path of Titans via RCON
            (pedido do dono: catálogo listado até agora). Sem preço em
            Ossos inventado pra nenhum item (o dono não deu valores,
            exceto a conversão pra Marks) — mostra "Em breve" no lugar
            de um número chutado.
        %>
        <section class="titan-card-premium flex-col gap-4">
            <div>
                <h2 class="section-title text-lg flex items-center gap-2">
                    <i data-lucide="bone" class="w-5 h-5" style="color:#F8DCC0;"></i>
                    <span data-i18n-pt>LOJA DE JOGO</span><span data-i18n-en>GAME SHOP</span>
                </h2>
                <p class="text-[13px] opacity-50 mt-1"><span data-i18n-pt>Paga com Ossos. Bônus aplicados DENTRO do Path of Titans, via comando do servidor.</span><span data-i18n-en>Paid with Bones. Bonuses applied INSIDE Path of Titans, via server command.</span></p>
            </div>

            <%
                // Valores de Growth confirmados pelo dono (2026-08-06):
                // 0 Filhote / 0.25 Juvenil / 0.50 Adolescente / 0.75
                // Subadulto / 1 Adulto — só os 4 estágios COMPRÁVEIS entram
                // no catálogo (Filhote é o ponto de partida de todo
                // dinossauro, não um item de loja).
                const lojaJogoItems = [
                    { icon: 'sprout', labelPt: 'Growth: Juvenil', labelEn: 'Growth: Juvenile', descPt: 'Define Growth em 0.25.', descEn: 'Sets Growth to 0.25.' },
                    { icon: 'sprout', labelPt: 'Growth: Adolescente', labelEn: 'Growth: Adolescent', descPt: 'Define Growth em 0.50.', descEn: 'Sets Growth to 0.50.' },
                    { icon: 'sprout', labelPt: 'Growth: Subadulto', labelEn: 'Growth: Sub-Adult', descPt: 'Define Growth em 0.75.', descEn: 'Sets Growth to 0.75.' },
                    { icon: 'sprout', labelPt: 'Growth: Adulto', labelEn: 'Growth: Adult', descPt: 'Define Growth em 1.0.', descEn: 'Sets Growth to 1.0.' },
                    { icon: 'refresh-cw', labelPt: 'Skipshed', labelEn: 'Skipshed', descPt: 'Pula a muda (troca de pele).', descEn: 'Skips the molt (skin shed).' },
                    { icon: 'scroll-text', labelPt: 'Missão de Marks', labelEn: 'Marks Quest', descPt: 'Concede uma missão em jogo que recompensa Marks.', descEn: 'Grants an in-game quest that rewards Marks.' },
                    { icon: 'repeat', labelPt: 'Converter em Marks', labelEn: 'Convert to Marks', descPt: '1 Osso = 10 Marks.', descEn: '1 Bone = 10 Marks.', isRate: true },
                ];
            %>
            <div class="loja-grid">
                <% lojaJogoItems.forEach(item => { %>
                    <div class="loja-item">
                        <span class="loja-soon-ribbon"><span data-i18n-pt>Em breve</span><span data-i18n-en>Soon</span></span>
                        <div class="loja-item-thumb"><i data-lucide="<%= item.icon %>"></i></div>
                        <span class="loja-item-label"><span data-i18n-pt><%= item.labelPt %></span><span data-i18n-en><%= item.labelEn %></span></span>
                        <% if (item.descPt) { %>
                            <span class="loja-item-desc"><span data-i18n-pt><%= item.descPt %></span><span data-i18n-en><%= item.descEn %></span></span>
                        <% } %>
                        <% if (item.isRate) { %>
                            <span class="loja-item-price is-bones"><i data-lucide="bone"></i> <span data-i18n-pt>Taxa: 1 Osso = 10 Marks</span><span data-i18n-en>Rate: 1 Bone = 10 Marks</span></span>
                        <% } else { %>
                            <span class="loja-item-price is-bones"><i data-lucide="bone"></i> <span data-i18n-pt>Preço a definir</span><span data-i18n-en>Price TBD</span></span>
                        <% } %>
                    </div>
                <% }); %>
            </div>
        </section>

        <footer class="flex justify-end pb-2">
            <span class="bebas text-[12px] uppercase tracking-[6px] text-titan-cream opacity-10 hover:opacity-30 transition-opacity">
                BY: KNUST SEIER VI
            </span>
        </footer>
    </main>

    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <script>if (window.lucide) window.lucide.createIcons();</script>
</body>
</html>
