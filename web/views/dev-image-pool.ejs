<%#
  web/views/dev-image-pool.ejs
  Página GLOBAL (sem :guildID — o pool de imagens não pertence a nenhum
  servidor), restrita ao dono do bot (isOwnerSession, ver dashboard.js
  GET /dev/image-pool) — gerencia o pool dinâmico (avatar/plano de
  fundo/emblema/banner, ver src/systems/pot/profileImagePool.js): sobe
  imagem nova, ativa/desativa visibilidade sem remover, ou apaga de
  verdade. Mesmas ações do /perfil-pool no Discord (add/remover), só que
  pelo dashboard, mais o toggle de público/privado que só existe aqui.
  Também precifica item pra Loja de Caçadas (shop_price/shop_min_tier,
  ver src/systems/pot/imageShopSystem.js) — POST /dev/image-pool/:type/:id/preco.

  Uso: res.render('dev-image-pool', { groups })
    groups — array [{ type, label, images: [{ id, label, url, is_public,
             created_at, shop_price, shop_min_tier }] }] (shop_price/
             shop_min_tier vêm de graça no spread `...row` do SELECT *,
             ver dashboard.js GET /dev/image-pool).
%>
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pool de Imagens (Dev) | <%= bot.user.username %></title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Tilt+Warp&family=Bebas+Neue&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'titan-bg': '#0D0D0D',
                        'titan-accent': '#803E30',
                        'titan-cream': '#F8DCC0',
                        'titan-gold': '#D9A362',
                    }
                }
            }
        }
    </script>
    <style>
        .pool-grid { display: flex; flex-wrap: wrap; gap: 16px; }
        .pool-item {
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            gap: 8px;
            width: 160px;
            padding: 10px;
            background: #131314;
            border: 1px solid rgba(217, 163, 98, 0.25);
            border-radius: 10px;
        }
        .pool-item-thumb {
            width: 100%;
            aspect-ratio: 4 / 3;
            border-radius: 8px;
            background-color: #1F1D20;
            background-size: cover;
            background-position: center;
        }
        .pool-item-label {
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 0.8rem;
            color: #F8DCC0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .pool-item-meta { font-size: 0.7rem; opacity: 0.5; }
        .pool-item-badge {
            display: inline-flex;
            align-self: flex-start;
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 2px 8px;
            border-radius: 20px;
        }
        .pool-item-badge.is-public { background: rgba(165, 255, 161, 0.15); color: #A5FFA1; }
        .pool-item-badge.is-private { background: rgba(255, 78, 59, 0.15); color: #FF4E3B; }
        .pool-item-actions { display: flex; flex-direction: column; gap: 6px; margin-top: auto; }
        .pool-toggle-btn, .pool-delete-btn {
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 0.75rem;
            width: 100%;
            padding: 6px 10px;
            border-radius: 8px;
            border: 1px solid rgba(248, 220, 192, 0.25);
            background: transparent;
            color: #F8DCC0;
            cursor: pointer;
            transition: background 0.15s ease, border-color 0.15s ease;
        }
        .pool-toggle-btn:hover { background: rgba(248, 220, 192, 0.1); }
        .pool-delete-btn { border-color: rgba(255, 78, 59, 0.3); color: #FF4E3B; }
        .pool-delete-btn:hover { background: rgba(255, 78, 59, 0.12); }

        /* Form de upload no topo de cada card — mesma cápsula
           .input-container-premium/.input-premium-field do resto do
           dashboard, só compacta (label curto + arquivo lado a lado). */
        .pool-upload-form {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
            padding: 12px;
            background: #131314;
            border: 1px dashed rgba(217, 163, 98, 0.3);
            border-radius: 10px;
        }
        .pool-upload-form input[type="text"] {
            background: transparent;
            border: 1px solid rgba(217, 163, 98, 0.3);
            border-radius: 8px;
            padding: 8px 12px;
            color: #F8DCC0;
            font-family: 'Poppins', sans-serif;
            font-size: 0.85rem;
            width: 200px;
        }
        .pool-upload-form input[type="file"] {
            color: #F8DCC0;
            font-family: 'Poppins', sans-serif;
            font-size: 0.8rem;
        }
        .pool-upload-form input[type="file"]::file-selector-button {
            margin-right: 10px;
            padding: 6px 12px;
            border: none;
            border-radius: 6px;
            background: #DCA15E;
            color: #131314;
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 0.75rem;
            cursor: pointer;
        }
        .pool-upload-submit {
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 0.8rem;
            padding: 8px 16px;
            border-radius: 8px;
            border: none;
            background: #DCA15E;
            color: #131314;
            cursor: pointer;
            transition: background 0.15s ease;
        }
        .pool-upload-submit:hover { background: #F8DCC0; }

        /* Form compacto de preço da Loja, dentro de cada card — mesma
           paleta dos botões de toggle/excluir, só que agrupado numa
           cápsula própria pra não confundir com as outras ações. */
        .pool-price-form {
            display: flex;
            flex-direction: column;
            gap: 6px;
            padding: 8px;
            margin-top: 4px;
            background: rgba(217, 163, 98, 0.06);
            border: 1px dashed rgba(217, 163, 98, 0.25);
            border-radius: 8px;
        }
        .pool-price-current { font-size: 0.65rem; opacity: 0.6; }
        .pool-price-row { display: flex; gap: 6px; }
        .pool-price-row input[type="number"],
        .pool-price-row select {
            flex: 1;
            min-width: 0;
            background: #1F1D20;
            border: 1px solid rgba(217, 163, 98, 0.3);
            border-radius: 6px;
            padding: 4px 6px;
            color: #F8DCC0;
            font-family: 'Poppins', sans-serif;
            font-size: 0.7rem;
        }
        .pool-price-submit {
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 0.7rem;
            width: 100%;
            padding: 5px 10px;
            border-radius: 6px;
            border: none;
            background: #803E30;
            color: #F8DCC0;
            cursor: pointer;
            transition: background 0.15s ease;
        }
        .pool-price-submit:hover { background: #9A4C3B; }
    </style>
</head>
<body class="flex min-h-screen">

    <%
        // Tiers da Loja de Caçadas (ImageShopSystem.VALID_SHOP_TIERS) — mesmo
        // trio/nomes já usados em perfil.ejs (pfTierLabels), repetido aqui
        // pra não precisar passar o módulo inteiro como local.
        const SHOP_TIERS = ['free', 'compy', 'raptor'];
        const TIER_LABELS = { free: 'Free', compy: 'Compy', raptor: 'Raptor' };
    %>

    <%# Sem overflow-y-auto (pedido do dono, 2026-08-05) — ver comentário completo em moderacao.ejs. Página inteira rola via <body>, não mais o <main> por dentro (evita cortar a sombra dos cards). Página sem sidebar, mas o mesmo overflow-y aqui cortava a sombra contra a própria borda esquerda do <main>. %>
    <main class="flex-1 w-full flex flex-col p-[30px] gap-[30px]">

        <%- include('partials/save-result-overlay', { saved }) %>

        <div class="flex items-center justify-between flex-wrap gap-3">
            <div>
                <h1 class="section-title text-xl">Pool de Imagens</h1>
                <p class="text-xs opacity-50 mt-1">Suba imagens novas, ative/desative sem remover (imagens privadas somem dos menus de escolha — avatar/plano de fundo/emblema/banner — mas continuam guardadas) ou apague de verdade. As mesmas ações também existem pelo <code>/perfil-pool</code> no Discord.</p>
            </div>
            <a href="/dashboard" class="btn-primary !min-w-0 !h-auto !py-2 !px-4 !text-sm">
                <i data-lucide="arrow-left" class="w-4 h-4"></i> Voltar
            </a>
        </div>

        <% groups.forEach(group => { %>
            <section class="titan-card-premium flex-col gap-4">
                <h2 class="section-title text-lg"><%= group.label %> (<%= group.images.length %>)</h2>

                <% if (group.type === 'titulo') { %>
                    <form class="pool-upload-form" action="/dev/image-pool/titulo/add" method="POST">
                        <input type="text" name="titulo" placeholder="Texto do título" maxlength="80" required>
                        <button type="submit" class="pool-upload-submit">Adicionar</button>
                    </form>
                <% } else { %>
                    <form class="pool-upload-form" action="/dev/image-pool/<%= group.type %>/upload" method="POST" enctype="multipart/form-data">
                        <input type="text" name="label" placeholder="Nome de exibição" maxlength="80" required>
                        <input type="file" name="imagem" accept="image/png,image/jpeg,image/webp" required>
                        <button type="submit" class="pool-upload-submit">Adicionar</button>
                    </form>
                <% } %>

                <% if (group.images.length === 0) { %>
                    <p class="text-sm opacity-40">Nenhuma imagem cadastrada ainda.</p>
                <% } else { %>
                    <div class="pool-grid">
                        <% group.images.forEach(img => { %>
                            <div class="pool-item">
                                <% if (group.type === 'titulo') { %>
                                    <div class="pool-item-thumb flex items-center justify-center text-center p-2">
                                        <span class="pool-item-label !whitespace-normal"><%= img.label %></span>
                                    </div>
                                <% } else { %>
                                    <div class="pool-item-thumb" style="<%= img.url ? `background-image:url('${img.url}')` : '' %>"></div>
                                    <span class="pool-item-label"><%= img.label %></span>
                                <% } %>
                                <span class="pool-item-meta">#<%= img.id %> — <%= new Date(img.created_at).toLocaleDateString('pt-BR') %></span>
                                <span class="pool-item-badge <%= img.is_public ? 'is-public' : 'is-private' %>"><%= img.is_public ? 'Público' : 'Privado' %></span>
                                <%
                                    // Preço só faz sentido pra tipos com um caminho de USO ligado à
                                    // compra (avatar/background — ver imageShopSystem.js#canUseImage
                                    // e ConfigSystem.getOwnedUsableOptions, únicos consumidos pela
                                    // seleção de /perfil-edit e /perfil web). Emblema já é livre em
                                    // QUALQUER tier de propósito, então "comprar" um seria inútil;
                                    // banner é escolha de SERVIDOR (Caçador), não do jogador; título
                                    // ainda não tem NENHUM jeito do jogador escolher um da pool (só
                                    // texto livre Raptor) — precificar esses 3 venderia algo que
                                    // ninguém consegue usar depois. Escondido aqui de propósito.
                                %>
                                <% if (group.type === 'avatar' || group.type === 'background') { %>
                                    <div class="pool-price-form">
                                        <span class="pool-price-current">
                                            <% if (img.shop_price) { %>
                                                Preço atual: <%= img.shop_price %> Caçadas (mín. <%= TIER_LABELS[img.shop_min_tier] || img.shop_min_tier %>)
                                            <% } else { %>
                                                Não está à venda
                                            <% } %>
                                        </span>
                                        <form action="/dev/image-pool/<%= group.type %>/<%= img.id %>/preco" method="POST">
                                            <div class="pool-price-row">
                                                <input type="number" name="preco" min="0" step="1" placeholder="Preço" value="<%= img.shop_price || '' %>">
                                                <select name="tier_minimo">
                                                    <% SHOP_TIERS.forEach(tier => { %>
                                                        <option value="<%= tier %>" <%= (img.shop_min_tier || 'free') === tier ? 'selected' : '' %>><%= TIER_LABELS[tier] %></option>
                                                    <% }); %>
                                                </select>
                                            </div>
                                            <button type="submit" class="pool-price-submit">Salvar preço</button>
                                        </form>
                                    </div>
                                <% } %>
                                <div class="pool-item-actions">
                                    <form action="/dev/image-pool/<%= group.type %>/<%= img.id %>/toggle" method="POST">
                                        <button type="submit" class="pool-toggle-btn"><%= img.is_public ? 'Tornar privado' : 'Tornar público' %></button>
                                    </form>
                                    <form action="/dev/image-pool/<%= group.type %>/<%= img.id %>/delete" method="POST" onsubmit="return confirm('Excluir \'<%= img.label.replace(/'/g, "") %>\' do pool? Isso não pode ser desfeito.');">
                                        <button type="submit" class="pool-delete-btn">Excluir</button>
                                    </form>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </section>
        <% }); %>

        <footer class="flex justify-end pb-2">
            <span class="bebas text-[12px] uppercase tracking-[6px] text-titan-cream opacity-10 hover:opacity-30 transition-opacity">
                BY: KNUST SEIER VI
            </span>
        </footer>
    </main>

    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <script>if (window.lucide) window.lucide.createIcons();</script>
</body>
</html>
